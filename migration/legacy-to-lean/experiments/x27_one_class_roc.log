289        proc means data=work.credit_raw n nmiss mean std min max;
290            title "Raw Data Summary - Kaggle Give Me Some Credit";
291        run;
292        
293        /*****************************************************************************
294         * 2. Data Cleaning and Missing Value Handling
295         *****************************************************************************/
296        
297        /* First convert MonthlyIncome to numeric if needed */
298        data work.credit_raw_clean;
299            set work.credit_raw;
300        
301            /* Convert to numeric - input function handles character to numeric */
302            MonthlyIncome_num = input(MonthlyIncome, best32.);
303            NumberOfDependents_num = input(NumberOfDependents, best32.);
304        
305            /* Keep the numeric versions, drop character if they exist */
306            drop MonthlyIncome NumberOfDependents;
307            rename MonthlyIncome_num = MonthlyIncome
308                   NumberOfDependents_num = NumberOfDependents;
309        run;
