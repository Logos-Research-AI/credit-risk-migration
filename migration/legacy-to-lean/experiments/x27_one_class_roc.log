1351       
1352       /*****************************************************************************
1353        * 2. Train Logistic Regression Model
1354        *****************************************************************************/
1355       
1356       /* Train logistic regression with stepwise selection */
1357       proc logistic data=work.model_features_train descending;
1358           model default_flag =
1359               /* Core risk metrics */
1360               credit_utilization_capped debt_ratio_capped
1361       
1362               /* Late payment indicators */
1363               num_late_30_59 num_late_60_89 num_late_90_plus
1364               total_late_payments has_delinquency has_serious_delinquency
1365       
1366               /* Financial metrics */
1367               age monthly_income log_monthly_income
1368               num_credit_lines num_real_estate_loans log_num_credit_lines
1369               num_dependents income_per_dependent credit_lines_per_person
1370       
1371               /* Risk flags */
1372               flag_high_utilization flag_very_high_utilization
1373               flag_high_debt_ratio flag_very_high_debt_ratio
1374               flag_recent_late_payments flag_serious_delinquency
1375               flag_multiple_delinquencies flag_low_income
1376               flag_many_dependents flag_few_credit_lines
1377               total_risk_flags
1378       
1379               /* Categorical indicators */
1380               credit_util_category debt_category age_category
1381       
1382               /* Composite scores */
1383               financial_health
1384       
1385               /* Interaction features */
1386               age_income_interaction utilization_debt_interaction
1387       
1388               /* Missing value flags */
1389               MonthlyIncome_missing Dependents_missing
1390       
1391           / selection=stepwise slentry=0.05 slstay=0.05
1392             ctable lackfit rsquare;
1393       
1394           /* Output predictions */
1395           output out=work.logit_scored_train
1396                  predicted=pd_logistic;
1397       
1398           /* Store model for scoring */
1399           store work.logit_model;
1400       
1401           /* Output parameter estimates (coefficients) */
1402           ods output ParameterEstimates=work.model_coefficients;
1403       
1404           title "Logistic Regression Model - Credit Default Prediction";
1405       run;
1406       
1407       /*****************************************************************************
1408        * 3. Evaluate Model on Training Data
1409        *****************************************************************************/
1410       
1411       /* Add binary prediction variable */
1412       data work.logit_scored_train;
1413           set work.logit_scored_train;
1414           pred_logistic = (pd_logistic >= 0.5);
1415       run;
1416       
1417       /* Confusion matrix on training set */
1418       proc freq data=work.logit_scored_train noprint;
1419           tables default_flag * pred_logistic / out=work.confusion_matrix_train;
1420       run;
1421       
1422       proc print data=work.confusion_matrix_train;
1423           title "Confusion Matrix - Training Set";
1424       run;
1425       
1426       /* Calculate precision, recall, and F1 score for training set */
1427       data work.training_metrics;
1428           set work.confusion_matrix_train end=eof;
1429           retain TP TN FP FN 0;
1430       
1431           if default_flag = 1 and pred_logistic = 1 then TP = count;
1432           else if default_flag = 0 and pred_logistic = 0 then TN = count;
1433           else if default_flag = 0 and pred_logistic = 1 then FP = count;
1434           else if default_flag = 1 and pred_logistic = 0 then FN = count;
1435       
1436           if eof then do;
1437               if (TP + FP) > 0 then train_precision = TP / (TP + FP);
1438               else train_precision = .;
1439               if (TP + FN) > 0 then train_recall = TP / (TP + FN);
1440               else train_recall = .;
1441               if (train_precision + train_recall) > 0 then train_f1_score = 2 * (train_precision * train_recall) /
1441     ! (train_precision + train_recall);
1442               else train_f1_score = .;
1443               if (TP + TN + FP + FN) > 0 then train_accuracy = (TP + TN) / (TP + TN + FP + FN);
1444               else train_accuracy = .;
1445               output;
1446           end;
1447           keep train_precision train_recall train_f1_score train_accuracy;
1448       run;
1449       
1450       proc print data=work.training_metrics;
1451           title "Training Set - Performance Metrics";
1452           format train_precision train_recall train_f1_score train_accuracy 8.4;
1453       run;
1454       
1455       /*****************************************************************************
1456        * 4. Score Validation Set
1457        *****************************************************************************/
1458       
1459       /* Score validation set with trained model */
1460       proc plm restore=work.logit_model;
1461           score data=work.model_features_validation
1462                 out=work.logit_scored_valid_temp
1463                 predicted=predicted_logit;
1464       run;
1465       
1466       /* Convert logit to probability */
1467       data work.logit_scored_valid;
1468           set work.logit_scored_valid_temp;
1469       
1470           /* Apply inverse logit (logistic) function */
1471           pd_logistic = 1 / (1 + exp(-predicted_logit));
1472       
1473           /* Add binary prediction */
1474           pred_logistic = (pd_logistic >= 0.5);
1475       
1476           drop predicted_logit;
1477       run;
1478       
1479       /* Confusion matrix on validation set */
1480       proc freq data=work.logit_scored_valid noprint;
1481           tables default_flag * pred_logistic / out=work.confusion_matrix;
1482       run;
1483       
1484       proc print data=work.confusion_matrix;
1485           title "Confusion Matrix - Validation Set";
1486       run;
1487       
1488       /* Calculate precision, recall, and F1 score for validation set */
1489       data work.validation_metrics;
1490           set work.confusion_matrix end=eof;
1491           retain TP TN FP FN 0;
1492       
1493           if default_flag = 1 and pred_logistic = 1 then TP = count;
1494           else if default_flag = 0 and pred_logistic = 0 then TN = count;
1495           else if default_flag = 0 and pred_logistic = 1 then FP = count;
1496           else if default_flag = 1 and pred_logistic = 0 then FN = count;
1497       
1498           if eof then do;
1499               if (TP + FP) > 0 then valid_precision = TP / (TP + FP);
1500               else valid_precision = .;
1501               if (TP + FN) > 0 then valid_recall = TP / (TP + FN);
1502               else valid_recall = .;
1503               if (valid_precision + valid_recall) > 0 then valid_f1_score = 2 * (valid_precision * valid_recall) /
1503     ! (valid_precision + valid_recall);
1504               else valid_f1_score = .;
1505               if (TP + TN + FP + FN) > 0 then valid_accuracy = (TP + TN) / (TP + TN + FP + FN);
1506               else valid_accuracy = .;
1507               output;
1508           end;
1509           keep valid_precision valid_recall valid_f1_score valid_accuracy;
1510       run;
1511       
1512       proc print data=work.validation_metrics;
1513           title "Validation Set - Performance Metrics";
1514           format valid_precision valid_recall valid_f1_score valid_accuracy 8.4;
1515       run;
1516       
1517       /*****************************************************************************
1518        * 5. Create Risk Scores and Grades
1519        *****************************************************************************/
1520       
1521       /* Generate risk scores for training set */
1522       data work.risk_scores_train;
1523           set work.logit_scored_train;
1524       
1525           /* Convert probability to credit risk score (300-850 scale like FICO) */
1526           base_score = 600;
1527           score_range = 250;
1528           credit_risk_score = base_score + score_range * (1 - pd_logistic);
1529       
1530           /* Assign risk grades from the probability (a missing probability is graded F) */
1531           if missing(pd_logistic) then risk_grade = 'F';
1532           else if pd_logistic < 0.10 then risk_grade = 'A';
1533           else if pd_logistic < 0.15 then risk_grade = 'B';
1534           else if pd_logistic < 0.25 then risk_grade = 'C';
1535           else if pd_logistic < 0.35 then risk_grade = 'D';
1536           else if pd_logistic <= 0.50 then risk_grade = 'E';
1537           else risk_grade = 'F';
1538       
1539           /* Recommended actions */
1540           if risk_grade in ('A', 'B') then recommendation = 'Approve';
1541           else if risk_grade = 'C' then recommendation = 'Review';
1542           else recommendation = 'Decline';
1543       
1544           /* Suggested interest rate (risk-based pricing) */
1545           base_rate = 0.05;
1546           if risk_grade = 'A' then interest_rate = base_rate;
1547           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
1548           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
1549           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
1550           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
1551           else interest_rate = base_rate + 0.15;
1552       
1553           format interest_rate percent8.2;
1554       run;
1555       
1556       /* Generate risk scores for validation set */
1557       data work.risk_scores_validation;
1558           set work.logit_scored_valid;
1559       
1560           /* Same scoring logic as training */
1561           base_score = 600;
1562           score_range = 250;
1563           credit_risk_score = base_score + score_range * (1 - pd_logistic);
1564       
1565           if missing(pd_logistic) then risk_grade = 'F';
1566           else if pd_logistic < 0.10 then risk_grade = 'A';
1567           else if pd_logistic < 0.15 then risk_grade = 'B';
1568           else if pd_logistic < 0.25 then risk_grade = 'C';
1569           else if pd_logistic < 0.35 then risk_grade = 'D';
1570           else if pd_logistic <= 0.50 then risk_grade = 'E';
1571           else risk_grade = 'F';
1572       
1573           if risk_grade in ('A', 'B') then recommendation = 'Approve';
1574           else if risk_grade = 'C' then recommendation = 'Review';
1575           else recommendation = 'Decline';
1576       
1577           base_rate = 0.05;
1578           if risk_grade = 'A' then interest_rate = base_rate;
1579           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
1580           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
1581           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
1582           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
1583           else interest_rate = base_rate + 0.15;
1584       
1585           format interest_rate percent8.2;
1586       run;
1587       
1588       /* Risk grade distribution */
1589       proc freq data=work.risk_scores_train;
1590           tables risk_grade * default_flag / nocol nopercent;
1591           title "Default Rate by Risk Grade - Training Set";
1592       run;
1593       
1594       proc freq data=work.risk_scores_validation;
1595           tables risk_grade * default_flag / nocol nopercent;
1596           title "Default Rate by Risk Grade - Validation Set";
1597       run;
