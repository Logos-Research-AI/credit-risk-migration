310        
311        /* Calculate income medians by age group for imputation */
312        proc sql;
313            create table work.income_medians as
314            select
315                case
316                    when age < 30 then 1
317                    when age < 40 then 2
318                    when age < 50 then 3
319                    when age < 60 then 4
320                    else 5
321                end as age_group,
322                median(MonthlyIncome) as median_income
323            from work.credit_raw_clean
324            where MonthlyIncome is not missing
325            group by calculated age_group;
326        quit;
327        
328        /* One row per age group, with the median of all known incomes:
329           the fallback for an age group that has no known income */
330        data work.age_groups;
331            do age_group = 1 to 5;
332                output;
333            end;
334        run;
335        
336        proc sql;
337            create table work.income_medians_all as
338            select
339                g.age_group,
340                m.median_income,
341                (select median(MonthlyIncome) from work.credit_raw_clean
342                 where MonthlyIncome is not missing) as overall_median_income
343            from work.age_groups g
344            left join work.income_medians m
345            on g.age_group = m.age_group
346            order by g.age_group;
347        quit;
348        
349        data work.credit_cleaned;
350            set work.credit_raw_clean;
351        
352            /* Create age group for income imputation */
353            if age < 30 then age_group = 1;
354            else if age < 40 then age_group = 2;
355            else if age < 50 then age_group = 3;
356            else if age < 60 then age_group = 4;
357            else age_group = 5;
358        
359            /* Handle missing values - create flags */
360            if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
361            else MonthlyIncome_missing = 0;
362        
363            if missing(NumberOfDependents) then do;
364                NumberOfDependents = 0;
365                Dependents_missing = 1;
366            end;
367            else Dependents_missing = 0;
368        run;
369        
370        /* Merge and impute income - rename columns in SQL */
371        proc sql;
372            create table work.credit_imputed as
373            select
374                a.VAR1 as row_id,
375                a.SeriousDlqin2yrs as default_flag,
376                a.age,
377                case when a.MonthlyIncome_missing = 1 then coalesce(b.median_income, b.overall_median_income)
378                     else a.MonthlyIncome
379                end as monthly_income,
380                a.MonthlyIncome_missing,
381                a.NumberOfDependents as num_dependents,
382                a.Dependents_missing,
383                a.age_group,
384                a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
385                a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
386                a.NumberOfTimes90DaysLate as num_late_90_plus,
387                a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
388                a.DebtRatio * 100 as debt_ratio,
389                a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
390                a.NumberRealEstateLoansOrLines as num_real_estate_loans
391            from work.credit_cleaned a
392            left join work.income_medians_all b
393            on a.age_group = b.age_group;
394        quit;
395        
396        /*****************************************************************************
397         * 3. Feature Engineering
398         *****************************************************************************/
399        
400        data work.credit_features;
401            set work.credit_imputed;
402        
403            /* Total late payments across all categories */
404            total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
405        
406            /* Has any delinquency indicator */
407            has_delinquency = (total_late_payments > 0);
408        
409            /* Has serious delinquency (90+ days) */
410            has_serious_delinquency = (num_late_90_plus > 0);
411        
412            /* Credit utilization categories */
413            if credit_utilization < 30 then credit_util_category = 1; /* Low */
414            else if credit_utilization < 50 then credit_util_category = 2; /* Medium */
415            else if credit_utilization < 75 then credit_util_category = 3; /* High */
416            else credit_util_category = 4; /* Very High */
417        
418            /* Debt ratio categories */
419            if debt_ratio < 30 then debt_category = 1; /* Low */
420            else if debt_ratio < 43 then debt_category = 2; /* Medium */
421            else if debt_ratio < 60 then debt_category = 3; /* High */
422            else debt_category = 4; /* Very High */
423        
424            /* Income per dependent (handle division by zero) */
425            if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
426            else income_per_dependent = monthly_income;
427        
428            /* Credit lines per person in household */
429            credit_lines_per_person = num_credit_lines / (num_dependents + 1);
430        
431            /* Age categories for risk assessment */
432            if age < 25 then age_category = 1; /* Young */
433            else if age < 35 then age_category = 2; /* Young Adult */
434            else if age < 50 then age_category = 3; /* Middle Age */
435            else if age < 65 then age_category = 4; /* Mature */
436            else age_category = 5; /* Senior */
437        
438            /* Risk flags */
439            flag_high_utilization = (credit_utilization > 75);
440            flag_very_high_utilization = (credit_utilization > 100);
441            flag_high_debt_ratio = (debt_ratio > 43);
442            flag_very_high_debt_ratio = (debt_ratio > 60);
443            flag_recent_late_payments = (num_late_30_59 > 0);
444            flag_serious_delinquency = (num_late_90_plus > 0);
445            flag_multiple_delinquencies = (total_late_payments >= 3);
446            flag_low_income = (monthly_income < 2500);
447            flag_many_dependents = (num_dependents >= 3);
448            flag_few_credit_lines = (num_credit_lines <= 2);
449        
450            /* Total risk flags */
451            total_risk_flags = sum(flag_high_utilization, flag_very_high_utilization,
452                                  flag_high_debt_ratio,
453                                  flag_serious_delinquency, flag_multiple_delinquencies,
454                                  flag_low_income, flag_many_dependents,
455                                  flag_few_credit_lines);
456        
457            /* Financial health score (0-100) */
458            financial_health = 100;
459            if credit_utilization > 30 then financial_health = financial_health - 15;
460            if credit_utilization > 75 then financial_health = financial_health - 15;
461            if debt_ratio > 43 then financial_health = financial_health - 20;
462            if has_delinquency then financial_health = financial_health - 20;
463            if num_late_90_plus > 0 then financial_health = financial_health - 30;
464            financial_health = max(0, financial_health);
465        
466            /* Log transformations for skewed variables (add 1 to handle zeros) */
467            log_monthly_income = log(monthly_income + 1);
468            log_num_credit_lines = log(num_credit_lines + 1);
469            log_total_late_payments = log(total_late_payments + 1);
470        
471            /* Interaction features */
472            if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
473            else age_income_interaction = age * log_monthly_income;
474            utilization_debt_interaction = credit_utilization * debt_ratio;
475        
476            /* Cap extreme outliers in credit_utilization and debt_ratio */
477            credit_utilization_capped = min(credit_utilization, 200);
478            debt_ratio_capped = min(debt_ratio, 500);
479        run;
