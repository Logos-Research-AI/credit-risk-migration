1517       /*****************************************************************************
1518        * 5. Create Risk Scores and Grades
1519        *****************************************************************************/
1520       
1521       /* Generate risk scores for training set */
1522       data work.risk_scores_train;
1523           set work.logit_scored_train;
1524       
1525           /* Convert probability to credit risk score (300-850 scale like FICO) */
1526           base_score = 600;
1527           score_range = 250;
1528           credit_risk_score = base_score + score_range * (1 - pd_logistic);
1529       
1530           /* Assign risk grades from the probability (a missing probability is graded F) */
1531           if missing(pd_logistic) then risk_grade = 'F';
1532           else if pd_logistic < 0.10 then risk_grade = 'A';
1533           else if pd_logistic < 0.15 then risk_grade = 'B';
1534           else if pd_logistic < 0.25 then risk_grade = 'C';
1535           else if pd_logistic < 0.35 then risk_grade = 'D';
1536           else if pd_logistic <= 0.50 then risk_grade = 'E';
1537           else risk_grade = 'F';
1538       
1539           /* Recommended actions */
1540           if risk_grade in ('A', 'B') then recommendation = 'Approve';
1541           else if risk_grade = 'C' then recommendation = 'Review';
1542           else recommendation = 'Decline';
1543       
1544           /* Suggested interest rate (risk-based pricing) */
1545           base_rate = 0.05;
1546           if risk_grade = 'A' then interest_rate = base_rate;
1547           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
1548           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
1549           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
1550           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
1551           else interest_rate = base_rate + 0.15;
1552       
1553           format interest_rate percent8.2;
1554       run;
1555       
1556       /* Generate risk scores for validation set */
1557       data work.risk_scores_validation;
1558           set work.logit_scored_valid;
1559       
1560           /* Same scoring logic as training */
1561           base_score = 600;
1562           score_range = 250;
1563           credit_risk_score = base_score + score_range * (1 - pd_logistic);
1564       
1565           if missing(pd_logistic) then risk_grade = 'F';
1566           else if pd_logistic < 0.10 then risk_grade = 'A';
1567           else if pd_logistic < 0.15 then risk_grade = 'B';
1568           else if pd_logistic < 0.25 then risk_grade = 'C';
1569           else if pd_logistic < 0.35 then risk_grade = 'D';
1570           else if pd_logistic <= 0.50 then risk_grade = 'E';
1571           else risk_grade = 'F';
1572       
1573           if risk_grade in ('A', 'B') then recommendation = 'Approve';
1574           else if risk_grade = 'C' then recommendation = 'Review';
1575           else recommendation = 'Decline';
1576       
1577           base_rate = 0.05;
1578           if risk_grade = 'A' then interest_rate = base_rate;
1579           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
1580           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
1581           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
1582           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
1583           else interest_rate = base_rate + 0.15;
1584       
1585           format interest_rate percent8.2;
1586       run;
