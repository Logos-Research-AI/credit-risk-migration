482         * 4. Split into Training and Validation Sets (70/30)
483         *****************************************************************************/
484        
485        /* Set random seed for reproducibility */
486        proc surveyselect data=work.credit_features
487                          out=work.credit_split
488                          samprate=0.7
489                          seed=42
490                          outall;
491        run;
492        
493        data work.credit_train work.credit_validation;
494            set work.credit_split;
495            if selected = 1 then output work.credit_train;
496            else output work.credit_validation;
497            drop selected;
498        run;
