1352       /*****************************************************************************
1353        * 2. Train Logistic Regression Model
1354        *****************************************************************************/
1355       
1356       /* Train logistic regression with stepwise selection */
1357       proc logistic data=work.model_features_train descending;
1358           model default_flag =
1359               /* Core risk metrics */
1360               credit_utilization_capped debt_ratio_capped
1361       
1362               /* Late payment indicators */
1363               num_late_30_59 num_late_60_89 num_late_90_plus
1364               total_late_payments has_delinquency has_serious_delinquency
1365       
1366               /* Financial metrics */
1367               age monthly_income log_monthly_income
1368               num_credit_lines num_real_estate_loans log_num_credit_lines
1369               num_dependents income_per_dependent credit_lines_per_person
1370       
1371               /* Risk flags */
1372               flag_high_utilization flag_very_high_utilization
1373               flag_high_debt_ratio flag_very_high_debt_ratio
1374               flag_recent_late_payments flag_serious_delinquency
1375               flag_multiple_delinquencies flag_low_income
1376               flag_many_dependents flag_few_credit_lines
1377               total_risk_flags
1378       
1379               /* Categorical indicators */
1380               credit_util_category debt_category age_category
1381       
1382               /* Composite scores */
1383               financial_health
1384       
1385               /* Interaction features */
1386               age_income_interaction utilization_debt_interaction
1387       
1388               /* Missing value flags */
1389               MonthlyIncome_missing Dependents_missing
1390       
1391           / selection=stepwise slentry=0.05 slstay=0.05
1392             ctable lackfit rsquare;
1393       
1394           /* Output predictions */
1395           output out=work.logit_scored_train
1396                  predicted=pd_logistic;
1397       
1398           /* Store model for scoring */
1399           store work.logit_model;
1400       
1401           /* Output parameter estimates (coefficients) */
1402           ods output ParameterEstimates=work.model_coefficients;
1403       
1404           title "Logistic Regression Model - Credit Default Prediction";
1405       run;
