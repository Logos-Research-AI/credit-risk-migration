1441               if (train_precision + train_recall) > 0 then train_f1_score = 2 * (train_precision * train_recall) /
1441     ! (train_precision + train_recall);
1442               else train_f1_score = .;
1443               if (TP + TN + FP + FN) > 0 then train_accuracy = (TP + TN) / (TP + TN + FP + FN);
1444               else train_accuracy = .;
1445               output;
1446           end;
1447           keep train_precision train_recall train_f1_score train_accuracy;
