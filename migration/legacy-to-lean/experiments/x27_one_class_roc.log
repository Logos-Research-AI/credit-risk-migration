212        /* Check the input conditions: stop with an error before anything is exported */
213        /* The numeric value of a raw column: a numeric column as it is; a character column
214           read as a number, missing when the text is no number or is longer than 32 characters */
215        %macro num(v);
216            %local dsid pos vtype;
217            %let vtype = ;
218            %let dsid = %sysfunc(open(work.credit_raw));
219            %let pos = %sysfunc(varnum(&dsid, &v));
220            %if &pos > 0 %then %let vtype = %sysfunc(vartype(&dsid, &pos));
221            %let dsid = %sysfunc(close(&dsid));
222            %if &vtype = N %then "&v"n;
223            %else ifn(lengthn(strip("&v"n)) <= 32, input(strip("&v"n), ?? best32.), .);
224        %mend;
225        
226        %let columns_ok = 0;
227        %let bad_rows = 1;
228        %let duplicate_ids = 1;
229        %let known_incomes = 0;
230        
231        proc sql noprint;
232            /* The expected columns and no others */
233            select (count(*) = 12 and sum(upcase(name) in
234                       ('VAR1', 'SERIOUSDLQIN2YRS', 'AGE', 'MONTHLYINCOME', 'NUMBEROFDEPENDENTS',
235                        'REVOLVINGUTILIZATIONOFUNSECUREDL', 'DEBTRATIO',
236                        'NUMBEROFTIME30-59DAYSPASTDUENOTW', 'NUMBEROFTIME60-89DAYSPASTDUENOTW',
237                        'NUMBEROFTIMES90DAYSLATE', 'NUMBEROFOPENCREDITLINESANDLOANS',
238                        'NUMBERREALESTATELOANSORLINES')) = 12)
239            into :columns_ok trimmed
240            from dictionary.columns
241            where libname = 'WORK' and memname = 'CREDIT_RAW';
242        quit;
243        
244        /* Only MonthlyIncome and NumberOfDependents may be missing (blank or NA);
245           the outcome is 0 or 1; the counts are whole numbers, zero or more;
246           a known MonthlyIncome is zero or more */
247        data work.input_check;
248            set work.credit_raw;
249            bad_row = (missing(%num(VAR1))
250                or %num(SeriousDlqin2yrs) not in (0, 1)
251                or missing(%num(age))
252                or missing(%num(RevolvingUtilizationOfUnsecuredL))
253                or missing(%num(DebtRatio))
254                or missing(%num(NumberRealEstateLoansOrLines))
255                or not (%num(NumberOfTime30-59DaysPastDueNotW) >= 0 and
256                        %num(NumberOfTime30-59DaysPastDueNotW) = int(%num(NumberOfTime30-59DaysPastDueNotW)))
257                or not (%num(NumberOfTime60-89DaysPastDueNotW) >= 0 and
258                        %num(NumberOfTime60-89DaysPastDueNotW) = int(%num(NumberOfTime60-89DaysPastDueNotW)))
259                or not (%num(NumberOfTimes90DaysLate) >= 0 and
260                        %num(NumberOfTimes90DaysLate) = int(%num(NumberOfTimes90DaysLate)))
261                or not (%num(NumberOfOpenCreditLinesAndLoans) >= 0 and
262                        %num(NumberOfOpenCreditLinesAndLoans) = int(%num(NumberOfOpenCreditLinesAndLoans)))
263                or (upcase(cats(MonthlyIncome)) not in ('', '.', 'NA') and missing(%num(MonthlyIncome)))
264                or (not missing(%num(MonthlyIncome)) and %num(MonthlyIncome) < 0)
265                or (upcase(cats(NumberOfDependents)) not in ('', '.', 'NA') and
266                    not (%num(NumberOfDependents) >= 0 and
267                         %num(NumberOfDependents) = int(%num(NumberOfDependents)))));
268            known_income = not missing(%num(MonthlyIncome));
269            keep VAR1 bad_row known_income;
270        run;
271        
272        /* Bad rows, repeated row ids, known incomes */
273        proc sql noprint;
274            select coalesce(sum(bad_row), 0), count(*) - count(distinct VAR1), coalesce(sum(known_income), 0)
275            into :bad_rows trimmed, :duplicate_ids trimmed, :known_incomes trimmed
276            from work.input_check;
277        quit;
