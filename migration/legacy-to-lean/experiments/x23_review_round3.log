25         /* x23: rules questioned by the reviewers of round 3 (second update).
26            (G) the check steps of feature_engineering.sas 81-114 and predict.sas 88-121 on a table that
27                has no VAR1 column: which variables does work.input_check have, in which order, and what
28                are the totals;
29            (H) COUNT(DISTINCT VAR1) on a character id column whose texts read as numbers:
30                '7', '07', '7.0', '+7', a value with a leading blank, values of different stored padding;
31            (I) what PROC IMPORT stores for id texts with leading or trailing blanks in the CSV;
32            (J) a CSV whose id texts all read as numbers: is the column character or numeric. */
33         %let x23_dir = %sysfunc(pathname(work));
34         options validvarname=any;
35         
36         %macro num(v);
37             %local dsid pos vtype;
38             %let vtype = ;
39             %let dsid = %sysfunc(open(work.&x23_tab));
40             %let pos = %sysfunc(varnum(&dsid, &v));
41             %if &pos > 0 %then %let vtype = %sysfunc(vartype(&dsid, &pos));
42             %let dsid = %sysfunc(close(&dsid));
43             %if &vtype = N %then "&v"n;
44             %else ifn(lengthn(strip("&v"n)) <= 32, input(strip("&v"n), ?? best32.), .);
45         %mend;
46         
47         %macro check(tab, kind, label);
48             %global x23_tab;
49             %let x23_tab = &tab;
50             %let bad_rows = 1;
51             %let duplicate_ids = 1;
52             %let known_incomes = 0;
53             data work.input_check;
54                 set work.&tab;
55                 %if &kind = train %then %do;
56                 bad_row = (missing(%num(VAR1))
57                     or %num(SeriousDlqin2yrs) not in (0, 1)
58                 %end;
59                 %else %do;
60                 bad_row = (missing(%num(VAR1))
61                     or (upcase(cats(SeriousDlqin2yrs)) not in ('', '.', 'NA') and
62                         %num(SeriousDlqin2yrs) not in (0, 1))
63                 %end;
64                     or missing(%num(age))
65                     or missing(%num(RevolvingUtilizationOfUnsecuredL))
66                     or missing(%num(DebtRatio))
67                     or missing(%num(NumberRealEstateLoansOrLines))
68                     or not (%num(NumberOfTime30-59DaysPastDueNotW) >= 0 and
69                             %num(NumberOfTime30-59DaysPastDueNotW) = int(%num(NumberOfTime30-59DaysPastDueNotW)))
70                     or not (%num(NumberOfTime60-89DaysPastDueNotW) >= 0 and
71                             %num(NumberOfTime60-89DaysPastDueNotW) = int(%num(NumberOfTime60-89DaysPastDueNotW)))
72                     or not (%num(NumberOfTimes90DaysLate) >= 0 and
73                             %num(NumberOfTimes90DaysLate) = int(%num(NumberOfTimes90DaysLate)))
74                     or not (%num(NumberOfOpenCreditLinesAndLoans) >= 0 and
75                             %num(NumberOfOpenCreditLinesAndLoans) = int(%num(NumberOfOpenCreditLinesAndLoans)))
76                     or (upcase(cats(MonthlyIncome)) not in ('', '.', 'NA') and missing(%num(MonthlyIncome)))
77                     or (not missing(%num(MonthlyIncome)) and %num(MonthlyIncome) < 0)
78                     or (upcase(cats(NumberOfDependents)) not in ('', '.', 'NA') and
79                         not (%num(NumberOfDependents) >= 0 and
80                              %num(NumberOfDependents) = int(%num(NumberOfDependents)))));
81                 %if &kind = train %then %do;
82                 known_income = not missing(%num(MonthlyIncome));
83                 keep VAR1 bad_row known_income;
84                 %end;
85                 %else %do;
86                 keep VAR1 bad_row;
87                 %end;
88             run;
89             proc contents data=work.input_check varnum; title "x23 input_check &label"; run;
90             proc print data=work.input_check; title "x23 input_check &label"; run;
91             data _null_;
92                 set work.input_check;
93                 length x23_t $1;
94                 x23_t = vtype(VAR1);
95                 x23_l = vlength(VAR1);
96                 put "X23 ROW &label " _n_= x23_t= x23_l= bad_row= 'VAR1=[' VAR1 +(-1) ']';
97             run;
98             proc sql noprint;
99                 select coalesce(sum(bad_row), 0), count(*) - count(distinct VAR1), count(*), count(distinct VAR1)
100                into :bad_rows trimmed, :duplicate_ids trimmed, :x23_n trimmed, :x23_d trimmed
101                from work.input_check;
102            quit;
103            %put X23 CHECK &label kind=&kind rows=&x23_n distinct=&x23_d bad_rows=&bad_rows duplicate_ids=&duplicate_ids;
104        %mend;
