569        /* joins: missing keys match; row order */
570        data ja; input bin p; datalines;
576        ;
577        data jb; input bin q; datalines;
582        ;
583        proc sql;
584          create table jo as select a.bin, a.p, b.q, (a.p - b.q) * log(a.p / b.q) as comp
585            from (select bin, p from ja) a join (select bin, q from jb) b on a.bin = b.bin;
586          create table js as select sum(comp) as PSI format=8.4,
587             case when calculated PSI < 0.1 then 'No significant change'
588                  when calculated PSI < 0.25 then 'Some change' else 'Significant change' end as interp
589             from jo;
590          create table je as select sum(comp) as PSI format=8.4,
591             case when calculated PSI < 0.1 then 'No significant change'
592                  when calculated PSI < 0.25 then 'Some change' else 'Significant change' end as interp
593             from jo where bin > 100;
594        quit;
595        data _null_; set jo; put "X13 join " bin= p= q= comp= hex16.; run;
