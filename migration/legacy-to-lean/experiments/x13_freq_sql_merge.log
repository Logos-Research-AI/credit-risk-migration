611        /* MERGE: where= selecting no rows; 2-row middle dataset; length after merge */
612        data m1; length ROCModel $14; ROCModel = 'Logistic Model'; AUC = 0.8; Gini = 0.6; run;
613        data m2; KS = 0.5; cut = 0.1; output; KS = 0.5; cut = 0.2; output; run;
614        data m3; PSI = 0.01; length interp $21; interp = 'No significant change'; run;
615        data m4; threshold = 0.4; acc = 1; output; threshold = 0.6; acc = 2; output; run;
616        data mm; merge m1 m2 m3 m4(where=(threshold = 0.5));
617          length model $20 status $20; model = "Logistic Regression";
618          if AUC >= 0.7 and KS >= 0.3 and PSI < 0.25 then status = "Production Ready";
619          else if AUC >= 0.65 then status = "Requires Review"; else status = "Needs Improvement";
620        run;
621        data _null_; set mm; put "X13 merge " ROCModel= AUC= Gini= KS= cut= PSI= interp= threshold= acc= model= status=; run;
