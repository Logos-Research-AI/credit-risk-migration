25         /* x20: the corrected log and interaction statements of feature_engineering.sas / predict.sas
26            (copied verbatim) on incomes at and below -1, between -1 and 0, at 0 and above. */
27         data work.x20;
28             age = 40;
29             do monthly_income = -7.5, -1, -0.5, 0, 5000;
30             if monthly_income > -1 then log_monthly_income = log(monthly_income + 1);
31             else log_monthly_income = 0;
32             if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
33             else age_income_interaction = age * log_monthly_income;
34                 put 'X20 ' monthly_income= log_monthly_income= age_income_interaction=;
35                 output;
36             end;
37         run;
