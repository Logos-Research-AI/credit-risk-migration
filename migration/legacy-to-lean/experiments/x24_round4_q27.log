2144        * 4. Split into Training and Validation Sets (70/30)
2145        *****************************************************************************/
2146       
2147       /* Set random seed for reproducibility */
2148       proc surveyselect data=work.credit_features
2149                         out=work.credit_split
2150                         samprate=0.7
2151                         seed=42
2152                         outall;
2153       run;
2154       
2155       data work.credit_train work.credit_validation;
2156           set work.credit_split;
2157           if selected = 1 then output work.credit_train;
2158           else output work.credit_validation;
2159           drop selected;
2160       run;
