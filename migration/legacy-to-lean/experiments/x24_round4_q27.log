1955       /*****************************************************************************
1956        * 2. Data Cleaning and Missing Value Handling
1957        *****************************************************************************/
1958       
1959       /* First convert MonthlyIncome to numeric if needed */
1960       data work.credit_raw_clean;
1961           set work.credit_raw;
1962       
1963           /* Convert to numeric - input function handles character to numeric */
1964           MonthlyIncome_num = input(MonthlyIncome, best32.);
1965           NumberOfDependents_num = input(NumberOfDependents, best32.);
1966       
1967           /* Keep the numeric versions, drop character if they exist */
1968           drop MonthlyIncome NumberOfDependents;
1969           rename MonthlyIncome_num = MonthlyIncome
1970                  NumberOfDependents_num = NumberOfDependents;
1971       run;
1972       
1973       /* Calculate income medians by age group for imputation */
1974       proc sql;
1975           create table work.income_medians as
1976           select
1977               case
1978                   when age < 30 then 1
1979                   when age < 40 then 2
1980                   when age < 50 then 3
1981                   when age < 60 then 4
1982                   else 5
1983               end as age_group,
1984               median(MonthlyIncome) as median_income
1985           from work.credit_raw_clean
1986           where MonthlyIncome is not missing
1987           group by calculated age_group;
1988       quit;
1989       
1990       /* One row per age group, with the median of all known incomes:
1991          the fallback for an age group that has no known income */
1992       data work.age_groups;
1993           do age_group = 1 to 5;
1994               output;
1995           end;
1996       run;
1997       
1998       proc sql;
1999           create table work.income_medians_all as
2000           select
2001               g.age_group,
2002               m.median_income,
2003               (select median(MonthlyIncome) from work.credit_raw_clean
2004                where MonthlyIncome is not missing) as overall_median_income
2005           from work.age_groups g
2006           left join work.income_medians m
2007           on g.age_group = m.age_group
2008           order by g.age_group;
2009       quit;
2010       
2011       data work.credit_cleaned;
2012           set work.credit_raw_clean;
2013       
2014           /* Create age group for income imputation */
2015           if age < 30 then age_group = 1;
2016           else if age < 40 then age_group = 2;
2017           else if age < 50 then age_group = 3;
2018           else if age < 60 then age_group = 4;
2019           else age_group = 5;
2020       
2021           /* Handle missing values - create flags */
2022           if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
2023           else MonthlyIncome_missing = 0;
2024       
2025           if missing(NumberOfDependents) then do;
2026               NumberOfDependents = 0;
2027               Dependents_missing = 1;
2028           end;
2029           else Dependents_missing = 0;
2030       run;
2031       
2032       /* Merge and impute income - rename columns in SQL */
2033       proc sql;
2034           create table work.credit_imputed as
2035           select
2036               a.VAR1 as row_id,
2037               a.SeriousDlqin2yrs as default_flag,
2038               a.age,
2039               case when a.MonthlyIncome_missing = 1 then coalesce(b.median_income, b.overall_median_income)
2040                    else a.MonthlyIncome
2041               end as monthly_income,
2042               a.MonthlyIncome_missing,
2043               a.NumberOfDependents as num_dependents,
2044               a.Dependents_missing,
2045               a.age_group,
2046               a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
2047               a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
2048               a.NumberOfTimes90DaysLate as num_late_90_plus,
2049               a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
2050               a.DebtRatio * 100 as debt_ratio,
2051               a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
2052               a.NumberRealEstateLoansOrLines as num_real_estate_loans
2053           from work.credit_cleaned a
2054           left join work.income_medians_all b
2055           on a.age_group = b.age_group;
2056       quit;
2057       
2058       /*****************************************************************************
2059        * 3. Feature Engineering
2060        *****************************************************************************/
2061       
2062       data work.credit_features;
2063           set work.credit_imputed;
2064       
2065           /* Total late payments across all categories */
2066           total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
2067       
2068           /* Has any delinquency indicator */
2069           has_delinquency = (total_late_payments > 0);
2070       
2071           /* Has serious delinquency (90+ days) */
2072           has_serious_delinquency = (num_late_90_plus > 0);
2073       
2074           /* Credit utilization categories */
2075           if credit_utilization < 30 then credit_util_category = 1; /* Low */
2076           else if credit_utilization < 50 then credit_util_category = 2; /* Medium */
2077           else if credit_utilization < 75 then credit_util_category = 3; /* High */
2078           else credit_util_category = 4; /* Very High */
2079       
2080           /* Debt ratio categories */
2081           if debt_ratio < 30 then debt_category = 1; /* Low */
2082           else if debt_ratio < 43 then debt_category = 2; /* Medium */
2083           else if debt_ratio < 60 then debt_category = 3; /* High */
2084           else debt_category = 4; /* Very High */
2085       
2086           /* Income per dependent (handle division by zero) */
2087           if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
2088           else income_per_dependent = monthly_income;
2089       
2090           /* Credit lines per person in household */
2091           credit_lines_per_person = num_credit_lines / (num_dependents + 1);
2092       
2093           /* Age categories for risk assessment */
2094           if age < 25 then age_category = 1; /* Young */
2095           else if age < 35 then age_category = 2; /* Young Adult */
2096           else if age < 50 then age_category = 3; /* Middle Age */
2097           else if age < 65 then age_category = 4; /* Mature */
2098           else age_category = 5; /* Senior */
2099       
2100           /* Risk flags */
2101           flag_high_utilization = (credit_utilization > 75);
2102           flag_very_high_utilization = (credit_utilization > 100);
2103           flag_high_debt_ratio = (debt_ratio > 43);
2104           flag_very_high_debt_ratio = (debt_ratio > 60);
2105           flag_recent_late_payments = (num_late_30_59 > 0);
2106           flag_serious_delinquency = (num_late_90_plus > 0);
2107           flag_multiple_delinquencies = (total_late_payments >= 3);
2108           flag_low_income = (monthly_income < 2500);
2109           flag_many_dependents = (num_dependents >= 3);
2110           flag_few_credit_lines = (num_credit_lines <= 2);
2111       
2112           /* Total risk flags */
2113           total_risk_flags = sum(flag_high_utilization, flag_very_high_utilization,
2114                                 flag_high_debt_ratio,
2115                                 flag_serious_delinquency, flag_multiple_delinquencies,
2116                                 flag_low_income, flag_many_dependents,
2117                                 flag_few_credit_lines);
2118       
2119           /* Financial health score (0-100) */
2120           financial_health = 100;
2121           if credit_utilization > 30 then financial_health = financial_health - 15;
2122           if credit_utilization > 75 then financial_health = financial_health - 15;
2123           if debt_ratio > 43 then financial_health = financial_health - 20;
2124           if has_delinquency then financial_health = financial_health - 20;
2125           if num_late_90_plus > 0 then financial_health = financial_health - 30;
2126           financial_health = max(0, financial_health);
2127       
2128           /* Log transformations for skewed variables (add 1 to handle zeros) */
2129           log_monthly_income = log(monthly_income + 1);
2130           log_num_credit_lines = log(num_credit_lines + 1);
2131           log_total_late_payments = log(total_late_payments + 1);
2132       
2133           /* Interaction features */
2134           if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
2135           else age_income_interaction = age * log_monthly_income;
2136           utilization_debt_interaction = credit_utilization * debt_ratio;
2137       
2138           /* Cap extreme outliers in credit_utilization and debt_ratio */
2139           credit_utilization_capped = min(credit_utilization, 200);
2140           debt_ratio_capped = min(debt_ratio, 500);
2141       run;
2142       
