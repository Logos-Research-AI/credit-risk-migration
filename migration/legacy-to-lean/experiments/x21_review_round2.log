387        /* ---------- (F) metrics_calculation.sas 278-359 with an empty training score table ---------- */
388        data work.logit_scored_train;
389            length default_flag pd_logistic credit_risk_score 8;
390            stop;
391        run;
392        data work.logit_scored_valid;
393            do credit_risk_score = 600, 700, 800;
394                default_flag = 0; pd_logistic = 0.1;
395                output;
396            end;
397        run;
398        proc sort data=work.logit_scored_train(keep=credit_risk_score)
399                  out=work.train_scores_sorted;
400            by credit_risk_score;
401        run;
402        
403        data work.psi_cuts;
404            set work.train_scores_sorted nobs=n_train end=eof;
405            array cut{9};
406            retain cut1-cut9;
407            do k = 1 to 9;
408                if _n_ = ceil(k * n_train / 10) then cut{k} = credit_risk_score;
409            end;
410            if eof then output;
411            keep cut1-cut9;
412        run;
413        
414        data work.train_bins;
415            if _n_ = 1 then set work.psi_cuts;
416            set work.logit_scored_train;
417            array cut{9};
418            score_bin = 0;
419            do k = 1 to 9;
420                if credit_risk_score > cut{k} then score_bin = score_bin + 1;
421            end;
422            drop k cut1-cut9;
423        run;
424        
425        data work.valid_bins;
426            if _n_ = 1 then set work.psi_cuts;
427            set work.logit_scored_valid;
428            array cut{9};
429            score_bin = 0;
430            do k = 1 to 9;
431                if credit_risk_score > cut{k} then score_bin = score_bin + 1;
432            end;
433            drop k cut1-cut9;
434        run;
435        
436        data work.psi_bins;
437            do score_bin = 0 to 9;
438                output;
439            end;
440        run;
441        
442        %let psi_floor = unset;
443        proc sql noprint;
444            select 0.5 / max(t.n, v.n) into :psi_floor trimmed
445            from (select count(*) as n from work.train_bins) t,
446                 (select count(*) as n from work.valid_bins) v;
447        quit;
448        %put X21 F psi_floor=[&psi_floor];
X21 F psi_floor=[.]
449        
450        proc sql;
451            create table work.psi_calculation as
452            select
453                s.score_bin,
454                coalesce(a.train_pct, 0) as train_pct,
455                coalesce(b.valid_pct, 0) as valid_pct,
456                (max(calculated train_pct, &psi_floor) - max(calculated valid_pct, &psi_floor))
457                    * log(max(calculated train_pct, &psi_floor) / max(calculated valid_pct, &psi_floor)) as psi_component
458            from work.psi_bins s
459            left join
460                (select score_bin, count(*) / (select count(*) from work.train_bins) as train_pct
461                 from work.train_bins group by score_bin) a
462            on s.score_bin = a.score_bin
463            left join
464                (select score_bin, count(*) / (select count(*) from work.valid_bins) as valid_pct
465                 from work.valid_bins group by score_bin) b
466            on s.score_bin = b.score_bin
467            order by s.score_bin;
468        
469            create table work.psi_summary as
470            select sum(psi_component) as PSI format=best12.,
471                   case
472                      when calculated PSI < 0.1 then 'No significant change'
473                      when calculated PSI < 0.25 then 'Some change'
474                      else 'Significant change'
475                   end as PSI_interpretation
476            from work.psi_calculation;
477        quit;
478        data _null_;
479            do ds = 'PSI_CUTS', 'TRAIN_BINS', 'VALID_BINS', 'PSI_CALCULATION', 'PSI_SUMMARY';
480                dsid = open(cats('work.', ds));
481                n = attrn(dsid, 'nlobs');
482                nv = attrn(dsid, 'nvars');
483                rc = close(dsid);
484                put 'X21 F ' ds= n= nv=;
485            end;
486        run;
