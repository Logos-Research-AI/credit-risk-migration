106        /* ---------- the check of feature_engineering.sas 52-123 and predict.sas 60-130, on a named table,
107           reporting instead of stopping ---------- */
108        %macro num(v);
109            %local dsid pos vtype;
110            %let vtype = ;
111            %let dsid = %sysfunc(open(work.&x21_tab));
112            %let pos = %sysfunc(varnum(&dsid, &v));
113            %if &pos > 0 %then %let vtype = %sysfunc(vartype(&dsid, &pos));
114            %let dsid = %sysfunc(close(&dsid));
115            %if &vtype = N %then "&v"n;
116            %else ifn(lengthn(strip("&v"n)) <= 32, input(strip("&v"n), ?? best32.), .);
117        %mend;
118        
119        %macro check(tab, kind, label);
120            %global x21_tab;
121            %let x21_tab = &tab;
122            %let columns_ok = 0;
123            %let bad_rows = 1;
124            %let duplicate_ids = 1;
125            %let known_incomes = 0;
126            proc sql noprint;
127                select (count(*) = 12 and sum(upcase(name) in
128                           ('VAR1', 'SERIOUSDLQIN2YRS', 'AGE', 'MONTHLYINCOME', 'NUMBEROFDEPENDENTS',
129                            'REVOLVINGUTILIZATIONOFUNSECUREDL', 'DEBTRATIO',
130                            'NUMBEROFTIME30-59DAYSPASTDUENOTW', 'NUMBEROFTIME60-89DAYSPASTDUENOTW',
131                            'NUMBEROFTIMES90DAYSLATE', 'NUMBEROFOPENCREDITLINESANDLOANS',
132                            'NUMBERREALESTATELOANSORLINES')) = 12)
133                into :columns_ok trimmed
134                from dictionary.columns
135                where libname = 'WORK' and memname = "%upcase(&tab)";
136            quit;
137            data work.input_check;
138                set work.&tab;
139                %if &kind = train %then %do;
140                bad_row = (missing(VAR1)
141                    or %num(SeriousDlqin2yrs) not in (0, 1)
142                %end;
143                %else %do;
144                bad_row = (missing(VAR1)
145                    or (upcase(cats(SeriousDlqin2yrs)) not in ('', '.', 'NA') and
146                        %num(SeriousDlqin2yrs) not in (0, 1))
147                %end;
148                    or missing(%num(age))
149                    or missing(%num(RevolvingUtilizationOfUnsecuredL))
150                    or missing(%num(DebtRatio))
151                    or missing(%num(NumberRealEstateLoansOrLines))
152                    or not (%num(NumberOfTime30-59DaysPastDueNotW) >= 0 and
153                            %num(NumberOfTime30-59DaysPastDueNotW) = int(%num(NumberOfTime30-59DaysPastDueNotW)))
154                    or not (%num(NumberOfTime60-89DaysPastDueNotW) >= 0 and
155                            %num(NumberOfTime60-89DaysPastDueNotW) = int(%num(NumberOfTime60-89DaysPastDueNotW)))
156                    or not (%num(NumberOfTimes90DaysLate) >= 0 and
157                            %num(NumberOfTimes90DaysLate) = int(%num(NumberOfTimes90DaysLate)))
158                    or not (%num(NumberOfOpenCreditLinesAndLoans) >= 0 and
159                            %num(NumberOfOpenCreditLinesAndLoans) = int(%num(NumberOfOpenCreditLinesAndLoans)))
160                    or (upcase(cats(MonthlyIncome)) not in ('', '.', 'NA') and missing(%num(MonthlyIncome)))
161                    or (not missing(%num(MonthlyIncome)) and %num(MonthlyIncome) < 0)
162                    or (upcase(cats(NumberOfDependents)) not in ('', '.', 'NA') and
163                        not (%num(NumberOfDependents) >= 0 and
164                             %num(NumberOfDependents) = int(%num(NumberOfDependents)))));
165                known_income = not missing(%num(MonthlyIncome));
166                x21_age = %num(age);
167                x21_income = %num(MonthlyIncome);
168                put "X21 ROW &label " VAR1= bad_row= known_income= x21_age= x21_income=;
169                keep VAR1 bad_row known_income;
170            run;
171            proc sql noprint;
172                select coalesce(sum(bad_row), 0), count(*) - count(distinct VAR1), coalesce(sum(known_income), 0),
173                       count(*)
174                into :bad_rows trimmed, :duplicate_ids trimmed, :known_incomes trimmed, :x21_n trimmed
175                from work.input_check;
176            quit;
177            %put X21 CHECK &label kind=&kind rows=&x21_n columns_ok=&columns_ok bad_rows=&bad_rows duplicate_ids=&duplicate_ids
177      ! known_incomes=&known_incomes;
178        %mend;
179        
180        %macro imp(file, tab);
181            proc import datafile="&x21_dir/&file" out=work.&tab dbms=csv replace;
182                getnames=yes;
183                guessingrows=max;
184            run;
185            proc contents data=work.&tab varnum; title "x21 &tab"; run;
186        %mend;
