25         /* x21: rules questioned by the reviewers of round 2.
26            (A) what INPUT(strip(text), ?? best32.) returns for texts that are not [sign]digits[.digits];
27            (B) the input check on a file whose headers have another capitalisation (AGE, monthlyincome);
28            (C) the test-file check on a file holding the header line only;
29            (D) %num on a column the file does not have;
30            (E) a character VAR1 through the check and through `a.VAR1 as row_id`;
31            (F) `if _n_ = 1 then set psi_cuts;` when psi_cuts has no row (training score table empty). */
32         %let x21_dir = %sysfunc(pathname(work));
