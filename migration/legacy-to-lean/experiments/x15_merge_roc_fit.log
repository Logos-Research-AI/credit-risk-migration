36         %macro roc(ds, tag);
37           ods select none;
38           proc logistic data=&ds;
39             model y(event='1') = p / nofit;
40             roc 'M' pred=p;
41             ods output ROCAssociation=ra_&tag;
42           run;
43           ods select all;
44           data _null_; set ra_&tag; put "X15B &tag " ROCModel= Area= hex16. Area= best32. StdErr= hex16. SomersD= hex16. Gamma=
44       ! hex16. TauA= hex16.; run;
45         %mend;
46         data r1; input p y @@; datalines;
48         ;
49         %roc(r1, r1);
X15B r1 ROCModel=M Area=3FE5555555555555 Area=0.66666666666666 StdErr=3FC582A80870BEF9 SomersD=3FD5555555555554
Gamma=3FD8000000000000 TauA=3FC745D1745D1746
50         /* near ties: event 0.3 vs nonevent 0.3+5e-9 (inside 1e-8); event 0.6+2e-8 vs nonevent 0.6 */
51         data r2; p = 0.3; y = 1; output; p = 0.3 + 5e-9; y = 0; output; p = 0.6 + 2e-8; y = 1; output; p = 0.6; y = 0; output;
51       ! run;
52         %roc(r2, r2);
X15B r2 ROCModel=M Area=3FE4000000000000 Area=0.625 StdErr=3FE0F876CCDF6CDA SomersD=3FD0000000000000 Gamma=3FD5555555555555
TauA=3FC5555555555555
53         /* chain: a (event), a+0.6e-8 (nonevent), a+1.2e-8 (event), plus anchors */
54         data r3; p = 0.5; y = 1; output; p = 0.5 + 0.6e-8; y = 0; output; p = 0.5 + 1.2e-8; y = 1; output; p = 0.1; y = 0; output
54       ! ; p = 0.9; y = 1; output; run;
55         %roc(r3, r3);
X15B r3 ROCModel=M Area=3FE8000000000000 Area=0.75 StdErr=3FD0703D6DFA043C SomersD=3FE0000000000000 Gamma=3FE3333333333333
TauA=3FD3333333333333
56         /* reversed near pair: nonevent lower by 5e-9 (would be concordant if exact) */
57         data r4; p = 0.3; y = 0; output; p = 0.3 + 5e-9; y = 1; output; p = 0.8; y = 0; output; p = 0.2; y = 1; output; run;
58         %roc(r4, r4);
X15B r4 ROCModel=M Area=3FC0000000000000 Area=0.125 StdErr=3FD94C583ADA5B53 SomersD=BFE8000000000000 Gamma=BFF0000000000000
TauA=BFE0000000000000
59         /* missing p and missing y rows */
60         data r5; set r1 end=e; output; if e then do; p = .; y = 1; output; p = 0.45; y = .; output; p = .; y = 0; output; end;
60       ! run;
61         %roc(r5, r5);
X15B r5 ROCModel=M Area=3FE5555555555555 Area=0.66666666666666 StdErr=3FC582A80870BEF9 SomersD=3FD5555555555554
Gamma=3FD8000000000000 TauA=3FC745D1745D1746
62         /* 7 events, 13 nonevents, no ties except two */
63         data r6; input p y @@; datalines;
65         ;
66         %roc(r6, r6);
X15B r6 ROCModel=M Area=3FE2D02D02D02D03 Area=0.58791208791208 StdErr=3FC1F1C48FF04A8F SomersD=3FC6816816816818
Gamma=3FC6C16C16C16C17 TauA=3FB58ED2308158ED
