68         /* (C) fit */
69         data fit; call streaminit(20261110);
70           do i = 1 to 3000;
71             x1 = round(rand('normal'), 0.1); x2 = rand('uniform');
72             eta = -2 + x1 + 0.5 * x2; y = rand('bernoulli', 1 / (1 + exp(-eta)));
73             if i = 2998 then y = .; if i = 2999 then x2 = .; if i = 3000 then x1 = .;
74             output;
75           end;
76           drop eta;
77         run;
78         ods select none;
79         proc logistic data=fit descending;
80           model y = x1 x2 / lackfit;
81           output out=fo predicted=p xbeta=xb;
82           store work.fitmodel;
83           ods output Association=fa LackFitPartition=fh LackFitChiSq=fc ParameterEstimates=fp;
84         run;
85         proc plm restore=work.fitmodel; score data=fit out=fs predicted=pl; run;
86         ods select all;
87         data _null_; set fp; put "X15C coef " Variable= Estimate= hex16.; run;
