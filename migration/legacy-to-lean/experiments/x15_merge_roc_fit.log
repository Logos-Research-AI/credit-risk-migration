93         /* (D) discrete covariate: few distinct probabilities, big tie blocks */
94         data fit2; call streaminit(7);
95           do i = 1 to 1000; x1 = rand('integer', 0, 15); y = rand('bernoulli', 1 / (1 + exp(-(-2.5 + 0.3 * x1)))); output; end;
96         run;
97         ods select none;
98         proc logistic data=fit2 descending;
99           model y = x1 / lackfit;
100          output out=fo2 predicted=p;
101          ods output Association=fa2 LackFitPartition=fh2 LackFitChiSq=fc2;
102        run;
