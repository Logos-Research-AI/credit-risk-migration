25         /* X15: (A) one-to-one MERGE when a later data set with a same-named variable runs out;
26            (B) PROC LOGISTIC ROC statement with PRED= on small inputs: ties, near-ties (ROCEPS),
27                missing values, full-precision Area; (C) a small fit with OUTPUT, LACKFIT, Association,
28                and PROC PLM SCORE, printed in hex so that scoring and grouping rules can be checked. */
29         data a; x = 1; y = 10; output; x = 2; y = 20; output; x = 3; y = 30; output; run;
30         data b; x = 5; z = 7; output; run;
31         data mab; merge a b; run;
32         data _null_; set mab; put "X15A merge_ab " x= y= z=; run;
X15A merge_ab x=5 y=10 z=7
X15A merge_ab x=2 y=20 z=.
X15A merge_ab x=3 y=30 z=.
33         data mba; merge b a; run;
34         data _null_; set mba; put "X15A merge_ba " x= y= z=; run;
X15A merge_ba x=1 y=10 z=7
X15A merge_ba x=2 y=20 z=.
X15A merge_ba x=3 y=30 z=.
