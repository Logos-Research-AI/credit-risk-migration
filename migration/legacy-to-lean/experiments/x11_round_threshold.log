25         /* X11: where does one-argument ROUND switch from rounding down to rounding up below a
26            half-integer m? Bisect on doubles; print the smallest x < m that still rounds up. */
27         data _null_;
28           array ms{9} _temporary_ (0.5 2.5 100.5 600.5 712.5 849.5 1000000.5 1e9 4.5e12);
29           do i = 1 to 9;
30             m = ms{i}; if i = 8 then m = 1e9 + 0.5; if i = 9 then m = 4.5e12 + 0.5;
31             up = round(m);
32             lo = m - m * 1e-6; hi = m;
33             do j = 1 to 200;
34               mid = (lo + hi) / 2;
35               if mid = lo or mid = hi then leave;
36               if round(mid) = up then hi = mid; else lo = mid;
37             end;
38             gap = m - hi; rel = gap / m;
39             put "X11 m=" m best32. " up=" up best32. " thr=" hi hex16. " m_hex=" m hex16. " gap=" gap e12. " rel=" rel e12.;
40           end;
41           /* negative side and exact halves */
42           x = -2.5; r = round(x); put "X11 neg " x= r=;
43           x = -712.49999999999989; r = round(x); put "X11 neg " x= best32. r=;
44           x = 0.49999999999999994; r = round(x); put "X11 below_half " x= hex16. r=;
45           x = 0.4999999999999; r = round(x); put "X11 below_half13 " r=;
46           x = 0.499999999999; r = round(x); put "X11 below_half12 " r=;
47           x = 0.49999999999; r = round(x); put "X11 below_half11 " r=;
48           /* the pipeline expression */
49           do pd = 0.002, 0.25, 0.5, 0.998, 1, 0, 1 - 0.5/250, 1 - 1.5/250, 0.75;
50             s = round(600 + 250 * (1 - pd)); put "X11 score pd=" pd best32. " s=" s best32.;
51           end;
52         run;
