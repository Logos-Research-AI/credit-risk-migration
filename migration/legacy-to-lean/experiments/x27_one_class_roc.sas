 *****************************************************************************/

/* Clean up training set - drop extra columns from PROC LOGISTIC */
data work.risk_scores_train_clean;
    set work.risk_scores_train;
    drop IP_: XP_: _FROM_ _INTO_ _LEVEL_;
run;

/* Clean up validation set - drop extra columns */
