/*****************************************************************************
 * Credit Risk Scoring Model - Feature Engineering
 *
 * Purpose: Load Kaggle "Give Me Some Credit" data and create features
 * Author: Risk Analytics Team
 * Date: 2025
 *
 * Data Source: Kaggle "Give Me Some Credit" competition
 * https://www.kaggle.com/c/GiveMeSomeCredit
 *
 * This script:
 * - Loads cs-training.csv from data/ directory
 * - Handles missing values
 * - Creates derived features and risk indicators
 * - Splits into training (70%) and validation (30%) sets
 * - Exports engineered features for modeling
 *****************************************************************************/

/* Define base paths */
%let data_path = /saswork/SAS_work5AD800009110_odaws01-euw1.oda.sas.com/SAS_work6F3700009110_odaws01-euw1.oda.sas.com/x27_data;
%let output_path = /saswork/SAS_work5AD800009110_odaws01-euw1.oda.sas.com/SAS_work6F3700009110_odaws01-euw1.oda.sas.com/x27_out;

/* Remove the results of an earlier run first: a run that stops leaves no result */
data _null_;
    length fref $8 fname $64;
    do fname = 'income_medians.csv', 'model_features_train.csv',
               'model_features_validation.csv';
        fref = ' ';
        if filename(fref, cats("&output_path/", fname)) = 0 then do;
            if fexist(fref) then rc = fdelete(fref);
            rc = filename(fref);
        end;
    end;
run;

/*****************************************************************************
 * 1. Load Kaggle Training Data
 *****************************************************************************/

/* Import Kaggle training data */
proc import datafile="&data_path/cs-training.csv"
    out=work.credit_raw
    dbms=csv
    replace;
    getnames=yes;
    guessingrows=max;
run;

/* Check the input conditions: stop with an error before anything is exported */
/* The numeric value of a raw column: a numeric column as it is; a character column
   read as a number, missing when the text is no number or is longer than 32 characters */
%macro num(v);
    %local dsid pos vtype;
    %let vtype = ;
    %let dsid = %sysfunc(open(work.credit_raw));
    %let pos = %sysfunc(varnum(&dsid, &v));
    %if &pos > 0 %then %let vtype = %sysfunc(vartype(&dsid, &pos));
    %let dsid = %sysfunc(close(&dsid));
    %if &vtype = N %then "&v"n;
    %else ifn(lengthn(strip("&v"n)) <= 32, input(strip("&v"n), ?? best32.), .);
%mend;

%let columns_ok = 0;
%let bad_rows = 1;
%let duplicate_ids = 1;
%let known_incomes = 0;

proc sql noprint;
    /* The expected columns and no others */
    select (count(*) = 12 and sum(upcase(name) in
               ('VAR1', 'SERIOUSDLQIN2YRS', 'AGE', 'MONTHLYINCOME', 'NUMBEROFDEPENDENTS',
                'REVOLVINGUTILIZATIONOFUNSECUREDL', 'DEBTRATIO',
                'NUMBEROFTIME30-59DAYSPASTDUENOTW', 'NUMBEROFTIME60-89DAYSPASTDUENOTW',
                'NUMBEROFTIMES90DAYSLATE', 'NUMBEROFOPENCREDITLINESANDLOANS',
                'NUMBERREALESTATELOANSORLINES')) = 12)
    into :columns_ok trimmed
    from dictionary.columns
    where libname = 'WORK' and memname = 'CREDIT_RAW';
quit;

/* Only MonthlyIncome and NumberOfDependents may be missing (blank or NA);
   the outcome is 0 or 1; the counts are whole numbers, zero or more;
   a known MonthlyIncome is zero or more */
data work.input_check;
    set work.credit_raw;
    bad_row = (missing(%num(VAR1))
        or %num(SeriousDlqin2yrs) not in (0, 1)
        or missing(%num(age))
        or missing(%num(RevolvingUtilizationOfUnsecuredL))
        or missing(%num(DebtRatio))
        or missing(%num(NumberRealEstateLoansOrLines))
        or not (%num(NumberOfTime30-59DaysPastDueNotW) >= 0 and
                %num(NumberOfTime30-59DaysPastDueNotW) = int(%num(NumberOfTime30-59DaysPastDueNotW)))
        or not (%num(NumberOfTime60-89DaysPastDueNotW) >= 0 and
                %num(NumberOfTime60-89DaysPastDueNotW) = int(%num(NumberOfTime60-89DaysPastDueNotW)))
        or not (%num(NumberOfTimes90DaysLate) >= 0 and
                %num(NumberOfTimes90DaysLate) = int(%num(NumberOfTimes90DaysLate)))
        or not (%num(NumberOfOpenCreditLinesAndLoans) >= 0 and
                %num(NumberOfOpenCreditLinesAndLoans) = int(%num(NumberOfOpenCreditLinesAndLoans)))
        or (upcase(cats(MonthlyIncome)) not in ('', '.', 'NA') and missing(%num(MonthlyIncome)))
        or (not missing(%num(MonthlyIncome)) and %num(MonthlyIncome) < 0)
        or (upcase(cats(NumberOfDependents)) not in ('', '.', 'NA') and
            not (%num(NumberOfDependents) >= 0 and
                 %num(NumberOfDependents) = int(%num(NumberOfDependents)))));
    known_income = not missing(%num(MonthlyIncome));
    keep VAR1 bad_row known_income;
run;

/* Bad rows, repeated row ids, known incomes */
proc sql noprint;
    select coalesce(sum(bad_row), 0), count(*) - count(distinct VAR1), coalesce(sum(known_income), 0)
    into :bad_rows trimmed, :duplicate_ids trimmed, :known_incomes trimmed
    from work.input_check;
quit;

data _null_;
    if &columns_ok ne 1 or &bad_rows ne 0 or &duplicate_ids ne 0 or &known_incomes < 1 then do;
        put "ERROR: cs-training.csv does not meet the input conditions: "
            "columns_ok=&columns_ok bad_rows=&bad_rows duplicate_ids=&duplicate_ids known_incomes=&known_incomes..";
        put "ERROR: Feature engineering stopped. Nothing is exported.";
        abort cancel;
    end;
run;

/* Display basic statistics */
proc means data=work.credit_raw n nmiss mean std min max;
    title "Raw Data Summary - Kaggle Give Me Some Credit";
run;

/*****************************************************************************
 * 2. Data Cleaning and Missing Value Handling
 *****************************************************************************/

/* First convert MonthlyIncome to numeric if needed */
data work.credit_raw_clean;
    set work.credit_raw;

    /* Convert to numeric - input function handles character to numeric */
    MonthlyIncome_num = input(MonthlyIncome, best32.);
    NumberOfDependents_num = input(NumberOfDependents, best32.);

    /* Keep the numeric versions, drop character if they exist */
    drop MonthlyIncome NumberOfDependents;
    rename MonthlyIncome_num = MonthlyIncome
           NumberOfDependents_num = NumberOfDependents;
run;

/* Calculate income medians by age group for imputation */
proc sql;
    create table work.income_medians as
    select
        case
            when age < 30 then 1
            when age < 40 then 2
            when age < 50 then 3
            when age < 60 then 4
            else 5
        end as age_group,
        median(MonthlyIncome) as median_income
    from work.credit_raw_clean
    where MonthlyIncome is not missing
    group by calculated age_group;
quit;

/* One row per age group, with the median of all known incomes:
   the fallback for an age group that has no known income */
data work.age_groups;
    do age_group = 1 to 5;
        output;
    end;
run;

proc sql;
    create table work.income_medians_all as
    select
        g.age_group,
        m.median_income,
        (select median(MonthlyIncome) from work.credit_raw_clean
         where MonthlyIncome is not missing) as overall_median_income
    from work.age_groups g
    left join work.income_medians m
    on g.age_group = m.age_group
    order by g.age_group;
quit;

data work.credit_cleaned;
    set work.credit_raw_clean;

    /* Create age group for income imputation */
    if age < 30 then age_group = 1;
    else if age < 40 then age_group = 2;
    else if age < 50 then age_group = 3;
    else if age < 60 then age_group = 4;
    else age_group = 5;

    /* Handle missing values - create flags */
    if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
    else MonthlyIncome_missing = 0;

    if missing(NumberOfDependents) then do;
        NumberOfDependents = 0;
        Dependents_missing = 1;
    end;
    else Dependents_missing = 0;
run;

/* Merge and impute income - rename columns in SQL */
proc sql;
    create table work.credit_imputed as
    select
        a.VAR1 as row_id,
        a.SeriousDlqin2yrs as default_flag,
        a.age,
        case when a.MonthlyIncome_missing = 1 then coalesce(b.median_income, b.overall_median_income)
             else a.MonthlyIncome
        end as monthly_income,
        a.MonthlyIncome_missing,
        a.NumberOfDependents as num_dependents,
        a.Dependents_missing,
        a.age_group,
        a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
        a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
        a.NumberOfTimes90DaysLate as num_late_90_plus,
        a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
        a.DebtRatio * 100 as debt_ratio,
        a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
        a.NumberRealEstateLoansOrLines as num_real_estate_loans
    from work.credit_cleaned a
    left join work.income_medians_all b
    on a.age_group = b.age_group;
quit;

/*****************************************************************************
 * 3. Feature Engineering
 *****************************************************************************/

data work.credit_features;
    set work.credit_imputed;

    /* Total late payments across all categories */
    total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);

    /* Has any delinquency indicator */
    has_delinquency = (total_late_payments > 0);

    /* Has serious delinquency (90+ days) */
    has_serious_delinquency = (num_late_90_plus > 0);

    /* Credit utilization categories */
    if credit_utilization < 30 then credit_util_category = 1; /* Low */
    else if credit_utilization < 50 then credit_util_category = 2; /* Medium */
    else if credit_utilization < 75 then credit_util_category = 3; /* High */
    else credit_util_category = 4; /* Very High */

    /* Debt ratio categories */
    if debt_ratio < 30 then debt_category = 1; /* Low */
    else if debt_ratio < 43 then debt_category = 2; /* Medium */
    else if debt_ratio < 60 then debt_category = 3; /* High */
    else debt_category = 4; /* Very High */

    /* Income per dependent (handle division by zero) */
    if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
    else income_per_dependent = monthly_income;

    /* Credit lines per person in household */
    credit_lines_per_person = num_credit_lines / (num_dependents + 1);

    /* Age categories for risk assessment */
    if age < 25 then age_category = 1; /* Young */
    else if age < 35 then age_category = 2; /* Young Adult */
    else if age < 50 then age_category = 3; /* Middle Age */
    else if age < 65 then age_category = 4; /* Mature */
    else age_category = 5; /* Senior */

    /* Risk flags */
    flag_high_utilization = (credit_utilization > 75);
    flag_very_high_utilization = (credit_utilization > 100);
    flag_high_debt_ratio = (debt_ratio > 43);
    flag_very_high_debt_ratio = (debt_ratio > 60);
    flag_recent_late_payments = (num_late_30_59 > 0);
    flag_serious_delinquency = (num_late_90_plus > 0);
    flag_multiple_delinquencies = (total_late_payments >= 3);
    flag_low_income = (monthly_income < 2500);
    flag_many_dependents = (num_dependents >= 3);
    flag_few_credit_lines = (num_credit_lines <= 2);

    /* Total risk flags */
    total_risk_flags = sum(flag_high_utilization, flag_very_high_utilization,
                          flag_high_debt_ratio,
                          flag_serious_delinquency, flag_multiple_delinquencies,
                          flag_low_income, flag_many_dependents,
                          flag_few_credit_lines);

    /* Financial health score (0-100) */
    financial_health = 100;
    if credit_utilization > 30 then financial_health = financial_health - 15;
    if credit_utilization > 75 then financial_health = financial_health - 15;
    if debt_ratio > 43 then financial_health = financial_health - 20;
    if has_delinquency then financial_health = financial_health - 20;
    if num_late_90_plus > 0 then financial_health = financial_health - 30;
    financial_health = max(0, financial_health);

    /* Log transformations for skewed variables (add 1 to handle zeros) */
    log_monthly_income = log(monthly_income + 1);
    log_num_credit_lines = log(num_credit_lines + 1);
    log_total_late_payments = log(total_late_payments + 1);

    /* Interaction features */
    if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
    else age_income_interaction = age * log_monthly_income;
    utilization_debt_interaction = credit_utilization * debt_ratio;

    /* Cap extreme outliers in credit_utilization and debt_ratio */
    credit_utilization_capped = min(credit_utilization, 200);
    debt_ratio_capped = min(debt_ratio, 500);
run;

/*****************************************************************************
 * 4. Split into Training and Validation Sets (70/30)
 *****************************************************************************/

/* Set random seed for reproducibility */
proc surveyselect data=work.credit_features
                  out=work.credit_split
                  samprate=0.7
                  seed=42
                  outall;
run;

data work.credit_train work.credit_validation;
    set work.credit_split;
    if selected = 1 then output work.credit_train;
    else output work.credit_validation;
    drop selected;
run;

/*****************************************************************************
 * 5. Summary Statistics
 *****************************************************************************/

proc means data=work.credit_train n mean std min max;
    var age monthly_income credit_utilization debt_ratio total_late_payments
        num_credit_lines num_real_estate_loans default_flag;
    title "Training Set Summary Statistics";
run;

proc freq data=work.credit_train;
    tables default_flag;
    title "Training Set - Default Rate";
run;

proc means data=work.credit_validation n mean std min max;
    var age monthly_income credit_utilization debt_ratio total_late_payments
        num_credit_lines num_real_estate_loans default_flag;
    title "Validation Set Summary Statistics";
run;

proc freq data=work.credit_validation;
    tables default_flag;
    title "Validation Set - Default Rate";
run;

/*****************************************************************************
 * 6. Export Engineered Features
 *****************************************************************************/

/* Ensure all variables are numeric before export */
data work.credit_train_export;
    set work.credit_train;
    /* Force numeric format for all variables */
    format _numeric_ best12.;
run;

data work.credit_validation_export;
    set work.credit_validation;
    /* Force numeric format for all variables */
    format _numeric_ best12.;
run;

/* Export the training income medians (per age group, and overall):
   predict.sas imputes the test set from them */
data work.income_medians_export;
    set work.income_medians_all;
    format median_income overall_median_income best32.;
run;

proc export data=work.income_medians_export
    outfile="&output_path/income_medians.csv"
    dbms=csv
    replace;
run;

/* Export training set */
proc export data=work.credit_train_export
    outfile="&output_path/model_features_train.csv"
    dbms=csv
    replace;
run;

/* Export validation set */
proc export data=work.credit_validation_export
    outfile="&output_path/model_features_validation.csv"
    dbms=csv
    replace;
run;

%put NOTE: Feature engineering completed successfully;
%put NOTE: Training set: exported to &output_path/model_features_train.csv;
%put NOTE: Validation set: exported to &output_path/model_features_validation.csv;
%put NOTE: Missing value imputation completed;
%put NOTE: Ready for model training;
/* ================= X27 SUBMISSION B60_train.sas (paths redirected) ================= */
/*****************************************************************************
 * Credit Risk Scoring Model - Model Training
 *
 * Purpose: Train logistic regression model for credit default prediction
 * Author: Risk Analytics Team
 * Date: 2025
 *
 * Data Source: Kaggle "Give Me Some Credit" competition
 *
 * This script:
 * - Trains logistic regression model with stepwise selection
 * - Generates predictions and probability scores
 * - Creates risk grades and recommendations
 * - Evaluates model performance
 * - Exports model results and coefficients
 *****************************************************************************/

/* Define output path */
%let output_path = /saswork/SAS_work5AD800009110_odaws01-euw1.oda.sas.com/SAS_work6F3700009110_odaws01-euw1.oda.sas.com/x27_out;

/* Remove the results of an earlier run first: a run that stops leaves no result */
data _null_;
    length fref $8 fname $64;
    do fname = 'risk_scores_train.csv', 'risk_scores_validation.csv',
               'final_model_output.csv', 'model_summary.csv', 'model_coefficients.csv';
        fref = ' ';
        if filename(fref, cats("&output_path/", fname)) = 0 then do;
            if fexist(fref) then rc = fdelete(fref);
            rc = filename(fref);
        end;
    end;
run;

/* Stop when the step before did not produce its result */
data _null_;
    if not fileexist("&output_path/model_features_train.csv")
       or not fileexist("&output_path/model_features_validation.csv") then do;
        put "ERROR: The feature files are not in the output folder: feature engineering did not complete.";
        put "ERROR: Model training stopped. Nothing is exported.";
        abort cancel;
    end;
run;

/*****************************************************************************
 * 1. Load Feature-Engineered Data
 *****************************************************************************/

/* Import training features */
proc import datafile="&output_path/model_features_train.csv"
    out=work.model_features_train
    dbms=csv
    replace;
    getnames=yes;
    guessingrows=max;
run;

/* Import validation features */
proc import datafile="&output_path/model_features_validation.csv"
    out=work.model_features_validation
    dbms=csv
    replace;
    getnames=yes;
    guessingrows=max;
run;

/*****************************************************************************
 * 2. Train Logistic Regression Model
 *****************************************************************************/

/* Train logistic regression with stepwise selection */
proc logistic data=work.model_features_train descending;
    model default_flag =
        /* Core risk metrics */
        credit_utilization_capped debt_ratio_capped

        /* Late payment indicators */
        num_late_30_59 num_late_60_89 num_late_90_plus
        total_late_payments has_delinquency has_serious_delinquency

        /* Financial metrics */
        age monthly_income log_monthly_income
        num_credit_lines num_real_estate_loans log_num_credit_lines
        num_dependents income_per_dependent credit_lines_per_person

        /* Risk flags */
        flag_high_utilization flag_very_high_utilization
        flag_high_debt_ratio flag_very_high_debt_ratio
        flag_recent_late_payments flag_serious_delinquency
        flag_multiple_delinquencies flag_low_income
        flag_many_dependents flag_few_credit_lines
        total_risk_flags

        /* Categorical indicators */
        credit_util_category debt_category age_category

        /* Composite scores */
        financial_health

        /* Interaction features */
        age_income_interaction utilization_debt_interaction

        /* Missing value flags */
        MonthlyIncome_missing Dependents_missing

    / selection=stepwise slentry=0.05 slstay=0.05
      ctable lackfit rsquare;

    /* Output predictions */
    output out=work.logit_scored_train
           predicted=pd_logistic;

    /* Store model for scoring */
    store work.logit_model;

    /* Output parameter estimates (coefficients) */
    ods output ParameterEstimates=work.model_coefficients;

    title "Logistic Regression Model - Credit Default Prediction";
run;

/*****************************************************************************
 * 3. Evaluate Model on Training Data
 *****************************************************************************/

/* Add binary prediction variable */
data work.logit_scored_train;
    set work.logit_scored_train;
    pred_logistic = (pd_logistic >= 0.5);
run;

/* Confusion matrix on training set */
proc freq data=work.logit_scored_train noprint;
    tables default_flag * pred_logistic / out=work.confusion_matrix_train;
run;

proc print data=work.confusion_matrix_train;
    title "Confusion Matrix - Training Set";
run;

/* Calculate precision, recall, and F1 score for training set */
data work.training_metrics;
    set work.confusion_matrix_train end=eof;
    retain TP TN FP FN 0;

    if default_flag = 1 and pred_logistic = 1 then TP = count;
    else if default_flag = 0 and pred_logistic = 0 then TN = count;
    else if default_flag = 0 and pred_logistic = 1 then FP = count;
    else if default_flag = 1 and pred_logistic = 0 then FN = count;

    if eof then do;
        if (TP + FP) > 0 then train_precision = TP / (TP + FP);
        else train_precision = .;
        if (TP + FN) > 0 then train_recall = TP / (TP + FN);
        else train_recall = .;
        if (train_precision + train_recall) > 0 then train_f1_score = 2 * (train_precision * train_recall) / (train_precision + train_recall);
        else train_f1_score = .;
        if (TP + TN + FP + FN) > 0 then train_accuracy = (TP + TN) / (TP + TN + FP + FN);
        else train_accuracy = .;
        output;
    end;
    keep train_precision train_recall train_f1_score train_accuracy;
run;

proc print data=work.training_metrics;
    title "Training Set - Performance Metrics";
    format train_precision train_recall train_f1_score train_accuracy 8.4;
run;

/*****************************************************************************
 * 4. Score Validation Set
 *****************************************************************************/

/* Score validation set with trained model */
proc plm restore=work.logit_model;
    score data=work.model_features_validation
          out=work.logit_scored_valid_temp
          predicted=predicted_logit;
run;

/* Convert logit to probability */
data work.logit_scored_valid;
    set work.logit_scored_valid_temp;

    /* Apply inverse logit (logistic) function */
    pd_logistic = 1 / (1 + exp(-predicted_logit));

    /* Add binary prediction */
    pred_logistic = (pd_logistic >= 0.5);

    drop predicted_logit;
run;

/* Confusion matrix on validation set */
proc freq data=work.logit_scored_valid noprint;
    tables default_flag * pred_logistic / out=work.confusion_matrix;
run;

proc print data=work.confusion_matrix;
    title "Confusion Matrix - Validation Set";
run;

/* Calculate precision, recall, and F1 score for validation set */
data work.validation_metrics;
    set work.confusion_matrix end=eof;
    retain TP TN FP FN 0;

    if default_flag = 1 and pred_logistic = 1 then TP = count;
    else if default_flag = 0 and pred_logistic = 0 then TN = count;
    else if default_flag = 0 and pred_logistic = 1 then FP = count;
    else if default_flag = 1 and pred_logistic = 0 then FN = count;

    if eof then do;
        if (TP + FP) > 0 then valid_precision = TP / (TP + FP);
        else valid_precision = .;
        if (TP + FN) > 0 then valid_recall = TP / (TP + FN);
        else valid_recall = .;
        if (valid_precision + valid_recall) > 0 then valid_f1_score = 2 * (valid_precision * valid_recall) / (valid_precision + valid_recall);
        else valid_f1_score = .;
        if (TP + TN + FP + FN) > 0 then valid_accuracy = (TP + TN) / (TP + TN + FP + FN);
        else valid_accuracy = .;
        output;
    end;
    keep valid_precision valid_recall valid_f1_score valid_accuracy;
run;

proc print data=work.validation_metrics;
    title "Validation Set - Performance Metrics";
    format valid_precision valid_recall valid_f1_score valid_accuracy 8.4;
run;

/*****************************************************************************
 * 5. Create Risk Scores and Grades
 *****************************************************************************/

/* Generate risk scores for training set */
data work.risk_scores_train;
    set work.logit_scored_train;

    /* Convert probability to credit risk score (300-850 scale like FICO) */
    base_score = 600;
    score_range = 250;
    credit_risk_score = base_score + score_range * (1 - pd_logistic);

    /* Assign risk grades from the probability (a missing probability is graded F) */
    if missing(pd_logistic) then risk_grade = 'F';
    else if pd_logistic < 0.10 then risk_grade = 'A';
    else if pd_logistic < 0.15 then risk_grade = 'B';
    else if pd_logistic < 0.25 then risk_grade = 'C';
    else if pd_logistic < 0.35 then risk_grade = 'D';
    else if pd_logistic <= 0.50 then risk_grade = 'E';
    else risk_grade = 'F';

    /* Recommended actions */
    if risk_grade in ('A', 'B') then recommendation = 'Approve';
    else if risk_grade = 'C' then recommendation = 'Review';
    else recommendation = 'Decline';

    /* Suggested interest rate (risk-based pricing) */
    base_rate = 0.05;
    if risk_grade = 'A' then interest_rate = base_rate;
    else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
    else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
    else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
    else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
    else interest_rate = base_rate + 0.15;

    format interest_rate percent8.2;
run;

/* Generate risk scores for validation set */
data work.risk_scores_validation;
    set work.logit_scored_valid;

    /* Same scoring logic as training */
    base_score = 600;
    score_range = 250;
    credit_risk_score = base_score + score_range * (1 - pd_logistic);

    if missing(pd_logistic) then risk_grade = 'F';
    else if pd_logistic < 0.10 then risk_grade = 'A';
    else if pd_logistic < 0.15 then risk_grade = 'B';
    else if pd_logistic < 0.25 then risk_grade = 'C';
    else if pd_logistic < 0.35 then risk_grade = 'D';
    else if pd_logistic <= 0.50 then risk_grade = 'E';
    else risk_grade = 'F';

    if risk_grade in ('A', 'B') then recommendation = 'Approve';
    else if risk_grade = 'C' then recommendation = 'Review';
    else recommendation = 'Decline';

    base_rate = 0.05;
    if risk_grade = 'A' then interest_rate = base_rate;
    else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
    else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
    else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
    else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
    else interest_rate = base_rate + 0.15;

    format interest_rate percent8.2;
run;

/* Risk grade distribution */
proc freq data=work.risk_scores_train;
    tables risk_grade * default_flag / nocol nopercent;
    title "Default Rate by Risk Grade - Training Set";
run;

proc freq data=work.risk_scores_validation;
    tables risk_grade * default_flag / nocol nopercent;
    title "Default Rate by Risk Grade - Validation Set";
run;

/*****************************************************************************
 * 6. ROC Curve and AUC
 *****************************************************************************/

/* ROC analysis for training set */
proc logistic data=work.risk_scores_train;
    model default_flag(event='1') = pd_logistic / nofit;
    roc 'Training Set' pred=pd_logistic;
    ods output ROCAssociation=work.roc_train;
    title "ROC Curve - Training Set";
run;

/* ROC analysis for validation set */
proc logistic data=work.risk_scores_validation;
    model default_flag(event='1') = pd_logistic / nofit;
    roc 'Validation Set' pred=pd_logistic;
    ods output ROCAssociation=work.roc_valid;
    title "ROC Curve - Validation Set";
run;

/* Display AUC */
proc print data=work.roc_train;
    where ROCModel = 'Training Set';
    var Area;
    title "Training Set AUC";
run;

proc print data=work.roc_valid;
    where ROCModel = 'Validation Set';
    var Area;
    title "Validation Set AUC";
run;

/*****************************************************************************
 * 7. Export Results
 *****************************************************************************/

/* Clean up training set - drop extra columns from PROC LOGISTIC */
data work.risk_scores_train_clean;
    set work.risk_scores_train;
    drop IP_: XP_: _FROM_ _INTO_ _LEVEL_;
run;

/* Clean up validation set - drop extra columns */
data work.risk_scores_validation_clean;
    set work.risk_scores_validation;
    drop IP_: XP_: _FROM_ _INTO_ _LEVEL_;
run;

/* Export scored training set */
proc export data=work.risk_scores_train_clean
    outfile="&output_path/risk_scores_train.csv"
    dbms=csv
    replace;
run;

/* Export scored validation set */
proc export data=work.risk_scores_validation_clean
    outfile="&output_path/risk_scores_validation.csv"
    dbms=csv
    replace;
run;

/* Create final model output for reporting */
data work.final_model_output;
    set work.risk_scores_train;
    keep row_id default_flag pd_logistic credit_risk_score
         risk_grade recommendation interest_rate
         age monthly_income credit_utilization debt_ratio
         total_late_payments num_credit_lines;
run;

proc export data=work.final_model_output
    outfile="&output_path/final_model_output.csv"
    dbms=csv
    replace;
run;

/* Export model performance summary */
data work.model_summary;
    merge work.roc_train(where=(ROCModel='Training Set') rename=(Area=Train_AUC))
          work.roc_valid(where=(ROCModel='Validation Set') rename=(Area=Valid_AUC))
          work.training_metrics
          work.validation_metrics;

    model_name = "Logistic Regression";
    training_date = today();
    training_records = 105000; /* Approximate 70% of 150K */
    validation_records = 45000; /* Approximate 30% of 150K */

    format training_date date9.
           Train_AUC Valid_AUC
           train_precision train_recall train_f1_score train_accuracy
           valid_precision valid_recall valid_f1_score valid_accuracy 8.4;
    keep model_name training_date training_records validation_records
         Train_AUC Valid_AUC
         train_precision train_recall train_f1_score train_accuracy
         valid_precision valid_recall valid_f1_score valid_accuracy;
run;

proc export data=work.model_summary
    outfile="&output_path/model_summary.csv"
    dbms=csv
    replace;
run;

/* Export model coefficients */
proc export data=work.model_coefficients
    outfile="&output_path/model_coefficients.csv"
    dbms=csv
    replace;
run;

