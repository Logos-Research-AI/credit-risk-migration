3528       
3529       /* Remove the results of an earlier run first: a run that stops leaves no result */
3530       data _null_;
3531           length fref $8 fname $64;
3532           do fname = 'kaggle_submission.csv', 'test_predictions.csv';
3533               fref = ' ';
3534               if filename(fref, cats("&output_path/", fname)) = 0 then do;
