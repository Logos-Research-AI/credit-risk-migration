3823       /* Merge and impute income - rename columns in SQL */
3824       proc sql;
3825           create table work.test_imputed as
3826           select
3827               a.VAR1 as row_id,
3828               a.age,
3829               case when a.MonthlyIncome_missing = 1 then coalesce(b.median_income, b.overall_median_income)
3830                    else a.MonthlyIncome
3831               end as monthly_income,
3832               a.MonthlyIncome_missing,
3833               a.NumberOfDependents as num_dependents,
3834               a.Dependents_missing,
3835               a.age_group,
3836               a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
3837               a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
3838               a.NumberOfTimes90DaysLate as num_late_90_plus,
3839               a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
3840               a.DebtRatio * 100 as debt_ratio,
3841               a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
3842               a.NumberRealEstateLoansOrLines as num_real_estate_loans
3843           from work.test_cleaned a
3844           left join work.train_income_medians b
3845           on a.age_group = b.age_group;
3846       quit;
3847       
3848       /*****************************************************************************
3849        * 3. Feature Engineering (Same as Training)
3850        *****************************************************************************/
3851       
3852       data work.test_features;
3853           set work.test_imputed;
3854       
3855           /* Total late payments across all categories */
3856           total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
3857       
3858           /* Has any delinquency indicator */
3859           has_delinquency = (total_late_payments > 0);
3860       
3861           /* Has serious delinquency (90+ days) */
3862           has_serious_delinquency = (num_late_90_plus > 0);
3863       
3864           /* Credit utilization categories */
3865           if credit_utilization < 30 then credit_util_category = 1;
3866           else if credit_utilization < 50 then credit_util_category = 2;
3867           else if credit_utilization < 75 then credit_util_category = 3;
3868           else credit_util_category = 4;
3869       
3870           /* Debt ratio categories */
3871           if debt_ratio < 30 then debt_category = 1;
3872           else if debt_ratio < 43 then debt_category = 2;
3873           else if debt_ratio < 60 then debt_category = 3;
3874           else debt_category = 4;
3875       
3876           /* Income per dependent */
3877           if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
3878           else income_per_dependent = monthly_income;
3879       
3880           /* Credit lines per person in household */
3881           credit_lines_per_person = num_credit_lines / (num_dependents + 1);
3882       
3883           /* Age categories */
3884           if age < 25 then age_category = 1;
3885           else if age < 35 then age_category = 2;
3886           else if age < 50 then age_category = 3;
3887           else if age < 65 then age_category = 4;
3888           else age_category = 5;
3889       
3890           /* Risk flags */
3891           flag_high_utilization = (credit_utilization > 75);
3892           flag_very_high_utilization = (credit_utilization > 100);
3893           flag_high_debt_ratio = (debt_ratio > 43);
3894           flag_very_high_debt_ratio = (debt_ratio > 60);
3895           flag_recent_late_payments = (num_late_30_59 > 0);
3896           flag_serious_delinquency = (num_late_90_plus > 0);
3897           flag_multiple_delinquencies = (total_late_payments >= 3);
3898           flag_low_income = (monthly_income < 2500);
3899           flag_many_dependents = (num_dependents >= 3);
3900           flag_few_credit_lines = (num_credit_lines <= 2);
3901       
3902           /* Total risk flags */
3903           total_risk_flags = sum(flag_high_utilization, flag_very_high_utilization,
3904                                 flag_high_debt_ratio,
3905                                 flag_serious_delinquency, flag_multiple_delinquencies,
3906                                 flag_low_income, flag_many_dependents,
3907                                 flag_few_credit_lines);
3908       
3909           /* Financial health score */
3910           financial_health = 100;
3911           if credit_utilization > 30 then financial_health = financial_health - 15;
3912           if credit_utilization > 75 then financial_health = financial_health - 15;
3913           if debt_ratio > 43 then financial_health = financial_health - 20;
3914           if has_delinquency then financial_health = financial_health - 20;
3915           if num_late_90_plus > 0 then financial_health = financial_health - 30;
3916           financial_health = max(0, financial_health);
3917       
3918           /* Log transformations */
3919           log_monthly_income = log(monthly_income + 1);
3920           log_num_credit_lines = log(num_credit_lines + 1);
3921           log_total_late_payments = log(total_late_payments + 1);
3922       
3923           /* Interaction features */
3924           if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
3925           else age_income_interaction = age * log_monthly_income;
3926           utilization_debt_interaction = credit_utilization * debt_ratio;
3927       
3928           /* Cap extreme outliers */
3929           credit_utilization_capped = min(credit_utilization, 200);
3930           debt_ratio_capped = min(debt_ratio, 500);
3931       run;
3932       
3933       /*****************************************************************************
3934        * 4. Score Test Set Using Trained Model
3935        *****************************************************************************/
3936       
3937       /* Score test set with trained model */
3938       proc plm restore=work.logit_model;
3939           score data=work.test_features
3940                 out=work.test_scored_temp
3941                 predicted=predicted_logit;
3942       run;
3943       
3944       /* Convert logit to probability */
3945       data work.test_scored;
3946           set work.test_scored_temp;
3947       
3948           /* Apply inverse logit function */
3949           pd_logistic = 1 / (1 + exp(-predicted_logit));
3950       
3951           drop predicted_logit;
3952       run;
3953       
3954       /*****************************************************************************
3955        * 5. Generate Risk Scores and Recommendations
3956        *****************************************************************************/
3957       
3958       data work.test_predictions;
3959           set work.test_scored;
3960       
3961           /* Binary prediction at 0.5 threshold */
3962           pred_logistic = (pd_logistic >= 0.5);
3963       
3964           /* Convert probability to credit risk score (300-850 scale) */
3965           base_score = 600;
3966           score_range = 250;
3967           credit_risk_score = base_score + score_range * (1 - pd_logistic);
3968       
3969           /* Assign risk grades from the probability (a missing probability is graded F) */
3970           if missing(pd_logistic) then risk_grade = 'F';
3971           else if pd_logistic < 0.10 then risk_grade = 'A';
3972           else if pd_logistic < 0.15 then risk_grade = 'B';
3973           else if pd_logistic < 0.25 then risk_grade = 'C';
3974           else if pd_logistic < 0.35 then risk_grade = 'D';
3975           else if pd_logistic <= 0.50 then risk_grade = 'E';
3976           else risk_grade = 'F';
3977       
3978           /* Recommended actions */
3979           if risk_grade in ('A', 'B') then recommendation = 'Approve';
3980           else if risk_grade = 'C' then recommendation = 'Review';
3981           else recommendation = 'Decline';
3982       
3983           /* Suggested interest rate */
3984           base_rate = 0.05;
3985           if risk_grade = 'A' then interest_rate = base_rate;
3986           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
3987           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
3988           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
3989           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
3990           else interest_rate = base_rate + 0.15;
3991       
3992           format interest_rate percent8.2;
3993       run;
3994       
3995       /*****************************************************************************
3996        * 6. Create Output Datasets
3997        *****************************************************************************/
3998       
3999       /* Kaggle submission format (row_id, probability) */
4000       data work.kaggle_submission;
4001           set work.test_predictions;
4002           keep row_id pd_logistic;
4003       run;
4004       
4005       /* Full predictions with all scores and recommendations */
4006       data work.test_predictions_full;
4007           set work.test_predictions;
4008           keep row_id pd_logistic pred_logistic credit_risk_score risk_grade
4009                recommendation interest_rate age monthly_income
4010                credit_utilization debt_ratio total_late_payments
4011                num_credit_lines financial_health total_risk_flags;
4012       run;
