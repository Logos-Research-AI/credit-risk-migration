3802       data work.test_cleaned;
3803           set work.test_raw_clean;
3804       
3805           /* Create age group for income imputation */
3806           if age < 30 then age_group = 1;
3807           else if age < 40 then age_group = 2;
3808           else if age < 50 then age_group = 3;
3809           else if age < 60 then age_group = 4;
3810           else age_group = 5;
3811       
3812           /* Handle missing values - create flags */
3813           if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
3814           else MonthlyIncome_missing = 0;
3815       
3816           if missing(NumberOfDependents) then do;
3817               NumberOfDependents = 0;
3818               Dependents_missing = 1;
3819           end;
3820           else Dependents_missing = 0;
