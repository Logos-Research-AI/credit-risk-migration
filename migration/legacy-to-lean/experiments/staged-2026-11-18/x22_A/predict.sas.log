3554       
3555       /* How many lines the test file has (counted up to two). The first line is copied to the
3556          work folder with one made-up applicant under it: a value for every name, chosen by the
3557          name and not by its place (NA under the three names that may hold NA, a number under
3558          every other), the same line end */
3559       %let test_lines = 0;
3560       %let header_copy = %sysfunc(pathname(work))/cs-test-header.csv;
3561       
3562       data _null_;
3563           infile "&data_path/cs-test.csv" lrecl=32767 truncover obs=2 length=len;
3564           file "&header_copy" lrecl=131068;
3565           input;
3566           if _n_ = 1 then do;
3567               put _infile_;
3568               do i = 1 to countc(_infile_, ',') + 1;
3569                   if i > 1 then put ',' @;
3570                   if upcase(compress(scan(_infile_, i, ',', 'm'), , 'kn')) in
3571                      ('SERIOUSDLQIN2YRS', 'MONTHLYINCOME', 'NUMBEROFDEPENDENTS') then put 'NA' @;
3572                   else put '1' @;
3573               end;
3574               if len > 0 then if char(_infile_, len) = '0D'x then put '0D'x @;
3575               put;
3576           end;
3577           call symputx('test_lines', _n_);
3578       run;
3579       
3580       /* Import test data. PROC IMPORT cannot read a file that has its header line and no
3581          applicant: PROC IMPORT then reads the copy, so the columns are named as it names them,
3582          and the made-up applicant is removed, which leaves an empty table. The tables an earlier
3583          scoring left in the session are removed first: a step that fails finds no table to use */
3584       %macro import_test;
3585           %local source;
3586           %let source = &data_path/cs-test.csv;
3587           %if &test_lines = 1 %then %do;
3588               %let source = &header_copy;
3589               proc datasets library=work nolist nowarn;
3590                   delete test_raw input_check test_raw_clean test_cleaned test_imputed
3591                          test_features test_scored_temp test_scored test_predictions
3592                          kaggle_submission test_predictions_full;
3593               quit;
3594           %end;
3595           proc import datafile="&source"
3596               out=work.test_raw
3597               dbms=csv
3598               replace;
3599               getnames=yes;
3600               guessingrows=max;
3601           run;
3602           %if &test_lines = 1 and %sysfunc(exist(work.test_raw)) %then %do;
3603               data work.test_raw;
3604                   set work.test_raw;
3605                   stop;
3606               run;
3607           %end;
3608       %mend;
3609       %import_test
