684        /*****************************************************************************
685         * 2. Train Logistic Regression Model
686         *****************************************************************************/
687        
688        /* Train logistic regression with stepwise selection */
689        proc logistic data=work.model_features_train descending;
690            model default_flag = age flag_recent_late_payments
691            / ctable lackfit rsquare;
692        
693            /* Output predictions */
694            output out=work.logit_scored_train
695                   predicted=pd_logistic;
696        
697            /* Store model for scoring */
698            store work.logit_model;
699        
700            /* Output parameter estimates (coefficients) */
701            ods output ModelBuildingSummary=work._j_modelbuildingsummary FitStatistics=work._j_fitstatistics
701      ! GlobalTests=work._j_globaltests RSquare=work._j_rsquare Association=work._j_association OddsRatios=work._j_oddsratios
701      ! LackFitPartition=work._j_lackfitpartition LackFitChiSq=work._j_lackfitchisq Classification=work._j_classification
701      ! ParameterEstimates=work.model_coefficients ConvergenceStatus=work._x22_cs;
702        
703            title "Logistic Regression Model - Credit Default Prediction";
704        run;
