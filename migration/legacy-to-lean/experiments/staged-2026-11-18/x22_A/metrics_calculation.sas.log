2512       /*****************************************************************************
2513        * 2. ROC Curve and AUC Analysis
2514        *****************************************************************************/
2515       
2516       /* ROC analysis for validation set */
2517       proc logistic data=work.logit_scored_valid;
2518           model default_flag(event='1') = pd_logistic / nofit;
2519           roc 'Logistic Model' pred=pd_logistic;
2520           roccontrast;
2521           ods output ROCAssociation=work.roc_stats;
2522           title "ROC Curve Analysis - Validation Set";
2523       run;
2524       
2525       /* Calculate and display AUC: the exact pairwise AUC of the validation probabilities.
2526          A defaulter/non-defaulter pair is concordant when the defaulter's probability is
2527          higher, and tied only when the two probabilities are equal */
2528       proc sql;
2529           create table work.auc_pairs as
2530           select pd_logistic,
2531                  sum(default_flag = 1) as n_bad,
2532                  sum(default_flag = 0) as n_good
2533           from work.logit_scored_valid
2534           where not missing(pd_logistic)
2535           group by pd_logistic
2536           order by pd_logistic;
2537       quit;
2538       
2539       data work.auc_summary;
2540           length ROCModel $14;
2541           set work.auc_pairs end=eof;
2542           retain concordant tied cum_good cum_bad 0;
2543       
2544           concordant + n_bad * cum_good;
2545           tied + n_bad * n_good;
2546           cum_good + n_good;
2547           cum_bad + n_bad;
2548       
2549           if eof then do;
2550               ROCModel = 'Logistic Model';
2551               if cum_bad * cum_good > 0 then do;
2552                   AUC = (concordant + tied / 2) / (cum_bad * cum_good);
2553                   Gini = 2 * AUC - 1;
2554               end;
2555               output;
2556           end;
2557           keep ROCModel AUC Gini;
2558           format AUC Gini 8.4;
2559       run;
2560       
2561       proc print data=work.auc_summary noobs;
2562           title "Model Performance Metrics - AUC and Gini";
2563       run;
2564       
2565       /*****************************************************************************
2566        * 3. Kolmogorov-Smirnov (KS) Statistic
2567        *****************************************************************************/
2568       
2569       /* Sort by predicted probability */
2570       proc sort data=work.logit_scored_valid;
2571           by pd_logistic;
2572       run;
2573       
2574       /* Calculate total good and bad counts */
2575       proc sql noprint;
2576           select sum(default_flag = 0), sum(default_flag = 1)
2577           into :total_good_count, :total_bad_count
2578           from work.logit_scored_valid;
2579       quit;
2580       
2581       /* Calculate cumulative distributions */
2582       data work.ks_calculation;
2583           set work.logit_scored_valid;
2584           by pd_logistic;
2585           retain cum_good cum_bad;
2586       
2587           if _n_ = 1 then do;
2588               cum_good = 0;
2589               cum_bad = 0;
2590           end;
2591       
2592           if default_flag = 0 then cum_good + 1;
2593           else cum_bad + 1;
2594       
2595           cum_pct_good = cum_good / &total_good_count;
2596           cum_pct_bad = cum_bad / &total_bad_count;
2597           /* Compare the two distributions only after the last applicant of each probability */
2598           if last.pd_logistic then ks_value = abs(cum_pct_good - cum_pct_bad);
2599       run;
2600       
2601       /* Find maximum KS (one row: the lowest cutoff when several attain the maximum) */
2602       proc sql;
2603           create table work.ks_statistic as
2604           select max(ks_value) as KS_Statistic format=8.4,
2605                  min(pd_logistic) as KS_Cutoff format=8.4
2606           from work.ks_calculation
2607           where ks_value = (select max(ks_value) from work.ks_calculation);
2608       quit;
2609       
2610       proc print data=work.ks_statistic noobs;
2611           title "Kolmogorov-Smirnov Statistic";
2612       run;
2613       
2614       /*****************************************************************************
2615        * 4. Confusion Matrix and Accuracy Metrics
2616        *****************************************************************************/
2617       
2618       /* Calculate metrics at different thresholds */
2619       %macro confusion_metrics(threshold, suffix);
2620           data work.confusion_&suffix;
2621               set work.logit_scored_valid;
2622               predicted = (pd_logistic >= &threshold);
2623           run;
2624       
2625           proc freq data=work.confusion_&suffix noprint;
2626               tables default_flag * predicted / out=work.conf_matrix_&suffix;
2627           run;
2628       
2629           /* Calculate metrics */
2630           data work.metrics_&suffix;
2631               set work.conf_matrix_&suffix end=eof;
2632               retain TP TN FP FN 0;
2633       
2634               if default_flag = 1 and predicted = 1 then TP = count;
2635               else if default_flag = 0 and predicted = 0 then TN = count;
2636               else if default_flag = 0 and predicted = 1 then FP = count;
2637               else if default_flag = 1 and predicted = 0 then FN = count;
2638       
2639               if eof then do;
2640                   threshold = &threshold;
2641                   if (TP + TN + FP + FN) > 0 then accuracy = (TP + TN) / (TP + TN + FP + FN);
2642                   else accuracy = .;
2643                   if (TP + FP) > 0 then precision = TP / (TP + FP);
2644                   else precision = .;
2645                   if (TP + FN) > 0 then recall = TP / (TP + FN);
2646                   else recall = .;
2647                   if (precision + recall) > 0 then f1_score = 2 * (precision * recall) / (precision + recall);
2648                   else f1_score = .;
2649                   if (TN + FP) > 0 then specificity = TN / (TN + FP);
2650                   else specificity = .;
2651                   output;
2652               end;
2653               keep threshold accuracy precision recall f1_score specificity;
2654           run;
2655       %mend;
2656       
2657       /* Test multiple thresholds */
2658       %confusion_metrics(0.3, 03);
2659       %confusion_metrics(0.4, 04);
2660       %confusion_metrics(0.5, 05);
2661       %confusion_metrics(0.6, 06);
2662       %confusion_metrics(0.7, 07);
2663       
2664       /* Combine results */
2665       data work.threshold_analysis;
2666           set work.metrics_03 work.metrics_04 work.metrics_05
2667               work.metrics_06 work.metrics_07;
2668       run;
2669       
2670       proc print data=work.threshold_analysis;
2671           title "Performance Metrics at Different Thresholds";
2672           format accuracy precision recall f1_score specificity 8.4;
2673       run;
2674       
2675       /*****************************************************************************
2676        * 5. Decile Analysis and Lift Chart
2677        *****************************************************************************/
2678       
2679       /* Create deciles based on predicted probability */
2680       proc rank data=work.logit_scored_valid
2681                 out=work.decile_data
2682                 groups=10 descending;
2683           var pd_logistic;
2684           ranks decile;
2685       run;
2686       
2687       /* Always ten rows, deciles 1 to 10 */
2688       data work.decile_list;
2689           do decile = 1 to 10;
2690               output;
2691           end;
2692       run;
2693       
2694       /* Calculate lift by decile; a decile that receives no applicant has
2695          count 0, capture rate 0 and lift 0; with no defaulter in the validation set
2696          capture rate and lift are 0 on every decile */
2697       proc sql;
2698           create table work.decile_analysis as
2699           select
2700               l.decile,
2701               coalesce(d.total_count, 0) as total_count,
2702               coalesce(d.defaults, 0) as defaults,
2703               d.default_rate format=percent8.2,
2704               d.avg_pd format=8.4,
2705               d.min_pd format=8.4,
2706               d.max_pd format=8.4,
2707               coalesce(d.capture_rate, 0) as capture_rate format=percent8.2,
2708               coalesce(d.lift, 0) as lift format=8.2
2709           from work.decile_list l
2710           left join
2711               (select
2712                   decile + 1 as decile,
2713                   count(*) as total_count,
2714                   sum(default_flag) as defaults,
2715                   mean(default_flag) as default_rate,
2716                   mean(pd_logistic) as avg_pd,
2717                   min(pd_logistic) as min_pd,
2718                   max(pd_logistic) as max_pd,
2719                   sum(default_flag) / (select sum(default_flag) from work.decile_data) as capture_rate,
2720                   (calculated default_rate) / (select mean(default_flag) from work.decile_data) as lift
2721                from work.decile_data
2722                group by decile) d
2723           on l.decile = d.decile
2724           order by l.decile;
2725       quit;
2726       
2727       proc print data=work.decile_analysis;
2728           title "Decile Analysis - Model Lift and Capture Rate";
2729       run;
2730       
2731       /* Calculate totals for cumulative lift chart */
2732       proc sql noprint;
2733           select sum(default_flag), mean(default_flag)
2734           into :total_defaults, :overall_default_rate
2735           from work.decile_data;
2736       quit;
2737       
2738       /* Create cumulative lift chart */
2739       data work.cumulative_lift;
2740           set work.decile_analysis;
2741           retain cum_defaults cum_count;
2742           if _n_ = 1 then do;
2743               cum_defaults = defaults;
2744               cum_count = total_count;
2745           end;
2746           else do;
2747               cum_defaults + defaults;
2748               cum_count + total_count;
2749           end;
2750       
2751           /* With no defaulter in the validation set both are 0, as in the decile table */
2752           if &total_defaults > 0 then cum_capture_rate = cum_defaults / &total_defaults;
2753           else cum_capture_rate = 0;
2754           /* No cumulative lift while the deciles so far are empty */
2755           if cum_count > 0 then do;
2756               if &overall_default_rate > 0 then cum_lift = (cum_defaults / cum_count) / &overall_default_rate;
2757               else cum_lift = 0;
2758           end;
2759           format cum_capture_rate percent8.2 cum_lift 8.2;
2760       run;
2761       
2762       proc sgplot data=work.cumulative_lift;
2763           series x=decile y=cum_lift;
2764           refline 1 / axis=y;
2765           xaxis label="Decile";
2766           yaxis label="Cumulative Lift";
2767           title "Cumulative Lift Chart";
2768       run;
2769       
2770       /*****************************************************************************
2771        * 6. Population Stability Index (PSI)
2772        *****************************************************************************/
2773       
2774       /* Compare score distributions between training and validation */
2775       
2776       /* Ten bins cut from the training scores: the nine cuts are the nearest-rank
2777          deciles of the training scores (no interpolation) */
2778       proc sort data=work.logit_scored_train(keep=credit_risk_score)
2779                 out=work.train_scores_sorted;
2780           by credit_risk_score;
2781       run;
2782       
2783       data work.psi_cuts;
2784           set work.train_scores_sorted nobs=n_train end=eof;
2785           array cut{9};
2786           retain cut1-cut9;
2787           do k = 1 to 9;
2788               if _n_ = ceil(k * n_train / 10) then cut{k} = credit_risk_score;
2789           end;
2790           if eof then output;
2791           keep cut1-cut9;
2792       run;
2793       
2794       /* Place both sets in the same bins; a score equal to a cut belongs to the lower bin */
2795       data work.train_bins;
2796           if _n_ = 1 then set work.psi_cuts;
2797           set work.logit_scored_train;
2798           array cut{9};
2799           score_bin = 0;
2800           do k = 1 to 9;
2801               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
2802           end;
2803           drop k cut1-cut9;
2804       run;
2805       
2806       data work.valid_bins;
2807           if _n_ = 1 then set work.psi_cuts;
2808           set work.logit_scored_valid;
2809           array cut{9};
2810           score_bin = 0;
2811           do k = 1 to 9;
2812               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
2813           end;
2814           drop k cut1-cut9;
2815       run;
2816       
2817       data work.psi_bins;
2818           do score_bin = 0 to 9;
2819               output;
2820           end;
2821       run;
2822       
2823       /* An empty bin is given a share below that of one applicant, the same on both
2824          sides, so that a bin filled on one side only adds a positive amount */
2825       /* The size of the larger set is carried as a whole number and the share is computed
2826          where it is used, so it is not cut to the 8 characters of a macro variable */
2827       proc sql noprint;
2828           select max(t.n, v.n) format=32. into :psi_rows trimmed
2829           from (select count(*) as n from work.train_bins) t,
2830                (select count(*) as n from work.valid_bins) v;
2831       quit;
2832       %let psi_floor = (0.5 / &psi_rows);
2833       
2834       /* Calculate PSI */
2835       proc sql;
2836           create table work.psi_calculation as
2837           select
2838               s.score_bin,
2839               coalesce(a.train_pct, 0) as train_pct,
2840               coalesce(b.valid_pct, 0) as valid_pct,
2841               (max(calculated train_pct, &psi_floor) - max(calculated valid_pct, &psi_floor))
2842                   * log(max(calculated train_pct, &psi_floor) / max(calculated valid_pct, &psi_floor)) as psi_component
2843           from work.psi_bins s
2844           left join
2845               (select score_bin, count(*) / (select count(*) from work.train_bins) as train_pct
2846                from work.train_bins group by score_bin) a
2847           on s.score_bin = a.score_bin
2848           left join
2849               (select score_bin, count(*) / (select count(*) from work.valid_bins) as valid_pct
2850                from work.valid_bins group by score_bin) b
2851           on s.score_bin = b.score_bin
2852           order by s.score_bin;
2853       
2854           create table work.psi_summary as
2855           select sum(psi_component) as PSI format=best12.,
2856                  case
2857                     when calculated PSI < 0.1 then 'No significant change'
2858                     when calculated PSI < 0.25 then 'Some change'
2859                     else 'Significant change'
2860                  end as PSI_interpretation
2861           from work.psi_calculation;
2862       quit;
2863       
2864       proc print data=work.psi_summary noobs;
2865           title "Population Stability Index";
2866       run;
2867       
2868       /*****************************************************************************
2869        * 7. Calibration Plot
2870        *****************************************************************************/
2871       
2872       /* Bin predictions and compare to actual */
2873       proc rank data=work.logit_scored_valid
2874                 out=work.calibration_data
2875                 groups=20;
2876           var pd_logistic;
2877           ranks pred_bin;
2878       run;
2879       
2880       proc sql;
2881           create table work.calibration_plot as
2882           select
2883               pred_bin,
2884               mean(pd_logistic) as mean_predicted format=8.4,
2885               mean(default_flag) as mean_actual format=8.4,
2886               count(*) as bin_count
2887           from work.calibration_data
2888           group by pred_bin
2889           order by pred_bin;
2890       quit;
2891       
2892       proc sgplot data=work.calibration_plot;
2893           scatter x=mean_predicted y=mean_actual / markerattrs=(size=10);
2894           lineparm x=0 y=0 slope=1 / lineattrs=(pattern=dash);
2895           xaxis label="Mean Predicted Probability";
2896           yaxis label="Mean Actual Default Rate";
2897           title "Calibration Plot - Predicted vs Actual";
2898       run;
2899       
2900       /*****************************************************************************
2901        * 8. Generate Validation Report
2902        *****************************************************************************/
2903       
2904       /* Compile validation metrics */
2905       data work.validation_summary;
2906           merge work.auc_summary
2907                 work.ks_statistic
2908                 work.psi_summary;
2909           length model $20 status $20;
2910           model = "Logistic Regression";
2911       
2912           /* Determine model status based on metrics */
2913           if AUC >= 0.7 and KS_Statistic >= 0.3 and PSI < 0.25 then
2914               status = "Production Ready";
2915           else if AUC >= 0.65 then
2916               status = "Requires Review";
2917           else
2918               status = "Needs Improvement";
2919       run;
2920       
2921       proc print data=work.validation_summary noobs;
2922           title "Model Validation Summary";
2923       run;
