1289       /*****************************************************************************
1290        * 2. Train Logistic Regression Model
1291        *****************************************************************************/
1292       
1293       /* Train logistic regression with stepwise selection */
1294       proc logistic data=work.model_features_train descending;
1295           model default_flag =
1296               /* Core risk metrics */
1297               credit_utilization_capped debt_ratio_capped
1298       
1299               /* Late payment indicators */
1300               num_late_30_59 num_late_60_89 num_late_90_plus
1301               total_late_payments has_delinquency has_serious_delinquency
1302       
1303               /* Financial metrics */
1304               age monthly_income log_monthly_income
1305               num_credit_lines num_real_estate_loans log_num_credit_lines
1306               num_dependents income_per_dependent credit_lines_per_person
1307       
1308               /* Risk flags */
1309               flag_high_utilization flag_very_high_utilization
1310               flag_high_debt_ratio flag_very_high_debt_ratio
1311               flag_recent_late_payments flag_serious_delinquency
1312               flag_multiple_delinquencies flag_low_income
1313               flag_many_dependents flag_few_credit_lines
1314               total_risk_flags
1315       
1316               /* Categorical indicators */
1317               credit_util_category debt_category age_category
1318       
1319               /* Composite scores */
1320               financial_health
1321       
1322               /* Interaction features */
1323               age_income_interaction utilization_debt_interaction
1324       
1325               /* Missing value flags */
1326               MonthlyIncome_missing Dependents_missing
1327       
1328           / selection=stepwise slentry=0.05 slstay=0.05
1329             ctable lackfit rsquare;
1330       
1331           /* Output predictions */
1332           output out=work.logit_scored_train
1333                  predicted=pd_logistic;
1334       
1335           /* Store model for scoring */
1336           store work.logit_model;
1337       
1338           /* Output parameter estimates (coefficients) */
1339           ods output ModelBuildingSummary=work._j_modelbuildingsummary FitStatistics=work._j_fitstatistics
1339     ! GlobalTests=work._j_globaltests RSquare=work._j_rsquare Association=work._j_association OddsRatios=work._j_oddsratios
1339     ! LackFitPartition=work._j_lackfitpartition LackFitChiSq=work._j_lackfitchisq Classification=work._j_classification
1339     ! ParameterEstimates=work.model_coefficients;
1340       
1341           title "Logistic Regression Model - Credit Default Prediction";
1342       run;
