1454       /*****************************************************************************
1455        * 5. Create Risk Scores and Grades
1456        *****************************************************************************/
1457       
1458       /* Generate risk scores for training set */
1459       data work.risk_scores_train;
1460           set work.logit_scored_train;
1461       
1462           /* Convert probability to credit risk score (300-850 scale like FICO) */
1463           base_score = 600;
1464           score_range = 250;
1465           credit_risk_score = base_score + score_range * (1 - pd_logistic);
1466       
1467           /* Assign risk grades from the probability (a missing probability is graded F) */
1468           if missing(pd_logistic) then risk_grade = 'F';
1469           else if pd_logistic < 0.10 then risk_grade = 'A';
1470           else if pd_logistic < 0.15 then risk_grade = 'B';
1471           else if pd_logistic < 0.25 then risk_grade = 'C';
1472           else if pd_logistic < 0.35 then risk_grade = 'D';
1473           else if pd_logistic <= 0.50 then risk_grade = 'E';
1474           else risk_grade = 'F';
1475       
1476           /* Recommended actions */
1477           if risk_grade in ('A', 'B') then recommendation = 'Approve';
1478           else if risk_grade = 'C' then recommendation = 'Review';
1479           else recommendation = 'Decline';
1480       
1481           /* Suggested interest rate (risk-based pricing) */
1482           base_rate = 0.05;
1483           if risk_grade = 'A' then interest_rate = base_rate;
1484           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
1485           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
1486           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
1487           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
1488           else interest_rate = base_rate + 0.15;
1489       
1490           format interest_rate percent8.2;
1491       run;
1492       
