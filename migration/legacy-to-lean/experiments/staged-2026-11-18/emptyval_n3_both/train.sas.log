1363       /* Calculate precision, recall, and F1 score for training set */
1364       data work.training_metrics;
1365           set work.confusion_matrix_train end=eof;
1366           retain TP TN FP FN 0;
1367       
1368           if default_flag = 1 and pred_logistic = 1 then TP = count;
1369           else if default_flag = 0 and pred_logistic = 0 then TN = count;
1370           else if default_flag = 0 and pred_logistic = 1 then FP = count;
1371           else if default_flag = 1 and pred_logistic = 0 then FN = count;
1372       
1373           if eof then do;
1374               if (TP + FP) > 0 then train_precision = TP / (TP + FP);
1375               else train_precision = .;
1376               if (TP + FN) > 0 then train_recall = TP / (TP + FN);
1377               else train_recall = .;
1378               if (train_precision + train_recall) > 0 then train_f1_score = 2 * (train_precision * train_recall) /
1378     ! (train_precision + train_recall);
1379               else train_f1_score = .;
1380               if (TP + TN + FP + FN) > 0 then train_accuracy = (TP + TN) / (TP + TN + FP + FN);
1381               else train_accuracy = .;
1382               output;
1383           end;
1384           keep train_precision train_recall train_f1_score train_accuracy;
1385       run;
1386       
1387       proc print data=work.training_metrics;
1388           title "Training Set - Performance Metrics";
