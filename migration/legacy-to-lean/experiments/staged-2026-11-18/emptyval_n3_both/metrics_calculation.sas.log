2860       /* Calculate lift by decile; a decile that receives no applicant has
2861          count 0, capture rate 0 and lift 0; with no defaulter in the validation set
2862          capture rate and lift are 0 on every decile */
2863       proc sql;
2864           create table work.decile_analysis as
2865           select
2866               l.decile,
2867               coalesce(d.total_count, 0) as total_count,
2868               coalesce(d.defaults, 0) as defaults,
2869               d.default_rate format=percent8.2,
2870               d.avg_pd format=8.4,
2871               d.min_pd format=8.4,
2872               d.max_pd format=8.4,
2873               coalesce(d.capture_rate, 0) as capture_rate format=percent8.2,
2874               coalesce(d.lift, 0) as lift format=8.2
2875           from work.decile_list l
2876           left join
2877               (select
2878                   decile + 1 as decile,
2879                   count(*) as total_count,
2880                   sum(default_flag) as defaults,
2881                   mean(default_flag) as default_rate,
2882                   mean(pd_logistic) as avg_pd,
2883                   min(pd_logistic) as min_pd,
2884                   max(pd_logistic) as max_pd,
2885                   sum(default_flag) / (select sum(default_flag) from work.decile_data) as capture_rate,
2886                   (calculated default_rate) / (select mean(default_flag) from work.decile_data) as lift
2887                from work.decile_data
2888                group by decile) d
2889           on l.decile = d.decile
2890           order by l.decile;
