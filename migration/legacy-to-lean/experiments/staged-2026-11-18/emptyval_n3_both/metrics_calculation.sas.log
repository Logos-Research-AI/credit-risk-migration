2795           /* Calculate metrics */
2796           data work.metrics_&suffix;
2797               set work.conf_matrix_&suffix end=eof;
2798               retain TP TN FP FN 0;
2799       
2800               if default_flag = 1 and predicted = 1 then TP = count;
2801               else if default_flag = 0 and predicted = 0 then TN = count;
2802               else if default_flag = 0 and predicted = 1 then FP = count;
2803               else if default_flag = 1 and predicted = 0 then FN = count;
2804       
2805               if eof then do;
2806                   threshold = &threshold;
2807                   if (TP + TN + FP + FN) > 0 then accuracy = (TP + TN) / (TP + TN + FP + FN);
2808                   else accuracy = .;
2809                   if (TP + FP) > 0 then precision = TP / (TP + FP);
2810                   else precision = .;
2811                   if (TP + FN) > 0 then recall = TP / (TP + FN);
2812                   else recall = .;
2813                   if (precision + recall) > 0 then f1_score = 2 * (precision * recall) / (precision + recall);
2814                   else f1_score = .;
2815                   if (TN + FP) > 0 then specificity = TN / (TN + FP);
2816                   else specificity = .;
2817                   output;
2818               end;
2819               keep threshold accuracy precision recall f1_score specificity;
