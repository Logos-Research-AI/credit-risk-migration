2936       /*****************************************************************************
2937        * 6. Population Stability Index (PSI)
2938        *****************************************************************************/
2939       
2940       /* Compare score distributions between training and validation */
2941       
2942       /* Ten bins cut from the training scores: the nine cuts are the nearest-rank
2943          deciles of the training scores (no interpolation) */
2944       proc sort data=work.logit_scored_train(keep=credit_risk_score)
2945                 out=work.train_scores_sorted;
2946           by credit_risk_score;
2947       run;
2948       
2949       data work.psi_cuts;
2950           set work.train_scores_sorted nobs=n_train end=eof;
2951           array cut{9};
2952           retain cut1-cut9;
2953           do k = 1 to 9;
2954               if _n_ = ceil(k * n_train / 10) then cut{k} = credit_risk_score;
2955           end;
2956           if eof then output;
2957           keep cut1-cut9;
2958       run;
2959       
2960       /* Place both sets in the same bins; a score equal to a cut belongs to the lower bin */
2961       data work.train_bins;
2962           if _n_ = 1 then set work.psi_cuts;
2963           set work.logit_scored_train;
2964           array cut{9};
2965           score_bin = 0;
2966           do k = 1 to 9;
2967               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
2968           end;
2969           drop k cut1-cut9;
2970       run;
2971       
2972       data work.valid_bins;
2973           if _n_ = 1 then set work.psi_cuts;
2974           set work.logit_scored_valid;
ERROR: File WORK.LOGIT_SCORED_VALID.DATA does not exist.
2975           array cut{9};
2976           score_bin = 0;
2977           do k = 1 to 9;
2978               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
2979           end;
2980           drop k cut1-cut9;
2981       run;
WARNING: The data set WORK.VALID_BINS may be incomplete.  When this step was stopped there were 0 observations and 2 variables.
2982       
2983       data work.psi_bins;
2984           do score_bin = 0 to 9;
2985               output;
2986           end;
2987       run;
2988       
2989       /* An empty bin is given a share below that of one applicant, the same on both
2990          sides, so that a bin filled on one side only adds a positive amount */
2991       /* The size of the larger set is carried as a whole number and the share is computed
2992          where it is used, so it is not cut to the 8 characters of a macro variable */
2993       proc sql noprint;
2994           select max(t.n, v.n) format=32. into :psi_rows trimmed
2995           from (select count(*) as n from work.train_bins) t,
2996                (select count(*) as n from work.valid_bins) v;
2997       quit;
2998       %let psi_floor = (0.5 / &psi_rows);
2999       
3000       /* Calculate PSI */
3001       proc sql;
3002           create table work.psi_calculation as
3003           select
3004               s.score_bin,
3005               coalesce(a.train_pct, 0) as train_pct,
3006               coalesce(b.valid_pct, 0) as valid_pct,
3007               (max(calculated train_pct, &psi_floor) - max(calculated valid_pct, &psi_floor))
3008                   * log(max(calculated train_pct, &psi_floor) / max(calculated valid_pct, &psi_floor)) as psi_component
3009           from work.psi_bins s
3010           left join
3011               (select score_bin, count(*) / (select count(*) from work.train_bins) as train_pct
3012                from work.train_bins group by score_bin) a
3013           on s.score_bin = a.score_bin
3014           left join
3015               (select score_bin, count(*) / (select count(*) from work.valid_bins) as valid_pct
3016                from work.valid_bins group by score_bin) b
3017           on s.score_bin = b.score_bin
3018           order by s.score_bin;
3019       
3020           create table work.psi_summary as
3021           select sum(psi_component) as PSI format=best12.,
3022                  case
3023                     when calculated PSI < 0.1 then 'No significant change'
3024                     when calculated PSI < 0.25 then 'Some change'
3025                     else 'Significant change'
3026                  end as PSI_interpretation
3027           from work.psi_calculation;
3028       quit;
3029       
3030       proc print data=work.psi_summary noobs;
3031           title "Population Stability Index";
3032       run;
