3748       data work.test_cleaned;
3749           set work.test_raw_clean;
3750       
3751           /* Create age group for income imputation */
3752           if age < 30 then age_group = 1;
3753           else if age < 40 then age_group = 2;
3754           else if age < 50 then age_group = 3;
3755           else if age < 60 then age_group = 4;
3756           else age_group = 5;
3757       
3758           /* Handle missing values - create flags */
3759           if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
3760           else MonthlyIncome_missing = 0;
3761       
3762           if missing(NumberOfDependents) then do;
3763               NumberOfDependents = 0;
3764               Dependents_missing = 1;
3765           end;
3766           else Dependents_missing = 0;
3767       run;
3768       
3769       /* Merge and impute income - rename columns in SQL */
3770       proc sql;
3771           create table work.test_imputed as
3772           select
3773               a.VAR1 as row_id,
3774               a.age,
3775               case when a.MonthlyIncome_missing = 1 then coalesce(b.median_income, b.overall_median_income)
3776                    else a.MonthlyIncome
3777               end as monthly_income,
3778               a.MonthlyIncome_missing,
3779               a.NumberOfDependents as num_dependents,
3780               a.Dependents_missing,
3781               a.age_group,
3782               a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
3783               a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
3784               a.NumberOfTimes90DaysLate as num_late_90_plus,
3785               a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
3786               a.DebtRatio * 100 as debt_ratio,
3787               a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
3788               a.NumberRealEstateLoansOrLines as num_real_estate_loans
3789           from work.test_cleaned a
3790           left join work.train_income_medians b
3791           on a.age_group = b.age_group;
3792       quit;
