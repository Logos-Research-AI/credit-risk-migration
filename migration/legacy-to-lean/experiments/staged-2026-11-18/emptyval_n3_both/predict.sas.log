3794       /*****************************************************************************
3795        * 3. Feature Engineering (Same as Training)
3796        *****************************************************************************/
3797       
3798       data work.test_features;
3799           set work.test_imputed;
3800       
3801           /* Total late payments across all categories */
3802           total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
3803       
3804           /* Has any delinquency indicator */
3805           has_delinquency = (total_late_payments > 0);
3806       
3807           /* Has serious delinquency (90+ days) */
3808           has_serious_delinquency = (num_late_90_plus > 0);
3809       
3810           /* Credit utilization categories */
3811           if credit_utilization < 30 then credit_util_category = 1;
3812           else if credit_utilization < 50 then credit_util_category = 2;
3813           else if credit_utilization < 75 then credit_util_category = 3;
3814           else credit_util_category = 4;
3815       
3816           /* Debt ratio categories */
3817           if debt_ratio < 30 then debt_category = 1;
3818           else if debt_ratio < 43 then debt_category = 2;
3819           else if debt_ratio < 60 then debt_category = 3;
3820           else debt_category = 4;
3821       
3822           /* Income per dependent */
3823           if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
3824           else income_per_dependent = monthly_income;
3825       
3826           /* Credit lines per person in household */
3827           credit_lines_per_person = num_credit_lines / (num_dependents + 1);
3828       
3829           /* Age categories */
3830           if age < 25 then age_category = 1;
3831           else if age < 35 then age_category = 2;
3832           else if age < 50 then age_category = 3;
3833           else if age < 65 then age_category = 4;
3834           else age_category = 5;
3835       
3836           /* Risk flags */
3837           flag_high_utilization = (credit_utilization > 75);
3838           flag_very_high_utilization = (credit_utilization > 100);
3839           flag_high_debt_ratio = (debt_ratio > 43);
3840           flag_very_high_debt_ratio = (debt_ratio > 60);
3841           flag_recent_late_payments = (num_late_30_59 > 0);
3842           flag_serious_delinquency = (num_late_90_plus > 0);
3843           flag_multiple_delinquencies = (total_late_payments >= 3);
3844           flag_low_income = (monthly_income < 2500);
3845           flag_many_dependents = (num_dependents >= 3);
3846           flag_few_credit_lines = (num_credit_lines <= 2);
3847       
3848           /* Total risk flags */
3849           total_risk_flags = sum(flag_high_utilization, flag_very_high_utilization,
3850                                 flag_high_debt_ratio,
3851                                 flag_serious_delinquency, flag_multiple_delinquencies,
3852                                 flag_low_income, flag_many_dependents,
3853                                 flag_few_credit_lines);
3854       
3855           /* Financial health score */
3856           financial_health = 100;
3857           if credit_utilization > 30 then financial_health = financial_health - 15;
3858           if credit_utilization > 75 then financial_health = financial_health - 15;
3859           if debt_ratio > 43 then financial_health = financial_health - 20;
3860           if has_delinquency then financial_health = financial_health - 20;
3861           if num_late_90_plus > 0 then financial_health = financial_health - 30;
3862           financial_health = max(0, financial_health);
3863       
3864           /* Log transformations */
3865           log_monthly_income = log(monthly_income + 1);
3866           log_num_credit_lines = log(num_credit_lines + 1);
3867           log_total_late_payments = log(total_late_payments + 1);
3868       
3869           /* Interaction features */
3870           if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
3871           else age_income_interaction = age * log_monthly_income;
3872           utilization_debt_interaction = credit_utilization * debt_ratio;
3873       
3874           /* Cap extreme outliers */
3875           credit_utilization_capped = min(credit_utilization, 200);
3876           debt_ratio_capped = min(debt_ratio, 500);
3877       run;
