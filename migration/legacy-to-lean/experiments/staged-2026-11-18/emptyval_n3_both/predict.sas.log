3879       /*****************************************************************************
3880        * 4. Score Test Set Using Trained Model
3881        *****************************************************************************/
3882       
3883       /* Score test set with trained model */
3884       proc plm restore=work.logit_model;
3885           score data=work.test_features
3886                 out=work.test_scored_temp
3887                 predicted=predicted_logit;
3888       run;
3889       
3890       /* Convert logit to probability */
3891       data work.test_scored;
3892           set work.test_scored_temp;
3893       
3894           /* Apply inverse logit function */
3895           pd_logistic = 1 / (1 + exp(-predicted_logit));
3896       
3897           drop predicted_logit;
3898       run;
3899       
3900       /*****************************************************************************
3901        * 5. Generate Risk Scores and Recommendations
3902        *****************************************************************************/
3903       
3904       data work.test_predictions;
3905           set work.test_scored;
3906       
3907           /* Binary prediction at 0.5 threshold */
3908           pred_logistic = (pd_logistic >= 0.5);
3909       
3910           /* Convert probability to credit risk score (300-850 scale) */
3911           base_score = 600;
3912           score_range = 250;
3913           credit_risk_score = base_score + score_range * (1 - pd_logistic);
3914       
3915           /* Assign risk grades from the probability (a missing probability is graded F) */
3916           if missing(pd_logistic) then risk_grade = 'F';
3917           else if pd_logistic < 0.10 then risk_grade = 'A';
3918           else if pd_logistic < 0.15 then risk_grade = 'B';
3919           else if pd_logistic < 0.25 then risk_grade = 'C';
3920           else if pd_logistic < 0.35 then risk_grade = 'D';
3921           else if pd_logistic <= 0.50 then risk_grade = 'E';
3922           else risk_grade = 'F';
3923       
3924           /* Recommended actions */
3925           if risk_grade in ('A', 'B') then recommendation = 'Approve';
3926           else if risk_grade = 'C' then recommendation = 'Review';
3927           else recommendation = 'Decline';
3928       
3929           /* Suggested interest rate */
3930           base_rate = 0.05;
3931           if risk_grade = 'A' then interest_rate = base_rate;
3932           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
3933           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
3934           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
3935           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
3936           else interest_rate = base_rate + 0.15;
3937       
3938           format interest_rate percent8.2;
3939       run;
