2717       /* Calculate lift by decile; a decile that receives no applicant has
2718          count 0, capture rate 0 and lift 0; with no defaulter in the validation set
2719          capture rate and lift are 0 on every decile */
2720       proc sql;
2721           create table work.decile_analysis as
2722           select
2723               l.decile,
2724               coalesce(d.total_count, 0) as total_count,
2725               coalesce(d.defaults, 0) as defaults,
2726               d.default_rate format=percent8.2,
2727               d.avg_pd format=8.4,
2728               d.min_pd format=8.4,
2729               d.max_pd format=8.4,
2730               coalesce(d.capture_rate, 0) as capture_rate format=percent8.2,
2731               coalesce(d.lift, 0) as lift format=8.2
2732           from work.decile_list l
2733           left join
2734               (select
2735                   decile + 1 as decile,
2736                   count(*) as total_count,
2737                   sum(default_flag) as defaults,
2738                   mean(default_flag) as default_rate,
2739                   mean(pd_logistic) as avg_pd,
2740                   min(pd_logistic) as min_pd,
2741                   max(pd_logistic) as max_pd,
2742                   sum(default_flag) / (select sum(default_flag) from work.decile_data) as capture_rate,
2743                   (calculated default_rate) / (select mean(default_flag) from work.decile_data) as lift
2744                from work.decile_data
2745                group by decile) d
2746           on l.decile = d.decile
2747           order by l.decile;
