2548       /* Calculate and display AUC: the exact pairwise AUC of the validation probabilities.
2549          A defaulter/non-defaulter pair is concordant when the defaulter's probability is
2550          higher, and tied only when the two probabilities are equal */
2551       proc sql;
2552           create table work.auc_pairs as
2553           select pd_logistic,
2554                  sum(default_flag = 1) as n_bad,
2555                  sum(default_flag = 0) as n_good
2556           from work.logit_scored_valid
2557           where not missing(pd_logistic)
2558           group by pd_logistic
2559           order by pd_logistic;
