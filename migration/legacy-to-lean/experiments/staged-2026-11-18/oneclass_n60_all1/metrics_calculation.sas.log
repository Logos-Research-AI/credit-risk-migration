2793       /*****************************************************************************
2794        * 6. Population Stability Index (PSI)
2795        *****************************************************************************/
2796       
2797       /* Compare score distributions between training and validation */
2798       
2799       /* Ten bins cut from the training scores: the nine cuts are the nearest-rank
2800          deciles of the training scores (no interpolation) */
2801       proc sort data=work.logit_scored_train(keep=credit_risk_score)
2802                 out=work.train_scores_sorted;
2803           by credit_risk_score;
2804       run;
2805       
2806       data work.psi_cuts;
2807           set work.train_scores_sorted nobs=n_train end=eof;
2808           array cut{9};
2809           retain cut1-cut9;
2810           do k = 1 to 9;
2811               if _n_ = ceil(k * n_train / 10) then cut{k} = credit_risk_score;
2812           end;
2813           if eof then output;
2814           keep cut1-cut9;
2815       run;
2816       
2817       /* Place both sets in the same bins; a score equal to a cut belongs to the lower bin */
2818       data work.train_bins;
2819           if _n_ = 1 then set work.psi_cuts;
2820           set work.logit_scored_train;
2821           array cut{9};
2822           score_bin = 0;
2823           do k = 1 to 9;
2824               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
2825           end;
2826           drop k cut1-cut9;
2827       run;
2828       
2829       data work.valid_bins;
2830           if _n_ = 1 then set work.psi_cuts;
2831           set work.logit_scored_valid;
ERROR: File WORK.LOGIT_SCORED_VALID.DATA does not exist.
2832           array cut{9};
2833           score_bin = 0;
2834           do k = 1 to 9;
2835               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
2836           end;
2837           drop k cut1-cut9;
2838       run;
WARNING: The data set WORK.VALID_BINS may be incomplete.  When this step was stopped there were 0 observations and 2 variables.
2839       
2840       data work.psi_bins;
2841           do score_bin = 0 to 9;
2842               output;
2843           end;
2844       run;
2845       
2846       /* An empty bin is given a share below that of one applicant, the same on both
2847          sides, so that a bin filled on one side only adds a positive amount */
2848       /* The size of the larger set is carried as a whole number and the share is computed
2849          where it is used, so it is not cut to the 8 characters of a macro variable */
2850       proc sql noprint;
2851           select max(t.n, v.n) format=32. into :psi_rows trimmed
2852           from (select count(*) as n from work.train_bins) t,
2853                (select count(*) as n from work.valid_bins) v;
2854       quit;
2855       %let psi_floor = (0.5 / &psi_rows);
2856       
2857       /* Calculate PSI */
2858       proc sql;
2859           create table work.psi_calculation as
2860           select
2861               s.score_bin,
2862               coalesce(a.train_pct, 0) as train_pct,
2863               coalesce(b.valid_pct, 0) as valid_pct,
2864               (max(calculated train_pct, &psi_floor) - max(calculated valid_pct, &psi_floor))
2865                   * log(max(calculated train_pct, &psi_floor) / max(calculated valid_pct, &psi_floor)) as psi_component
2866           from work.psi_bins s
2867           left join
2868               (select score_bin, count(*) / (select count(*) from work.train_bins) as train_pct
2869                from work.train_bins group by score_bin) a
2870           on s.score_bin = a.score_bin
2871           left join
2872               (select score_bin, count(*) / (select count(*) from work.valid_bins) as valid_pct
2873                from work.valid_bins group by score_bin) b
2874           on s.score_bin = b.score_bin
2875           order by s.score_bin;
2876       
2877           create table work.psi_summary as
2878           select sum(psi_component) as PSI format=best12.,
2879                  case
2880                     when calculated PSI < 0.1 then 'No significant change'
2881                     when calculated PSI < 0.25 then 'Some change'
2882                     else 'Significant change'
2883                  end as PSI_interpretation
2884           from work.psi_calculation;
2885       quit;
2886       
2887       proc print data=work.psi_summary noobs;
2888           title "Population Stability Index";
2889       run;
