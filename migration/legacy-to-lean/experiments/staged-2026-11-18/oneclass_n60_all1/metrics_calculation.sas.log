2649               tables default_flag * predicted / out=work.conf_matrix_&suffix;
2650           run;
2651       
2652           /* Calculate metrics */
2653           data work.metrics_&suffix;
2654               set work.conf_matrix_&suffix end=eof;
2655               retain TP TN FP FN 0;
2656       
2657               if default_flag = 1 and predicted = 1 then TP = count;
2658               else if default_flag = 0 and predicted = 0 then TN = count;
2659               else if default_flag = 0 and predicted = 1 then FP = count;
2660               else if default_flag = 1 and predicted = 0 then FN = count;
2661       
2662               if eof then do;
2663                   threshold = &threshold;
2664                   if (TP + TN + FP + FN) > 0 then accuracy = (TP + TN) / (TP + TN + FP + FN);
2665                   else accuracy = .;
2666                   if (TP + FP) > 0 then precision = TP / (TP + FP);
2667                   else precision = .;
2668                   if (TP + FN) > 0 then recall = TP / (TP + FN);
2669                   else recall = .;
2670                   if (precision + recall) > 0 then f1_score = 2 * (precision * recall) / (precision + recall);
2671                   else f1_score = .;
2672                   if (TN + FP) > 0 then specificity = TN / (TN + FP);
2673                   else specificity = .;
2674                   output;
2675               end;
2676               keep threshold accuracy precision recall f1_score specificity;
