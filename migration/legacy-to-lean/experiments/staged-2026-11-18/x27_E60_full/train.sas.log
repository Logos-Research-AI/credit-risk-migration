1578               else valid_precision = .;
1579               if (TP + FN) > 0 then valid_recall = TP / (TP + FN);
1580               else valid_recall = .;
1581               if (valid_precision + valid_recall) > 0 then valid_f1_score = 2 * (valid_precision * valid_recall) /
1581     ! (valid_precision + valid_recall);
1582               else valid_f1_score = .;
1583               if (TP + TN + FP + FN) > 0 then valid_accuracy = (TP + TN) / (TP + TN + FP + FN);
1584               else valid_accuracy = .;
1585               output;
1586           end;
1587           keep valid_precision valid_recall valid_f1_score valid_accuracy;
1588       run;
1589       
1590       proc print data=work.validation_metrics;
1591           title "Validation Set - Performance Metrics";
1592           format valid_precision valid_recall valid_f1_score valid_accuracy 8.4;
1593       run;
1594       
1595       /*****************************************************************************
1596        * 5. Create Risk Scores and Grades
1597        *****************************************************************************/
1598       
1599       /* Generate risk scores for training set */
1600       data work.risk_scores_train;
1601           set work.logit_scored_train;
1602       
1603           /* Convert probability to credit risk score (300-850 scale like FICO) */
1604           base_score = 600;
1605           score_range = 250;
1606           credit_risk_score = base_score + score_range * (1 - pd_logistic);
1607       
1608           /* Assign risk grades from the probability (a missing probability is graded F) */
1609           if missing(pd_logistic) then risk_grade = 'F';
1610           else if pd_logistic < 0.10 then risk_grade = 'A';
1611           else if pd_logistic < 0.15 then risk_grade = 'B';
1612           else if pd_logistic < 0.25 then risk_grade = 'C';
1613           else if pd_logistic < 0.35 then risk_grade = 'D';
1614           else if pd_logistic <= 0.50 then risk_grade = 'E';
1615           else risk_grade = 'F';
1616       
1617           /* Recommended actions */
1618           if risk_grade in ('A', 'B') then recommendation = 'Approve';
1619           else if risk_grade = 'C' then recommendation = 'Review';
1620           else recommendation = 'Decline';
1621       
1622           /* Suggested interest rate (risk-based pricing) */
1623           base_rate = 0.05;
1624           if risk_grade = 'A' then interest_rate = base_rate;
1625           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
1626           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
1627           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
1628           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
1629           else interest_rate = base_rate + 0.15;
1630       
1631           format interest_rate percent8.2;
1632       run;
1633       
1634       /* Generate risk scores for validation set */
1635       data work.risk_scores_validation;
1636           set work.logit_scored_valid;
1637       
1638           /* Same scoring logic as training */
1639           base_score = 600;
1640           score_range = 250;
1641           credit_risk_score = base_score + score_range * (1 - pd_logistic);
1642       
1643           if missing(pd_logistic) then risk_grade = 'F';
1644           else if pd_logistic < 0.10 then risk_grade = 'A';
1645           else if pd_logistic < 0.15 then risk_grade = 'B';
1646           else if pd_logistic < 0.25 then risk_grade = 'C';
1647           else if pd_logistic < 0.35 then risk_grade = 'D';
1648           else if pd_logistic <= 0.50 then risk_grade = 'E';
1649           else risk_grade = 'F';
1650       
1651           if risk_grade in ('A', 'B') then recommendation = 'Approve';
1652           else if risk_grade = 'C' then recommendation = 'Review';
1653           else recommendation = 'Decline';
1654       
1655           base_rate = 0.05;
1656           if risk_grade = 'A' then interest_rate = base_rate;
1657           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
1658           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
1659           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
1660           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
1661           else interest_rate = base_rate + 0.15;
1662       
1663           format interest_rate percent8.2;
1664       run;
1665       
1666       /* Risk grade distribution */
1667       proc freq data=work.risk_scores_train;
1668           tables risk_grade * default_flag / nocol nopercent;
1669           title "Default Rate by Risk Grade - Training Set";
1670       run;
