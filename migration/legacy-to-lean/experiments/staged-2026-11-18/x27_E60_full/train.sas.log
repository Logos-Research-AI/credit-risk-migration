1430       /*****************************************************************************
1431        * 2. Train Logistic Regression Model
1432        *****************************************************************************/
1433       
1434       /* Train logistic regression with stepwise selection */
1435       proc logistic data=work.model_features_train descending;
1436           model default_flag =
1437               /* Core risk metrics */
1438               credit_utilization_capped debt_ratio_capped
1439       
1440               /* Late payment indicators */
1441               num_late_30_59 num_late_60_89 num_late_90_plus
1442               total_late_payments has_delinquency has_serious_delinquency
1443       
1444               /* Financial metrics */
1445               age monthly_income log_monthly_income
1446               num_credit_lines num_real_estate_loans log_num_credit_lines
1447               num_dependents income_per_dependent credit_lines_per_person
1448       
1449               /* Risk flags */
1450               flag_high_utilization flag_very_high_utilization
1451               flag_high_debt_ratio flag_very_high_debt_ratio
1452               flag_recent_late_payments flag_serious_delinquency
1453               flag_multiple_delinquencies flag_low_income
1454               flag_many_dependents flag_few_credit_lines
1455               total_risk_flags
1456       
1457               /* Categorical indicators */
1458               credit_util_category debt_category age_category
1459       
1460               /* Composite scores */
1461               financial_health
1462       
1463               /* Interaction features */
1464               age_income_interaction utilization_debt_interaction
1465       
1466               /* Missing value flags */
1467               MonthlyIncome_missing Dependents_missing
1468       
1469           / selection=stepwise slentry=0.05 slstay=0.05
1470             ctable lackfit rsquare;
1471       
1472           /* Output predictions */
1473           output out=work.logit_scored_train
1474                  predicted=pd_logistic;
1475       
1476           /* Store model for scoring */
1477           store work.logit_model;
1478       
1479           /* Output parameter estimates (coefficients) */
1480           ods output ModelBuildingSummary=work._j_modelbuildingsummary FitStatistics=work._j_fitstatistics
1480     ! GlobalTests=work._j_globaltests RSquare=work._j_rsquare Association=work._j_association OddsRatios=work._j_oddsratios
1480     ! LackFitPartition=work._j_lackfitpartition LackFitChiSq=work._j_lackfitchisq Classification=work._j_classification
1480     ! ParameterEstimates=work.model_coefficients;
1481       
1482           title "Logistic Regression Model - Credit Default Prediction";
1483       run;
