1506           set work.confusion_matrix_train end=eof;
1507           retain TP TN FP FN 0;
1508       
1509           if default_flag = 1 and pred_logistic = 1 then TP = count;
1510           else if default_flag = 0 and pred_logistic = 0 then TN = count;
1511           else if default_flag = 0 and pred_logistic = 1 then FP = count;
1512           else if default_flag = 1 and pred_logistic = 0 then FN = count;
1513       
1514           if eof then do;
1515               if (TP + FP) > 0 then train_precision = TP / (TP + FP);
1516               else train_precision = .;
1517               if (TP + FN) > 0 then train_recall = TP / (TP + FN);
1518               else train_recall = .;
1519               if (train_precision + train_recall) > 0 then train_f1_score = 2 * (train_precision * train_recall) /
1519     ! (train_precision + train_recall);
1520               else train_f1_score = .;
1521               if (TP + TN + FP + FN) > 0 then train_accuracy = (TP + TN) / (TP + TN + FP + FN);
1522               else train_accuracy = .;
1523               output;
1524           end;
1525           keep train_precision train_recall train_f1_score train_accuracy;
1526       run;
