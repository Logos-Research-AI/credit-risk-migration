292        /* Check the input conditions: stop with an error before anything is exported */
293        /* The numeric value of a raw column: a numeric column as it is; a character column
294           read as a number, missing when the text is no number or is longer than 32 characters */
295        %macro num(v);
296            %local dsid pos vtype;
297            %let vtype = ;
298            %let dsid = %sysfunc(open(work.credit_raw));
299            %let pos = %sysfunc(varnum(&dsid, &v));
300            %if &pos > 0 %then %let vtype = %sysfunc(vartype(&dsid, &pos));
301            %let dsid = %sysfunc(close(&dsid));
302            %if &vtype = N %then "&v"n;
303            %else ifn(lengthn(strip("&v"n)) <= 32, input(strip("&v"n), ?? best32.), .);
304        %mend;
305        
306        %let columns_ok = 0;
307        %let bad_rows = 1;
308        %let duplicate_ids = 1;
309        %let known_incomes = 0;
310        
311        proc sql noprint;
312            /* The expected columns and no others */
313            select (count(*) = 12 and sum(upcase(name) in
314                       ('VAR1', 'SERIOUSDLQIN2YRS', 'AGE', 'MONTHLYINCOME', 'NUMBEROFDEPENDENTS',
315                        'REVOLVINGUTILIZATIONOFUNSECUREDL', 'DEBTRATIO',
316                        'NUMBEROFTIME30-59DAYSPASTDUENOTW', 'NUMBEROFTIME60-89DAYSPASTDUENOTW',
317                        'NUMBEROFTIMES90DAYSLATE', 'NUMBEROFOPENCREDITLINESANDLOANS',
318                        'NUMBERREALESTATELOANSORLINES')) = 12)
319            into :columns_ok trimmed
320            from dictionary.columns
321            where libname = 'WORK' and memname = 'CREDIT_RAW';
322        quit;
323        
324        /* Only MonthlyIncome and NumberOfDependents may be missing (blank or NA);
325           the outcome is 0 or 1; the counts are whole numbers, zero or more;
326           a known MonthlyIncome is zero or more */
327        data work.input_check;
328            set work.credit_raw;
329            bad_row = (missing(%num(VAR1))
330                or %num(SeriousDlqin2yrs) not in (0, 1)
331                or missing(%num(age))
332                or missing(%num(RevolvingUtilizationOfUnsecuredL))
333                or missing(%num(DebtRatio))
334                or missing(%num(NumberRealEstateLoansOrLines))
335                or not (%num(NumberOfTime30-59DaysPastDueNotW) >= 0 and
336                        %num(NumberOfTime30-59DaysPastDueNotW) = int(%num(NumberOfTime30-59DaysPastDueNotW)))
337                or not (%num(NumberOfTime60-89DaysPastDueNotW) >= 0 and
338                        %num(NumberOfTime60-89DaysPastDueNotW) = int(%num(NumberOfTime60-89DaysPastDueNotW)))
339                or not (%num(NumberOfTimes90DaysLate) >= 0 and
340                        %num(NumberOfTimes90DaysLate) = int(%num(NumberOfTimes90DaysLate)))
341                or not (%num(NumberOfOpenCreditLinesAndLoans) >= 0 and
342                        %num(NumberOfOpenCreditLinesAndLoans) = int(%num(NumberOfOpenCreditLinesAndLoans)))
343                or (upcase(cats(MonthlyIncome)) not in ('', '.', 'NA') and missing(%num(MonthlyIncome)))
344                or (not missing(%num(MonthlyIncome)) and %num(MonthlyIncome) < 0)
345                or (upcase(cats(NumberOfDependents)) not in ('', '.', 'NA') and
346                    not (%num(NumberOfDependents) >= 0 and
347                         %num(NumberOfDependents) = int(%num(NumberOfDependents)))));
348            known_income = not missing(%num(MonthlyIncome));
349            keep VAR1 bad_row known_income;
350        run;
351        
352        /* Bad rows, repeated row ids, known incomes */
353        proc sql noprint;
354            select coalesce(sum(bad_row), 0), count(*) - count(distinct VAR1), coalesce(sum(known_income), 0)
355            into :bad_rows trimmed, :duplicate_ids trimmed, :known_incomes trimmed
356            from work.input_check;
357        quit;
358        
359        data _null_;
360            if &columns_ok ne 1 or &bad_rows ne 0 or &duplicate_ids ne 0 or &known_incomes < 1 then do;
361                put "ERROR: cs-training.csv does not meet the input conditions: "
362                    "columns_ok=&columns_ok bad_rows=&bad_rows duplicate_ids=&duplicate_ids known_incomes=&known_incomes..";
363                put "ERROR: Feature engineering stopped. Nothing is exported.";
364                abort cancel;
365            end;
366        run;
