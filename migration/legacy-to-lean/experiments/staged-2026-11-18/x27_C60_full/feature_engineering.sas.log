390        
391        /* Calculate income medians by age group for imputation */
392        proc sql;
393            create table work.income_medians as
394            select
395                case
396                    when age < 30 then 1
397                    when age < 40 then 2
398                    when age < 50 then 3
399                    when age < 60 then 4
400                    else 5
401                end as age_group,
402                median(MonthlyIncome) as median_income
403            from work.credit_raw_clean
404            where MonthlyIncome is not missing
405            group by calculated age_group;
406        quit;
407        
408        /* One row per age group, with the median of all known incomes:
409           the fallback for an age group that has no known income */
410        data work.age_groups;
411            do age_group = 1 to 5;
412                output;
413            end;
414        run;
415        
416        proc sql;
417            create table work.income_medians_all as
418            select
419                g.age_group,
420                m.median_income,
421                (select median(MonthlyIncome) from work.credit_raw_clean
422                 where MonthlyIncome is not missing) as overall_median_income
423            from work.age_groups g
424            left join work.income_medians m
425            on g.age_group = m.age_group
426            order by g.age_group;
427        quit;
428        
429        data work.credit_cleaned;
430            set work.credit_raw_clean;
431        
432            /* Create age group for income imputation */
433            if age < 30 then age_group = 1;
434            else if age < 40 then age_group = 2;
435            else if age < 50 then age_group = 3;
436            else if age < 60 then age_group = 4;
437            else age_group = 5;
438        
439            /* Handle missing values - create flags */
440            if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
441            else MonthlyIncome_missing = 0;
442        
443            if missing(NumberOfDependents) then do;
444                NumberOfDependents = 0;
445                Dependents_missing = 1;
446            end;
447            else Dependents_missing = 0;
448        run;
449        
450        /* Merge and impute income - rename columns in SQL */
451        proc sql;
452            create table work.credit_imputed as
453            select
454                a.VAR1 as row_id,
455                a.SeriousDlqin2yrs as default_flag,
456                a.age,
457                case when a.MonthlyIncome_missing = 1 then coalesce(b.median_income, b.overall_median_income)
458                     else a.MonthlyIncome
459                end as monthly_income,
460                a.MonthlyIncome_missing,
461                a.NumberOfDependents as num_dependents,
462                a.Dependents_missing,
463                a.age_group,
464                a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
465                a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
466                a.NumberOfTimes90DaysLate as num_late_90_plus,
467                a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
468                a.DebtRatio * 100 as debt_ratio,
469                a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
470                a.NumberRealEstateLoansOrLines as num_real_estate_loans
471            from work.credit_cleaned a
472            left join work.income_medians_all b
473            on a.age_group = b.age_group;
474        quit;
475        
476        /*****************************************************************************
477         * 3. Feature Engineering
478         *****************************************************************************/
479        
480        data work.credit_features;
481            set work.credit_imputed;
482        
483            /* Total late payments across all categories */
484            total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
485        
486            /* Has any delinquency indicator */
487            has_delinquency = (total_late_payments > 0);
488        
489            /* Has serious delinquency (90+ days) */
490            has_serious_delinquency = (num_late_90_plus > 0);
491        
492            /* Credit utilization categories */
493            if credit_utilization < 30 then credit_util_category = 1; /* Low */
494            else if credit_utilization < 50 then credit_util_category = 2; /* Medium */
495            else if credit_utilization < 75 then credit_util_category = 3; /* High */
496            else credit_util_category = 4; /* Very High */
497        
498            /* Debt ratio categories */
499            if debt_ratio < 30 then debt_category = 1; /* Low */
500            else if debt_ratio < 43 then debt_category = 2; /* Medium */
501            else if debt_ratio < 60 then debt_category = 3; /* High */
502            else debt_category = 4; /* Very High */
503        
504            /* Income per dependent (handle division by zero) */
505            if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
506            else income_per_dependent = monthly_income;
507        
508            /* Credit lines per person in household */
509            credit_lines_per_person = num_credit_lines / (num_dependents + 1);
510        
511            /* Age categories for risk assessment */
512            if age < 25 then age_category = 1; /* Young */
513            else if age < 35 then age_category = 2; /* Young Adult */
514            else if age < 50 then age_category = 3; /* Middle Age */
515            else if age < 65 then age_category = 4; /* Mature */
516            else age_category = 5; /* Senior */
517        
518            /* Risk flags */
519            flag_high_utilization = (credit_utilization > 75);
520            flag_very_high_utilization = (credit_utilization > 100);
521            flag_high_debt_ratio = (debt_ratio > 43);
522            flag_very_high_debt_ratio = (debt_ratio > 60);
523            flag_recent_late_payments = (num_late_30_59 > 0);
524            flag_serious_delinquency = (num_late_90_plus > 0);
525            flag_multiple_delinquencies = (total_late_payments >= 3);
526            flag_low_income = (monthly_income < 2500);
527            flag_many_dependents = (num_dependents >= 3);
528            flag_few_credit_lines = (num_credit_lines <= 2);
529        
530            /* Total risk flags */
531            total_risk_flags = sum(flag_high_utilization, flag_very_high_utilization,
532                                  flag_high_debt_ratio,
533                                  flag_serious_delinquency, flag_multiple_delinquencies,
534                                  flag_low_income, flag_many_dependents,
535                                  flag_few_credit_lines);
536        
537            /* Financial health score (0-100) */
538            financial_health = 100;
539            if credit_utilization > 30 then financial_health = financial_health - 15;
540            if credit_utilization > 75 then financial_health = financial_health - 15;
541            if debt_ratio > 43 then financial_health = financial_health - 20;
542            if has_delinquency then financial_health = financial_health - 20;
543            if num_late_90_plus > 0 then financial_health = financial_health - 30;
544            financial_health = max(0, financial_health);
545        
546            /* Log transformations for skewed variables (add 1 to handle zeros) */
547            log_monthly_income = log(monthly_income + 1);
548            log_num_credit_lines = log(num_credit_lines + 1);
549            log_total_late_payments = log(total_late_payments + 1);
550        
551            /* Interaction features */
552            if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
553            else age_income_interaction = age * log_monthly_income;
554            utilization_debt_interaction = credit_utilization * debt_ratio;
555        
556            /* Cap extreme outliers in credit_utilization and debt_ratio */
557            credit_utilization_capped = min(credit_utilization, 200);
558            debt_ratio_capped = min(debt_ratio, 500);
559        run;
