3983       /* Merge and impute income - rename columns in SQL */
3984       proc sql;
3985           create table work.test_imputed as
3986           select
3987               a.VAR1 as row_id,
3988               a.age,
3989               case when a.MonthlyIncome_missing = 1 then coalesce(b.median_income, b.overall_median_income)
3990                    else a.MonthlyIncome
3991               end as monthly_income,
3992               a.MonthlyIncome_missing,
3993               a.NumberOfDependents as num_dependents,
3994               a.Dependents_missing,
3995               a.age_group,
3996               a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
3997               a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
3998               a.NumberOfTimes90DaysLate as num_late_90_plus,
3999               a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
4000               a.DebtRatio * 100 as debt_ratio,
4001               a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
4002               a.NumberRealEstateLoansOrLines as num_real_estate_loans
4003           from work.test_cleaned a
4004           left join work.train_income_medians b
4005           on a.age_group = b.age_group;
4006       quit;
4007       
4008       /*****************************************************************************
4009        * 3. Feature Engineering (Same as Training)
4010        *****************************************************************************/
4011       
4012       data work.test_features;
4013           set work.test_imputed;
4014       
4015           /* Total late payments across all categories */
4016           total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
4017       
4018           /* Has any delinquency indicator */
4019           has_delinquency = (total_late_payments > 0);
4020       
4021           /* Has serious delinquency (90+ days) */
4022           has_serious_delinquency = (num_late_90_plus > 0);
4023       
4024           /* Credit utilization categories */
4025           if credit_utilization < 30 then credit_util_category = 1;
4026           else if credit_utilization < 50 then credit_util_category = 2;
4027           else if credit_utilization < 75 then credit_util_category = 3;
4028           else credit_util_category = 4;
4029       
4030           /* Debt ratio categories */
4031           if debt_ratio < 30 then debt_category = 1;
4032           else if debt_ratio < 43 then debt_category = 2;
4033           else if debt_ratio < 60 then debt_category = 3;
4034           else debt_category = 4;
4035       
4036           /* Income per dependent */
4037           if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
4038           else income_per_dependent = monthly_income;
4039       
4040           /* Credit lines per person in household */
4041           credit_lines_per_person = num_credit_lines / (num_dependents + 1);
4042       
4043           /* Age categories */
4044           if age < 25 then age_category = 1;
4045           else if age < 35 then age_category = 2;
4046           else if age < 50 then age_category = 3;
4047           else if age < 65 then age_category = 4;
4048           else age_category = 5;
4049       
4050           /* Risk flags */
4051           flag_high_utilization = (credit_utilization > 75);
4052           flag_very_high_utilization = (credit_utilization > 100);
4053           flag_high_debt_ratio = (debt_ratio > 43);
4054           flag_very_high_debt_ratio = (debt_ratio > 60);
4055           flag_recent_late_payments = (num_late_30_59 > 0);
4056           flag_serious_delinquency = (num_late_90_plus > 0);
4057           flag_multiple_delinquencies = (total_late_payments >= 3);
4058           flag_low_income = (monthly_income < 2500);
4059           flag_many_dependents = (num_dependents >= 3);
4060           flag_few_credit_lines = (num_credit_lines <= 2);
4061       
4062           /* Total risk flags */
4063           total_risk_flags = sum(flag_high_utilization, flag_very_high_utilization,
4064                                 flag_high_debt_ratio,
4065                                 flag_serious_delinquency, flag_multiple_delinquencies,
4066                                 flag_low_income, flag_many_dependents,
4067                                 flag_few_credit_lines);
4068       
4069           /* Financial health score */
4070           financial_health = 100;
4071           if credit_utilization > 30 then financial_health = financial_health - 15;
4072           if credit_utilization > 75 then financial_health = financial_health - 15;
4073           if debt_ratio > 43 then financial_health = financial_health - 20;
4074           if has_delinquency then financial_health = financial_health - 20;
4075           if num_late_90_plus > 0 then financial_health = financial_health - 30;
4076           financial_health = max(0, financial_health);
4077       
4078           /* Log transformations */
4079           log_monthly_income = log(monthly_income + 1);
4080           log_num_credit_lines = log(num_credit_lines + 1);
4081           log_total_late_payments = log(total_late_payments + 1);
4082       
4083           /* Interaction features */
4084           if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
4085           else age_income_interaction = age * log_monthly_income;
4086           utilization_debt_interaction = credit_utilization * debt_ratio;
4087       
4088           /* Cap extreme outliers */
4089           credit_utilization_capped = min(credit_utilization, 200);
4090           debt_ratio_capped = min(debt_ratio, 500);
4091       run;
4092       
4093       /*****************************************************************************
4094        * 4. Score Test Set Using Trained Model
4095        *****************************************************************************/
4096       
4097       /* Score test set with trained model */
4098       proc plm restore=work.logit_model;
4099           score data=work.test_features
4100                 out=work.test_scored_temp
4101                 predicted=predicted_logit;
4102       run;
4103       
4104       /* Convert logit to probability */
4105       data work.test_scored;
4106           set work.test_scored_temp;
4107       
4108           /* Apply inverse logit function */
4109           pd_logistic = 1 / (1 + exp(-predicted_logit));
4110       
4111           drop predicted_logit;
4112       run;
4113       
4114       /*****************************************************************************
4115        * 5. Generate Risk Scores and Recommendations
4116        *****************************************************************************/
4117       
4118       data work.test_predictions;
4119           set work.test_scored;
4120       
4121           /* Binary prediction at 0.5 threshold */
4122           pred_logistic = (pd_logistic >= 0.5);
4123       
4124           /* Convert probability to credit risk score (300-850 scale) */
4125           base_score = 600;
4126           score_range = 250;
4127           credit_risk_score = base_score + score_range * (1 - pd_logistic);
4128       
4129           /* Assign risk grades from the probability (a missing probability is graded F) */
4130           if missing(pd_logistic) then risk_grade = 'F';
4131           else if pd_logistic < 0.10 then risk_grade = 'A';
4132           else if pd_logistic < 0.15 then risk_grade = 'B';
4133           else if pd_logistic < 0.25 then risk_grade = 'C';
4134           else if pd_logistic < 0.35 then risk_grade = 'D';
4135           else if pd_logistic <= 0.50 then risk_grade = 'E';
4136           else risk_grade = 'F';
4137       
4138           /* Recommended actions */
4139           if risk_grade in ('A', 'B') then recommendation = 'Approve';
4140           else if risk_grade = 'C' then recommendation = 'Review';
4141           else recommendation = 'Decline';
4142       
4143           /* Suggested interest rate */
4144           base_rate = 0.05;
4145           if risk_grade = 'A' then interest_rate = base_rate;
4146           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
4147           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
4148           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
4149           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
4150           else interest_rate = base_rate + 0.15;
4151       
4152           format interest_rate percent8.2;
4153       run;
4154       
4155       /*****************************************************************************
4156        * 6. Create Output Datasets
4157        *****************************************************************************/
4158       
4159       /* Kaggle submission format (row_id, probability) */
4160       data work.kaggle_submission;
4161           set work.test_predictions;
4162           keep row_id pd_logistic;
4163       run;
4164       
4165       /* Full predictions with all scores and recommendations */
4166       data work.test_predictions_full;
4167           set work.test_predictions;
4168           keep row_id pd_logistic pred_logistic credit_risk_score risk_grade
4169                recommendation interest_rate age monthly_income
4170                credit_utilization debt_ratio total_late_payments
4171                num_credit_lines financial_health total_risk_flags;
4172       run;
4173       
