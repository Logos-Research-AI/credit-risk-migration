3962       data work.test_cleaned;
3963           set work.test_raw_clean;
3964       
3965           /* Create age group for income imputation */
3966           if age < 30 then age_group = 1;
3967           else if age < 40 then age_group = 2;
3968           else if age < 50 then age_group = 3;
3969           else if age < 60 then age_group = 4;
3970           else age_group = 5;
3971       
3972           /* Handle missing values - create flags */
3973           if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
3974           else MonthlyIncome_missing = 0;
3975       
3976           if missing(NumberOfDependents) then do;
3977               NumberOfDependents = 0;
3978               Dependents_missing = 1;
3979           end;
3980           else Dependents_missing = 0;
3981       run;
