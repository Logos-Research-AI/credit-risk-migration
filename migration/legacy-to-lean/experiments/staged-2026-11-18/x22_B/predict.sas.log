3714       
3715       /* How many lines the test file has (counted up to two). The first line is copied to the
3716          work folder with one made-up applicant under it: a value for every name, chosen by the
3717          name and not by its place (NA under the three names that may hold NA, a number under
3718          every other), the same line end */
3719       %let test_lines = 0;
3720       %let header_copy = %sysfunc(pathname(work))/cs-test-header.csv;
3721       
3722       data _null_;
3723           infile "&data_path/cs-test.csv" lrecl=32767 truncover obs=2 length=len;
3724           file "&header_copy" lrecl=131068;
3725           input;
3726           if _n_ = 1 then do;
3727               put _infile_;
3728               do i = 1 to countc(_infile_, ',') + 1;
3729                   if i > 1 then put ',' @;
3730                   if upcase(compress(scan(_infile_, i, ',', 'm'), , 'kn')) in
3731                      ('SERIOUSDLQIN2YRS', 'MONTHLYINCOME', 'NUMBEROFDEPENDENTS') then put 'NA' @;
3732                   else put '1' @;
3733               end;
3734               if len > 0 then if char(_infile_, len) = '0D'x then put '0D'x @;
3735               put;
3736           end;
3737           call symputx('test_lines', _n_);
3738       run;
3739       
3740       /* Import test data. PROC IMPORT cannot read a file that has its header line and no
3741          applicant: PROC IMPORT then reads the copy, so the columns are named as it names them,
3742          and the made-up applicant is removed, which leaves an empty table. The tables an earlier
3743          scoring left in the session are removed first: a step that fails finds no table to use */
3744       %macro import_test;
3745           %local source;
3746           %let source = &data_path/cs-test.csv;
3747           %if &test_lines = 1 %then %do;
3748               %let source = &header_copy;
3749               proc datasets library=work nolist nowarn;
3750                   delete test_raw input_check test_raw_clean test_cleaned test_imputed
3751                          test_features test_scored_temp test_scored test_predictions
3752                          kaggle_submission test_predictions_full;
3753               quit;
3754           %end;
3755           proc import datafile="&source"
3756               out=work.test_raw
3757               dbms=csv
3758               replace;
3759               getnames=yes;
3760               guessingrows=max;
3761           run;
3762           %if &test_lines = 1 and %sysfunc(exist(work.test_raw)) %then %do;
3763               data work.test_raw;
3764                   set work.test_raw;
3765                   stop;
3766               run;
3767           %end;
3768       %mend;
3769       %import_test
