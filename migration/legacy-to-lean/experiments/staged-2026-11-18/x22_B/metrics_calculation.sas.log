2671       
2672       /*****************************************************************************
2673        * 2. ROC Curve and AUC Analysis
2674        *****************************************************************************/
2675       
2676       /* ROC analysis for validation set */
2677       proc logistic data=work.logit_scored_valid;
2678           model default_flag(event='1') = pd_logistic / nofit;
2679           roc 'Logistic Model' pred=pd_logistic;
2680           roccontrast;
2681           ods output ROCAssociation=work.roc_stats;
2682           title "ROC Curve Analysis - Validation Set";
2683       run;
2684       
2685       /* Calculate and display AUC: the exact pairwise AUC of the validation probabilities.
2686          A defaulter/non-defaulter pair is concordant when the defaulter's probability is
2687          higher, and tied only when the two probabilities are equal */
2688       proc sql;
2689           create table work.auc_pairs as
2690           select pd_logistic,
2691                  sum(default_flag = 1) as n_bad,
2692                  sum(default_flag = 0) as n_good
2693           from work.logit_scored_valid
2694           where not missing(pd_logistic)
2695           group by pd_logistic
2696           order by pd_logistic;
2697       quit;
2698       
2699       data work.auc_summary;
2700           length ROCModel $14;
2701           set work.auc_pairs end=eof;
2702           retain concordant tied cum_good cum_bad 0;
2703       
2704           concordant + n_bad * cum_good;
2705           tied + n_bad * n_good;
2706           cum_good + n_good;
2707           cum_bad + n_bad;
2708       
2709           if eof then do;
2710               ROCModel = 'Logistic Model';
2711               if cum_bad * cum_good > 0 then do;
2712                   AUC = (concordant + tied / 2) / (cum_bad * cum_good);
2713                   Gini = 2 * AUC - 1;
2714               end;
2715               output;
2716           end;
2717           keep ROCModel AUC Gini;
2718           format AUC Gini 8.4;
2719       run;
2720       
2721       proc print data=work.auc_summary noobs;
2722           title "Model Performance Metrics - AUC and Gini";
2723       run;
2724       
2725       /*****************************************************************************
2726        * 3. Kolmogorov-Smirnov (KS) Statistic
2727        *****************************************************************************/
2728       
2729       /* Sort by predicted probability */
2730       proc sort data=work.logit_scored_valid;
2731           by pd_logistic;
2732       run;
2733       
2734       /* Calculate total good and bad counts */
2735       proc sql noprint;
2736           select sum(default_flag = 0), sum(default_flag = 1)
2737           into :total_good_count, :total_bad_count
2738           from work.logit_scored_valid;
2739       quit;
2740       
2741       /* Calculate cumulative distributions */
2742       data work.ks_calculation;
2743           set work.logit_scored_valid;
2744           by pd_logistic;
2745           retain cum_good cum_bad;
2746       
2747           if _n_ = 1 then do;
2748               cum_good = 0;
2749               cum_bad = 0;
2750           end;
2751       
2752           if default_flag = 0 then cum_good + 1;
2753           else cum_bad + 1;
2754       
2755           cum_pct_good = cum_good / &total_good_count;
2756           cum_pct_bad = cum_bad / &total_bad_count;
2757           /* Compare the two distributions only after the last applicant of each probability */
2758           if last.pd_logistic then ks_value = abs(cum_pct_good - cum_pct_bad);
2759       run;
2760       
2761       /* Find maximum KS (one row: the lowest cutoff when several attain the maximum) */
2762       proc sql;
2763           create table work.ks_statistic as
2764           select max(ks_value) as KS_Statistic format=8.4,
2765                  min(pd_logistic) as KS_Cutoff format=8.4
2766           from work.ks_calculation
2767           where ks_value = (select max(ks_value) from work.ks_calculation);
2768       quit;
2769       
2770       proc print data=work.ks_statistic noobs;
2771           title "Kolmogorov-Smirnov Statistic";
2772       run;
2773       
2774       /*****************************************************************************
2775        * 4. Confusion Matrix and Accuracy Metrics
2776        *****************************************************************************/
2777       
2778       /* Calculate metrics at different thresholds */
2779       %macro confusion_metrics(threshold, suffix);
2780           data work.confusion_&suffix;
2781               set work.logit_scored_valid;
2782               predicted = (pd_logistic >= &threshold);
2783           run;
2784       
2785           proc freq data=work.confusion_&suffix noprint;
2786               tables default_flag * predicted / out=work.conf_matrix_&suffix;
2787           run;
2788       
2789           /* Calculate metrics */
2790           data work.metrics_&suffix;
2791               set work.conf_matrix_&suffix end=eof;
2792               retain TP TN FP FN 0;
2793       
2794               if default_flag = 1 and predicted = 1 then TP = count;
2795               else if default_flag = 0 and predicted = 0 then TN = count;
2796               else if default_flag = 0 and predicted = 1 then FP = count;
2797               else if default_flag = 1 and predicted = 0 then FN = count;
2798       
2799               if eof then do;
2800                   threshold = &threshold;
2801                   if (TP + TN + FP + FN) > 0 then accuracy = (TP + TN) / (TP + TN + FP + FN);
2802                   else accuracy = .;
2803                   if (TP + FP) > 0 then precision = TP / (TP + FP);
2804                   else precision = .;
2805                   if (TP + FN) > 0 then recall = TP / (TP + FN);
2806                   else recall = .;
2807                   if (precision + recall) > 0 then f1_score = 2 * (precision * recall) / (precision + recall);
2808                   else f1_score = .;
2809                   if (TN + FP) > 0 then specificity = TN / (TN + FP);
2810                   else specificity = .;
2811                   output;
2812               end;
2813               keep threshold accuracy precision recall f1_score specificity;
2814           run;
2815       %mend;
2816       
2817       /* Test multiple thresholds */
2818       %confusion_metrics(0.3, 03);
2819       %confusion_metrics(0.4, 04);
2820       %confusion_metrics(0.5, 05);
2821       %confusion_metrics(0.6, 06);
2822       %confusion_metrics(0.7, 07);
2823       
2824       /* Combine results */
2825       data work.threshold_analysis;
2826           set work.metrics_03 work.metrics_04 work.metrics_05
2827               work.metrics_06 work.metrics_07;
2828       run;
2829       
2830       proc print data=work.threshold_analysis;
2831           title "Performance Metrics at Different Thresholds";
2832           format accuracy precision recall f1_score specificity 8.4;
2833       run;
2834       
2835       /*****************************************************************************
2836        * 5. Decile Analysis and Lift Chart
2837        *****************************************************************************/
2838       
2839       /* Create deciles based on predicted probability */
2840       proc rank data=work.logit_scored_valid
2841                 out=work.decile_data
2842                 groups=10 descending;
2843           var pd_logistic;
2844           ranks decile;
2845       run;
2846       
2847       /* Always ten rows, deciles 1 to 10 */
2848       data work.decile_list;
2849           do decile = 1 to 10;
2850               output;
2851           end;
2852       run;
2853       
2854       /* Calculate lift by decile; a decile that receives no applicant has
2855          count 0, capture rate 0 and lift 0; with no defaulter in the validation set
2856          capture rate and lift are 0 on every decile */
2857       proc sql;
2858           create table work.decile_analysis as
2859           select
2860               l.decile,
2861               coalesce(d.total_count, 0) as total_count,
2862               coalesce(d.defaults, 0) as defaults,
2863               d.default_rate format=percent8.2,
2864               d.avg_pd format=8.4,
2865               d.min_pd format=8.4,
2866               d.max_pd format=8.4,
2867               coalesce(d.capture_rate, 0) as capture_rate format=percent8.2,
2868               coalesce(d.lift, 0) as lift format=8.2
2869           from work.decile_list l
2870           left join
2871               (select
2872                   decile + 1 as decile,
2873                   count(*) as total_count,
2874                   sum(default_flag) as defaults,
2875                   mean(default_flag) as default_rate,
2876                   mean(pd_logistic) as avg_pd,
2877                   min(pd_logistic) as min_pd,
2878                   max(pd_logistic) as max_pd,
2879                   sum(default_flag) / (select sum(default_flag) from work.decile_data) as capture_rate,
2880                   (calculated default_rate) / (select mean(default_flag) from work.decile_data) as lift
2881                from work.decile_data
2882                group by decile) d
2883           on l.decile = d.decile
2884           order by l.decile;
2885       quit;
2886       
2887       proc print data=work.decile_analysis;
2888           title "Decile Analysis - Model Lift and Capture Rate";
2889       run;
2890       
2891       /* Calculate totals for cumulative lift chart */
2892       proc sql noprint;
2893           select sum(default_flag), mean(default_flag)
2894           into :total_defaults, :overall_default_rate
2895           from work.decile_data;
2896       quit;
2897       
2898       /* Create cumulative lift chart */
2899       data work.cumulative_lift;
2900           set work.decile_analysis;
2901           retain cum_defaults cum_count;
2902           if _n_ = 1 then do;
2903               cum_defaults = defaults;
2904               cum_count = total_count;
2905           end;
2906           else do;
2907               cum_defaults + defaults;
2908               cum_count + total_count;
2909           end;
2910       
2911           /* With no defaulter in the validation set both are 0, as in the decile table */
2912           if &total_defaults > 0 then cum_capture_rate = cum_defaults / &total_defaults;
2913           else cum_capture_rate = 0;
2914           /* No cumulative lift while the deciles so far are empty */
2915           if cum_count > 0 then do;
2916               if &overall_default_rate > 0 then cum_lift = (cum_defaults / cum_count) / &overall_default_rate;
2917               else cum_lift = 0;
2918           end;
2919           format cum_capture_rate percent8.2 cum_lift 8.2;
2920       run;
2921       
2922       proc sgplot data=work.cumulative_lift;
2923           series x=decile y=cum_lift;
2924           refline 1 / axis=y;
2925           xaxis label="Decile";
2926           yaxis label="Cumulative Lift";
2927           title "Cumulative Lift Chart";
2928       run;
2929       
2930       /*****************************************************************************
2931        * 6. Population Stability Index (PSI)
2932        *****************************************************************************/
2933       
2934       /* Compare score distributions between training and validation */
2935       
2936       /* Ten bins cut from the training scores: the nine cuts are the nearest-rank
2937          deciles of the training scores (no interpolation) */
2938       proc sort data=work.logit_scored_train(keep=credit_risk_score)
2939                 out=work.train_scores_sorted;
2940           by credit_risk_score;
2941       run;
2942       
2943       data work.psi_cuts;
2944           set work.train_scores_sorted nobs=n_train end=eof;
2945           array cut{9};
2946           retain cut1-cut9;
2947           do k = 1 to 9;
2948               if _n_ = ceil(k * n_train / 10) then cut{k} = credit_risk_score;
2949           end;
2950           if eof then output;
2951           keep cut1-cut9;
2952       run;
2953       
2954       /* Place both sets in the same bins; a score equal to a cut belongs to the lower bin */
2955       data work.train_bins;
2956           if _n_ = 1 then set work.psi_cuts;
2957           set work.logit_scored_train;
2958           array cut{9};
2959           score_bin = 0;
2960           do k = 1 to 9;
2961               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
2962           end;
2963           drop k cut1-cut9;
2964       run;
2965       
2966       data work.valid_bins;
2967           if _n_ = 1 then set work.psi_cuts;
2968           set work.logit_scored_valid;
2969           array cut{9};
2970           score_bin = 0;
2971           do k = 1 to 9;
2972               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
2973           end;
2974           drop k cut1-cut9;
2975       run;
2976       
2977       data work.psi_bins;
2978           do score_bin = 0 to 9;
2979               output;
2980           end;
2981       run;
2982       
2983       /* An empty bin is given a share below that of one applicant, the same on both
2984          sides, so that a bin filled on one side only adds a positive amount */
2985       /* The size of the larger set is carried as a whole number and the share is computed
2986          where it is used, so it is not cut to the 8 characters of a macro variable */
2987       proc sql noprint;
2988           select max(t.n, v.n) format=32. into :psi_rows trimmed
2989           from (select count(*) as n from work.train_bins) t,
2990                (select count(*) as n from work.valid_bins) v;
2991       quit;
2992       %let psi_floor = (0.5 / &psi_rows);
2993       
2994       /* Calculate PSI */
2995       proc sql;
2996           create table work.psi_calculation as
2997           select
2998               s.score_bin,
2999               coalesce(a.train_pct, 0) as train_pct,
3000               coalesce(b.valid_pct, 0) as valid_pct,
3001               (max(calculated train_pct, &psi_floor) - max(calculated valid_pct, &psi_floor))
3002                   * log(max(calculated train_pct, &psi_floor) / max(calculated valid_pct, &psi_floor)) as psi_component
3003           from work.psi_bins s
3004           left join
3005               (select score_bin, count(*) / (select count(*) from work.train_bins) as train_pct
3006                from work.train_bins group by score_bin) a
3007           on s.score_bin = a.score_bin
3008           left join
3009               (select score_bin, count(*) / (select count(*) from work.valid_bins) as valid_pct
3010                from work.valid_bins group by score_bin) b
3011           on s.score_bin = b.score_bin
3012           order by s.score_bin;
3013       
3014           create table work.psi_summary as
3015           select sum(psi_component) as PSI format=best12.,
3016                  case
3017                     when calculated PSI < 0.1 then 'No significant change'
3018                     when calculated PSI < 0.25 then 'Some change'
3019                     else 'Significant change'
3020                  end as PSI_interpretation
3021           from work.psi_calculation;
3022       quit;
3023       
3024       proc print data=work.psi_summary noobs;
3025           title "Population Stability Index";
3026       run;
3027       
3028       /*****************************************************************************
3029        * 7. Calibration Plot
3030        *****************************************************************************/
3031       
3032       /* Bin predictions and compare to actual */
3033       proc rank data=work.logit_scored_valid
3034                 out=work.calibration_data
3035                 groups=20;
3036           var pd_logistic;
3037           ranks pred_bin;
3038       run;
3039       
3040       proc sql;
3041           create table work.calibration_plot as
3042           select
3043               pred_bin,
3044               mean(pd_logistic) as mean_predicted format=8.4,
3045               mean(default_flag) as mean_actual format=8.4,
3046               count(*) as bin_count
3047           from work.calibration_data
3048           group by pred_bin
3049           order by pred_bin;
3050       quit;
3051       
3052       proc sgplot data=work.calibration_plot;
3053           scatter x=mean_predicted y=mean_actual / markerattrs=(size=10);
3054           lineparm x=0 y=0 slope=1 / lineattrs=(pattern=dash);
3055           xaxis label="Mean Predicted Probability";
3056           yaxis label="Mean Actual Default Rate";
3057           title "Calibration Plot - Predicted vs Actual";
3058       run;
3059       
3060       /*****************************************************************************
3061        * 8. Generate Validation Report
3062        *****************************************************************************/
3063       
3064       /* Compile validation metrics */
3065       data work.validation_summary;
3066           merge work.auc_summary
3067                 work.ks_statistic
3068                 work.psi_summary;
3069           length model $20 status $20;
3070           model = "Logistic Regression";
3071       
3072           /* Determine model status based on metrics */
3073           if AUC >= 0.7 and KS_Statistic >= 0.3 and PSI < 0.25 then
3074               status = "Production Ready";
3075           else if AUC >= 0.65 then
3076               status = "Requires Review";
3077           else
3078               status = "Needs Improvement";
3079       run;
3080       
3081       proc print data=work.validation_summary noobs;
3082           title "Model Validation Summary";
3083       run;
