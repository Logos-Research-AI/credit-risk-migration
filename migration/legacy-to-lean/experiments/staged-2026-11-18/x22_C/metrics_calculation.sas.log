2600       /*****************************************************************************
2601        * 2. ROC Curve and AUC Analysis
2602        *****************************************************************************/
2603       
2604       /* ROC analysis for validation set */
2605       proc logistic data=work.logit_scored_valid;
2606           model default_flag(event='1') = pd_logistic / nofit;
2607           roc 'Logistic Model' pred=pd_logistic;
2608           roccontrast;
2609           ods output ROCAssociation=work.roc_stats;
2610           title "ROC Curve Analysis - Validation Set";
2611       run;
2612       
2613       /* Calculate and display AUC: the exact pairwise AUC of the validation probabilities.
2614          A defaulter/non-defaulter pair is concordant when the defaulter's probability is
2615          higher, and tied only when the two probabilities are equal */
2616       proc sql;
2617           create table work.auc_pairs as
2618           select pd_logistic,
2619                  sum(default_flag = 1) as n_bad,
2620                  sum(default_flag = 0) as n_good
2621           from work.logit_scored_valid
2622           where not missing(pd_logistic)
2623           group by pd_logistic
2624           order by pd_logistic;
2625       quit;
2626       
2627       data work.auc_summary;
2628           length ROCModel $14;
2629           set work.auc_pairs end=eof;
2630           retain concordant tied cum_good cum_bad 0;
2631       
2632           concordant + n_bad * cum_good;
2633           tied + n_bad * n_good;
2634           cum_good + n_good;
2635           cum_bad + n_bad;
2636       
2637           if eof then do;
2638               ROCModel = 'Logistic Model';
2639               if cum_bad * cum_good > 0 then do;
2640                   AUC = (concordant + tied / 2) / (cum_bad * cum_good);
2641                   Gini = 2 * AUC - 1;
2642               end;
2643               output;
2644           end;
2645           keep ROCModel AUC Gini;
2646           format AUC Gini 8.4;
2647       run;
2648       
2649       proc print data=work.auc_summary noobs;
2650           title "Model Performance Metrics - AUC and Gini";
2651       run;
2652       
2653       /*****************************************************************************
2654        * 3. Kolmogorov-Smirnov (KS) Statistic
2655        *****************************************************************************/
2656       
2657       /* Sort by predicted probability */
2658       proc sort data=work.logit_scored_valid;
2659           by pd_logistic;
2660       run;
2661       
2662       /* Calculate total good and bad counts */
2663       proc sql noprint;
2664           select sum(default_flag = 0), sum(default_flag = 1)
2665           into :total_good_count, :total_bad_count
2666           from work.logit_scored_valid;
2667       quit;
2668       
2669       /* Calculate cumulative distributions */
2670       data work.ks_calculation;
2671           set work.logit_scored_valid;
2672           by pd_logistic;
2673           retain cum_good cum_bad;
2674       
2675           if _n_ = 1 then do;
2676               cum_good = 0;
2677               cum_bad = 0;
2678           end;
2679       
2680           if default_flag = 0 then cum_good + 1;
2681           else cum_bad + 1;
2682       
2683           cum_pct_good = cum_good / &total_good_count;
2684           cum_pct_bad = cum_bad / &total_bad_count;
2685           /* Compare the two distributions only after the last applicant of each probability */
2686           if last.pd_logistic then ks_value = abs(cum_pct_good - cum_pct_bad);
2687       run;
2688       
2689       /* Find maximum KS (one row: the lowest cutoff when several attain the maximum) */
2690       proc sql;
2691           create table work.ks_statistic as
2692           select max(ks_value) as KS_Statistic format=8.4,
2693                  min(pd_logistic) as KS_Cutoff format=8.4
2694           from work.ks_calculation
2695           where ks_value = (select max(ks_value) from work.ks_calculation);
2696       quit;
2697       
2698       proc print data=work.ks_statistic noobs;
2699           title "Kolmogorov-Smirnov Statistic";
2700       run;
2701       
2702       /*****************************************************************************
2703        * 4. Confusion Matrix and Accuracy Metrics
2704        *****************************************************************************/
2705       
2706       /* Calculate metrics at different thresholds */
2707       %macro confusion_metrics(threshold, suffix);
2708           data work.confusion_&suffix;
2709               set work.logit_scored_valid;
2710               predicted = (pd_logistic >= &threshold);
2711           run;
2712       
2713           proc freq data=work.confusion_&suffix noprint;
2714               tables default_flag * predicted / out=work.conf_matrix_&suffix;
2715           run;
2716       
2717           /* Calculate metrics */
2718           data work.metrics_&suffix;
2719               set work.conf_matrix_&suffix end=eof;
2720               retain TP TN FP FN 0;
2721       
2722               if default_flag = 1 and predicted = 1 then TP = count;
2723               else if default_flag = 0 and predicted = 0 then TN = count;
2724               else if default_flag = 0 and predicted = 1 then FP = count;
2725               else if default_flag = 1 and predicted = 0 then FN = count;
2726       
2727               if eof then do;
2728                   threshold = &threshold;
2729                   if (TP + TN + FP + FN) > 0 then accuracy = (TP + TN) / (TP + TN + FP + FN);
2730                   else accuracy = .;
2731                   if (TP + FP) > 0 then precision = TP / (TP + FP);
2732                   else precision = .;
2733                   if (TP + FN) > 0 then recall = TP / (TP + FN);
2734                   else recall = .;
2735                   if (precision + recall) > 0 then f1_score = 2 * (precision * recall) / (precision + recall);
2736                   else f1_score = .;
2737                   if (TN + FP) > 0 then specificity = TN / (TN + FP);
2738                   else specificity = .;
2739                   output;
2740               end;
2741               keep threshold accuracy precision recall f1_score specificity;
2742           run;
2743       %mend;
2744       
2745       /* Test multiple thresholds */
2746       %confusion_metrics(0.3, 03);
2747       %confusion_metrics(0.4, 04);
2748       %confusion_metrics(0.5, 05);
2749       %confusion_metrics(0.6, 06);
2750       %confusion_metrics(0.7, 07);
2751       
2752       /* Combine results */
2753       data work.threshold_analysis;
2754           set work.metrics_03 work.metrics_04 work.metrics_05
2755               work.metrics_06 work.metrics_07;
2756       run;
2757       
2758       proc print data=work.threshold_analysis;
2759           title "Performance Metrics at Different Thresholds";
2760           format accuracy precision recall f1_score specificity 8.4;
2761       run;
2762       
2763       /*****************************************************************************
2764        * 5. Decile Analysis and Lift Chart
2765        *****************************************************************************/
2766       
2767       /* Create deciles based on predicted probability */
2768       proc rank data=work.logit_scored_valid
2769                 out=work.decile_data
2770                 groups=10 descending;
2771           var pd_logistic;
2772           ranks decile;
2773       run;
2774       
2775       /* Always ten rows, deciles 1 to 10 */
2776       data work.decile_list;
2777           do decile = 1 to 10;
2778               output;
2779           end;
2780       run;
2781       
2782       /* Calculate lift by decile; a decile that receives no applicant has
2783          count 0, capture rate 0 and lift 0; with no defaulter in the validation set
2784          capture rate and lift are 0 on every decile */
2785       proc sql;
2786           create table work.decile_analysis as
2787           select
2788               l.decile,
2789               coalesce(d.total_count, 0) as total_count,
2790               coalesce(d.defaults, 0) as defaults,
2791               d.default_rate format=percent8.2,
2792               d.avg_pd format=8.4,
2793               d.min_pd format=8.4,
2794               d.max_pd format=8.4,
2795               coalesce(d.capture_rate, 0) as capture_rate format=percent8.2,
2796               coalesce(d.lift, 0) as lift format=8.2
2797           from work.decile_list l
2798           left join
2799               (select
2800                   decile + 1 as decile,
2801                   count(*) as total_count,
2802                   sum(default_flag) as defaults,
2803                   mean(default_flag) as default_rate,
2804                   mean(pd_logistic) as avg_pd,
2805                   min(pd_logistic) as min_pd,
2806                   max(pd_logistic) as max_pd,
2807                   sum(default_flag) / (select sum(default_flag) from work.decile_data) as capture_rate,
2808                   (calculated default_rate) / (select mean(default_flag) from work.decile_data) as lift
2809                from work.decile_data
2810                group by decile) d
2811           on l.decile = d.decile
2812           order by l.decile;
2813       quit;
2814       
2815       proc print data=work.decile_analysis;
2816           title "Decile Analysis - Model Lift and Capture Rate";
2817       run;
2818       
2819       /* Calculate totals for cumulative lift chart */
2820       proc sql noprint;
2821           select sum(default_flag), mean(default_flag)
2822           into :total_defaults, :overall_default_rate
2823           from work.decile_data;
2824       quit;
2825       
2826       /* Create cumulative lift chart */
2827       data work.cumulative_lift;
2828           set work.decile_analysis;
2829           retain cum_defaults cum_count;
2830           if _n_ = 1 then do;
2831               cum_defaults = defaults;
2832               cum_count = total_count;
2833           end;
2834           else do;
2835               cum_defaults + defaults;
2836               cum_count + total_count;
2837           end;
2838       
2839           /* With no defaulter in the validation set both are 0, as in the decile table */
2840           if &total_defaults > 0 then cum_capture_rate = cum_defaults / &total_defaults;
2841           else cum_capture_rate = 0;
2842           /* No cumulative lift while the deciles so far are empty */
2843           if cum_count > 0 then do;
2844               if &overall_default_rate > 0 then cum_lift = (cum_defaults / cum_count) / &overall_default_rate;
2845               else cum_lift = 0;
2846           end;
2847           format cum_capture_rate percent8.2 cum_lift 8.2;
2848       run;
2849       
2850       proc sgplot data=work.cumulative_lift;
2851           series x=decile y=cum_lift;
2852           refline 1 / axis=y;
2853           xaxis label="Decile";
2854           yaxis label="Cumulative Lift";
2855           title "Cumulative Lift Chart";
2856       run;
2857       
2858       /*****************************************************************************
2859        * 6. Population Stability Index (PSI)
2860        *****************************************************************************/
2861       
2862       /* Compare score distributions between training and validation */
2863       
2864       /* Ten bins cut from the training scores: the nine cuts are the nearest-rank
2865          deciles of the training scores (no interpolation) */
2866       proc sort data=work.logit_scored_train(keep=credit_risk_score)
2867                 out=work.train_scores_sorted;
2868           by credit_risk_score;
2869       run;
2870       
2871       data work.psi_cuts;
2872           set work.train_scores_sorted nobs=n_train end=eof;
2873           array cut{9};
2874           retain cut1-cut9;
2875           do k = 1 to 9;
2876               if _n_ = ceil(k * n_train / 10) then cut{k} = credit_risk_score;
2877           end;
2878           if eof then output;
2879           keep cut1-cut9;
2880       run;
2881       
2882       /* Place both sets in the same bins; a score equal to a cut belongs to the lower bin */
2883       data work.train_bins;
2884           if _n_ = 1 then set work.psi_cuts;
2885           set work.logit_scored_train;
2886           array cut{9};
2887           score_bin = 0;
2888           do k = 1 to 9;
2889               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
2890           end;
2891           drop k cut1-cut9;
2892       run;
2893       
2894       data work.valid_bins;
2895           if _n_ = 1 then set work.psi_cuts;
2896           set work.logit_scored_valid;
2897           array cut{9};
2898           score_bin = 0;
2899           do k = 1 to 9;
2900               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
2901           end;
2902           drop k cut1-cut9;
2903       run;
2904       
2905       data work.psi_bins;
2906           do score_bin = 0 to 9;
2907               output;
2908           end;
2909       run;
2910       
2911       /* An empty bin is given a share below that of one applicant, the same on both
2912          sides, so that a bin filled on one side only adds a positive amount */
2913       /* The size of the larger set is carried as a whole number and the share is computed
2914          where it is used, so it is not cut to the 8 characters of a macro variable */
2915       proc sql noprint;
2916           select max(t.n, v.n) format=32. into :psi_rows trimmed
2917           from (select count(*) as n from work.train_bins) t,
2918                (select count(*) as n from work.valid_bins) v;
2919       quit;
2920       %let psi_floor = (0.5 / &psi_rows);
2921       
2922       /* Calculate PSI */
2923       proc sql;
2924           create table work.psi_calculation as
2925           select
2926               s.score_bin,
2927               coalesce(a.train_pct, 0) as train_pct,
2928               coalesce(b.valid_pct, 0) as valid_pct,
2929               (max(calculated train_pct, &psi_floor) - max(calculated valid_pct, &psi_floor))
2930                   * log(max(calculated train_pct, &psi_floor) / max(calculated valid_pct, &psi_floor)) as psi_component
2931           from work.psi_bins s
2932           left join
2933               (select score_bin, count(*) / (select count(*) from work.train_bins) as train_pct
2934                from work.train_bins group by score_bin) a
2935           on s.score_bin = a.score_bin
2936           left join
2937               (select score_bin, count(*) / (select count(*) from work.valid_bins) as valid_pct
2938                from work.valid_bins group by score_bin) b
2939           on s.score_bin = b.score_bin
2940           order by s.score_bin;
2941       
2942           create table work.psi_summary as
2943           select sum(psi_component) as PSI format=best12.,
2944                  case
2945                     when calculated PSI < 0.1 then 'No significant change'
2946                     when calculated PSI < 0.25 then 'Some change'
2947                     else 'Significant change'
2948                  end as PSI_interpretation
2949           from work.psi_calculation;
2950       quit;
2951       
2952       proc print data=work.psi_summary noobs;
2953           title "Population Stability Index";
2954       run;
2955       
2956       /*****************************************************************************
2957        * 7. Calibration Plot
2958        *****************************************************************************/
2959       
2960       /* Bin predictions and compare to actual */
2961       proc rank data=work.logit_scored_valid
2962                 out=work.calibration_data
2963                 groups=20;
2964           var pd_logistic;
2965           ranks pred_bin;
2966       run;
2967       
2968       proc sql;
2969           create table work.calibration_plot as
2970           select
2971               pred_bin,
2972               mean(pd_logistic) as mean_predicted format=8.4,
2973               mean(default_flag) as mean_actual format=8.4,
2974               count(*) as bin_count
2975           from work.calibration_data
2976           group by pred_bin
2977           order by pred_bin;
2978       quit;
2979       
2980       proc sgplot data=work.calibration_plot;
2981           scatter x=mean_predicted y=mean_actual / markerattrs=(size=10);
2982           lineparm x=0 y=0 slope=1 / lineattrs=(pattern=dash);
2983           xaxis label="Mean Predicted Probability";
2984           yaxis label="Mean Actual Default Rate";
2985           title "Calibration Plot - Predicted vs Actual";
2986       run;
