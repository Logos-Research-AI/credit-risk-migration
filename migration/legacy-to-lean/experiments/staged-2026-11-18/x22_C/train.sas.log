1510           merge work.roc_train(where=(ROCModel='Training Set') rename=(Area=Train_AUC))
1511                 work.roc_valid(where=(ROCModel='Validation Set') rename=(Area=Valid_AUC))
1512                 work.training_metrics
1513                 work.validation_metrics;
1514       
1515           model_name = "Logistic Regression";
1516           training_date = today();
1517           training_records = 105000; /* Approximate 70% of 150K */
1518           validation_records = 45000; /* Approximate 30% of 150K */
1519       
1520           format training_date date9.
1521                  Train_AUC Valid_AUC
1522                  train_precision train_recall train_f1_score train_accuracy
1523                  valid_precision valid_recall valid_f1_score valid_accuracy 8.4;
1524           keep model_name training_date training_records validation_records
1525                Train_AUC Valid_AUC
1526                train_precision train_recall train_f1_score train_accuracy
