706        /*****************************************************************************
707         * 3. Evaluate Model on Training Data
708         *****************************************************************************/
709        
710        /* Add binary prediction variable */
711        data work.logit_scored_train;
712            set work.logit_scored_train;
713            pred_logistic = (pd_logistic >= 0.5);
714        run;
715        
716        /* Confusion matrix on training set */
717        proc freq data=work.logit_scored_train noprint;
718            tables default_flag * pred_logistic / out=work.confusion_matrix_train;
719        run;
720        
721        proc print data=work.confusion_matrix_train;
722            title "Confusion Matrix - Training Set";
723        run;
724        
725        /* Calculate precision, recall, and F1 score for training set */
726        data work.training_metrics;
727            set work.confusion_matrix_train end=eof;
728            retain TP TN FP FN 0;
729        
730            if default_flag = 1 and pred_logistic = 1 then TP = count;
731            else if default_flag = 0 and pred_logistic = 0 then TN = count;
732            else if default_flag = 0 and pred_logistic = 1 then FP = count;
733            else if default_flag = 1 and pred_logistic = 0 then FN = count;
734        
735            if eof then do;
736                if (TP + FP) > 0 then train_precision = TP / (TP + FP);
737                else train_precision = .;
738                if (TP + FN) > 0 then train_recall = TP / (TP + FN);
739                else train_recall = .;
740                if (train_precision + train_recall) > 0 then train_f1_score = 2 * (train_precision * train_recall) /
740      ! (train_precision + train_recall);
741                else train_f1_score = .;
742                if (TP + TN + FP + FN) > 0 then train_accuracy = (TP + TN) / (TP + TN + FP + FN);
743                else train_accuracy = .;
744                output;
745            end;
746            keep train_precision train_recall train_f1_score train_accuracy;
747        run;
748        
749        proc print data=work.training_metrics;
750            title "Training Set - Performance Metrics";
751            format train_precision train_recall train_f1_score train_accuracy 8.4;
752        run;
753        
754        /*****************************************************************************
755         * 4. Score Validation Set
756         *****************************************************************************/
757        
758        /* Score validation set with trained model */
759        proc plm restore=work.logit_model;
760            score data=work.model_features_validation
761                  out=work.logit_scored_valid_temp
762                  predicted=predicted_logit;
763        run;
764        
765        /* Convert logit to probability */
766        data work.logit_scored_valid;
767            set work.logit_scored_valid_temp;
768        
769            /* Apply inverse logit (logistic) function */
770            pd_logistic = 1 / (1 + exp(-predicted_logit));
771        
772            /* Add binary prediction */
773            pred_logistic = (pd_logistic >= 0.5);
774        
775            drop predicted_logit;
776        run;
777        
778        /* Confusion matrix on validation set */
779        proc freq data=work.logit_scored_valid noprint;
780            tables default_flag * pred_logistic / out=work.confusion_matrix;
781        run;
782        
783        proc print data=work.confusion_matrix;
784            title "Confusion Matrix - Validation Set";
785        run;
786        
787        /* Calculate precision, recall, and F1 score for validation set */
788        data work.validation_metrics;
789            set work.confusion_matrix end=eof;
790            retain TP TN FP FN 0;
791        
792            if default_flag = 1 and pred_logistic = 1 then TP = count;
793            else if default_flag = 0 and pred_logistic = 0 then TN = count;
794            else if default_flag = 0 and pred_logistic = 1 then FP = count;
795            else if default_flag = 1 and pred_logistic = 0 then FN = count;
796        
797            if eof then do;
798                if (TP + FP) > 0 then valid_precision = TP / (TP + FP);
799                else valid_precision = .;
800                if (TP + FN) > 0 then valid_recall = TP / (TP + FN);
801                else valid_recall = .;
802                if (valid_precision + valid_recall) > 0 then valid_f1_score = 2 * (valid_precision * valid_recall) /
802      ! (valid_precision + valid_recall);
803                else valid_f1_score = .;
804                if (TP + TN + FP + FN) > 0 then valid_accuracy = (TP + TN) / (TP + TN + FP + FN);
805                else valid_accuracy = .;
806                output;
807            end;
808            keep valid_precision valid_recall valid_f1_score valid_accuracy;
809        run;
810        
811        proc print data=work.validation_metrics;
812            title "Validation Set - Performance Metrics";
813            format valid_precision valid_recall valid_f1_score valid_accuracy 8.4;
814        run;
815        
816        /*****************************************************************************
817         * 5. Create Risk Scores and Grades
818         *****************************************************************************/
819        
820        /* Generate risk scores for training set */
821        data work.risk_scores_train;
822            set work.logit_scored_train;
823        
824            /* Convert probability to credit risk score (300-850 scale like FICO) */
825            base_score = 600;
826            score_range = 250;
827            credit_risk_score = base_score + score_range * (1 - pd_logistic);
828        
829            /* Assign risk grades from the probability (a missing probability is graded F) */
830            if missing(pd_logistic) then risk_grade = 'F';
831            else if pd_logistic < 0.10 then risk_grade = 'A';
832            else if pd_logistic < 0.15 then risk_grade = 'B';
833            else if pd_logistic < 0.25 then risk_grade = 'C';
834            else if pd_logistic < 0.35 then risk_grade = 'D';
835            else if pd_logistic <= 0.50 then risk_grade = 'E';
836            else risk_grade = 'F';
837        
838            /* Recommended actions */
839            if risk_grade in ('A', 'B') then recommendation = 'Approve';
840            else if risk_grade = 'C' then recommendation = 'Review';
841            else recommendation = 'Decline';
842        
843            /* Suggested interest rate (risk-based pricing) */
844            base_rate = 0.05;
845            if risk_grade = 'A' then interest_rate = base_rate;
846            else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
847            else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
848            else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
849            else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
850            else interest_rate = base_rate + 0.15;
851        
852            format interest_rate percent8.2;
853        run;
854        
855        /* Generate risk scores for validation set */
856        data work.risk_scores_validation;
857            set work.logit_scored_valid;
858        
859            /* Same scoring logic as training */
860            base_score = 600;
861            score_range = 250;
862            credit_risk_score = base_score + score_range * (1 - pd_logistic);
863        
864            if missing(pd_logistic) then risk_grade = 'F';
865            else if pd_logistic < 0.10 then risk_grade = 'A';
866            else if pd_logistic < 0.15 then risk_grade = 'B';
867            else if pd_logistic < 0.25 then risk_grade = 'C';
868            else if pd_logistic < 0.35 then risk_grade = 'D';
869            else if pd_logistic <= 0.50 then risk_grade = 'E';
870            else risk_grade = 'F';
871        
872            if risk_grade in ('A', 'B') then recommendation = 'Approve';
873            else if risk_grade = 'C' then recommendation = 'Review';
874            else recommendation = 'Decline';
875        
876            base_rate = 0.05;
877            if risk_grade = 'A' then interest_rate = base_rate;
878            else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
879            else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
880            else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
881            else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
882            else interest_rate = base_rate + 0.15;
883        
884            format interest_rate percent8.2;
885        run;
886        
887        /* Risk grade distribution */
888        proc freq data=work.risk_scores_train;
889            tables risk_grade * default_flag / nocol nopercent;
890            title "Default Rate by Risk Grade - Training Set";
891        run;
892        
893        proc freq data=work.risk_scores_validation;
894            tables risk_grade * default_flag / nocol nopercent;
895            title "Default Rate by Risk Grade - Validation Set";
896        run;
897        
898        /*****************************************************************************
899         * 6. ROC Curve and AUC
900         *****************************************************************************/
901        
902        /* ROC analysis for training set */
903        proc logistic data=work.risk_scores_train;
904            model default_flag(event='1') = pd_logistic / nofit;
905            roc 'Training Set' pred=pd_logistic;
906            ods output ROCAssociation=work.roc_train;
907            title "ROC Curve - Training Set";
908        run;
909        
910        /* ROC analysis for validation set */
911        proc logistic data=work.risk_scores_validation;
912            model default_flag(event='1') = pd_logistic / nofit;
913            roc 'Validation Set' pred=pd_logistic;
914            ods output ROCAssociation=work.roc_valid;
915            title "ROC Curve - Validation Set";
916        run;
917        
918        /* Display AUC */
919        proc print data=work.roc_train;
920            where ROCModel = 'Training Set';
921            var Area;
922            title "Training Set AUC";
923        run;
924        
925        proc print data=work.roc_valid;
926            where ROCModel = 'Validation Set';
927            var Area;
928            title "Validation Set AUC";
929        run;
