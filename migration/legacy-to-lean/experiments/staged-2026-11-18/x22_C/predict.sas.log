3642       
3643       /* How many lines the test file has (counted up to two). The first line is copied to the
3644          work folder with one made-up applicant under it: a value for every name, chosen by the
3645          name and not by its place (NA under the three names that may hold NA, a number under
3646          every other), the same line end */
3647       %let test_lines = 0;
3648       %let header_copy = %sysfunc(pathname(work))/cs-test-header.csv;
3649       
3650       data _null_;
3651           infile "&data_path/cs-test.csv" lrecl=32767 truncover obs=2 length=len;
3652           file "&header_copy" lrecl=131068;
3653           input;
3654           if _n_ = 1 then do;
3655               put _infile_;
3656               do i = 1 to countc(_infile_, ',') + 1;
3657                   if i > 1 then put ',' @;
3658                   if upcase(compress(scan(_infile_, i, ',', 'm'), , 'kn')) in
3659                      ('SERIOUSDLQIN2YRS', 'MONTHLYINCOME', 'NUMBEROFDEPENDENTS') then put 'NA' @;
3660                   else put '1' @;
3661               end;
3662               if len > 0 then if char(_infile_, len) = '0D'x then put '0D'x @;
3663               put;
3664           end;
3665           call symputx('test_lines', _n_);
3666       run;
3667       
3668       /* Import test data. PROC IMPORT cannot read a file that has its header line and no
3669          applicant: PROC IMPORT then reads the copy, so the columns are named as it names them,
3670          and the made-up applicant is removed, which leaves an empty table. The tables an earlier
3671          scoring left in the session are removed first: a step that fails finds no table to use */
3672       %macro import_test;
3673           %local source;
3674           %let source = &data_path/cs-test.csv;
3675           %if &test_lines = 1 %then %do;
3676               %let source = &header_copy;
3677               proc datasets library=work nolist nowarn;
3678                   delete test_raw input_check test_raw_clean test_cleaned test_imputed
3679                          test_features test_scored_temp test_scored test_predictions
3680                          kaggle_submission test_predictions_full;
3681               quit;
3682           %end;
3683           proc import datafile="&source"
3684               out=work.test_raw
3685               dbms=csv
3686               replace;
3687               getnames=yes;
3688               guessingrows=max;
3689           run;
3690           %if &test_lines = 1 and %sysfunc(exist(work.test_raw)) %then %do;
3691               data work.test_raw;
3692                   set work.test_raw;
3693                   stop;
3694               run;
3695           %end;
3696       %mend;
