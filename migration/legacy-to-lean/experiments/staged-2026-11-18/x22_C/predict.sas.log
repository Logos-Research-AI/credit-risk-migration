3911       /* Merge and impute income - rename columns in SQL */
3912       proc sql;
3913           create table work.test_imputed as
3914           select
3915               a.VAR1 as row_id,
3916               a.age,
3917               case when a.MonthlyIncome_missing = 1 then coalesce(b.median_income, b.overall_median_income)
3918                    else a.MonthlyIncome
3919               end as monthly_income,
3920               a.MonthlyIncome_missing,
3921               a.NumberOfDependents as num_dependents,
3922               a.Dependents_missing,
3923               a.age_group,
3924               a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
3925               a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
3926               a.NumberOfTimes90DaysLate as num_late_90_plus,
3927               a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
3928               a.DebtRatio * 100 as debt_ratio,
3929               a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
3930               a.NumberRealEstateLoansOrLines as num_real_estate_loans
3931           from work.test_cleaned a
3932           left join work.train_income_medians b
3933           on a.age_group = b.age_group;
3934       quit;
3935       
3936       /*****************************************************************************
3937        * 3. Feature Engineering (Same as Training)
3938        *****************************************************************************/
3939       
3940       data work.test_features;
3941           set work.test_imputed;
3942       
3943           /* Total late payments across all categories */
3944           total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
3945       
3946           /* Has any delinquency indicator */
3947           has_delinquency = (total_late_payments > 0);
3948       
3949           /* Has serious delinquency (90+ days) */
3950           has_serious_delinquency = (num_late_90_plus > 0);
3951       
3952           /* Credit utilization categories */
3953           if credit_utilization < 30 then credit_util_category = 1;
3954           else if credit_utilization < 50 then credit_util_category = 2;
3955           else if credit_utilization < 75 then credit_util_category = 3;
3956           else credit_util_category = 4;
3957       
3958           /* Debt ratio categories */
3959           if debt_ratio < 30 then debt_category = 1;
3960           else if debt_ratio < 43 then debt_category = 2;
3961           else if debt_ratio < 60 then debt_category = 3;
3962           else debt_category = 4;
3963       
3964           /* Income per dependent */
3965           if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
3966           else income_per_dependent = monthly_income;
3967       
3968           /* Credit lines per person in household */
3969           credit_lines_per_person = num_credit_lines / (num_dependents + 1);
3970       
3971           /* Age categories */
3972           if age < 25 then age_category = 1;
3973           else if age < 35 then age_category = 2;
3974           else if age < 50 then age_category = 3;
3975           else if age < 65 then age_category = 4;
3976           else age_category = 5;
3977       
3978           /* Risk flags */
3979           flag_high_utilization = (credit_utilization > 75);
3980           flag_very_high_utilization = (credit_utilization > 100);
3981           flag_high_debt_ratio = (debt_ratio > 43);
3982           flag_very_high_debt_ratio = (debt_ratio > 60);
3983           flag_recent_late_payments = (num_late_30_59 > 0);
3984           flag_serious_delinquency = (num_late_90_plus > 0);
3985           flag_multiple_delinquencies = (total_late_payments >= 3);
3986           flag_low_income = (monthly_income < 2500);
3987           flag_many_dependents = (num_dependents >= 3);
3988           flag_few_credit_lines = (num_credit_lines <= 2);
3989       
3990           /* Total risk flags */
3991           total_risk_flags = sum(flag_high_utilization, flag_very_high_utilization,
3992                                 flag_high_debt_ratio,
3993                                 flag_serious_delinquency, flag_multiple_delinquencies,
3994                                 flag_low_income, flag_many_dependents,
3995                                 flag_few_credit_lines);
3996       
3997           /* Financial health score */
3998           financial_health = 100;
3999           if credit_utilization > 30 then financial_health = financial_health - 15;
4000           if credit_utilization > 75 then financial_health = financial_health - 15;
4001           if debt_ratio > 43 then financial_health = financial_health - 20;
4002           if has_delinquency then financial_health = financial_health - 20;
4003           if num_late_90_plus > 0 then financial_health = financial_health - 30;
4004           financial_health = max(0, financial_health);
4005       
4006           /* Log transformations */
4007           log_monthly_income = log(monthly_income + 1);
4008           log_num_credit_lines = log(num_credit_lines + 1);
4009           log_total_late_payments = log(total_late_payments + 1);
4010       
4011           /* Interaction features */
4012           if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
4013           else age_income_interaction = age * log_monthly_income;
4014           utilization_debt_interaction = credit_utilization * debt_ratio;
4015       
4016           /* Cap extreme outliers */
4017           credit_utilization_capped = min(credit_utilization, 200);
4018           debt_ratio_capped = min(debt_ratio, 500);
4019       run;
4020       
4021       /*****************************************************************************
4022        * 4. Score Test Set Using Trained Model
4023        *****************************************************************************/
4024       
4025       /* Score test set with trained model */
4026       proc plm restore=work.logit_model;
4027           score data=work.test_features
4028                 out=work.test_scored_temp
4029                 predicted=predicted_logit;
4030       run;
4031       
4032       /* Convert logit to probability */
4033       data work.test_scored;
4034           set work.test_scored_temp;
4035       
4036           /* Apply inverse logit function */
4037           pd_logistic = 1 / (1 + exp(-predicted_logit));
4038       
4039           drop predicted_logit;
4040       run;
4041       
4042       /*****************************************************************************
4043        * 5. Generate Risk Scores and Recommendations
4044        *****************************************************************************/
4045       
4046       data work.test_predictions;
4047           set work.test_scored;
4048       
4049           /* Binary prediction at 0.5 threshold */
4050           pred_logistic = (pd_logistic >= 0.5);
4051       
4052           /* Convert probability to credit risk score (300-850 scale) */
4053           base_score = 600;
4054           score_range = 250;
4055           credit_risk_score = base_score + score_range * (1 - pd_logistic);
4056       
4057           /* Assign risk grades from the probability (a missing probability is graded F) */
4058           if missing(pd_logistic) then risk_grade = 'F';
4059           else if pd_logistic < 0.10 then risk_grade = 'A';
4060           else if pd_logistic < 0.15 then risk_grade = 'B';
4061           else if pd_logistic < 0.25 then risk_grade = 'C';
4062           else if pd_logistic < 0.35 then risk_grade = 'D';
4063           else if pd_logistic <= 0.50 then risk_grade = 'E';
4064           else risk_grade = 'F';
4065       
4066           /* Recommended actions */
4067           if risk_grade in ('A', 'B') then recommendation = 'Approve';
4068           else if risk_grade = 'C' then recommendation = 'Review';
4069           else recommendation = 'Decline';
4070       
4071           /* Suggested interest rate */
4072           base_rate = 0.05;
4073           if risk_grade = 'A' then interest_rate = base_rate;
4074           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
4075           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
4076           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
4077           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
4078           else interest_rate = base_rate + 0.15;
4079       
4080           format interest_rate percent8.2;
4081       run;
4082       
4083       /*****************************************************************************
4084        * 6. Create Output Datasets
4085        *****************************************************************************/
4086       
4087       /* Kaggle submission format (row_id, probability) */
4088       data work.kaggle_submission;
4089           set work.test_predictions;
4090           keep row_id pd_logistic;
4091       run;
4092       
4093       /* Full predictions with all scores and recommendations */
4094       data work.test_predictions_full;
4095           set work.test_predictions;
4096           keep row_id pd_logistic pred_logistic credit_risk_score risk_grade
4097                recommendation interest_rate age monthly_income
4098                credit_utilization debt_ratio total_late_payments
4099                num_credit_lines financial_health total_risk_flags;
4100       run;
