3890       data work.test_cleaned;
3891           set work.test_raw_clean;
3892       
3893           /* Create age group for income imputation */
3894           if age < 30 then age_group = 1;
3895           else if age < 40 then age_group = 2;
3896           else if age < 50 then age_group = 3;
3897           else if age < 60 then age_group = 4;
3898           else age_group = 5;
3899       
3900           /* Handle missing values - create flags */
3901           if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
3902           else MonthlyIncome_missing = 0;
3903       
3904           if missing(NumberOfDependents) then do;
3905               NumberOfDependents = 0;
3906               Dependents_missing = 1;
3907           end;
3908           else Dependents_missing = 0;
3909       run;
