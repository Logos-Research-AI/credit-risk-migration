1957       data work.x25_t;
1958           length risk_grade $1 recommendation $7;
1959           format row_id default_flag best12.;
1960           do row_id = 1 to 30;
1961               default_flag = (mod(row_id, 7) = 0);
1962               if row_id <= 25 then do; pd_logistic = 0.2 + row_id * 1e-13; risk_grade = 'C'; end;
1963               else if row_id = 26 then do; pd_logistic = 1 / 30; risk_grade = 'A'; end;
1964               else if row_id = 27 then do; pd_logistic = 0.3; risk_grade = 'D'; end;
1965               else if row_id = 28 then do; pd_logistic = 2 / 3; risk_grade = 'F'; end;
1966               else if row_id = 29 then do; pd_logistic = 0.12; risk_grade = 'B'; end;
1967               else do; pd_logistic = 0.4; risk_grade = 'E'; end;
1968               credit_risk_score = 600 + 250 * (1 - pd_logistic);
1969               if risk_grade in ('A', 'B') then recommendation = 'Approve';
1970               else if risk_grade = 'C' then recommendation = 'Review';
1971               else recommendation = 'Decline';
1972               base_rate = 0.05;
1973               if risk_grade = 'A' then interest_rate = base_rate;
1974               else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
1975               else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
1976               else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
1977               else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
1978               else interest_rate = base_rate + 0.15;
1979               output;
1980           end;
1981           format interest_rate percent8.2;
1982       run;
