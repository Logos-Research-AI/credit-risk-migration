472         * 6. Export Engineered Features
473         *****************************************************************************/
474        
475        /* Ensure all variables are numeric before export */
476        data work.credit_train_export;
477            set work.credit_train;
478            /* Force numeric format for all variables */
479            format _numeric_ best12.;
480        run;
481        
482        data work.credit_validation_export;
483            set work.credit_validation;
484            /* Force numeric format for all variables */
485            format _numeric_ best12.;
486        run;
487        
488        /* Export the training income medians (per age group, and overall):
489           predict.sas imputes the test set from them */
