2492       /* Check the input conditions: stop with an error before anything is exported */
2493       /* The numeric value of a raw column: a numeric column as it is; a character column
2494          read as a number, missing when the text is no number or is longer than 32 characters */
2495       %macro num(v);
2496           %local dsid pos vtype;
2497           %let vtype = ;
2498           %let dsid = %sysfunc(open(work.credit_raw));
2499           %let pos = %sysfunc(varnum(&dsid, &v));
2500           %if &pos > 0 %then %let vtype = %sysfunc(vartype(&dsid, &pos));
2501           %let dsid = %sysfunc(close(&dsid));
2502           %if &vtype = N %then "&v"n;
2503           %else ifn(lengthn(strip("&v"n)) <= 32, input(strip("&v"n), ?? best32.), .);
2504       %mend;
2505       
2506       %let columns_ok = 0;
2507       %let bad_rows = 1;
2508       %let duplicate_ids = 1;
2509       %let known_incomes = 0;
