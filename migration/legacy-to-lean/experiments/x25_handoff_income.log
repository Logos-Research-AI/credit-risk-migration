6279       
6280       data work.test_cleaned;
6281           set work.test_raw_clean;
6282       
6283           /* Create age group for income imputation */
6284           if age < 30 then age_group = 1;
6285           else if age < 40 then age_group = 2;
6286           else if age < 50 then age_group = 3;
6287           else if age < 60 then age_group = 4;
6288           else age_group = 5;
6289       
6290           /* Handle missing values - create flags */
6291           if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
6292           else MonthlyIncome_missing = 0;
6293       
6294           if missing(NumberOfDependents) then do;
6295               NumberOfDependents = 0;
6296               Dependents_missing = 1;
6297           end;
6298           else Dependents_missing = 0;
6299       run;
6300       
6301       /* Merge and impute income - rename columns in SQL */
6302       proc sql;
6303           create table work.test_imputed as
6304           select
6305               a.VAR1 as row_id,
6306               a.age,
6307               case when a.MonthlyIncome_missing = 1 then coalesce(b.median_income, b.overall_median_income)
6308                    else a.MonthlyIncome
6309               end as monthly_income,
6310               a.MonthlyIncome_missing,
6311               a.NumberOfDependents as num_dependents,
6312               a.Dependents_missing,
6313               a.age_group,
6314               a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
6315               a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
6316               a.NumberOfTimes90DaysLate as num_late_90_plus,
6317               a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
6318               a.DebtRatio * 100 as debt_ratio,
6319               a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
6320               a.NumberRealEstateLoansOrLines as num_real_estate_loans
6321           from work.test_cleaned a
6322           left join work.train_income_medians b
6323           on a.age_group = b.age_group;
6324       quit;
6325       
6326       /*****************************************************************************
6327        * 3. Feature Engineering (Same as Training)
6328        *****************************************************************************/
6329       
6330       data work.test_features;
6331           set work.test_imputed;
6332       
6333           /* Total late payments across all categories */
6334           total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
6335       
6336           /* Has any delinquency indicator */
6337           has_delinquency = (total_late_payments > 0);
6338       
6339           /* Has serious delinquency (90+ days) */
6340           has_serious_delinquency = (num_late_90_plus > 0);
6341       
6342           /* Credit utilization categories */
6343           if credit_utilization < 30 then credit_util_category = 1;
6344           else if credit_utilization < 50 then credit_util_category = 2;
6345           else if credit_utilization < 75 then credit_util_category = 3;
6346           else credit_util_category = 4;
6347       
6348           /* Debt ratio categories */
6349           if debt_ratio < 30 then debt_category = 1;
6350           else if debt_ratio < 43 then debt_category = 2;
6351           else if debt_ratio < 60 then debt_category = 3;
6352           else debt_category = 4;
6353       
6354           /* Income per dependent */
6355           if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
6356           else income_per_dependent = monthly_income;
6357       
6358           /* Credit lines per person in household */
6359           credit_lines_per_person = num_credit_lines / (num_dependents + 1);
6360       
6361           /* Age categories */
6362           if age < 25 then age_category = 1;
6363           else if age < 35 then age_category = 2;
6364           else if age < 50 then age_category = 3;
6365           else if age < 65 then age_category = 4;
6366           else age_category = 5;
6367       
6368           /* Risk flags */
6369           flag_high_utilization = (credit_utilization > 75);
6370           flag_very_high_utilization = (credit_utilization > 100);
6371           flag_high_debt_ratio = (debt_ratio > 43);
6372           flag_very_high_debt_ratio = (debt_ratio > 60);
6373           flag_recent_late_payments = (num_late_30_59 > 0);
6374           flag_serious_delinquency = (num_late_90_plus > 0);
6375           flag_multiple_delinquencies = (total_late_payments >= 3);
6376           flag_low_income = (monthly_income < 2500);
6377           flag_many_dependents = (num_dependents >= 3);
6378           flag_few_credit_lines = (num_credit_lines <= 2);
6379       
6380           /* Total risk flags */
6381           total_risk_flags = sum(flag_high_utilization, flag_very_high_utilization,
6382                                 flag_high_debt_ratio,
6383                                 flag_serious_delinquency, flag_multiple_delinquencies,
6384                                 flag_low_income, flag_many_dependents,
6385                                 flag_few_credit_lines);
6386       
6387           /* Financial health score */
6388           financial_health = 100;
6389           if credit_utilization > 30 then financial_health = financial_health - 15;
6390           if credit_utilization > 75 then financial_health = financial_health - 15;
6391           if debt_ratio > 43 then financial_health = financial_health - 20;
6392           if has_delinquency then financial_health = financial_health - 20;
6393           if num_late_90_plus > 0 then financial_health = financial_health - 30;
6394           financial_health = max(0, financial_health);
6395       
6396           /* Log transformations */
6397           log_monthly_income = log(monthly_income + 1);
6398           log_num_credit_lines = log(num_credit_lines + 1);
6399           log_total_late_payments = log(total_late_payments + 1);
6400       
6401           /* Interaction features */
6402           if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
6403           else age_income_interaction = age * log_monthly_income;
6404           utilization_debt_interaction = credit_utilization * debt_ratio;
6405       
6406           /* Cap extreme outliers */
6407           credit_utilization_capped = min(credit_utilization, 200);
6408           debt_ratio_capped = min(debt_ratio, 500);
6409       run;
6410       
6411       /*****************************************************************************
6412        * 4. Score Test Set Using Trained Model
6413        *****************************************************************************/
6414       
6415       /* Score test set with trained model */
6416       proc plm restore=work.logit_model;
6417           score data=work.test_features
6418                 out=work.test_scored_temp
6419                 predicted=predicted_logit;
6420       run;
6421       
6422       /* Convert logit to probability */
6423       data work.test_scored;
6424           set work.test_scored_temp;
6425       
6426           /* Apply inverse logit function */
6427           pd_logistic = 1 / (1 + exp(-predicted_logit));
6428       
6429           drop predicted_logit;
6430       run;
6431       
6432       /*****************************************************************************
6433        * 5. Generate Risk Scores and Recommendations
6434        *****************************************************************************/
6435       
6436       data work.test_predictions;
6437           set work.test_scored;
6438       
6439           /* Binary prediction at 0.5 threshold */
6440           pred_logistic = (pd_logistic >= 0.5);
6441       
6442           /* Convert probability to credit risk score (300-850 scale) */
6443           base_score = 600;
6444           score_range = 250;
6445           credit_risk_score = base_score + score_range * (1 - pd_logistic);
6446       
6447           /* Assign risk grades from the probability (a missing probability is graded F) */
6448           if missing(pd_logistic) then risk_grade = 'F';
6449           else if pd_logistic < 0.10 then risk_grade = 'A';
6450           else if pd_logistic < 0.15 then risk_grade = 'B';
6451           else if pd_logistic < 0.25 then risk_grade = 'C';
6452           else if pd_logistic < 0.35 then risk_grade = 'D';
6453           else if pd_logistic <= 0.50 then risk_grade = 'E';
6454           else risk_grade = 'F';
6455       
6456           /* Recommended actions */
6457           if risk_grade in ('A', 'B') then recommendation = 'Approve';
6458           else if risk_grade = 'C' then recommendation = 'Review';
6459           else recommendation = 'Decline';
6460       
6461           /* Suggested interest rate */
6462           base_rate = 0.05;
6463           if risk_grade = 'A' then interest_rate = base_rate;
6464           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
6465           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
6466           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
6467           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
6468           else interest_rate = base_rate + 0.15;
6469       
6470           format interest_rate percent8.2;
6471       run;
6472       
6473       /*****************************************************************************
6474        * 6. Create Output Datasets
6475        *****************************************************************************/
6476       
6477       /* Kaggle submission format (row_id, probability) */
6478       data work.kaggle_submission;
6479           set work.test_predictions;
6480           keep row_id pd_logistic;
6481       run;
6482       
6483       /* Full predictions with all scores and recommendations */
6484       data work.test_predictions_full;
6485           set work.test_predictions;
6486           keep row_id pd_logistic pred_logistic credit_risk_score risk_grade
6487                recommendation interest_rate age monthly_income
6488                credit_utilization debt_ratio total_late_payments
6489                num_credit_lines financial_health total_risk_flags;
6490       run;
6491       
