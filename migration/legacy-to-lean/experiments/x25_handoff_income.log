157        /* Check the input conditions: stop with an error before anything is exported */
158        /* The numeric value of a raw column: a numeric column as it is; a character column
159           read as a number, missing when the text is no number or is longer than 32 characters */
160        %macro num(v);
161            %local dsid pos vtype;
162            %let vtype = ;
163            %let dsid = %sysfunc(open(work.credit_raw));
164            %let pos = %sysfunc(varnum(&dsid, &v));
165            %if &pos > 0 %then %let vtype = %sysfunc(vartype(&dsid, &pos));
166            %let dsid = %sysfunc(close(&dsid));
167            %if &vtype = N %then "&v"n;
168            %else ifn(lengthn(strip("&v"n)) <= 32, input(strip("&v"n), ?? best32.), .);
169        %mend;
170        
171        %let columns_ok = 0;
172        %let bad_rows = 1;
173        %let duplicate_ids = 1;
174        %let known_incomes = 0;
175        
176        proc sql noprint;
177            /* The expected columns and no others */
178            select (count(*) = 12 and sum(upcase(name) in
179                       ('VAR1', 'SERIOUSDLQIN2YRS', 'AGE', 'MONTHLYINCOME', 'NUMBEROFDEPENDENTS',
180                        'REVOLVINGUTILIZATIONOFUNSECUREDL', 'DEBTRATIO',
181                        'NUMBEROFTIME30-59DAYSPASTDUENOTW', 'NUMBEROFTIME60-89DAYSPASTDUENOTW',
182                        'NUMBEROFTIMES90DAYSLATE', 'NUMBEROFOPENCREDITLINESANDLOANS',
183                        'NUMBERREALESTATELOANSORLINES')) = 12)
184            into :columns_ok trimmed
185            from dictionary.columns
186            where libname = 'WORK' and memname = 'CREDIT_RAW';
187        quit;
188        
189        /* Only MonthlyIncome and NumberOfDependents may be missing (blank or NA);
190           the outcome is 0 or 1; the counts are whole numbers, zero or more;
191           a known MonthlyIncome is zero or more */
192        data work.input_check;
193            set work.credit_raw;
194            bad_row = (missing(%num(VAR1))
195                or %num(SeriousDlqin2yrs) not in (0, 1)
196                or missing(%num(age))
197                or missing(%num(RevolvingUtilizationOfUnsecuredL))
198                or missing(%num(DebtRatio))
199                or missing(%num(NumberRealEstateLoansOrLines))
200                or not (%num(NumberOfTime30-59DaysPastDueNotW) >= 0 and
201                        %num(NumberOfTime30-59DaysPastDueNotW) = int(%num(NumberOfTime30-59DaysPastDueNotW)))
202                or not (%num(NumberOfTime60-89DaysPastDueNotW) >= 0 and
203                        %num(NumberOfTime60-89DaysPastDueNotW) = int(%num(NumberOfTime60-89DaysPastDueNotW)))
204                or not (%num(NumberOfTimes90DaysLate) >= 0 and
205                        %num(NumberOfTimes90DaysLate) = int(%num(NumberOfTimes90DaysLate)))
206                or not (%num(NumberOfOpenCreditLinesAndLoans) >= 0 and
207                        %num(NumberOfOpenCreditLinesAndLoans) = int(%num(NumberOfOpenCreditLinesAndLoans)))
208                or (upcase(cats(MonthlyIncome)) not in ('', '.', 'NA') and missing(%num(MonthlyIncome)))
209                or (not missing(%num(MonthlyIncome)) and %num(MonthlyIncome) < 0)
210                or (upcase(cats(NumberOfDependents)) not in ('', '.', 'NA') and
211                    not (%num(NumberOfDependents) >= 0 and
212                         %num(NumberOfDependents) = int(%num(NumberOfDependents)))));
213            known_income = not missing(%num(MonthlyIncome));
214            keep VAR1 bad_row known_income;
215        run;
216        
217        /* Bad rows, repeated row ids, known incomes */
218        proc sql noprint;
219            select coalesce(sum(bad_row), 0), count(*) - count(distinct VAR1), coalesce(sum(known_income), 0)
220            into :bad_rows trimmed, :duplicate_ids trimmed, :known_incomes trimmed
221            from work.input_check;
222        quit;
223        
224        data _null_;
225            if &columns_ok ne 1 or &bad_rows ne 0 or &duplicate_ids ne 0 or &known_incomes < 1 then do;
226                put "ERROR: cs-training.csv does not meet the input conditions: "
227                    "columns_ok=&columns_ok bad_rows=&bad_rows duplicate_ids=&duplicate_ids known_incomes=&known_incomes..";
228                put "ERROR: Feature engineering stopped. Nothing is exported.";
229                abort cancel;
230            end;
231        run;
