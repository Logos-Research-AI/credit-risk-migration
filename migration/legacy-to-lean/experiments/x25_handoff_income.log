238        /*****************************************************************************
239         * 2. Data Cleaning and Missing Value Handling
240         *****************************************************************************/
241        
242        /* First convert MonthlyIncome to numeric if needed */
243        data work.credit_raw_clean;
244            set work.credit_raw;
245        
246            /* Convert to numeric - input function handles character to numeric */
247            MonthlyIncome_num = input(MonthlyIncome, best32.);
248            NumberOfDependents_num = input(NumberOfDependents, best32.);
249        
250            /* Keep the numeric versions, drop character if they exist */
251            drop MonthlyIncome NumberOfDependents;
252            rename MonthlyIncome_num = MonthlyIncome
253                   NumberOfDependents_num = NumberOfDependents;
254        run;
255        
256        /* Calculate income medians by age group for imputation */
257        proc sql;
258            create table work.income_medians as
259            select
260                case
261                    when age < 30 then 1
262                    when age < 40 then 2
263                    when age < 50 then 3
264                    when age < 60 then 4
265                    else 5
266                end as age_group,
267                median(MonthlyIncome) as median_income
268            from work.credit_raw_clean
269            where MonthlyIncome is not missing
270            group by calculated age_group;
271        quit;
272        
273        /* One row per age group, with the median of all known incomes:
274           the fallback for an age group that has no known income */
275        data work.age_groups;
276            do age_group = 1 to 5;
277                output;
278            end;
279        run;
280        
281        proc sql;
282            create table work.income_medians_all as
283            select
284                g.age_group,
285                m.median_income,
286                (select median(MonthlyIncome) from work.credit_raw_clean
287                 where MonthlyIncome is not missing) as overall_median_income
288            from work.age_groups g
289            left join work.income_medians m
290            on g.age_group = m.age_group
291            order by g.age_group;
292        quit;
293        
294        data work.credit_cleaned;
295            set work.credit_raw_clean;
296        
297            /* Create age group for income imputation */
298            if age < 30 then age_group = 1;
299            else if age < 40 then age_group = 2;
300            else if age < 50 then age_group = 3;
301            else if age < 60 then age_group = 4;
302            else age_group = 5;
303        
304            /* Handle missing values - create flags */
305            if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
306            else MonthlyIncome_missing = 0;
307        
308            if missing(NumberOfDependents) then do;
309                NumberOfDependents = 0;
310                Dependents_missing = 1;
311            end;
312            else Dependents_missing = 0;
313        run;
314        
315        /* Merge and impute income - rename columns in SQL */
316        proc sql;
317            create table work.credit_imputed as
318            select
319                a.VAR1 as row_id,
320                a.SeriousDlqin2yrs as default_flag,
321                a.age,
322                case when a.MonthlyIncome_missing = 1 then coalesce(b.median_income, b.overall_median_income)
323                     else a.MonthlyIncome
324                end as monthly_income,
325                a.MonthlyIncome_missing,
326                a.NumberOfDependents as num_dependents,
327                a.Dependents_missing,
328                a.age_group,
329                a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
330                a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
331                a.NumberOfTimes90DaysLate as num_late_90_plus,
332                a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
333                a.DebtRatio * 100 as debt_ratio,
334                a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
335                a.NumberRealEstateLoansOrLines as num_real_estate_loans
336            from work.credit_cleaned a
337            left join work.income_medians_all b
338            on a.age_group = b.age_group;
339        quit;
340        
341        /*****************************************************************************
342         * 3. Feature Engineering
343         *****************************************************************************/
344        
345        data work.credit_features;
346            set work.credit_imputed;
347        
348            /* Total late payments across all categories */
349            total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
350        
351            /* Has any delinquency indicator */
352            has_delinquency = (total_late_payments > 0);
353        
354            /* Has serious delinquency (90+ days) */
355            has_serious_delinquency = (num_late_90_plus > 0);
356        
357            /* Credit utilization categories */
358            if credit_utilization < 30 then credit_util_category = 1; /* Low */
359            else if credit_utilization < 50 then credit_util_category = 2; /* Medium */
360            else if credit_utilization < 75 then credit_util_category = 3; /* High */
361            else credit_util_category = 4; /* Very High */
362        
363            /* Debt ratio categories */
364            if debt_ratio < 30 then debt_category = 1; /* Low */
365            else if debt_ratio < 43 then debt_category = 2; /* Medium */
366            else if debt_ratio < 60 then debt_category = 3; /* High */
367            else debt_category = 4; /* Very High */
368        
369            /* Income per dependent (handle division by zero) */
370            if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
371            else income_per_dependent = monthly_income;
372        
373            /* Credit lines per person in household */
374            credit_lines_per_person = num_credit_lines / (num_dependents + 1);
375        
376            /* Age categories for risk assessment */
377            if age < 25 then age_category = 1; /* Young */
378            else if age < 35 then age_category = 2; /* Young Adult */
379            else if age < 50 then age_category = 3; /* Middle Age */
380            else if age < 65 then age_category = 4; /* Mature */
381            else age_category = 5; /* Senior */
382        
383            /* Risk flags */
384            flag_high_utilization = (credit_utilization > 75);
385            flag_very_high_utilization = (credit_utilization > 100);
386            flag_high_debt_ratio = (debt_ratio > 43);
387            flag_very_high_debt_ratio = (debt_ratio > 60);
388            flag_recent_late_payments = (num_late_30_59 > 0);
389            flag_serious_delinquency = (num_late_90_plus > 0);
390            flag_multiple_delinquencies = (total_late_payments >= 3);
391            flag_low_income = (monthly_income < 2500);
392            flag_many_dependents = (num_dependents >= 3);
393            flag_few_credit_lines = (num_credit_lines <= 2);
394        
395            /* Total risk flags */
396            total_risk_flags = sum(flag_high_utilization, flag_very_high_utilization,
397                                  flag_high_debt_ratio,
398                                  flag_serious_delinquency, flag_multiple_delinquencies,
399                                  flag_low_income, flag_many_dependents,
400                                  flag_few_credit_lines);
401        
402            /* Financial health score (0-100) */
403            financial_health = 100;
404            if credit_utilization > 30 then financial_health = financial_health - 15;
405            if credit_utilization > 75 then financial_health = financial_health - 15;
406            if debt_ratio > 43 then financial_health = financial_health - 20;
407            if has_delinquency then financial_health = financial_health - 20;
408            if num_late_90_plus > 0 then financial_health = financial_health - 30;
409            financial_health = max(0, financial_health);
410        
411            /* Log transformations for skewed variables (add 1 to handle zeros) */
412            log_monthly_income = log(monthly_income + 1);
413            log_num_credit_lines = log(num_credit_lines + 1);
414            log_total_late_payments = log(total_late_payments + 1);
415        
416            /* Interaction features */
417            if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
418            else age_income_interaction = age * log_monthly_income;
419            utilization_debt_interaction = credit_utilization * debt_ratio;
420        
421            /* Cap extreme outliers in credit_utilization and debt_ratio */
422            credit_utilization_capped = min(credit_utilization, 200);
423            debt_ratio_capped = min(debt_ratio, 500);
424        run;
