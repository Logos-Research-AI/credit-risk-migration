3822       /*****************************************************************************
3823        * 5. Create Risk Scores and Grades
3824        *****************************************************************************/
3825       
3826       /* Generate risk scores for training set */
3827       data work.risk_scores_train;
3828           set work.logit_scored_train;
3829       
3830           /* Convert probability to credit risk score (300-850 scale like FICO) */
3831           base_score = 600;
3832           score_range = 250;
3833           credit_risk_score = base_score + score_range * (1 - pd_logistic);
3834       
3835           /* Assign risk grades from the probability (a missing probability is graded F) */
3836           if missing(pd_logistic) then risk_grade = 'F';
3837           else if pd_logistic < 0.10 then risk_grade = 'A';
3838           else if pd_logistic < 0.15 then risk_grade = 'B';
3839           else if pd_logistic < 0.25 then risk_grade = 'C';
3840           else if pd_logistic < 0.35 then risk_grade = 'D';
3841           else if pd_logistic <= 0.50 then risk_grade = 'E';
3842           else risk_grade = 'F';
3843       
3844           /* Recommended actions */
3845           if risk_grade in ('A', 'B') then recommendation = 'Approve';
3846           else if risk_grade = 'C' then recommendation = 'Review';
3847           else recommendation = 'Decline';
3848       
3849           /* Suggested interest rate (risk-based pricing) */
3850           base_rate = 0.05;
3851           if risk_grade = 'A' then interest_rate = base_rate;
3852           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
3853           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
3854           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
3855           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
3856           else interest_rate = base_rate + 0.15;
3857       
3858           format interest_rate percent8.2;
3859       run;
3860       
3861       /* Generate risk scores for validation set */
3862       data work.risk_scores_validation;
3863           set work.logit_scored_valid;
3864       
3865           /* Same scoring logic as training */
3866           base_score = 600;
3867           score_range = 250;
3868           credit_risk_score = base_score + score_range * (1 - pd_logistic);
3869       
3870           if missing(pd_logistic) then risk_grade = 'F';
3871           else if pd_logistic < 0.10 then risk_grade = 'A';
3872           else if pd_logistic < 0.15 then risk_grade = 'B';
3873           else if pd_logistic < 0.25 then risk_grade = 'C';
3874           else if pd_logistic < 0.35 then risk_grade = 'D';
3875           else if pd_logistic <= 0.50 then risk_grade = 'E';
3876           else risk_grade = 'F';
3877       
3878           if risk_grade in ('A', 'B') then recommendation = 'Approve';
3879           else if risk_grade = 'C' then recommendation = 'Review';
3880           else recommendation = 'Decline';
3881       
3882           base_rate = 0.05;
3883           if risk_grade = 'A' then interest_rate = base_rate;
3884           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
3885           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
3886           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
3887           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
3888           else interest_rate = base_rate + 0.15;
3889       
3890           format interest_rate percent8.2;
3891       run;
3892       
3893       /* Risk grade distribution */
3894       proc freq data=work.risk_scores_train;
3895           tables risk_grade * default_flag / nocol nopercent;
3896           title "Default Rate by Risk Grade - Training Set";
3897       run;
