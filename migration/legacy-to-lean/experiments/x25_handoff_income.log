2511       proc sql noprint;
2512           /* The expected columns and no others */
2513           select (count(*) = 12 and sum(upcase(name) in
2514                      ('VAR1', 'SERIOUSDLQIN2YRS', 'AGE', 'MONTHLYINCOME', 'NUMBEROFDEPENDENTS',
2515                       'REVOLVINGUTILIZATIONOFUNSECUREDL', 'DEBTRATIO',
2516                       'NUMBEROFTIME30-59DAYSPASTDUENOTW', 'NUMBEROFTIME60-89DAYSPASTDUENOTW',
2517                       'NUMBEROFTIMES90DAYSLATE', 'NUMBEROFOPENCREDITLINESANDLOANS',
2518                       'NUMBERREALESTATELOANSORLINES')) = 12)
2519           into :columns_ok trimmed
2520           from dictionary.columns
2521           where libname = 'WORK' and memname = 'CREDIT_RAW';
2522       quit;
2523       
2524       /* Only MonthlyIncome and NumberOfDependents may be missing (blank or NA);
2525          the outcome is 0 or 1; the counts are whole numbers, zero or more;
2526          a known MonthlyIncome is zero or more */
2527       data work.input_check;
2528           set work.credit_raw;
2529           bad_row = (missing(%num(VAR1))
2530               or %num(SeriousDlqin2yrs) not in (0, 1)
2531               or missing(%num(age))
2532               or missing(%num(RevolvingUtilizationOfUnsecuredL))
2533               or missing(%num(DebtRatio))
2534               or missing(%num(NumberRealEstateLoansOrLines))
2535               or not (%num(NumberOfTime30-59DaysPastDueNotW) >= 0 and
2536                       %num(NumberOfTime30-59DaysPastDueNotW) = int(%num(NumberOfTime30-59DaysPastDueNotW)))
2537               or not (%num(NumberOfTime60-89DaysPastDueNotW) >= 0 and
2538                       %num(NumberOfTime60-89DaysPastDueNotW) = int(%num(NumberOfTime60-89DaysPastDueNotW)))
2539               or not (%num(NumberOfTimes90DaysLate) >= 0 and
2540                       %num(NumberOfTimes90DaysLate) = int(%num(NumberOfTimes90DaysLate)))
2541               or not (%num(NumberOfOpenCreditLinesAndLoans) >= 0 and
2542                       %num(NumberOfOpenCreditLinesAndLoans) = int(%num(NumberOfOpenCreditLinesAndLoans)))
2543               or (upcase(cats(MonthlyIncome)) not in ('', '.', 'NA') and missing(%num(MonthlyIncome)))
2544               or (not missing(%num(MonthlyIncome)) and %num(MonthlyIncome) < 0)
2545               or (upcase(cats(NumberOfDependents)) not in ('', '.', 'NA') and
2546                   not (%num(NumberOfDependents) >= 0 and
2547                        %num(NumberOfDependents) = int(%num(NumberOfDependents)))));
2548           known_income = not missing(%num(MonthlyIncome));
2549           keep VAR1 bad_row known_income;
2550       run;
