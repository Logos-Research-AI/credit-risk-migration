MonthlyIncome=NA NumberOfOpenCreditLinesAndLoans=8 NumberOfTimes90DaysLate=0 NumberRealEstateLoansOrLines=3
NumberOfTime60-89DaysPastDueNotW=0 NumberOfDependents=0 MonthlyIncome_num=. NumberOfDependents_num=0 _ERROR_=1 _N_=7
1214       
1215       /* Calculate income medians by age group for imputation */
1216       proc sql;
1217           create table work.income_medians as
1218           select
1219               case
1220                   when age < 30 then 1
1221                   when age < 40 then 2
1222                   when age < 50 then 3
1223                   when age < 60 then 4
1224                   else 5
1225               end as age_group,
1226               median(MonthlyIncome) as median_income
1227           from work.credit_raw_clean
1228           where MonthlyIncome is not missing
1229           group by calculated age_group;
1230       quit;
1231       
1232       /* One row per age group, with the median of all known incomes:
1233          the fallback for an age group that has no known income */
1234       data work.age_groups;
1235           do age_group = 1 to 5;
1236               output;
1237           end;
1238       run;
1239       
1240       proc sql;
1241           create table work.income_medians_all as
1242           select
1243               g.age_group,
1244               m.median_income,
1245               (select median(MonthlyIncome) from work.credit_raw_clean
1246                where MonthlyIncome is not missing) as overall_median_income
1247           from work.age_groups g
1248           left join work.income_medians m
1249           on g.age_group = m.age_group
1250           order by g.age_group;
1251       quit;
1252       
1253       data work.credit_cleaned;
1254           set work.credit_raw_clean;
1255       
1256           /* Create age group for income imputation */
1257           if age < 30 then age_group = 1;
1258           else if age < 40 then age_group = 2;
1259           else if age < 50 then age_group = 3;
1260           else if age < 60 then age_group = 4;
1261           else age_group = 5;
1262       
1263           /* Handle missing values - create flags */
1264           if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
1265           else MonthlyIncome_missing = 0;
1266       
1267           if missing(NumberOfDependents) then do;
1268               NumberOfDependents = 0;
1269               Dependents_missing = 1;
1270           end;
1271           else Dependents_missing = 0;
1272       run;
1273       
1274       /* Merge and impute income - rename columns in SQL */
1275       proc sql;
1276           create table work.credit_imputed as
1277           select
1278               a.VAR1 as row_id,
1279               a.SeriousDlqin2yrs as default_flag,
1280               a.age,
1281               case when a.MonthlyIncome_missing = 1 then coalesce(b.median_income, b.overall_median_income)
1282                    else a.MonthlyIncome
1283               end as monthly_income,
1284               a.MonthlyIncome_missing,
1285               a.NumberOfDependents as num_dependents,
1286               a.Dependents_missing,
1287               a.age_group,
1288               a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
1289               a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
1290               a.NumberOfTimes90DaysLate as num_late_90_plus,
1291               a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
1292               a.DebtRatio * 100 as debt_ratio,
1293               a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
1294               a.NumberRealEstateLoansOrLines as num_real_estate_loans
1295           from work.credit_cleaned a
1296           left join work.income_medians_all b
1297           on a.age_group = b.age_group;
1298       quit;
1299       
1300       /*****************************************************************************
1301        * 3. Feature Engineering
1302        *****************************************************************************/
1303       
1304       data work.credit_features;
1305           set work.credit_imputed;
1306       
1307           /* Total late payments across all categories */
1308           total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
1309       
1310           /* Has any delinquency indicator */
1311           has_delinquency = (total_late_payments > 0);
1312       
1313           /* Has serious delinquency (90+ days) */
1314           has_serious_delinquency = (num_late_90_plus > 0);
1315       
1316           /* Credit utilization categories */
1317           if credit_utilization < 30 then credit_util_category = 1; /* Low */
1318           else if credit_utilization < 50 then credit_util_category = 2; /* Medium */
1319           else if credit_utilization < 75 then credit_util_category = 3; /* High */
1320           else credit_util_category = 4; /* Very High */
1321       
1322           /* Debt ratio categories */
1323           if debt_ratio < 30 then debt_category = 1; /* Low */
1324           else if debt_ratio < 43 then debt_category = 2; /* Medium */
1325           else if debt_ratio < 60 then debt_category = 3; /* High */
1326           else debt_category = 4; /* Very High */
1327       
1328           /* Income per dependent (handle division by zero) */
1329           if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
1330           else income_per_dependent = monthly_income;
1331       
1332           /* Credit lines per person in household */
1333           credit_lines_per_person = num_credit_lines / (num_dependents + 1);
1334       
1335           /* Age categories for risk assessment */
1336           if age < 25 then age_category = 1; /* Young */
1337           else if age < 35 then age_category = 2; /* Young Adult */
1338           else if age < 50 then age_category = 3; /* Middle Age */
1339           else if age < 65 then age_category = 4; /* Mature */
1340           else age_category = 5; /* Senior */
1341       
1342           /* Risk flags */
1343           flag_high_utilization = (credit_utilization > 75);
1344           flag_very_high_utilization = (credit_utilization > 100);
1345           flag_high_debt_ratio = (debt_ratio > 43);
1346           flag_very_high_debt_ratio = (debt_ratio > 60);
1347           flag_recent_late_payments = (num_late_30_59 > 0);
1348           flag_serious_delinquency = (num_late_90_plus > 0);
1349           flag_multiple_delinquencies = (total_late_payments >= 3);
1350           flag_low_income = (monthly_income < 2500);
1351           flag_many_dependents = (num_dependents >= 3);
1352           flag_few_credit_lines = (num_credit_lines <= 2);
1353       
1354           /* Total risk flags */
1355           total_risk_flags = sum(flag_high_utilization, flag_very_high_utilization,
1356                                 flag_high_debt_ratio,
1357                                 flag_serious_delinquency, flag_multiple_delinquencies,
1358                                 flag_low_income, flag_many_dependents,
1359                                 flag_few_credit_lines);
1360       
1361           /* Financial health score (0-100) */
1362           financial_health = 100;
1363           if credit_utilization > 30 then financial_health = financial_health - 15;
1364           if credit_utilization > 75 then financial_health = financial_health - 15;
1365           if debt_ratio > 43 then financial_health = financial_health - 20;
1366           if has_delinquency then financial_health = financial_health - 20;
1367           if num_late_90_plus > 0 then financial_health = financial_health - 30;
1368           financial_health = max(0, financial_health);
1369       
1370           /* Log transformations for skewed variables (add 1 to handle zeros) */
1371           log_monthly_income = log(monthly_income + 1);
1372           log_num_credit_lines = log(num_credit_lines + 1);
1373           log_total_late_payments = log(total_late_payments + 1);
1374       
1375           /* Interaction features */
1376           if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
1377           else age_income_interaction = age * log_monthly_income;
1378           utilization_debt_interaction = credit_utilization * debt_ratio;
1379       
1380           /* Cap extreme outliers in credit_utilization and debt_ratio */
1381           credit_utilization_capped = min(credit_utilization, 200);
1382           debt_ratio_capped = min(debt_ratio, 500);
1383       run;
