5132       /*****************************************************************************
5133        * 2. ROC Curve and AUC Analysis
5134        *****************************************************************************/
5135       
5136       /* ROC analysis for validation set */
5137       proc logistic data=work.logit_scored_valid;
5138           model default_flag(event='1') = pd_logistic / nofit;
5139           roc 'Logistic Model' pred=pd_logistic;
5140           roccontrast;
5141           ods output ROCAssociation=work.roc_stats;
5142           title "ROC Curve Analysis - Validation Set";
5143       run;
5144       
5145       /* Calculate and display AUC: the exact pairwise AUC of the validation probabilities.
5146          A defaulter/non-defaulter pair is concordant when the defaulter's probability is
5147          higher, and tied only when the two probabilities are equal */
5148       proc sql;
5149           create table work.auc_pairs as
5150           select pd_logistic,
5151                  sum(default_flag = 1) as n_bad,
5152                  sum(default_flag = 0) as n_good
5153           from work.logit_scored_valid
5154           where not missing(pd_logistic)
5155           group by pd_logistic
5156           order by pd_logistic;
5157       quit;
5158       
5159       data work.auc_summary;
5160           length ROCModel $14;
5161           set work.auc_pairs end=eof;
5162           retain concordant tied cum_good cum_bad 0;
5163       
5164           concordant + n_bad * cum_good;
5165           tied + n_bad * n_good;
5166           cum_good + n_good;
5167           cum_bad + n_bad;
5168       
5169           if eof then do;
5170               ROCModel = 'Logistic Model';
5171               if cum_bad * cum_good > 0 then do;
5172                   AUC = (concordant + tied / 2) / (cum_bad * cum_good);
5173                   Gini = 2 * AUC - 1;
5174               end;
5175               output;
5176           end;
5177           keep ROCModel AUC Gini;
5178           format AUC Gini 8.4;
5179       run;
5180       
5181       proc print data=work.auc_summary noobs;
5182           title "Model Performance Metrics - AUC and Gini";
5183       run;
5184       
5185       /*****************************************************************************
5186        * 3. Kolmogorov-Smirnov (KS) Statistic
5187        *****************************************************************************/
5188       
5189       /* Sort by predicted probability */
5190       proc sort data=work.logit_scored_valid;
5191           by pd_logistic;
5192       run;
5193       
5194       /* Calculate total good and bad counts */
5195       proc sql noprint;
5196           select sum(default_flag = 0), sum(default_flag = 1)
5197           into :total_good_count, :total_bad_count
5198           from work.logit_scored_valid;
5199       quit;
5200       
5201       /* Calculate cumulative distributions */
5202       data work.ks_calculation;
5203           set work.logit_scored_valid;
5204           by pd_logistic;
5205           retain cum_good cum_bad;
5206       
5207           if _n_ = 1 then do;
5208               cum_good = 0;
5209               cum_bad = 0;
5210           end;
5211       
5212           if default_flag = 0 then cum_good + 1;
5213           else cum_bad + 1;
5214       
5215           cum_pct_good = cum_good / &total_good_count;
5216           cum_pct_bad = cum_bad / &total_bad_count;
5217           /* Compare the two distributions only after the last applicant of each probability */
5218           if last.pd_logistic then ks_value = abs(cum_pct_good - cum_pct_bad);
5219       run;
5220       
5221       /* Find maximum KS (one row: the lowest cutoff when several attain the maximum) */
5222       proc sql;
5223           create table work.ks_statistic as
5224           select max(ks_value) as KS_Statistic format=8.4,
5225                  min(pd_logistic) as KS_Cutoff format=8.4
5226           from work.ks_calculation
5227           where ks_value = (select max(ks_value) from work.ks_calculation);
5228       quit;
5229       
5230       proc print data=work.ks_statistic noobs;
5231           title "Kolmogorov-Smirnov Statistic";
5232       run;
5233       
5234       /*****************************************************************************
5235        * 4. Confusion Matrix and Accuracy Metrics
5236        *****************************************************************************/
5237       
5238       /* Calculate metrics at different thresholds */
5239       %macro confusion_metrics(threshold, suffix);
5240           data work.confusion_&suffix;
5241               set work.logit_scored_valid;
5242               predicted = (pd_logistic >= &threshold);
5243           run;
5244       
5245           proc freq data=work.confusion_&suffix noprint;
5246               tables default_flag * predicted / out=work.conf_matrix_&suffix;
5247           run;
5248       
5249           /* Calculate metrics */
5250           data work.metrics_&suffix;
5251               set work.conf_matrix_&suffix end=eof;
5252               retain TP TN FP FN 0;
5253       
5254               if default_flag = 1 and predicted = 1 then TP = count;
5255               else if default_flag = 0 and predicted = 0 then TN = count;
5256               else if default_flag = 0 and predicted = 1 then FP = count;
5257               else if default_flag = 1 and predicted = 0 then FN = count;
5258       
5259               if eof then do;
5260                   threshold = &threshold;
5261                   if (TP + TN + FP + FN) > 0 then accuracy = (TP + TN) / (TP + TN + FP + FN);
5262                   else accuracy = .;
5263                   if (TP + FP) > 0 then precision = TP / (TP + FP);
5264                   else precision = .;
5265                   if (TP + FN) > 0 then recall = TP / (TP + FN);
5266                   else recall = .;
5267                   if (precision + recall) > 0 then f1_score = 2 * (precision * recall) / (precision + recall);
5268                   else f1_score = .;
5269                   if (TN + FP) > 0 then specificity = TN / (TN + FP);
5270                   else specificity = .;
5271                   output;
5272               end;
5273               keep threshold accuracy precision recall f1_score specificity;
5274           run;
5275       %mend;
5276       
5277       /* Test multiple thresholds */
5278       %confusion_metrics(0.3, 03);
5279       %confusion_metrics(0.4, 04);
5280       %confusion_metrics(0.5, 05);
5281       %confusion_metrics(0.6, 06);
5282       %confusion_metrics(0.7, 07);
5283       
5284       /* Combine results */
5285       data work.threshold_analysis;
5286           set work.metrics_03 work.metrics_04 work.metrics_05
5287               work.metrics_06 work.metrics_07;
5288       run;
5289       
5290       proc print data=work.threshold_analysis;
5291           title "Performance Metrics at Different Thresholds";
5292           format accuracy precision recall f1_score specificity 8.4;
5293       run;
5294       
5295       /*****************************************************************************
5296        * 5. Decile Analysis and Lift Chart
5297        *****************************************************************************/
5298       
5299       /* Create deciles based on predicted probability */
5300       proc rank data=work.logit_scored_valid
5301                 out=work.decile_data
5302                 groups=10 descending;
5303           var pd_logistic;
5304           ranks decile;
5305       run;
5306       
5307       /* Always ten rows, deciles 1 to 10 */
5308       data work.decile_list;
5309           do decile = 1 to 10;
5310               output;
5311           end;
5312       run;
5313       
5314       /* Calculate lift by decile; a decile that receives no applicant has
5315          count 0, capture rate 0 and lift 0; with no defaulter in the validation set
5316          capture rate and lift are 0 on every decile */
5317       proc sql;
5318           create table work.decile_analysis as
5319           select
5320               l.decile,
5321               coalesce(d.total_count, 0) as total_count,
5322               coalesce(d.defaults, 0) as defaults,
5323               d.default_rate format=percent8.2,
5324               d.avg_pd format=8.4,
5325               d.min_pd format=8.4,
5326               d.max_pd format=8.4,
5327               coalesce(d.capture_rate, 0) as capture_rate format=percent8.2,
5328               coalesce(d.lift, 0) as lift format=8.2
5329           from work.decile_list l
5330           left join
5331               (select
5332                   decile + 1 as decile,
5333                   count(*) as total_count,
5334                   sum(default_flag) as defaults,
5335                   mean(default_flag) as default_rate,
5336                   mean(pd_logistic) as avg_pd,
5337                   min(pd_logistic) as min_pd,
5338                   max(pd_logistic) as max_pd,
5339                   sum(default_flag) / (select sum(default_flag) from work.decile_data) as capture_rate,
5340                   (calculated default_rate) / (select mean(default_flag) from work.decile_data) as lift
5341                from work.decile_data
5342                group by decile) d
5343           on l.decile = d.decile
5344           order by l.decile;
5345       quit;
5346       
5347       proc print data=work.decile_analysis;
5348           title "Decile Analysis - Model Lift and Capture Rate";
5349       run;
5350       
5351       /* Calculate totals for cumulative lift chart */
5352       proc sql noprint;
5353           select sum(default_flag), mean(default_flag)
5354           into :total_defaults, :overall_default_rate
5355           from work.decile_data;
5356       quit;
5357       
5358       /* Create cumulative lift chart */
5359       data work.cumulative_lift;
5360           set work.decile_analysis;
5361           retain cum_defaults cum_count;
5362           if _n_ = 1 then do;
5363               cum_defaults = defaults;
5364               cum_count = total_count;
5365           end;
5366           else do;
5367               cum_defaults + defaults;
5368               cum_count + total_count;
5369           end;
5370       
5371           /* With no defaulter in the validation set both are 0, as in the decile table */
5372           if &total_defaults > 0 then cum_capture_rate = cum_defaults / &total_defaults;
5373           else cum_capture_rate = 0;
5374           /* No cumulative lift while the deciles so far are empty */
5375           if cum_count > 0 then do;
5376               if &overall_default_rate > 0 then cum_lift = (cum_defaults / cum_count) / &overall_default_rate;
5377               else cum_lift = 0;
5378           end;
5379           format cum_capture_rate percent8.2 cum_lift 8.2;
5380       run;
5381       
5382       proc sgplot data=work.cumulative_lift;
5383           series x=decile y=cum_lift;
5384           refline 1 / axis=y;
5385           xaxis label="Decile";
5386           yaxis label="Cumulative Lift";
5387           title "Cumulative Lift Chart";
5388       run;
5389       
5390       /*****************************************************************************
5391        * 6. Population Stability Index (PSI)
5392        *****************************************************************************/
5393       
5394       /* Compare score distributions between training and validation */
5395       
5396       /* Ten bins cut from the training scores: the nine cuts are the nearest-rank
5397          deciles of the training scores (no interpolation) */
5398       proc sort data=work.logit_scored_train(keep=credit_risk_score)
5399                 out=work.train_scores_sorted;
5400           by credit_risk_score;
5401       run;
5402       
5403       data work.psi_cuts;
5404           set work.train_scores_sorted nobs=n_train end=eof;
5405           array cut{9};
5406           retain cut1-cut9;
5407           do k = 1 to 9;
5408               if _n_ = ceil(k * n_train / 10) then cut{k} = credit_risk_score;
5409           end;
5410           if eof then output;
5411           keep cut1-cut9;
5412       run;
5413       
5414       /* Place both sets in the same bins; a score equal to a cut belongs to the lower bin */
5415       data work.train_bins;
5416           if _n_ = 1 then set work.psi_cuts;
5417           set work.logit_scored_train;
5418           array cut{9};
5419           score_bin = 0;
5420           do k = 1 to 9;
5421               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
5422           end;
5423           drop k cut1-cut9;
5424       run;
5425       
5426       data work.valid_bins;
5427           if _n_ = 1 then set work.psi_cuts;
5428           set work.logit_scored_valid;
5429           array cut{9};
5430           score_bin = 0;
5431           do k = 1 to 9;
5432               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
5433           end;
5434           drop k cut1-cut9;
5435       run;
5436       
5437       data work.psi_bins;
5438           do score_bin = 0 to 9;
5439               output;
5440           end;
5441       run;
5442       
5443       /* An empty bin is given a share below that of one applicant, the same on both
5444          sides, so that a bin filled on one side only adds a positive amount */
5445       /* The size of the larger set is carried as a whole number and the share is computed
5446          where it is used, so it is not cut to the 8 characters of a macro variable */
5447       proc sql noprint;
5448           select max(t.n, v.n) format=32. into :psi_rows trimmed
5449           from (select count(*) as n from work.train_bins) t,
5450                (select count(*) as n from work.valid_bins) v;
5451       quit;
5452       %let psi_floor = (0.5 / &psi_rows);
5453       
5454       /* Calculate PSI */
5455       proc sql;
5456           create table work.psi_calculation as
5457           select
5458               s.score_bin,
5459               coalesce(a.train_pct, 0) as train_pct,
5460               coalesce(b.valid_pct, 0) as valid_pct,
5461               (max(calculated train_pct, &psi_floor) - max(calculated valid_pct, &psi_floor))
5462                   * log(max(calculated train_pct, &psi_floor) / max(calculated valid_pct, &psi_floor)) as psi_component
5463           from work.psi_bins s
5464           left join
5465               (select score_bin, count(*) / (select count(*) from work.train_bins) as train_pct
5466                from work.train_bins group by score_bin) a
5467           on s.score_bin = a.score_bin
5468           left join
5469               (select score_bin, count(*) / (select count(*) from work.valid_bins) as valid_pct
5470                from work.valid_bins group by score_bin) b
5471           on s.score_bin = b.score_bin
5472           order by s.score_bin;
5473       
5474           create table work.psi_summary as
5475           select sum(psi_component) as PSI format=best12.,
5476                  case
5477                     when calculated PSI < 0.1 then 'No significant change'
5478                     when calculated PSI < 0.25 then 'Some change'
5479                     else 'Significant change'
5480                  end as PSI_interpretation
5481           from work.psi_calculation;
5482       quit;
5483       
5484       proc print data=work.psi_summary noobs;
5485           title "Population Stability Index";
5486       run;
5487       
5488       /*****************************************************************************
5489        * 7. Calibration Plot
5490        *****************************************************************************/
5491       
5492       /* Bin predictions and compare to actual */
5493       proc rank data=work.logit_scored_valid
5494                 out=work.calibration_data
5495                 groups=20;
5496           var pd_logistic;
5497           ranks pred_bin;
5498       run;
5499       
5500       proc sql;
5501           create table work.calibration_plot as
5502           select
5503               pred_bin,
5504               mean(pd_logistic) as mean_predicted format=8.4,
5505               mean(default_flag) as mean_actual format=8.4,
5506               count(*) as bin_count
5507           from work.calibration_data
5508           group by pred_bin
5509           order by pred_bin;
5510       quit;
5511       
5512       proc sgplot data=work.calibration_plot;
5513           scatter x=mean_predicted y=mean_actual / markerattrs=(size=10);
5514           lineparm x=0 y=0 slope=1 / lineattrs=(pattern=dash);
5515           xaxis label="Mean Predicted Probability";
5516           yaxis label="Mean Actual Default Rate";
5517           title "Calibration Plot - Predicted vs Actual";
5518       run;
5519       
5520       /*****************************************************************************
5521        * 8. Generate Validation Report
5522        *****************************************************************************/
5523       
5524       /* Compile validation metrics */
5525       data work.validation_summary;
5526           merge work.auc_summary
5527                 work.ks_statistic
5528                 work.psi_summary;
5529           length model $20 status $20;
5530           model = "Logistic Regression";
5531       
5532           /* Determine model status based on metrics */
5533           if AUC >= 0.7 and KS_Statistic >= 0.3 and PSI < 0.25 then
5534               status = "Production Ready";
5535           else if AUC >= 0.65 then
5536               status = "Requires Review";
5537           else
5538               status = "Needs Improvement";
5539       run;
5540       
5541       proc print data=work.validation_summary noobs;
5542           title "Model Validation Summary";
5543       run;
