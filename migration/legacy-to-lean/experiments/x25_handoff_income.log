3657       /*****************************************************************************
3658        * 2. Train Logistic Regression Model
3659        *****************************************************************************/
3660       
3661       /* Train logistic regression with stepwise selection */
3662       proc logistic data=work.model_features_train descending;
3663           model default_flag =
3664               /* Core risk metrics */
3665               credit_utilization_capped debt_ratio_capped
3666       
3667               /* Late payment indicators */
3668               num_late_30_59 num_late_60_89 num_late_90_plus
3669               total_late_payments has_delinquency has_serious_delinquency
3670       
3671               /* Financial metrics */
3672               age monthly_income log_monthly_income
3673               num_credit_lines num_real_estate_loans log_num_credit_lines
3674               num_dependents income_per_dependent credit_lines_per_person
3675       
3676               /* Risk flags */
3677               flag_high_utilization flag_very_high_utilization
3678               flag_high_debt_ratio flag_very_high_debt_ratio
3679               flag_recent_late_payments flag_serious_delinquency
3680               flag_multiple_delinquencies flag_low_income
3681               flag_many_dependents flag_few_credit_lines
3682               total_risk_flags
3683       
3684               /* Categorical indicators */
3685               credit_util_category debt_category age_category
3686       
3687               /* Composite scores */
3688               financial_health
3689       
3690               /* Interaction features */
3691               age_income_interaction utilization_debt_interaction
3692       
3693               /* Missing value flags */
3694               MonthlyIncome_missing Dependents_missing
3695       
3696           / selection=stepwise slentry=0.05 slstay=0.05
3697             ctable lackfit rsquare;
3698       
3699           /* Output predictions */
3700           output out=work.logit_scored_train
3701                  predicted=pd_logistic;
3702       
3703           /* Store model for scoring */
3704           store work.logit_model;
3705       
3706           /* Output parameter estimates (coefficients) */
3707           ods output ParameterEstimates=work.model_coefficients;
3708       
3709           title "Logistic Regression Model - Credit Default Prediction";
3710       run;
3711       
3712       /*****************************************************************************
3713        * 3. Evaluate Model on Training Data
3714        *****************************************************************************/
3715       
3716       /* Add binary prediction variable */
3717       data work.logit_scored_train;
3718           set work.logit_scored_train;
3719           pred_logistic = (pd_logistic >= 0.5);
3720       run;
3721       
3722       /* Confusion matrix on training set */
3723       proc freq data=work.logit_scored_train noprint;
3724           tables default_flag * pred_logistic / out=work.confusion_matrix_train;
3725       run;
3726       
3727       proc print data=work.confusion_matrix_train;
3728           title "Confusion Matrix - Training Set";
3729       run;
3730       
3731       /* Calculate precision, recall, and F1 score for training set */
3732       data work.training_metrics;
3733           set work.confusion_matrix_train end=eof;
3734           retain TP TN FP FN 0;
3735       
3736           if default_flag = 1 and pred_logistic = 1 then TP = count;
3737           else if default_flag = 0 and pred_logistic = 0 then TN = count;
3738           else if default_flag = 0 and pred_logistic = 1 then FP = count;
3739           else if default_flag = 1 and pred_logistic = 0 then FN = count;
3740       
3741           if eof then do;
3742               if (TP + FP) > 0 then train_precision = TP / (TP + FP);
3743               else train_precision = .;
3744               if (TP + FN) > 0 then train_recall = TP / (TP + FN);
3745               else train_recall = .;
3746               if (train_precision + train_recall) > 0 then train_f1_score = 2 * (train_precision * train_recall) /
3746     ! (train_precision + train_recall);
3747               else train_f1_score = .;
3748               if (TP + TN + FP + FN) > 0 then train_accuracy = (TP + TN) / (TP + TN + FP + FN);
3749               else train_accuracy = .;
3750               output;
3751           end;
3752           keep train_precision train_recall train_f1_score train_accuracy;
3753       run;
3754       
3755       proc print data=work.training_metrics;
3756           title "Training Set - Performance Metrics";
3757           format train_precision train_recall train_f1_score train_accuracy 8.4;
3758       run;
