1197       /*****************************************************************************
1198        * 2. Data Cleaning and Missing Value Handling
1199        *****************************************************************************/
1200       
1201       /* First convert MonthlyIncome to numeric if needed */
1202       data work.credit_raw_clean;
1203           set work.credit_raw;
1204       
1205           /* Convert to numeric - input function handles character to numeric */
1206           MonthlyIncome_num = input(MonthlyIncome, best32.);
1207           NumberOfDependents_num = input(NumberOfDependents, best32.);
1208       
1209           /* Keep the numeric versions, drop character if they exist */
1210           drop MonthlyIncome NumberOfDependents;
1211           rename MonthlyIncome_num = MonthlyIncome
1212                  NumberOfDependents_num = NumberOfDependents;
