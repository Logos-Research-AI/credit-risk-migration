6045               put _infile_;
6046               do i = 1 to countc(_infile_, ',') + 1;
6047                   if i > 1 then put ',' @;
6048                   if upcase(compress(scan(_infile_, i, ',', 'm'), , 'kn')) in
6049                      ('SERIOUSDLQIN2YRS', 'MONTHLYINCOME', 'NUMBEROFDEPENDENTS') then put 'NA' @;
6050                   else put '1' @;
6051               end;
6052               if len > 0 then if char(_infile_, len) = '0D'x then put '0D'x @;
6053               put;
6054           end;
6055           call symputx('test_lines', _n_);
6056       run;
