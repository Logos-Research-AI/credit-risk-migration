427         * 4. Split into Training and Validation Sets (70/30)
428         *****************************************************************************/
429        
430        /* Set random seed for reproducibility */
431        proc surveyselect data=work.credit_features
432                          out=work.credit_split
433                          samprate=0.7
434                          seed=42
435                          outall;
436        run;
437        
438        data work.credit_train work.credit_validation;
439            set work.credit_split;
440            if selected = 1 then output work.credit_train;
441            else output work.credit_validation;
442            drop selected;
443        run;
