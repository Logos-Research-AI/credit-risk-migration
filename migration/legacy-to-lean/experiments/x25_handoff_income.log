3760       /*****************************************************************************
3761        * 4. Score Validation Set
3762        *****************************************************************************/
3763       
3764       /* Score validation set with trained model */
3765       proc plm restore=work.logit_model;
3766           score data=work.model_features_validation
3767                 out=work.logit_scored_valid_temp
3768                 predicted=predicted_logit;
3769       run;
3770       
3771       /* Convert logit to probability */
3772       data work.logit_scored_valid;
3773           set work.logit_scored_valid_temp;
3774       
3775           /* Apply inverse logit (logistic) function */
3776           pd_logistic = 1 / (1 + exp(-predicted_logit));
3777       
3778           /* Add binary prediction */
3779           pred_logistic = (pd_logistic >= 0.5);
3780       
3781           drop predicted_logit;
3782       run;
3783       
3784       /* Confusion matrix on validation set */
3785       proc freq data=work.logit_scored_valid noprint;
3786           tables default_flag * pred_logistic / out=work.confusion_matrix;
3787       run;
3788       
3789       proc print data=work.confusion_matrix;
3790           title "Confusion Matrix - Validation Set";
3791       run;
3792       
3793       /* Calculate precision, recall, and F1 score for validation set */
3794       data work.validation_metrics;
3795           set work.confusion_matrix end=eof;
3796           retain TP TN FP FN 0;
3797       
3798           if default_flag = 1 and pred_logistic = 1 then TP = count;
3799           else if default_flag = 0 and pred_logistic = 0 then TN = count;
3800           else if default_flag = 0 and pred_logistic = 1 then FP = count;
3801           else if default_flag = 1 and pred_logistic = 0 then FN = count;
3802       
3803           if eof then do;
3804               if (TP + FP) > 0 then valid_precision = TP / (TP + FP);
3805               else valid_precision = .;
3806               if (TP + FN) > 0 then valid_recall = TP / (TP + FN);
3807               else valid_recall = .;
3808               if (valid_precision + valid_recall) > 0 then valid_f1_score = 2 * (valid_precision * valid_recall) /
3808     ! (valid_precision + valid_recall);
3809               else valid_f1_score = .;
3810               if (TP + TN + FP + FN) > 0 then valid_accuracy = (TP + TN) / (TP + TN + FP + FN);
3811               else valid_accuracy = .;
3812               output;
3813           end;
3814           keep valid_precision valid_recall valid_f1_score valid_accuracy;
3815       run;
3816       
3817       proc print data=work.validation_metrics;
3818           title "Validation Set - Performance Metrics";
3819           format valid_precision valid_recall valid_f1_score valid_accuracy 8.4;
