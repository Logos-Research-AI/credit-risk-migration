2590       
2591       /* Calculate income medians by age group for imputation */
2592       proc sql;
2593           create table work.income_medians as
2594           select
2595               case
2596                   when age < 30 then 1
2597                   when age < 40 then 2
2598                   when age < 50 then 3
2599                   when age < 60 then 4
2600                   else 5
2601               end as age_group,
2602               median(MonthlyIncome) as median_income
2603           from work.credit_raw_clean
2604           where MonthlyIncome is not missing
2605           group by calculated age_group;
2606       quit;
2607       
2608       /* One row per age group, with the median of all known incomes:
2609          the fallback for an age group that has no known income */
2610       data work.age_groups;
2611           do age_group = 1 to 5;
2612               output;
2613           end;
2614       run;
2615       
2616       proc sql;
2617           create table work.income_medians_all as
2618           select
2619               g.age_group,
2620               m.median_income,
2621               (select median(MonthlyIncome) from work.credit_raw_clean
2622                where MonthlyIncome is not missing) as overall_median_income
2623           from work.age_groups g
2624           left join work.income_medians m
2625           on g.age_group = m.age_group
2626           order by g.age_group;
2627       quit;
2628       
2629       data work.credit_cleaned;
2630           set work.credit_raw_clean;
2631       
2632           /* Create age group for income imputation */
2633           if age < 30 then age_group = 1;
2634           else if age < 40 then age_group = 2;
2635           else if age < 50 then age_group = 3;
2636           else if age < 60 then age_group = 4;
2637           else age_group = 5;
2638       
2639           /* Handle missing values - create flags */
2640           if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
2641           else MonthlyIncome_missing = 0;
2642       
2643           if missing(NumberOfDependents) then do;
2644               NumberOfDependents = 0;
2645               Dependents_missing = 1;
2646           end;
2647           else Dependents_missing = 0;
2648       run;
2649       
2650       /* Merge and impute income - rename columns in SQL */
2651       proc sql;
2652           create table work.credit_imputed as
2653           select
2654               a.VAR1 as row_id,
2655               a.SeriousDlqin2yrs as default_flag,
2656               a.age,
2657               case when a.MonthlyIncome_missing = 1 then coalesce(b.median_income, b.overall_median_income)
2658                    else a.MonthlyIncome
2659               end as monthly_income,
2660               a.MonthlyIncome_missing,
2661               a.NumberOfDependents as num_dependents,
2662               a.Dependents_missing,
2663               a.age_group,
2664               a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
2665               a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
2666               a.NumberOfTimes90DaysLate as num_late_90_plus,
2667               a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
2668               a.DebtRatio * 100 as debt_ratio,
2669               a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
2670               a.NumberRealEstateLoansOrLines as num_real_estate_loans
2671           from work.credit_cleaned a
2672           left join work.income_medians_all b
2673           on a.age_group = b.age_group;
2674       quit;
2675       
2676       /*****************************************************************************
2677        * 3. Feature Engineering
2678        *****************************************************************************/
2679       
2680       data work.credit_features;
2681           set work.credit_imputed;
2682       
2683           /* Total late payments across all categories */
2684           total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
2685       
2686           /* Has any delinquency indicator */
2687           has_delinquency = (total_late_payments > 0);
2688       
2689           /* Has serious delinquency (90+ days) */
2690           has_serious_delinquency = (num_late_90_plus > 0);
2691       
2692           /* Credit utilization categories */
2693           if credit_utilization < 30 then credit_util_category = 1; /* Low */
2694           else if credit_utilization < 50 then credit_util_category = 2; /* Medium */
2695           else if credit_utilization < 75 then credit_util_category = 3; /* High */
2696           else credit_util_category = 4; /* Very High */
2697       
2698           /* Debt ratio categories */
2699           if debt_ratio < 30 then debt_category = 1; /* Low */
2700           else if debt_ratio < 43 then debt_category = 2; /* Medium */
2701           else if debt_ratio < 60 then debt_category = 3; /* High */
2702           else debt_category = 4; /* Very High */
2703       
2704           /* Income per dependent (handle division by zero) */
2705           if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
2706           else income_per_dependent = monthly_income;
2707       
2708           /* Credit lines per person in household */
2709           credit_lines_per_person = num_credit_lines / (num_dependents + 1);
2710       
2711           /* Age categories for risk assessment */
2712           if age < 25 then age_category = 1; /* Young */
2713           else if age < 35 then age_category = 2; /* Young Adult */
2714           else if age < 50 then age_category = 3; /* Middle Age */
2715           else if age < 65 then age_category = 4; /* Mature */
2716           else age_category = 5; /* Senior */
2717       
2718           /* Risk flags */
2719           flag_high_utilization = (credit_utilization > 75);
2720           flag_very_high_utilization = (credit_utilization > 100);
2721           flag_high_debt_ratio = (debt_ratio > 43);
2722           flag_very_high_debt_ratio = (debt_ratio > 60);
2723           flag_recent_late_payments = (num_late_30_59 > 0);
2724           flag_serious_delinquency = (num_late_90_plus > 0);
2725           flag_multiple_delinquencies = (total_late_payments >= 3);
2726           flag_low_income = (monthly_income < 2500);
2727           flag_many_dependents = (num_dependents >= 3);
2728           flag_few_credit_lines = (num_credit_lines <= 2);
2729       
2730           /* Total risk flags */
2731           total_risk_flags = sum(flag_high_utilization, flag_very_high_utilization,
2732                                 flag_high_debt_ratio,
2733                                 flag_serious_delinquency, flag_multiple_delinquencies,
2734                                 flag_low_income, flag_many_dependents,
2735                                 flag_few_credit_lines);
2736       
2737           /* Financial health score (0-100) */
2738           financial_health = 100;
2739           if credit_utilization > 30 then financial_health = financial_health - 15;
2740           if credit_utilization > 75 then financial_health = financial_health - 15;
2741           if debt_ratio > 43 then financial_health = financial_health - 20;
2742           if has_delinquency then financial_health = financial_health - 20;
2743           if num_late_90_plus > 0 then financial_health = financial_health - 30;
2744           financial_health = max(0, financial_health);
2745       
2746           /* Log transformations for skewed variables (add 1 to handle zeros) */
2747           log_monthly_income = log(monthly_income + 1);
2748           log_num_credit_lines = log(num_credit_lines + 1);
2749           log_total_late_payments = log(total_late_payments + 1);
2750       
2751           /* Interaction features */
2752           if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
2753           else age_income_interaction = age * log_monthly_income;
2754           utilization_debt_interaction = credit_utilization * debt_ratio;
2755       
2756           /* Cap extreme outliers in credit_utilization and debt_ratio */
2757           credit_utilization_capped = min(credit_utilization, 200);
2758           debt_ratio_capped = min(debt_ratio, 500);
2759       run;
2760       
2761       /*****************************************************************************
2762        * 4. Split into Training and Validation Sets (70/30)
2763        *****************************************************************************/
2764       
2765       /* Set random seed for reproducibility */
2766       proc surveyselect data=work.credit_features
2767                         out=work.credit_split
2768                         samprate=0.7
2769                         seed=42
2770                         outall;
2771       run;
2772       
2773       data work.credit_train work.credit_validation;
2774           set work.credit_split;
2775           if selected = 1 then output work.credit_train;
2776           else output work.credit_validation;
2777           drop selected;
2778       run;
2779       
2780       /*****************************************************************************
2781        * 5. Summary Statistics
2782        *****************************************************************************/
2783       
2784       proc means data=work.credit_train n mean std min max;
2785           var age monthly_income credit_utilization debt_ratio total_late_payments
2786               num_credit_lines num_real_estate_loans default_flag;
2787           title "Training Set Summary Statistics";
2788       run;
2789       
2790       proc freq data=work.credit_train;
2791           tables default_flag;
2792           title "Training Set - Default Rate";
2793       run;
2794       
2795       proc means data=work.credit_validation n mean std min max;
2796           var age monthly_income credit_utilization debt_ratio total_late_payments
2797               num_credit_lines num_real_estate_loans default_flag;
2798           title "Validation Set Summary Statistics";
2799       run;
2800       
2801       proc freq data=work.credit_validation;
2802           tables default_flag;
2803           title "Validation Set - Default Rate";
2804       run;
2805       
2806       /*****************************************************************************
2807        * 6. Export Engineered Features
2808        *****************************************************************************/
2809       
2810       /* Ensure all variables are numeric before export */
2811       data work.credit_train_export;
2812           set work.credit_train;
2813           /* Force numeric format for all variables */
2814           format _numeric_ best12.;
2815       run;
2816       
2817       data work.credit_validation_export;
2818           set work.credit_validation;
2819           /* Force numeric format for all variables */
2820           format _numeric_ best12.;
2821       run;
2822       
2823       /* Export the training income medians (per age group, and overall):
2824          predict.sas imputes the test set from them */
2825       data work.income_medians_export;
2826           set work.income_medians_all;
2827           format median_income overall_median_income best32.;
2828       run;
2829       
2830       proc export data=work.income_medians_export
2831           outfile="&output_path/income_medians.csv"
2832           dbms=csv
2833           replace;
