6069                          test_features test_scored_temp test_scored test_predictions
6070                          kaggle_submission test_predictions_full;
6071               quit;
6072           %end;
6073           proc import datafile="&source"
6074               out=work.test_raw
6075               dbms=csv
6076               replace;
6077               getnames=yes;
6078               guessingrows=max;
6079           run;
6080           %if &test_lines = 1 and %sysfunc(exist(work.test_raw)) %then %do;
6081               data work.test_raw;
6082                   set work.test_raw;
