2553       proc sql noprint;
2554           select coalesce(sum(bad_row), 0), count(*) - count(distinct VAR1), coalesce(sum(known_income), 0)
2555           into :bad_rows trimmed, :duplicate_ids trimmed, :known_incomes trimmed
2556           from work.input_check;
2557       quit;
