283        /* Check the input conditions: stop with an error before anything is exported */
284        /* The numeric value of a raw column: a numeric column as it is; a character column
285           read as a number, missing when the text is no number or is longer than 32 characters */
286        %macro num(v);
287            %local dsid pos vtype;
288            %let vtype = ;
289            %let dsid = %sysfunc(open(work.credit_raw));
290            %let pos = %sysfunc(varnum(&dsid, &v));
291            %if &pos > 0 %then %let vtype = %sysfunc(vartype(&dsid, &pos));
292            %let dsid = %sysfunc(close(&dsid));
293            %if &vtype = N %then "&v"n;
294            %else ifn(lengthn(strip("&v"n)) <= 32, input(strip("&v"n), ?? best32.), .);
295        %mend;
296        
297        %let columns_ok = 0;
298        %let bad_rows = 1;
299        %let duplicate_ids = 1;
300        %let known_incomes = 0;
301        
302        proc sql noprint;
303            /* The expected columns and no others */
304            select (count(*) = 12 and sum(upcase(name) in
305                       ('VAR1', 'SERIOUSDLQIN2YRS', 'AGE', 'MONTHLYINCOME', 'NUMBEROFDEPENDENTS',
306                        'REVOLVINGUTILIZATIONOFUNSECUREDL', 'DEBTRATIO',
307                        'NUMBEROFTIME30-59DAYSPASTDUENOTW', 'NUMBEROFTIME60-89DAYSPASTDUENOTW',
308                        'NUMBEROFTIMES90DAYSLATE', 'NUMBEROFOPENCREDITLINESANDLOANS',
309                        'NUMBERREALESTATELOANSORLINES')) = 12)
310            into :columns_ok trimmed
311            from dictionary.columns
312            where libname = 'WORK' and memname = 'CREDIT_RAW';
313        quit;
314        
315        /* Only MonthlyIncome and NumberOfDependents may be missing (blank or NA);
316           the outcome is 0 or 1; the counts are whole numbers, zero or more;
317           a known MonthlyIncome is zero or more */
318        data work.input_check;
319            set work.credit_raw;
320            bad_row = (missing(%num(VAR1))
321                or %num(SeriousDlqin2yrs) not in (0, 1)
322                or missing(%num(age))
323                or missing(%num(RevolvingUtilizationOfUnsecuredL))
324                or missing(%num(DebtRatio))
325                or missing(%num(NumberRealEstateLoansOrLines))
326                or not (%num(NumberOfTime30-59DaysPastDueNotW) >= 0 and
327                        %num(NumberOfTime30-59DaysPastDueNotW) = int(%num(NumberOfTime30-59DaysPastDueNotW)))
328                or not (%num(NumberOfTime60-89DaysPastDueNotW) >= 0 and
329                        %num(NumberOfTime60-89DaysPastDueNotW) = int(%num(NumberOfTime60-89DaysPastDueNotW)))
330                or not (%num(NumberOfTimes90DaysLate) >= 0 and
331                        %num(NumberOfTimes90DaysLate) = int(%num(NumberOfTimes90DaysLate)))
332                or not (%num(NumberOfOpenCreditLinesAndLoans) >= 0 and
333                        %num(NumberOfOpenCreditLinesAndLoans) = int(%num(NumberOfOpenCreditLinesAndLoans)))
334                or (upcase(cats(MonthlyIncome)) not in ('', '.', 'NA') and missing(%num(MonthlyIncome)))
335                or (not missing(%num(MonthlyIncome)) and %num(MonthlyIncome) < 0)
336                or (upcase(cats(NumberOfDependents)) not in ('', '.', 'NA') and
337                    not (%num(NumberOfDependents) >= 0 and
338                         %num(NumberOfDependents) = int(%num(NumberOfDependents)))));
339            known_income = not missing(%num(MonthlyIncome));
340            keep VAR1 bad_row known_income;
341        run;
342        
343        /* Bad rows, repeated row ids, known incomes */
344        proc sql noprint;
345            select coalesce(sum(bad_row), 0), count(*) - count(distinct VAR1), coalesce(sum(known_income), 0)
346            into :bad_rows trimmed, :duplicate_ids trimmed, :known_incomes trimmed
347            from work.input_check;
348        quit;
349        
350        data _null_;
351            if &columns_ok ne 1 or &bad_rows ne 0 or &duplicate_ids ne 0 or &known_incomes < 1 then do;
352                put "ERROR: cs-training.csv does not meet the input conditions: "
353                    "columns_ok=&columns_ok bad_rows=&bad_rows duplicate_ids=&duplicate_ids known_incomes=&known_incomes..";
354                put "ERROR: Feature engineering stopped. Nothing is exported.";
355                abort cancel;
356            end;
357        run;
