364        /*****************************************************************************
365         * 2. Data Cleaning and Missing Value Handling
366         *****************************************************************************/
367        
368        /* First convert MonthlyIncome to numeric if needed */
369        data work.credit_raw_clean;
370            set work.credit_raw;
371        
372            /* Convert to numeric - input function handles character to numeric */
373            MonthlyIncome_num = input(MonthlyIncome, best32.);
374            NumberOfDependents_num = input(NumberOfDependents, best32.);
375        
376            /* Keep the numeric versions, drop character if they exist */
377            drop MonthlyIncome NumberOfDependents;
378            rename MonthlyIncome_num = MonthlyIncome
379                   NumberOfDependents_num = NumberOfDependents;
380        run;
381        
382        /* Calculate income medians by age group for imputation */
383        proc sql;
384            create table work.income_medians as
385            select
386                case
387                    when age < 30 then 1
388                    when age < 40 then 2
389                    when age < 50 then 3
390                    when age < 60 then 4
391                    else 5
392                end as age_group,
393                median(MonthlyIncome) as median_income
394            from work.credit_raw_clean
395            where MonthlyIncome is not missing
396            group by calculated age_group;
397        quit;
398        
399        /* One row per age group, with the median of all known incomes:
400           the fallback for an age group that has no known income */
401        data work.age_groups;
402            do age_group = 1 to 5;
403                output;
404            end;
405        run;
406        
407        proc sql;
408            create table work.income_medians_all as
409            select
410                g.age_group,
411                m.median_income,
412                (select median(MonthlyIncome) from work.credit_raw_clean
413                 where MonthlyIncome is not missing) as overall_median_income
414            from work.age_groups g
415            left join work.income_medians m
416            on g.age_group = m.age_group
417            order by g.age_group;
418        quit;
419        
420        data work.credit_cleaned;
421            set work.credit_raw_clean;
422        
423            /* Create age group for income imputation */
424            if age < 30 then age_group = 1;
425            else if age < 40 then age_group = 2;
426            else if age < 50 then age_group = 3;
427            else if age < 60 then age_group = 4;
428            else age_group = 5;
429        
430            /* Handle missing values - create flags */
431            if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
432            else MonthlyIncome_missing = 0;
433        
434            if missing(NumberOfDependents) then do;
435                NumberOfDependents = 0;
436                Dependents_missing = 1;
437            end;
438            else Dependents_missing = 0;
439        run;
440        
441        /* Merge and impute income - rename columns in SQL */
442        proc sql;
443            create table work.credit_imputed as
444            select
445                a.VAR1 as row_id,
446                a.SeriousDlqin2yrs as default_flag,
447                a.age,
448                case when a.MonthlyIncome_missing = 1 then coalesce(b.median_income, b.overall_median_income)
449                     else a.MonthlyIncome
450                end as monthly_income,
451                a.MonthlyIncome_missing,
452                a.NumberOfDependents as num_dependents,
453                a.Dependents_missing,
454                a.age_group,
455                a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
456                a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
457                a.NumberOfTimes90DaysLate as num_late_90_plus,
458                a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
459                a.DebtRatio * 100 as debt_ratio,
460                a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
461                a.NumberRealEstateLoansOrLines as num_real_estate_loans
462            from work.credit_cleaned a
463            left join work.income_medians_all b
464            on a.age_group = b.age_group;
465        quit;
466        
467        /*****************************************************************************
468         * 3. Feature Engineering
469         *****************************************************************************/
470        
471        data work.credit_features;
472            set work.credit_imputed;
473        
474            /* Total late payments across all categories */
475            total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
476        
477            /* Has any delinquency indicator */
478            has_delinquency = (total_late_payments > 0);
479        
480            /* Has serious delinquency (90+ days) */
481            has_serious_delinquency = (num_late_90_plus > 0);
482        
483            /* Credit utilization categories */
484            if credit_utilization < 30 then credit_util_category = 1; /* Low */
485            else if credit_utilization < 50 then credit_util_category = 2; /* Medium */
486            else if credit_utilization < 75 then credit_util_category = 3; /* High */
487            else credit_util_category = 4; /* Very High */
488        
489            /* Debt ratio categories */
490            if debt_ratio < 30 then debt_category = 1; /* Low */
491            else if debt_ratio < 43 then debt_category = 2; /* Medium */
492            else if debt_ratio < 60 then debt_category = 3; /* High */
493            else debt_category = 4; /* Very High */
494        
495            /* Income per dependent (handle division by zero) */
496            if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
497            else income_per_dependent = monthly_income;
498        
499            /* Credit lines per person in household */
500            credit_lines_per_person = num_credit_lines / (num_dependents + 1);
501        
502            /* Age categories for risk assessment */
503            if age < 25 then age_category = 1; /* Young */
504            else if age < 35 then age_category = 2; /* Young Adult */
505            else if age < 50 then age_category = 3; /* Middle Age */
506            else if age < 65 then age_category = 4; /* Mature */
507            else age_category = 5; /* Senior */
508        
509            /* Risk flags */
510            flag_high_utilization = (credit_utilization > 75);
511            flag_very_high_utilization = (credit_utilization > 100);
512            flag_high_debt_ratio = (debt_ratio > 43);
513            flag_very_high_debt_ratio = (debt_ratio > 60);
514            flag_recent_late_payments = (num_late_30_59 > 0);
515            flag_serious_delinquency = (num_late_90_plus > 0);
516            flag_multiple_delinquencies = (total_late_payments >= 3);
517            flag_low_income = (monthly_income < 2500);
518            flag_many_dependents = (num_dependents >= 3);
519            flag_few_credit_lines = (num_credit_lines <= 2);
520        
521            /* Total risk flags */
522            total_risk_flags = sum(flag_high_utilization, flag_very_high_utilization,
523                                  flag_high_debt_ratio,
524                                  flag_serious_delinquency, flag_multiple_delinquencies,
525                                  flag_low_income, flag_many_dependents,
526                                  flag_few_credit_lines);
527        
528            /* Financial health score (0-100) */
529            financial_health = 100;
530            if credit_utilization > 30 then financial_health = financial_health - 15;
531            if credit_utilization > 75 then financial_health = financial_health - 15;
532            if debt_ratio > 43 then financial_health = financial_health - 20;
533            if has_delinquency then financial_health = financial_health - 20;
534            if num_late_90_plus > 0 then financial_health = financial_health - 30;
535            financial_health = max(0, financial_health);
536        
537            /* Log transformations for skewed variables (add 1 to handle zeros) */
538            log_monthly_income = log(monthly_income + 1);
539            log_num_credit_lines = log(num_credit_lines + 1);
540            log_total_late_payments = log(total_late_payments + 1);
541        
542            /* Interaction features */
543            if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
544            else age_income_interaction = age * log_monthly_income;
545            utilization_debt_interaction = credit_utilization * debt_ratio;
546        
547            /* Cap extreme outliers in credit_utilization and debt_ratio */
548            credit_utilization_capped = min(credit_utilization, 200);
549            debt_ratio_capped = min(debt_ratio, 500);
550        run;
