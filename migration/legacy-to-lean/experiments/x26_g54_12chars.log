1139       /* Import test data. PROC IMPORT cannot read a file that has its header line and no
1140          applicant: PROC IMPORT then reads the copy, so the columns are named as it names them,
1141          and the made-up applicant is removed, which leaves an empty table. The tables an earlier
1142          scoring left in the session are removed first: a step that fails finds no table to use */
1143       %macro import_test;
1144           %local source;
1145           %let source = &data_path/cs-test.csv;
1146           %if &test_lines = 1 %then %do;
1147               %let source = &header_copy;
1148               proc datasets library=work nolist nowarn;
1149                   delete test_raw input_check test_raw_clean test_cleaned test_imputed
1150                          test_features test_scored_temp test_scored test_predictions
1151                          kaggle_submission test_predictions_full;
1152               quit;
1153           %end;
1154           proc import datafile="&source"
1155               out=work.test_raw
1156               dbms=csv
1157               replace;
1158               getnames=yes;
1159               guessingrows=max;
1160           run;
1161           %if &test_lines = 1 and %sysfunc(exist(work.test_raw)) %then %do;
1162               data work.test_raw;
1163                   set work.test_raw;
1164                   stop;
1165               run;
1166           %end;
1167       %mend;
