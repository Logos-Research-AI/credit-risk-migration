26         /* Inventory experiment X04 (prompt 02 review): how does SAS evaluate
27            utilization_debt_interaction = credit_utilization * debt_ratio / 100 (feature_engineering.sas:197),
28            with credit_utilization = R * 100, debt_ratio = D * 100 (:113-114, PROC SQL)? Rows are the
29            reference rows where Python's IEEE (u*d)/100 or u*d*0.01 does not print SAS's BEST12. text. */
30         data x;
31           length rid $8 rs ds $40;
32           input rid $ rs $ ds $;
33           R = input(rs, best32.); D = input(ds, best32.);
34           u = R * 100; d2 = D * 100;
35           p = u * d2; q = p / 100; w = p * 0.01;
36           put "X04 " rid R hex16. " " D hex16. " " u hex16. " " d2 hex16. " " p hex16. " " q hex16. " " w hex16. " " q best12.;
37         datalines;
