25         /* X16: the classification table (ctable) of an intercept-only fit. Which leave-one-out probability does
26            PROC LOGISTIC use, how are the levels built, and is a probability equal to a level counted at it?
27            For n observations with e events: the Classification table with ProbLevel in hex16., and the
28            cross-validated probability of the OUTPUT statement (predprobs=crossvalidate), which the documentation
29            gives as the probability the ctable option uses, in hex16.
30            The first eight cases are the fits of judge/runs (emptyval_n2/n3/n4_both, gen_s19, s22, s23, s25, s29),
31            as a check that this program's table is the pipeline's. */
32         options linesize=max nonotes;
33         %macro one(n, e);
34         data work.d; do i = 1 to &n; y = (i <= &e); output; end; run;
35         ods select none;
36         proc logistic data=work.d descending;
37           model y = / ctable;
38           output out=work.o predprobs=(individual crossvalidate);
39           ods output Classification=work.ct ParameterEstimates=work.pe;
40         run;
41         ods select all;
42         data _null_; set work.pe; put "PE|&n|&e|" Estimate hex16. " " Estimate best32.; run;
43         data _null_; set work.ct;
44           put "CT|&n|&e|" ProbLevel hex16. " " ProbLevel best32. " " CorrectEvents CorrectNonevents IncorrectEvents IncorrectNonevents;
45         run;
46         proc sort data=work.o out=work.o1 nodupkey; by y; run;
47         data _null_; set work.o1; put "XP|&n|&e|y=" y " IP_1=" IP_1 hex16. " " IP_1 best32. " XP_1=" XP_1 hex16. " " XP_1 best32.; run;
48         proc datasets lib=work nolist; delete d o o1 ct pe; quit;
49         %mend;
