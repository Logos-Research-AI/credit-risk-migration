+def _p_w_r(eta: FloatArray, y: FloatArray) -> tuple[FloatArray, FloatArray, FloatArray]:
+    """Probability, weight and residual y - p as SAS has them when a probability is near 0 or 1: with
+    e = exp(-|eta|), hi = 1 / (1 + e) is the probability of the likelier outcome and lo = e * hi that of the
+    other; lo is 0 when hi rounds to 1 (|eta| > 53 ln 2 = 36.74). Weight hi * lo; residual from hi and lo."""
+    e = np.exp(-np.abs(eta))
+    hi = 1.0 / (1.0 + e)
+    lo = np.where(hi < 1.0, e * hi, 0.0)
+    p1 = np.where(eta >= 0, hi, lo)
+    return p1, hi * lo, np.where(y == 1, np.where(eta >= 0, lo, hi), -p1)
+
+
+def _ginv(a: FloatArray) -> tuple[FloatArray, tuple[int, ...]]:
+    """SAS's inverse of an information matrix that may be singular: the parameters are taken in order, and
+    one whose pivot (its diagonal element after the earlier ones are swept out) is not above 1e-9 times
+    its own diagonal element is left out: its row and column of the inverse are 0."""
+    keep: list[int] = []
+    for j in range(a.shape[0]):
+        piv = a[j, j] - (a[j, keep] @ np.linalg.solve(a[np.ix_(keep, keep)], a[keep, j]) if keep else 0.0)
+        if a[j, j] > 0.0 and piv > 1e-9 * a[j, j]:
+            keep.append(j)
+    g = np.zeros_like(a)
+    if keep:
+        g[np.ix_(keep, keep)] = np.linalg.inv(a[np.ix_(keep, keep)])
+    return g, tuple(j for j in range(a.shape[0]) if j not in keep)
 
 
