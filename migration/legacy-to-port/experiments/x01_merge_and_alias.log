25         /* Inventory experiment X01 (prompt 02): settle two SAS behaviors empirically.
26            (a) one-to-one MERGE (no BY) when one input has more rows than another
27                -- metrics_calculation.sas:332 merges auc_summary (1 row), ks_statistic
28                   (1+ rows on KS ties), psi_summary (1 row).
29            (b) PROC SQL "select x + 1 as x ... group by x": source column or alias?
30                -- metrics_calculation.sas:192 (decile + 1 as decile ... group by decile). */
31         data a; auc = 0.8; run;
32         data k; ks = 0.5; output; ks = 0.6; output; run;
33         data p; psi = 0.01; run;
34         data merged; merge a k p; run;
35         proc print data=merged noobs; title "X01a one-to-one merge"; run;
