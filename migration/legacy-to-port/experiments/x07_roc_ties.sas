;
ods select none;
proc logistic data=ra;
  by g;
  model y(event='1') = p / nofit;
  roc 'M' pred=p;
  ods output ROCAssociation=ro;
run;
ods select all;
data _null_; set ro;
  put "X07 roc " g= Area= hex16. StdErr= hex16. LowerArea= hex16. UpperArea= hex16. SomersD= hex16. Gamma= hex16. TauA= hex16.;
run;

/* (C) Association table of a fitted model with near-tied predicted probabilities */
%macro fitc(seed, delta);
data fc; call streaminit(&seed);
  do i = 1 to 400;
    x0 = round(rand('normal'), 0.5); j = rand('integer', 0, 4);
    x = x0 + j * &delta;
    y = rand('bernoulli', 1 / (1 + exp(-(-1 + x0))));
    output;
  end;
run;
ods select none;
proc logistic data=fc descending;
  model y = x;
  output out=fco predicted=p;
  ods output Association=fca ParameterEstimates=fcp;
run;
ods select all;
data _null_; set fcp; put "X07 C&seed coef " Variable= Estimate= hex16.; run;
data _null_; set fca; put "X07 C&seed assoc " Label1= nValue1= hex16. nValue1= best32. Label2= nValue2= hex16.; run;
data _null_; set fco; put "X07 C&seed row " i= y= p= hex16.; run;
%mend;
%fitc(1, 2e-8);
%fitc(2, 3e-8);
%fitc(3, 1.5e-8);
%fitc(4, 5e-8);
