2188       /* (C) Association table of a fitted model with near-tied predicted probabilities */
2189       %macro fitc(seed, delta);
2190       data fc; call streaminit(&seed);
2191         do i = 1 to 400;
2192           x0 = round(rand('normal'), 0.5); j = rand('integer', 0, 4);
2193           x = x0 + j * &delta;
2194           y = rand('bernoulli', 1 / (1 + exp(-(-1 + x0))));
2195           output;
2196         end;
2197       run;
2198       ods select none;
2199       proc logistic data=fc descending;
2200         model y = x;
2201         output out=fco predicted=p;
2202         ods output Association=fca ParameterEstimates=fcp;
2203       run;
2204       ods select all;
2205       data _null_; set fcp; put "X07 C&seed coef " Variable= Estimate= hex16.; run;
2206       data _null_; set fca; put "X07 C&seed assoc " Label1= nValue1= hex16. nValue1= best32. Label2= nValue2= hex16.; run;
2207       data _null_; set fco; put "X07 C&seed row " i= y= p= hex16.; run;
2208       %mend;
2209       %fitc(1, 2e-8);
