index 0000000..875b425
--- /dev/null
+++ b/port/tests/test_left_out_final.py
@@ -0,0 +1,152 @@
+"""A final model with a parameter left out of a singular information matrix (variance exactly 0), as SAS.
+
+    cd port && uv run python tests/test_left_out_final.py        (or: uv run pytest tests)
+
+Experiment X22 (migration/legacy-to-port/experiments/x22_left_out_final.py): train.sas with its MODEL
+statement fixed to the design's variables and no selection, on the staged feature files of
+tests/data/x22_<design> (SAS's outputs copied there as sas_*.csv, the list of files it wrote in
+sas_files.txt). The selection path is not known to reach such a final model, so train.py is run with
+the selection replaced by the design's fit.
+  A  X21 S1: one event, the flag 1 on it alone; left out at the last iteration (weight 0), complete
+     separation.
+  B  num_late_90_plus = 2 * the flag: the flag is a linear combination, left out from the start; converged.
+  C  three events, one flagged alone: left out at the last iteration (weight 0); converged.
+SAS: the left-out parameter is printed with DF 0, Estimate 0 and empty cells and has no odds ratio; OUTPUT and
+PROC PLM predict with 0 for it, and Hosmer-Lemeshow uses those probabilities; the Association table is of the
+last iteration's estimates, the left-out value included; no Classification table in A and C, one in B.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import csv
+import io
+import json
+import sys
+import tempfile
+import warnings
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent))
+from credit_risk import sas_compat, train  # noqa: E402
+
+DATA = HERE / "data"
+DESIGNS = {
+    "A": ["age", "flag_recent_late_payments"],
+    "B": ["num_late_90_plus", "age", "flag_recent_late_payments"],
+    "C": ["age", "flag_recent_late_payments"],
+}
+TABLES = [
+    "model_coefficients",
+    "printed_odds_ratios",
+    "printed_association",
+    "printed_hl_partition",
+    "printed_hosmer_lemeshow",
+    "printed_classification",
+]
+# depend on the selection (SAS ran without one): not compared
+SELECTION = {
+    "stepwise_summary.csv",
+    "printed_fit_statistics.csv",
+    "printed_global_tests.csv",
+    "printed_rsquare.csv",
+}
+TRAIN_FILES = {
+    "risk_scores_train.csv",
+    "risk_scores_validation.csv",
+    "final_model_output.csv",
+    "model_summary.csv",
+    "model_coefficients.csv",
+    "printed_association.csv",
+    "printed_odds_ratios.csv",
+    "printed_hl_partition.csv",
+    "printed_hosmer_lemeshow.csv",
+    "printed_classification.csv",
+    "printed_roc_train.csv",
+    "printed_roc_validation.csv",
+    "printed_confusion_train.csv",
+    "printed_confusion_validation.csv",
+}
+
+
+def run_design(name: str, out: Path) -> sas_compat.LogisticFit:
+    cols = DESIGNS[name]
+    fits: list[sas_compat.LogisticFit] = []
+
+    def fixed(df: Any, response: str, candidates: Any, *_a: Any) -> sas_compat.StepwiseResult:
+        used = df.select([response, *candidates]).drop_nulls()
+        y = used.get_column(response).to_numpy().astype(np.float64)
+        x = np.column_stack(
+            [np.ones(len(y)), *[used.get_column(c).to_numpy().astype(np.float64) for c in cols]]
+        )
+        fit = sas_compat._fit_as_sas(x, y, ["Intercept", *cols])
+        assert fit is not None
+        fits.append(fit)
+        return sas_compat.StepwiseResult([], fit, sas_compat.fit_logistic(x[:, :1], y, ["Intercept"]))
+
+    real = sas_compat.stepwise_logistic
+    sas_compat.stepwise_logistic = fixed  # type: ignore[assignment]
+    try:
+        with contextlib.redirect_stdout(io.StringIO()), warnings.catch_warnings():
+            warnings.simplefilter("ignore")
+            train.run(DATA / f"x22_{name}", out)
+    finally:
+        sas_compat.stepwise_logistic = real  # type: ignore[assignment]
+    return fits[0]
+
+
+def column(path: Path, name: str) -> list[str]:
+    with path.open() as fh:
+        return [r[name] for r in csv.DictReader(fh)]
+
+
+def test_designs_are_sas() -> None:
+    for name in DESIGNS:
+        d = DATA / f"x22_{name}"
+        with tempfile.TemporaryDirectory() as tmp:
+            out = Path(tmp)
+            fit = run_design(name, out)
+            # the fit leaves the flag out at its last iteration (variance exactly 0)
+            assert sas_compat._left_out(fit) == ["flag_recent_late_payments"], (
+                name,
+                sas_compat._left_out(fit),
+            )
+            sas_files = set((d / "sas_files.txt").read_text().split()) & TRAIN_FILES
+            port_files = {p.name for p in out.iterdir()} & TRAIN_FILES
+            assert port_files == sas_files, (name, sas_files ^ port_files)
+            for t in TABLES:
+                if not (d / f"sas_{t}.csv").exists():
+                    continue
+                want = (d / f"sas_{t}.csv").read_text().splitlines()
+                got = (out / f"{t}.csv").read_text().splitlines()
+                if name == "A" and t == "model_coefficients":
+                    # age has no information there: its estimate is a rounding residue on both sides
+                    # (SAS 2.19E-15, the port's iteration -1.1E-15); the other cells are compared
+                    i = [ln.split(",")[0] for ln in want].index("age")
+                    assert abs(float(got[i].split(",")[2])) < 1e-14, got[i]
+                    want = [ln for k, ln in enumerate(want) if k != i]
+                    got = [ln for k, ln in enumerate(got) if k != i]
+                assert got == want, (name, t, [(a, b) for a, b in zip(got, want, strict=False) if a != b][:3])
+            assert (
+                "flag_recent_late_pay,0,0,,,,MLE" in (out / "model_coefficients.csv").read_text().splitlines()
+            )
+            # OUTPUT and PROC PLM: 0 for the left-out parameter (pd_logistic as SAS's, to its 8 digits)
+            for part in ("train", "validation"):
+                a = np.array(column(out / f"risk_scores_{part}.csv", "pd_logistic"), dtype=float)
+                b = np.array(column(d / f"sas_risk_scores_{part}.csv", "pd_logistic"), dtype=float)
+                assert np.allclose(a, b, rtol=1e-7, atol=0.0), (name, part, np.max(np.abs(a / b - 1)))
+            model = json.loads((out / "model.json").read_text())
+            assert model["coefficients"]["flag_recent_late_payments"] == 0.0, model
+            print(
+                f"  {name}: {len(sas_files)} train files as SAS; classification table: "
+                f"{'printed_classification.csv' in port_files}"
+            )
+
+
+if __name__ == "__main__":
+    test_designs_are_sas()
+    print("ALL OK")
diff --git a/port/tests/test_leverage_one.py b/port/tests/test_leverage_one.py
new file mode 100644
index 0000000..ed489a5
--- /dev/null
+++ b/port/tests/test_leverage_one.py
@@ -0,0 +1,141 @@
+"""The classification table on a fit with an observation of leverage 1 or near it (experiment X21).
+
+    cd port && uv run python tests/test_leverage_one.py        (or: uv run pytest tests)
+
+SAS makes no one-step adjustment for an observation whose leverage is within about 1e-8 of 1: its
+cross-validated probability is its predicted probability (adjusted at 1 - h = 1.489e-8, kept at 8.56e-9
+and below). tests/data/sas_x21_leverage.json: the designed fits of
+migration/legacy-to-port/experiments/x21_leverage_one.py (rows, MODEL order, SAS's estimates and its
+Classification table); tests/data/x21_r3_s03: the training feature file and SAS's
+printed_classification.csv of the raw input R3 (judge/runs/x21_r3_s03), where row id 276 has leverage
+1 within 1e-13 and the sign of 1 - h depends on the order the probabilities are summed in.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import io
+import json
+import sys
+import warnings
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import polars as pl
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent))
+from credit_risk import sas_compat  # noqa: E402
+
+DATA = HERE / "data"
+CASES: list[dict[str, Any]] = json.loads((DATA / "sas_x21_leverage.json").read_text())
+COUNTS = ["CorrectEvents", "CorrectNonevents", "IncorrectEvents", "IncorrectNonevents"]
+# train.py's MODEL statement order (train.sas:74-103)
+CANDIDATES = (
+    "credit_utilization_capped debt_ratio_capped num_late_30_59 num_late_60_89 num_late_90_plus "
+    "total_late_payments has_delinquency has_serious_delinquency age monthly_income log_monthly_income "
+    "num_credit_lines num_real_estate_loans log_num_credit_lines num_dependents income_per_dependent "
+    "credit_lines_per_person flag_high_utilization flag_very_high_utilization flag_high_debt_ratio "
+    "flag_very_high_debt_ratio flag_recent_late_payments flag_serious_delinquency "
+    "flag_multiple_delinquencies flag_low_income flag_many_dependents flag_few_credit_lines total_risk_flags "
+    "credit_util_category debt_category age_category financial_health age_income_interaction "
+    "utilization_debt_interaction MonthlyIncome_missing Dependents_missing"
+).split()
+
+
+def rows_of(t: pl.DataFrame) -> list[tuple[Any, ...]]:
+    return [
+        (round(float(r[0]), 3), *(int(v) for v in r[1:])) for r in t.select("ProbLevel", *COUNTS).iter_rows()
+    ]
+
+
+def leverage(x: np.ndarray, p: np.ndarray) -> np.ndarray:
+    w = p * (1.0 - p)
+    return w * np.einsum("ij,jk,ik->i", x, np.linalg.inv(x.T @ (x * w[:, None])), x)
+
+
+def test_designed_fits_are_sas() -> None:
+    """The 18 fits with a Classification table: five with an effect that is 1 on one observation alone
+    (h printed 1) and thirteen with 1 - h from about 1e-4 down to 1e-16; the table from SAS's estimates
+    is SAS's, row for row."""
+    n = near = 0
+    for case in CASES:
+        if not case["classification"]:
+            continue
+        arr = np.array(case["rows"], dtype=float)
+        y = arr[:, 0]
+        x = np.column_stack(
+            [np.ones(len(arr)), *[arr[:, 1 + case["columns"].index(c)] for c in case["model"]]]
+        )
+        p = sas_compat._expit(x @ np.array(case["estimates"]))
+        with warnings.catch_warnings():
+            warnings.simplefilter("ignore")
+            got = rows_of(sas_compat.classification_table(y, x, pd=p))
+            near += bool(np.any(1.0 - leverage(x, p) <= 1e-8))
+        want = [tuple(r) for r in case["classification"]]
+        assert got == want, (case["case"], [(a, b) for a, b in zip(got, want, strict=False) if a != b][:3])
+        n += 1
+    assert n == 18, n
+    print(f"  {n} fits: SAS's table; {near} with an observation whose 1 - h is 1e-8 or less")
+
+
+def test_raw_input_r3_both_orders() -> None:
+    """R3 through train.py's selection: final model age, flag_recent_late_payments,
+    utilization_debt_interaction; SAS's 51 rows whichever order the probabilities are summed in
+    (the pipeline's, 1 - h = -3.2e-14 on row id 276; x @ beta, 5.9e-15 apart, 1 - h = +5.4e-15)."""
+    df = sas_compat.proc_import_csv(DATA / "x21_r3_s03" / "model_features_train.csv", guessingrows=None)
+    ff = df.filter(pl.all_horizontal(pl.col(*CANDIDATES, "default_flag").is_not_null()))
+    with contextlib.redirect_stdout(io.StringIO()):
+        fin = sas_compat.stepwise_logistic(ff, "default_flag", CANDIDATES, 0.05, 0.05).final
+    assert fin is not None
+    assert fin.names == ["Intercept", "utilization_debt_interaction", "age", "flag_recent_late_payments"]
+    y = ff["default_flag"].to_numpy().astype(np.float64)
+    x = np.column_stack([np.ones(ff.height), *[ff[c].to_numpy().astype(np.float64) for c in fin.names[1:]]])
+    eta = pl.lit(float(fin.beta[0]), pl.Float64)  # train.py's pd_logistic: the effects in MODEL order
+    for c in [c for c in CANDIDATES if c in fin.names]:
+        eta = eta + float(fin.beta[fin.names.index(c)]) * pl.col(c)
+    p_pipeline = ff.select(1 / (1 + (-eta).exp())).to_series().to_numpy()
+    p_entry = sas_compat._expit(x @ fin.beta)
+    sas = pl.read_csv(DATA / "x21_r3_s03" / "printed_classification.csv", infer_schema=False)
+    want = [
+        (round(float(r[0]), 3), *(int(v) for v in r[1:]))
+        for r in sas.select("ProbLevel", *COUNTS).iter_rows()
+    ]
+    i = int(ff["row_id"].to_list().index(276))
+    for tag, p in (("pipeline", p_pipeline), ("x @ beta", p_entry)):
+        h = leverage(x, p)
+        assert abs(1.0 - h[i]) < 1e-12, (tag, 1.0 - h[i])
+        got = rows_of(sas_compat.classification_table(y, x, pd=p))
+        assert got == want, (tag, sum(a != b for a, b in zip(got, want, strict=False)), len(got), len(want))
+        print(f"  {tag}: 1 - h of row id 276 = {1.0 - h[i]:.2e}; {len(got)} rows as SAS")
+
+
+def test_rule_is_on_one_minus_h() -> None:
+    """X23 (migration/legacy-to-port/experiments/x23_leverage_tolerance.py): estimates fixed (INEST=,
+    MAXITER=0), so the observation of leverage near 1 has probability 0.5, 1e-9 or 0.999 and its column
+    scale 1e-3, 1 or 1e3. SAS keeps its probability at 1 - h = 5e-9 and 9.5e-9 and adjusts it at 1.2e-8,
+    1.4e-8 and 2e-8, whatever the weight, the scale and the outcome: a test on 1 - h alone, inside
+    (9.5e-9, 1.2e-8]. The port's table is SAS's on all 17 fits."""
+    cases: list[dict[str, Any]] = json.loads((DATA / "sas_x23_leverage.json").read_text())
+    kept = 0
+    for case in cases:
+        arr = np.array(case["rows"], dtype=float)
+        y = arr[:, 0]
+        x = np.column_stack([np.ones(len(arr)), arr[:, 1], arr[:, 2]])
+        p = sas_compat._expit(x @ np.array(case["estimates"]))
+        sas_keeps = float(case["sas_xp"]) == float(case["sas_p"])
+        assert (1.0 - leverage(x, p)[7] <= 1e-8) == sas_keeps, (case["case"], 1.0 - leverage(x, p)[7])
+        kept += sas_keeps
+        got = rows_of(sas_compat.classification_table(y, x, pd=p))
+        want = [tuple(r) for r in case["classification"]]
+        assert got == want, (case["case"], [(a, b) for a, b in zip(got, want, strict=False) if a != b][:3])
+    assert len(cases) == 17 and kept == 6, (len(cases), kept)
+    print(f"  {len(cases)} fits: SAS's table; SAS keeps the probability on {kept}, all with 1 - h below 1e-8")
+
+
+if __name__ == "__main__":
+    for t in (test_designed_fits_are_sas, test_raw_input_r3_both_orders, test_rule_is_on_one_minus_h):
+        print(t.__name__)
+        t()
+    print("ALL OK")
