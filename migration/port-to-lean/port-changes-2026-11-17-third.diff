+does not: a first ridge of 1e-4, ridges below 0.0064 and below 1e-4, ridged iterations on
+separated steps, ridges up to 419.4304, and quasi-complete steps with few events, where the
+intercept's element of the standardized inverse information is the largest.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import io
+import json
+import random
+import re
+import sys
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import polars as pl
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent))
+from credit_risk import sas_compat  # noqa: E402
+
+ROOT = HERE.parents[1]
+SAS = json.loads((ROOT / "migration/legacy-to-port/experiments/x17_sas_iteration_histories.json").read_text())
+REFERENCE = ROOT / "judge" / "reference"
+_train = (HERE.parent / "credit_risk" / "train.py").read_text()
+_start = _train.index("candidates = [")
+CANDIDATES = re.findall(r'"([A-Za-z_0-9]+)"', _train[_start : _train.index("]", _start)])
+
+
+def features(case: str) -> pl.DataFrame:
+    df = pl.read_csv(REFERENCE / "model_features_train.csv", infer_schema_length=None)
+    if case == "real":
+        return df
+    n, seed = (int(v) for v in case[3:].split("_"))  # x17_ridging_run.py: the same rows
+    rows = sorted(random.Random(1000 * seed + n).sample(range(len(df)), n))
+    assert (case, sum(rows)) == ("sub50000_2", 2625731170), "another sampler than the experiment's"
+    return df[rows]
+
+
+def column(df: pl.DataFrame, name: str) -> np.ndarray:
+    return (
+        df[next(c for c in df.columns if c[:32] == name)].to_numpy().astype(float)
+    )  # SAS names: 32 characters
+
+
+def check_case(case: str) -> None:
+    df = features(case)
+    y = df["default_flag"].to_numpy().astype(float)
+    worst = 0.0
+    ridged = 0
+    for step in SAS[case]:
+        names = ["Intercept", *step["variables"]]
+        x = np.column_stack([np.ones(len(y)), *[column(df, v) for v in step["variables"]]])
+        fit = sas_compat._fit_as_sas(x, y, names)
+        assert fit is not None and fit.converged and fit.separation is None, (case, step["step"])
+        assert fit.n_iter == len(step["ridge"]), (case, step["step"], fit.n_iter, len(step["ridge"]))
+        m2 = step["neg2loglike"][-1]
+        assert abs(-2.0 * fit.loglik - m2) <= 1e-10 * m2, (case, step["step"])
+        sas_b = np.array(step["estimates"])
+        diff = float(np.abs(fit.beta - sas_b).max())
+        assert np.allclose(fit.beta, sas_b, rtol=1e-9, atol=1e-11), (case, step["step"], diff)
+        worst = max(worst, diff)
+        ridged += sum(r > 0 for r in step["ridge"])
+    print(
+        f"  {case}: {len(SAS[case])} steps stop at SAS's iteration with SAS's estimates (largest difference"
+    )
+    print(f"  {worst:.1e}); SAS ridged {ridged} of their iterations")
+
+
+def test_reference_data_steps_are_sas() -> None:
+    check_case("real")
+
+
+def test_subset_with_large_ridges_is_sas() -> None:
+    check_case("sub50000_2")
+
+
+CASES = json.loads((HERE / "data" / "sas_fit_cases.json").read_text())
+INTERCEPT_FIRST = ("raw12", "raw90", "small12_43", "small120_6", "sep_credit_utilization_0p85_n400_s0_sw2")
+
+
+def check_step(case: dict[str, Any]) -> None:
+    y = np.array(case["y"], dtype=float)
+    x = np.column_stack([np.ones(len(y)), *[np.array(case["columns"][v]) for v in case["variables"]]])
+    with np.errstate(over="ignore"):
+        fit = sas_compat._fit_as_sas(x, y, ["Intercept", *case["variables"]])
+    where = (case["case"], case["step"])
+    assert fit is not None, where
+    assert (fit.separation, fit.n_iter) == (case["separation"], len(case["ridge"])), (
+        where,
+        fit.separation,
+        fit.n_iter,
+    )
+    assert fit.converged == (case["separation"] is None), where
+    # a separated step's estimates grow without bound and its systems are badly conditioned: the
+    # two sides agree to 2e-6 relative at worst (the floor on the ladder moves them by 1.9%)
+    assert np.allclose(fit.beta, np.array(case["estimates"]), rtol=1e-5, atol=1e-9), (where, fit.beta)
+    assert abs(-2.0 * fit.loglik - case["neg2loglike"]) <= 1e-6 * case["neg2loglike"], where
+
+
+def test_single_steps_are_sas() -> None:
+    """Each step ends as in SAS: same iteration, same kind, same estimates."""
+    for case in CASES:
+        check_step(case)
+    print(f"  {len(CASES)} steps of {len({c['case'] for c in CASES})} runs end as in SAS")
+
+
+def test_ridge_ladder_starts_at_1e_4_and_has_no_floor() -> None:
+    """What the cases must contain for the ridge rule to be pinned: a fit whose first ridge is 1e-4
+    (a start further up the ladder, or a ladder that cannot come down below 0.0064, would ridge
+    more), a ridge below 1e-4 right after one of 1e-4 (no floor at the start of the ladder), and
+    ridged iterations on separated steps."""
+    first = [next(r for r in c["ridge"] if r > 0) for c in CASES if any(c["ridge"])]
+    assert first.count(1e-4) >= 2 and min(first) == 1e-4, sorted(first)
+    floor = next(c for c in CASES if 2.5e-5 in c["ridge"])
+    k = floor["ridge"].index(2.5e-5)
+    assert floor["ridge"][k - 1] == 1e-4 and floor["separation"] == "complete"
+    assert any(0 < r < 0.0064 for c in CASES for r in c["ridge"])
+    ridged_separated = [c for c in CASES if c["separation"] and any(c["ridge"])]
+    assert {c["separation"] for c in ridged_separated} == {"complete", "quasicomplete"}
+    smallest = min(r for c in CASES for r in c["ridge"] if r)
+    print(f"  first ridges {sorted(set(first))}; smallest ridge {smallest:g};")
+    print(f"  {len(ridged_separated)} separated steps with ridged iterations")
+
+
+def test_quasi_complete_test_leaves_the_intercept_out() -> None:
+    """Five quasi-complete steps on which the intercept's element of the standardized inverse
+    information passes 5000 one or two iterations before a variable's does: SAS stops at the
+    variable's (iterations 11 to 15), and `test_single_steps_are_sas` holds the port to it."""
+    late = [c for c in CASES if c["case"] in INTERCEPT_FIRST]
+    assert len(late) == len(INTERCEPT_FIRST) and all(c["separation"] == "quasicomplete" for c in late)
+    for c in late:
+        y = np.array(c["y"], dtype=float)
+        x = np.column_stack([np.ones(len(y)), *[np.array(c["columns"][v]) for v in c["variables"]]])
+        xs = np.column_stack([x[:, 0], (x[:, 1:] - x[:, 1:].mean(axis=0)) / x[:, 1:].std(axis=0, ddof=1)])
+        p = 1.0 / (1.0 + np.exp(-(x @ np.array(c["estimates"]))))
+        d = np.diag(np.linalg.inv(xs.T @ (xs * (p * (1.0 - p))[:, None])))
+        assert d[0] > d[1:].max() > 5000.0, (
+            c["case"],
+            d,
+        )  # at SAS's stop: both above, the intercept's the larger
+    print(f"  {len(late)} quasi-complete steps where the intercept's element is the larger one")
+
+
+def test_a_step_that_keeps_the_log_likelihood_is_taken() -> None:
+    """The port's own choice, not measured in SAS (docstring of `_fit_as_sas`): a step that leaves
+    the log likelihood exactly equal is taken without a ridge. Here the variable's score is exactly
+    zero at the start, so the first step is zero and the fit has converged at iteration 1.
+    This does not tell `<` from `<=` in the test that calls for a ridge: on a zero step the first
+    ridge gives the same zero step and is accepted, and an exact tie on a step that is not zero
+    could not be built. The two readings differ only there."""
+    y = np.array([0.0, 1.0, 0.0, 1.0])
+    x = np.column_stack([np.ones(4), np.array([1.0, 1.0, -1.0, -1.0])])
+    fit = sas_compat._fit_as_sas(x, y, ["Intercept", "x"])
+    assert fit is not None and fit.converged and fit.n_iter == 1 and fit.beta.tolist() == [0.0, 0.0], fit
+    print("  a zero step is taken: converged at iteration 1")
+
+
+def test_reference_data_selection_is_the_reference() -> None:
+    """The whole selection on the reference feature file: every chi-square of the step summary is
+    the reference listing's to the 4 decimals printed (with the fully converged estimates the port
+    had before, 11 of the 19 were not, by up to 0.0245)."""
+    df = pl.read_csv(REFERENCE / "model_features_train.csv", infer_schema_length=None)
+    with contextlib.redirect_stdout(io.StringIO()):
+        res = sas_compat.stepwise_logistic(df, "default_flag", CANDIDATES, 0.05, 0.05)
+    ref = pl.read_csv(REFERENCE / "stepwise_summary.csv", infer_schema_length=0).to_dicts()
+    assert len(res.steps) == len(ref)
+    for s, r in zip(res.steps, ref, strict=True):
+        assert (s.entered or "")[:20] == (r["EffectEntered"] or "") and (s.removed or "")[:20] == (
+            r["EffectRemoved"] or ""
+        )
+        v, printed = (s.score_chisq, r["ScoreChiSq"]) if s.entered else (s.wald_chisq, r["WaldChiSq"])
+        assert v is not None and f"{v:.4f}" == printed, (s.step, v, printed)
+    print(f"  reference data: the {len(ref)} printed chi-squares equal the reference listing")
+
+
+if __name__ == "__main__":
+    for t in (
+        test_reference_data_steps_are_sas,
+        test_subset_with_large_ridges_is_sas,
+        test_single_steps_are_sas,
+        test_ridge_ladder_starts_at_1e_4_and_has_no_floor,
+        test_quasi_complete_test_leaves_the_intercept_out,
+        test_a_step_that_keeps_the_log_likelihood_is_taken,
+        test_reference_data_selection_is_the_reference,
+    ):
+        print(t.__name__)
+        t()
+    print("ALL OK")
diff --git a/port/tests/test_global_wald.py b/port/tests/test_global_wald.py
new file mode 100644
index 0000000..dca1296
--- /dev/null
+++ b/port/tests/test_global_wald.py
@@ -0,0 +1,67 @@
+"""The Wald test of the global null hypothesis as SAS prints it (global-wald-rule.md).
+
+    cd port && uv run python tests/test_global_wald.py        (or: uv run pytest tests)
+
+tests/data/sas_global_wald_cases.json: the 17 runs of experiment X20 (seed 6's step-7 model fitted
+alone with columns rescaled), SAS's estimates, covariance (COVB) and global Wald test of each. The
+interaction's pivot runs from 6.3e-25 to 6.3e-15: SAS leaves it out of the chi-square up to 1e-16 (T1)
+and keeps it from 2e-16 (T2), whatever the other slopes' scale (B1 to B5) or the intercept's variance
+(S1); the DF is 7 in every run.
+The second test runs `train.run` on seed 6's feature file (judge/runs/gen_s06, SAS's run of the
+generated input) and compares printed_global_tests.csv with SAS's, cell by cell.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import io
+import json
+import sys
+import tempfile
+from pathlib import Path
+
+import numpy as np
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent))
+from credit_risk import sas_compat, train  # noqa: E402
+
+RUNS = json.loads((HERE / "data" / "sas_global_wald_cases.json").read_text())["runs"]
+SEED6 = HERE.parents[1] / "judge" / "runs" / "gen_s06"
+
+
+def test_x20_runs_are_sas() -> None:
+    """Each run's chi-square from SAS's own estimates and covariance, and its DF of 7. A tolerance
+    relative to the largest slope variance fails A4 (left out by SAS at 5.2e-15 of it) or B4 and B5;
+    one relative to the slope's own variance (about 0.99 in every run) fails A0 to A4 or A5."""
+    left = 0
+    for run, r in RUNS.items():
+        names = ["Intercept", *r["names"][1:]]
+        fit = sas_compat.LogisticFit(names, np.array(r["beta"]), np.array(r["cov"]), 0.0, 1, True)
+        chisq, df = sas_compat.global_wald(fit, names[1:])
+        assert abs(chisq - r["wald"]) <= 1e-8 * r["wald"], (run, chisq, r["wald"])
+        assert df == r["df"] == 7, (run, df)
+        left += abs(chisq - 406.4827) < 1e-3
+    assert left == 11, left
+    print(f"  {len(RUNS)} runs: chi-square and DF as SAS; the interaction left out in {left}")
+
+
+def test_seed6_global_tests_are_sas() -> None:
+    """train.run on seed 6: every cell of printed_global_tests.csv equals SAS's, step 7's Wald test
+    included (`7,Wald,406.4827,7,<.0001`; the port printed 407.3550 before)."""
+    assert (SEED6 / "model_features_train.csv").exists(), f"{SEED6} is needed (SAS's run of seed 6)"
+    with tempfile.TemporaryDirectory() as tmp:
+        with contextlib.redirect_stdout(io.StringIO()):
+            train.run(SEED6, Path(tmp))
+        got = (Path(tmp) / "printed_global_tests.csv").read_text().splitlines()
+    sas = (SEED6 / "printed_global_tests.csv").read_text().splitlines()
+    assert "7,Wald,406.4827,7,<.0001" in sas
+    assert got == sas, [(g, s) for g, s in zip(got, sas, strict=False) if g != s][:3]
+    print(f"  seed 6: {len(got) - 1} global test rows equal SAS's")
+
+
+if __name__ == "__main__":
+    for t in (test_x20_runs_are_sas, test_seed6_global_tests_are_sas):
+        print(t.__name__)
+        t()
+    print("ALL OK")
diff --git a/port/tests/test_hosmer_lemeshow.py b/port/tests/test_hosmer_lemeshow.py
new file mode 100644
index 0000000..10dbc85
--- /dev/null
+++ b/port/tests/test_hosmer_lemeshow.py
@@ -0,0 +1,117 @@
+"""The Hosmer-Lemeshow tables on extreme fits: SAS's limits on a group's probability, and no table
+below 3 groups.
+
+    cd port && uv run python tests/test_hosmer_lemeshow.py        (or: uv run pytest tests)
+
+tests/data/sas_hosmer_lemeshow.json: for 11 SAS runs (judge/runs/<run>), the outcome and the
+probability of every training row as SAS wrote them (risk_scores_train.csv, 10 digits), SAS's two
+tables (printed_hosmer_lemeshow.csv, printed_hl_partition.csv; null when SAS created none), and
+whether its listing has the note "In calculating the Expected values, predicted probabilities less
+than 1E-6 and greater than 0.999999 were changed to 1E-6 and 0.999999 respectively."
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+from typing import Any
+
+import polars as pl
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent))
+from credit_risk import sas_compat  # noqa: E402
+
+CASES: list[dict[str, Any]] = json.loads((HERE / "data" / "sas_hosmer_lemeshow.json").read_text())
+
+
+def tables(case: dict[str, Any]) -> tuple[pl.DataFrame, dict[str, str]]:
+    y = pl.Series(case["y"], dtype=pl.Int64)
+    pd = pl.Series([float(v) for v in case["pd"]], dtype=pl.Float64)
+    table, chisq, dof, p = sas_compat.hosmer_lemeshow(y, pd)
+    test = {
+        "ChiSq": sas_compat.fmt_wd(chisq, 10, 4).strip(),
+        "DF": str(dof),
+        "ProbChiSq": sas_compat.sas_pvalue(p).strip(),
+        "NGroups": str(table.height),
+    }
+    return table, test
+
+
+def group_means(table: pl.DataFrame) -> list[float]:
+    return [r["EventsExpected"] / r["Total"] for r in table.to_dicts()]
+
+
+def test_tables_are_sas() -> None:
+    """Where SAS created the tables: the test's four cells and the partition, as SAS printed them."""
+    n = 0
+    for case in CASES:
+        if case["test"] is None:
+            continue
+        table, test = tables(case)
+        assert test == {k: v.strip() for k, v in case["test"].items()}, (case["run"], test, case["test"])
+        mine = [
+            [
+                str(r["Group"]),
+                str(r["Total"]),
+                str(r["EventsObserved"]),
+                f"{r['EventsExpected']:.2f}",
+                str(r["NoneventsObserved"]),
+                f"{r['NoneventsExpected']:.2f}",
+            ]
+            for r in table.to_dicts()
+        ]
+        assert mine == [[v.strip() for v in row] for row in case["partition"]], case["run"]
+        n += 1
+    print(f"  {n} runs: test and partition as SAS")
+
+
+def test_the_limit_is_on_the_group_not_on_the_observation() -> None:
+    """SAS's note goes with a GROUP whose average probability is outside [1e-6, 0.999999]. floorC has
+    62 observations above 0.999999 and no group outside (its last group is at 1 - 1.31e-6): SAS has
+    no note and the chi-square of the unlimited probabilities, 95.1047 (95.1048 if each observation
+    were limited). floorB has groups outside on both sides: 0.3656 with the limits, 0.3644 without."""
+    by = {c["run"]: c for c in CASES}
+    for case in CASES:
+        if case["test"] is None:
+            continue
+        table, _ = tables(case)
+        means = group_means(table)
+        # the port's groups are already limited: one AT a limit is one SAS changed
+        at_limit = any(m <= 1e-6 * (1 + 1e-12) or m >= 0.999999 * (1 - 1e-12) for m in means)
+        assert at_limit == case["note"], (case["run"], min(means), max(means))
+    c = by["rawfit_floorC"]
+    assert (
+        not c["note"]
+        and sum(float(v) > 0.999999 for v in c["pd"]) == 62
+        and c["test"]["ChiSq"].strip() == "95.1047"
+    )
+    b = by["rawfit_floorB"]
+    assert b["note"] and b["test"]["ChiSq"].strip() == "0.3656"
+    assert sum(float(v) < 1e-6 for v in b["pd"]) > 1000 and sum(float(v) > 0.999999 for v in b["pd"]) > 600
+    print("  SAS's note exactly on the runs with a group at a limit;")
+    print("  floorC (observations beyond the limit, no group) is not limited")
+
+
+def test_no_table_below_three_groups() -> None:
+    """SAS creates the two tables with 3 groups or more and neither with 2."""
+    seen: dict[int, set[bool]] = {}
+    for case in CASES:
+        table, _ = tables(case)
+        printed = sas_compat.hosmer_lemeshow_is_printed(table.height)
+        assert printed == (case["test"] is not None), (case["run"], table.height)
+        seen.setdefault(table.height, set()).add(printed)
+    assert seen[2] == {False} and seen[3] == {True} and seen[4] == {True}, seen
+    print(f"  groups -> tables created: { ({k: next(iter(v)) for k, v in sorted(seen.items())}) }")
+
+
+if __name__ == "__main__":
+    for t in (
+        test_tables_are_sas,
+        test_the_limit_is_on_the_group_not_on_the_observation,
+        test_no_table_below_three_groups,
+    ):
+        print(t.__name__)
+        t()
+    print("ALL OK")
diff --git a/port/tests/test_recycling.py b/port/tests/test_recycling.py
new file mode 100644
index 0000000..e02a3ba
--- /dev/null
+++ b/port/tests/test_recycling.py
@@ -0,0 +1,92 @@
+"""The stepwise selection ends rather than have a model twice (migration/legacy-to-port/recycling-rule.md).
+
+    cd port && uv run python tests/test_recycling.py        (or: uv run pytest tests)
+
+tests/data/sas_recycling_cases.json: the training features of 19 small raw inputs as SAS wrote them
+(judge/runs/rawfit_<case>/model_features_train.csv, the 36 MODEL variables and the outcome), with
+SAS's steps (stepwise_summary.csv), the variables of its final model, and its note on why the
+selection ended (train.sas.lst). The 13 inputs Da to Dn6 are those of experiment x18.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import io
+import json
+import sys
+from pathlib import Path
+from typing import Any
+
+import polars as pl
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent))
+from credit_risk import sas_compat  # noqa: E402
+
+CASES: list[dict[str, Any]] = json.loads((HERE / "data" / "sas_recycling_cases.json").read_text())
+RECYCLING = "Model building terminates because of recycling of previous steps."
+NEXT_ENTRY = "Model building terminates because the next effect to be added recycles previous steps."
+LAST_ENTERED = (
+    "Model building terminates because the last effect entered is removed by the Wald statistic criterion."
+)
+
+
+def select(case: dict[str, Any]) -> tuple[sas_compat.StepwiseResult, str]:
+    df = pl.DataFrame({"default_flag": case["y"], **case["columns"]})
+    with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
+        return sas_compat._stepwise_logistic_with_note(df, "default_flag", list(case["columns"]), 0.05, 0.05)
+
+
+def steps(res: sas_compat.StepwiseResult) -> list[list[str]]:
+    return [[(s.entered or "")[:20], (s.removed or "")[:20]] for s in res.steps]  # SAS prints 20 characters
+
+
+def test_steps_final_model_and_note_are_sas() -> None:
+    """Every case: SAS's steps in SAS's order, SAS's final variables, and SAS's note for the way the
+    selection ended. The note tells the three ends apart where the steps alone do not: a removal
+    onto the empty model is the last step because the empty model of step 0 is one the selection
+    has had (note "recycling of previous steps"), not because the next entry would recycle."""
+    for case in CASES:
+        res, note = select(case)
+        assert steps(res) == case["steps"], (case["case"], steps(res), case["steps"])
+        assert res.final is not None
+        assert sorted(n[:20] for n in res.final.names[1:]) == sorted(case["final"]), (
+            case["case"],
+            res.final.names,
+        )
+        assert note == case["note"], (case["case"], note, case["note"])
+    by_note: dict[str, int] = {}
+    for case in CASES:
+        by_note[case["note"]] = by_note.get(case["note"], 0) + 1
+    assert by_note[RECYCLING] >= 7 and by_note[NEXT_ENTRY] >= 6 and by_note[LAST_ENTERED] >= 4, by_note
+    assert len(by_note) == 4, by_note  # and one that ends with no candidate to enter
+    print(f"  {len(CASES)} selections: steps, final model and closing note as SAS")
+    for note, n in sorted(by_note.items()):
+        print(f"    {n:2d}  {note}")
+
+
+def test_the_cases_hold_each_shape_of_the_rule() -> None:
+    """What the cases must contain for each part of the rule to be pinned."""
+    by = {c["case"]: c for c in CASES}
+    # a removal onto the empty model (rule 1 with the empty model of step 0 in the list)
+    empty = [c for c in CASES if c["note"] == RECYCLING and not c["final"]]
+    assert len(empty) >= 5
+    # a removal onto an earlier model that is not the empty one
+    assert [c["case"] for c in CASES if c["note"] == RECYCLING and c["final"]] == ["Dd", "De"]
+    # the next entry would give an earlier model, and it is NOT the variable just removed (the port's
+    # old special case): the last step removed another variable, or was an entry
+    for name in ("Dn1", "Dn2", "Dn3", "Dn4", "Dn5", "Dn6"):
+        assert by[name]["note"] == NEXT_ENTRY
+    assert by["Dn1"]["steps"][-1][0] != ""  # ends after an entry
+    # the second-best candidate is not tried: with it Dn1 to Dn4 would make further steps (checked by
+    # mutation: candidates whose entry gives a model already had left out of the choice)
+    print(
+        f"  {len(empty)} removals onto the empty model, 2 onto another earlier model, 6 next entries that recycle"
+    )
+
+
+if __name__ == "__main__":
+    for t in (test_steps_final_model_and_note_are_sas, test_the_cases_hold_each_shape_of_the_rule):
+        print(t.__name__)
+        t()
+    print("ALL OK")
diff --git a/port/tests/test_singular_information.py b/port/tests/test_singular_information.py
new file mode 100644
index 0000000..c150bd0
--- /dev/null
+++ b/port/tests/test_singular_information.py
@@ -0,0 +1,205 @@
+"""A singular information matrix: the fit leaves a parameter out as SAS does (singular-information.md).
+
+    cd port && uv run python tests/test_singular_information.py        (or: uv run pytest tests)
+
+tests/data/sas_singular_cases.json: the 40 designed cases of experiment x19 (their rows, the order of
+the MODEL statement, whether the run was stepwise) with SAS's results from ITPRINT, DETAILS and COVB:
+for each fit how it ended, at which iteration, the last estimates, each parameter's DF, standard
+error and Wald chi-square, the global tests; for the stepwise runs the step summary; the warnings.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import io
+import json
+import math
+import sys
+import tempfile
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import polars as pl
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent))
+from credit_risk import sas_compat, train  # noqa: E402
+
+CASES: list[dict[str, Any]] = json.loads((HERE / "data" / "sas_singular_cases.json").read_text())
+SINGULAR = "WARNING: The information matrix is singular and thus the convergence is questionable."
+
+
+def xy(case: dict[str, Any], variables: list[str]) -> tuple[np.ndarray, np.ndarray]:
+    arr = np.array(case["rows"], dtype=float)
+    cols = [arr[:, 1 + case["columns"].index(v)] for v in variables]
+    return np.column_stack([np.ones(len(arr)), *cols]), arr[:, 0]
+
+
+def kind(status: str) -> str | None:
+    return "complete" if "Complete" in status else "quasicomplete" if "Quasi" in status else None
+
+
+def test_every_fit_is_sas() -> None:
+    """The 44 fits: the stop and its iteration, the last estimates, which parameters have DF 0
+    (variance exactly 0 in the port's covariance), and the standard errors of the others."""
+    n = left = 0
+    for case in CASES:
+        for st in case["steps"]:
+            x, y = xy(case, st["variables"])
+            fit = sas_compat._fit_as_sas(x, y, ["Intercept", *st["variables"]])
+            where = (case["case"], st["step"])
+            assert fit is not None, where
+            assert (fit.separation, fit.n_iter) == (kind(st["status"]), st["n_iter"]), (
+                where,
+                fit.separation,
+                fit.n_iter,
+            )
+            assert np.allclose(fit.beta, st["estimates"], rtol=1e-6, atol=1e-9), (where, fit.beta)
+            out = sas_compat._left_out(fit)
+            assert out == [p["variable"] for p in st["parameters"] if p["df"] == 0], (where, out)
+            for i, p in enumerate(st["parameters"]):
+                if p["df"] and p["stderr"] is not None:
+                    assert abs(math.sqrt(fit.cov[i, i]) - p["stderr"]) <= 1e-5 * p["stderr"], (
+                        where,
+                        p["variable"],
+                    )
+            n += 1
+            left += bool(out)
+    print(f"  {n} fits end as in SAS; {left} of them with a parameter left out at the last iteration")
+
+
+def test_the_cases_pin_the_tolerance_and_the_limit() -> None:
+    """What the cases hold: the two sides of the 1e-9 tolerance (G8 series: the second column off
+    collinearity by 2.3e-5 is left out, by 2.7e-5 it is kept), unchanged when the first or the second
+    column is multiplied by 1000 (H1, G8e: a tolerance relative to the largest diagonal element
+    fails there); which of two collinear columns goes (the later in the MODEL order, G7a and G7b);
+    the limit 36.7368 beyond which a weight is 0 (G4a below it, G4b above, and mirrored)."""
+    by = {c["case"]: c for c in CASES}
+
+    def left_out(name: str) -> list[str]:
+        return [p["variable"] for p in by[name]["steps"][0]["parameters"] if p["df"] == 0]
+
+    assert left_out("G8m_near_2.3e-05") == ["x2"] and left_out("G8m_near_2.7e-05") == []
+    assert (
+        left_out("H1_x1_times_1000_near_2.3e-05") == ["x2"]
+        and left_out("H1_x1_times_1000_near_2.7e-05") == []
+    )
+    assert left_out("G8e_near_1e-7_x2_times_1000") == ["x2"]
+    assert left_out("G7a_collinear_after_x1_x2") == ["x2"] and left_out("G7b_collinear_after_x2_x1") == ["x1"]
+    for name in (
+        "G4a_n202_k5_below",
+        "G4b_n283_k7_above",
+        "G9d_mirror_n202_k5_below",
+        "G9e_mirror_n283_k7_above",
+    ):
+        assert name in by
+    print("  tolerance bracketed (2.3e-5 out, 2.7e-5 kept; the same with a column scaled);")
+    print("  the order and the limit cases are present")
+
+
+def test_stepwise_runs_are_sas() -> None:
+    """The 14 stepwise runs: SAS's steps; a variable whose parameter was left out at the last
+    iteration is removed at the next step with DF 0 and no Wald test, also beside a variable whose
+    own test keeps it (J5: `a` with a Wald chi-square of 42.37 stays, x1 goes); one left out on the
+    way only is removed by its ordinary test (Wald 4.4e-13, DF 1); and the port prints SAS's warning
+    on the same runs as SAS."""
+    n = zero_df = 0
+    for case in CASES:
+        if not case["stepwise"]:
+            continue
+        arr = np.array(case["rows"], dtype=float)
+        df = pl.DataFrame({"y": arr[:, 0], **{v: arr[:, 1 + i] for i, v in enumerate(case["columns"])}})
+        buf = io.StringIO()
+        with contextlib.redirect_stdout(buf):
+            res = sas_compat.stepwise_logistic(df, "y", case["model"], 0.05, 0.05)
+        assert len(res.steps) == len(case["summary"]), (case["case"], len(res.steps))
+        for s, r in zip(res.steps, case["summary"], strict=True):
+            where = (case["case"], s.step)
+            assert (s.entered or "", s.removed or "", s.df) == (r["entered"], r["removed"], r["df"]), where
+            if r["entered"]:
+                assert s.score_chisq is not None and abs(s.score_chisq - r["score"]) <= 1e-6 * r["score"], (
+                    where
+                )
+            elif r["df"] == 0:
+                assert s.wald_chisq is not None and math.isnan(s.wald_chisq) and math.isnan(s.p_value), where
+                zero_df += 1
+            else:
+                assert s.wald_chisq is not None and abs(s.wald_chisq - r["wald"]) <= 1e-6 * max(
+                    r["wald"], 1e-6
+                ), where
+        assert (SINGULAR in buf.getvalue()) == any(w.startswith(SINGULAR) for w in case["warnings"]), case[
+            "case"
+        ]
+        n += 1
+    j5 = next(c for c in CASES if c["case"] == "J5_regular_then_flag")
+    assert [(r["removed"], r["df"]) for r in j5["summary"]][-1] == ("x1", 0)
+    assert zero_df >= 8
+    print(f"  {n} stepwise runs: steps, DF and tests as SAS; {zero_df} removals with DF 0; warning as SAS")
+
+
+def test_train_writes_sas_cells() -> None:
+    """The 14 stepwise runs through `train.run`, each designed variable in a column of the feature
+    file (a -> age, x1 -> flag_very_high_utilization, z -> flag_low_income, every other candidate 0,
+    which the entry test skips as aliased with the intercept; the MODEL order a, x1, z is kept).
+    stepwise_summary.csv: a removal of a parameter left out at the last iteration is
+    `step,,effect,0,n,_,,` (DF 0, empty Wald chi-square and probability). printed_global_tests.csv:
+    SAS's chi-square and DF of every test of every step with a variable; the Wald test of a step with
+    a parameter left out has an empty chi-square and probability and DF = the variables not left out
+    (J5 step 2: `2,Wald,,1,`; G2 step 1: `1,Wald,,0,`)."""
+    header = (HERE.parents[1] / "judge" / "reference" / "model_features_train.csv").open().readline()
+    column = {"a": "age", "x1": "flag_very_high_utilization", "z": "flag_low_income"}
+    n = empty = 0
+    for case in CASES:
+        if not case["stepwise"]:
+            continue
+        arr = np.array(case["rows"], dtype=float)
+        cols = {h: np.zeros(len(arr)) for h in header.strip().split(",")}
+        cols["row_id"] = np.arange(1.0, len(arr) + 1.0)
+        cols["default_flag"] = arr[:, 0]
+        for i, v in enumerate(case["columns"]):
+            cols[column[v]] = arr[:, 1 + i]
+        with tempfile.TemporaryDirectory() as tmp:
+            d = Path(tmp)
+            pl.DataFrame(cols).write_csv(d / "model_features_train.csv")
+            pl.DataFrame(cols).write_csv(d / "model_features_validation.csv")
+            with contextlib.redirect_stdout(io.StringIO()):
+                train.run(d, d / "out")
+            summary = pl.read_csv(d / "out" / "stepwise_summary.csv", infer_schema_length=0).fill_null("")
+            tests = pl.read_csv(d / "out" / "printed_global_tests.csv", infer_schema_length=0).fill_null("")
+        assert summary.height == len(case["summary"]), case["case"]
+        for row, r in zip(summary.iter_rows(named=True), case["summary"], strict=True):
+            where = (case["case"], r["step"])
+            assert row["DF"] == str(r["df"]), (where, row)
+            if r["df"] == 0:
+                assert (row["ScoreChiSq"], row["WaldChiSq"], row["ProbChiSq"]) == ("_", "", ""), (where, row)
+                empty += 1
+            elif r["removed"]:
+                assert row["WaldChiSq"] == sas_compat.fmt_wd(r["wald"], 10, 4), (where, row)
+            else:
+                assert row["ScoreChiSq"] == sas_compat.fmt_wd(r["score"], 10, 4), (where, row)
+        got = {(int(t["Step"]), t["Test"]): t for t in tests.iter_rows(named=True)}
+        for st in case["steps"]:
+            for g in st["global_tests"]:
+                t = got[(st["step"], g["test"])]
+                where = (case["case"], st["step"], g["test"])
+                assert t["DF"] == str(g["df"]), (where, t)
+                if g["chisq"] is None:
+                    assert (t["ChiSq"], t["ProbChiSq"]) == ("", ""), (where, t)
+                    empty += 1
+                else:
+                    assert t["ChiSq"] == sas_compat.fmt_wd(g["chisq"], 10, 4), (where, t)
+        n += 1
+    print(f"  {n} stepwise runs through train.run: summary and global tests as SAS; {empty} empty-cell rows")
+
+
+if __name__ == "__main__":
+    for t in (
+        test_every_fit_is_sas,
+        test_the_cases_pin_the_tolerance_and_the_limit,
+        test_stepwise_runs_are_sas,
+        test_train_writes_sas_cells,
+    ):
+        print(t.__name__)
+        t()
+    print("ALL OK")
