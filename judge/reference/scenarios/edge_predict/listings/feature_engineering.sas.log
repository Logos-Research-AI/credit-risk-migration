492        /*****************************************************************************
493         * 6. Export Engineered Features
494         *****************************************************************************/
495        
496        /* Ensure all variables are numeric before export */
497        data work.credit_train_export;
498            set work.credit_train;
499            /* Force numeric format for all variables */
500            format _numeric_ best12.;
501        run;
502        
503        data work.credit_validation_export;
504            set work.credit_validation;
505            /* Force numeric format for all variables */
506            format _numeric_ best12.;
507        run;
508        
509        /* Export training set */
510        proc export data=work.credit_train_export
511            outfile="&output_path/model_features_train.csv"
512            dbms=csv
513            replace;
514        run;
