300        
301        /* Calculate income medians by age group for imputation */
302        proc sql;
303            create table work.income_medians as
304            select
305                case
306                    when age < 30 then 1
307                    when age < 40 then 2
308                    when age < 50 then 3
309                    when age < 60 then 4
310                    else 5
311                end as age_group,
312                median(MonthlyIncome) as median_income
313            from work.credit_raw_clean
314            where MonthlyIncome is not missing
315            group by calculated age_group;
316        quit;
317        
318        data work.credit_cleaned;
319            set work.credit_raw_clean;
320        
321            /* Create age group for income imputation */
322            if age < 30 then age_group = 1;
323            else if age < 40 then age_group = 2;
324            else if age < 50 then age_group = 3;
325            else if age < 60 then age_group = 4;
326            else age_group = 5;
327        
328            /* Handle missing values - create flags */
329            if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
330            else MonthlyIncome_missing = 0;
331        
332            if missing(NumberOfDependents) then do;
333                NumberOfDependents = 0;
334                Dependents_missing = 1;
335            end;
336            else Dependents_missing = 0;
337        run;
338        
339        /* Merge and impute income - rename columns in SQL */
340        proc sql;
341            create table work.credit_imputed as
342            select
343                a.VAR1 as row_id,
344                a.SeriousDlqin2yrs as default_flag,
345                a.age,
346                case when a.MonthlyIncome_missing = 1 then b.median_income
347                     else a.MonthlyIncome
348                end as monthly_income,
349                a.MonthlyIncome_missing,
350                a.NumberOfDependents as num_dependents,
351                a.Dependents_missing,
352                a.age_group,
353                a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
354                a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
355                a.NumberOfTimes90DaysLate as num_late_90_plus,
356                a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
357                a.DebtRatio * 100 as debt_ratio,
358                a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
359                a.NumberRealEstateLoansOrLines as num_real_estate_loans
360            from work.credit_cleaned a
361            left join work.income_medians b
362            on a.age_group = b.age_group;
363        quit;
364        
365        /*****************************************************************************
366         * 3. Feature Engineering
367         *****************************************************************************/
368        
369        data work.credit_features;
370            set work.credit_imputed;
371        
372            /* Total late payments across all categories */
373            total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
374        
375            /* Has any delinquency indicator */
376            has_delinquency = (total_late_payments > 0);
377        
378            /* Has serious delinquency (90+ days) */
379            has_serious_delinquency = (num_late_90_plus > 0);
380        
381            /* Credit utilization categories */
382            if credit_utilization < 30 then credit_util_category = 1; /* Low */
383            else if credit_utilization < 50 then credit_util_category = 2; /* Medium */
384            else if credit_utilization < 75 then credit_util_category = 3; /* High */
385            else credit_util_category = 4; /* Very High */
386        
387            /* Debt ratio categories */
388            if debt_ratio < 30 then debt_category = 1; /* Low */
389            else if debt_ratio < 43 then debt_category = 2; /* Medium */
390            else if debt_ratio < 60 then debt_category = 3; /* High */
391            else debt_category = 4; /* Very High */
392        
393            /* Income per dependent (handle division by zero) */
394            if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
395            else income_per_dependent = monthly_income;
396        
397            /* Credit lines per person in household */
398            credit_lines_per_person = num_credit_lines / (num_dependents + 1);
399        
400            /* Age categories for risk assessment */
401            if age < 25 then age_category = 1; /* Young */
402            else if age < 35 then age_category = 2; /* Young Adult */
403            else if age < 50 then age_category = 3; /* Middle Age */
404            else if age < 65 then age_category = 4; /* Mature */
405            else age_category = 5; /* Senior */
406        
407            /* Risk flags */
408            flag_high_utilization = (credit_utilization > 75);
409            flag_very_high_utilization = (credit_utilization > 100);
410            flag_high_debt_ratio = (debt_ratio > 43);
411            flag_very_high_debt_ratio = (debt_ratio > 60);
412            flag_recent_late_payments = (num_late_30_59 > 0);
413            flag_serious_delinquency = (num_late_90_plus > 0);
414            flag_multiple_delinquencies = (total_late_payments >= 3);
415            flag_low_income = (monthly_income < 2500);
416            flag_many_dependents = (num_dependents >= 3);
417            flag_few_credit_lines = (num_credit_lines <= 2);
418        
419            /* Total risk flags */
420            total_risk_flags = sum(flag_high_utilization, flag_high_debt_ratio,
421                                  flag_serious_delinquency, flag_multiple_delinquencies,
422                                  flag_low_income);
423        
424            /* Financial health score (0-100) */
425            financial_health = 100;
426            if credit_utilization > 30 then financial_health = financial_health - 15;
427            if credit_utilization > 75 then financial_health = financial_health - 15;
428            if debt_ratio > 43 then financial_health = financial_health - 20;
429            if has_delinquency then financial_health = financial_health - 20;
430            if num_late_90_plus > 0 then financial_health = financial_health - 30;
431            financial_health = max(0, financial_health);
432        
433            /* Log transformations for skewed variables (add 1 to handle zeros) */
434            log_monthly_income = log(monthly_income + 1);
435            log_num_credit_lines = log(num_credit_lines + 1);
436            log_total_late_payments = log(total_late_payments + 1);
437        
438            /* Interaction features */
439            age_income_interaction = age * log_monthly_income;
440            utilization_debt_interaction = credit_utilization * debt_ratio / 100;
441        
442            /* Cap extreme outliers in credit_utilization and debt_ratio */
443            credit_utilization_capped = min(credit_utilization, 200);
444            debt_ratio_capped = min(debt_ratio, 500);
445        run;
446        
447        /*****************************************************************************
448         * 4. Split into Training and Validation Sets (70/30)
449         *****************************************************************************/
450        
451        /* Set random seed for reproducibility */
452        proc surveyselect data=work.credit_features
453                          out=work.credit_split
454                          samprate=0.7
455                          seed=42
456                          outall;
457        run;
458        
459        data work.credit_train work.credit_validation;
460            set work.credit_split;
461            if selected = 1 then output work.credit_train;
462            else output work.credit_validation;
463            drop selected;
464        run;
465        
466        /*****************************************************************************
467         * 5. Summary Statistics
468         *****************************************************************************/
469        
470        proc means data=work.credit_train n mean std min max;
471            var age monthly_income credit_utilization debt_ratio total_late_payments
472                num_credit_lines num_real_estate_loans default_flag;
473            title "Training Set Summary Statistics";
474        run;
475        
476        proc freq data=work.credit_train;
477            tables default_flag;
478            title "Training Set - Default Rate";
479        run;
480        
481        proc means data=work.credit_validation n mean std min max;
482            var age monthly_income credit_utilization debt_ratio total_late_payments
483                num_credit_lines num_real_estate_loans default_flag;
484            title "Validation Set Summary Statistics";
485        run;
486        
487        proc freq data=work.credit_validation;
488            tables default_flag;
489            title "Validation Set - Default Rate";
490        run;
