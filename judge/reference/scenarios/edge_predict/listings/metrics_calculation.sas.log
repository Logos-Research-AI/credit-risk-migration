3312       /*****************************************************************************
3313        * 2. ROC Curve and AUC Analysis
3314        *****************************************************************************/
3315       
3316       /* ROC analysis for validation set */
3317       proc logistic data=work.logit_scored_valid;
3318           model default_flag(event='1') = pd_logistic / nofit;
3319           roc 'Logistic Model' pred=pd_logistic;
3320           roccontrast;
3321           ods output ROCAssociation=work.roc_stats;
3322           title "ROC Curve Analysis - Validation Set";
3323       run;
3324       
3325       /* Extract and display AUC */
3326       data work.auc_summary;
3327           set work.roc_stats;
3328           where ROCModel = 'Logistic Model';
3329           AUC = Area;
3330           Gini = 2 * Area - 1;
3331           keep ROCModel AUC Gini;
3332           format AUC Gini 8.4;
3333       run;
3334       
3335       proc print data=work.auc_summary noobs;
3336           title "Model Performance Metrics - AUC and Gini";
3337       run;
3338       
3339       /*****************************************************************************
3340        * 3. Kolmogorov-Smirnov (KS) Statistic
3341        *****************************************************************************/
3342       
3343       /* Sort by predicted probability */
3344       proc sort data=work.logit_scored_valid;
3345           by pd_logistic;
3346       run;
3347       
3348       /* Calculate total good and bad counts */
3349       proc sql noprint;
3350           select sum(default_flag = 0), sum(default_flag = 1)
3351           into :total_good_count, :total_bad_count
3352           from work.logit_scored_valid;
3353       quit;
3354       
3355       /* Calculate cumulative distributions */
3356       data work.ks_calculation;
3357           set work.logit_scored_valid;
3358           retain cum_good cum_bad;
3359       
3360           if _n_ = 1 then do;
3361               cum_good = 0;
3362               cum_bad = 0;
3363           end;
3364       
3365           if default_flag = 0 then cum_good + 1;
3366           else cum_bad + 1;
3367       
3368           cum_pct_good = cum_good / &total_good_count;
3369           cum_pct_bad = cum_bad / &total_bad_count;
3370           ks_value = abs(cum_pct_good - cum_pct_bad);
3371       run;
3372       
3373       /* Find maximum KS */
3374       proc sql;
3375           create table work.ks_statistic as
3376           select max(ks_value) as KS_Statistic format=8.4,
3377                  pd_logistic as KS_Cutoff format=8.4
3378           from work.ks_calculation
3379           where ks_value = (select max(ks_value) from work.ks_calculation);
3380       quit;
3381       
3382       proc print data=work.ks_statistic noobs;
3383           title "Kolmogorov-Smirnov Statistic";
3384       run;
3385       
3386       /*****************************************************************************
3387        * 4. Confusion Matrix and Accuracy Metrics
3388        *****************************************************************************/
3389       
3390       /* Calculate metrics at different thresholds */
3391       %macro confusion_metrics(threshold, suffix);
3392           data work.confusion_&suffix;
3393               set work.logit_scored_valid;
3394               predicted = (pd_logistic >= &threshold);
3395           run;
3396       
3397           proc freq data=work.confusion_&suffix noprint;
3398               tables default_flag * predicted / out=work.conf_matrix_&suffix;
3399           run;
3400       
3401           /* Calculate metrics */
3402           data work.metrics_&suffix;
3403               set work.conf_matrix_&suffix end=eof;
3404               retain TP TN FP FN 0;
3405       
3406               if default_flag = 1 and predicted = 1 then TP = count;
3407               else if default_flag = 0 and predicted = 0 then TN = count;
3408               else if default_flag = 0 and predicted = 1 then FP = count;
3409               else if default_flag = 1 and predicted = 0 then FN = count;
3410       
3411               if eof then do;
3412                   threshold = &threshold;
3413                   if (TP + TN + FP + FN) > 0 then accuracy = (TP + TN) / (TP + TN + FP + FN);
3414                   else accuracy = .;
3415                   if (TP + FP) > 0 then precision = TP / (TP + FP);
3416                   else precision = .;
3417                   if (TP + FN) > 0 then recall = TP / (TP + FN);
3418                   else recall = .;
3419                   if (precision + recall) > 0 then f1_score = 2 * (precision * recall) / (precision + recall);
3420                   else f1_score = .;
3421                   if (TN + FP) > 0 then specificity = TN / (TN + FP);
3422                   else specificity = .;
3423                   output;
3424               end;
3425               keep threshold accuracy precision recall f1_score specificity;
3426           run;
3427       %mend;
3428       
3429       /* Test multiple thresholds */
3430       %confusion_metrics(0.3, 03);
3431       %confusion_metrics(0.4, 04);
3432       %confusion_metrics(0.5, 05);
3433       %confusion_metrics(0.6, 06);
3434       %confusion_metrics(0.7, 07);
3435       
3436       /* Combine results */
3437       data work.threshold_analysis;
3438           set work.metrics_03 work.metrics_04 work.metrics_05
3439               work.metrics_06 work.metrics_07;
3440       run;
3441       
3442       proc print data=work.threshold_analysis;
3443           title "Performance Metrics at Different Thresholds";
3444           format accuracy precision recall f1_score specificity 8.4;
3445       run;
3446       
3447       /*****************************************************************************
3448        * 5. Decile Analysis and Lift Chart
3449        *****************************************************************************/
3450       
3451       /* Create deciles based on predicted probability */
3452       proc rank data=work.logit_scored_valid
3453                 out=work.decile_data
3454                 groups=10 descending;
3455           var pd_logistic;
3456           ranks decile;
3457       run;
3458       
3459       /* Calculate lift by decile */
3460       proc sql;
3461           create table work.decile_analysis as
3462           select
3463               decile + 1 as decile,
3464               count(*) as total_count,
3465               sum(default_flag) as defaults,
3466               mean(default_flag) as default_rate format=percent8.2,
3467               mean(pd_logistic) as avg_pd format=8.4,
3468               min(pd_logistic) as min_pd format=8.4,
3469               max(pd_logistic) as max_pd format=8.4,
3470               sum(default_flag) / (select sum(default_flag) from work.decile_data) as capture_rate format=percent8.2,
3471               (calculated default_rate) / (select mean(default_flag) from work.decile_data) as lift format=8.2
3472           from work.decile_data
3473           group by decile
3474           order by decile;
3475       quit;
3476       
3477       proc print data=work.decile_analysis;
3478           title "Decile Analysis - Model Lift and Capture Rate";
3479       run;
3480       
3481       /* Calculate totals for cumulative lift chart */
3482       proc sql noprint;
3483           select sum(default_flag), mean(default_flag)
3484           into :total_defaults, :overall_default_rate
3485           from work.decile_data;
3486       quit;
3487       
3488       /* Create cumulative lift chart */
3489       data work.cumulative_lift;
3490           set work.decile_analysis;
3491           retain cum_defaults cum_count;
3492           if _n_ = 1 then do;
3493               cum_defaults = defaults;
3494               cum_count = total_count;
3495           end;
3496           else do;
3497               cum_defaults + defaults;
3498               cum_count + total_count;
3499           end;
3500       
3501           cum_capture_rate = cum_defaults / &total_defaults;
3502           cum_lift = (cum_defaults / cum_count) / &overall_default_rate;
3503           format cum_capture_rate percent8.2 cum_lift 8.2;
3504       run;
3505       
3506       proc sgplot data=work.cumulative_lift;
3507           series x=decile y=cum_lift;
3508           refline 1 / axis=y;
3509           xaxis label="Decile";
3510           yaxis label="Cumulative Lift";
3511           title "Cumulative Lift Chart";
3512       run;
3513       
3514       /*****************************************************************************
3515        * 6. Population Stability Index (PSI)
3516        *****************************************************************************/
3517       
3518       /* Compare score distributions between training and validation */
3519       proc rank data=work.logit_scored_train
3520                 out=work.train_bins
3521                 groups=10;
3522           var pd_logistic;
3523           ranks score_bin;
3524       run;
3525       
3526       proc rank data=work.logit_scored_valid
3527                 out=work.valid_bins
3528                 groups=10;
3529           var pd_logistic;
3530           ranks score_bin;
3531       run;
3532       
3533       /* Calculate PSI */
3534       proc sql;
3535           create table work.psi_calculation as
3536           select
3537               a.score_bin,
3538               a.train_pct,
3539               b.valid_pct,
3540               (a.train_pct - b.valid_pct) * log(a.train_pct / b.valid_pct) as psi_component
3541           from
3542               (select score_bin, count(*) / (select count(*) from work.train_bins) as train_pct
3543                from work.train_bins group by score_bin) a
3544           join
3545               (select score_bin, count(*) / (select count(*) from work.valid_bins) as valid_pct
3546                from work.valid_bins group by score_bin) b
3547           on a.score_bin = b.score_bin;
3548       
3549           create table work.psi_summary as
3550           select sum(psi_component) as PSI format=8.4,
3551                  case
3552                     when calculated PSI < 0.1 then 'No significant change'
3553                     when calculated PSI < 0.25 then 'Some change'
3554                     else 'Significant change'
3555                  end as PSI_interpretation
3556           from work.psi_calculation;
3557       quit;
3558       
3559       proc print data=work.psi_summary noobs;
3560           title "Population Stability Index";
3561       run;
3562       
3563       /*****************************************************************************
3564        * 7. Calibration Plot
3565        *****************************************************************************/
3566       
3567       /* Bin predictions and compare to actual */
3568       proc rank data=work.logit_scored_valid
3569                 out=work.calibration_data
3570                 groups=20;
3571           var pd_logistic;
3572           ranks pred_bin;
3573       run;
3574       
3575       proc sql;
3576           create table work.calibration_plot as
3577           select
3578               pred_bin,
3579               mean(pd_logistic) as mean_predicted format=8.4,
3580               mean(default_flag) as mean_actual format=8.4,
3581               count(*) as bin_count
3582           from work.calibration_data
3583           group by pred_bin
3584           order by pred_bin;
3585       quit;
3586       
3587       proc sgplot data=work.calibration_plot;
3588           scatter x=mean_predicted y=mean_actual / markerattrs=(size=10);
3589           lineparm x=0 y=0 slope=1 / lineattrs=(pattern=dash);
3590           xaxis label="Mean Predicted Probability";
3591           yaxis label="Mean Actual Default Rate";
3592           title "Calibration Plot - Predicted vs Actual";
3593       run;
3594       
3595       /*****************************************************************************
3596        * 8. Generate Validation Report
3597        *****************************************************************************/
3598       
3599       /* Compile validation metrics */
3600       data work.validation_summary;
3601           merge work.auc_summary
3602                 work.ks_statistic
3603                 work.psi_summary;
3604           length model $20 status $20;
3605           model = "Logistic Regression";
3606       
3607           /* Determine model status based on metrics */
3608           if AUC >= 0.7 and KS_Statistic >= 0.3 and PSI < 0.25 then
3609               status = "Production Ready";
3610           else if AUC >= 0.65 then
3611               status = "Requires Review";
3612           else
3613               status = "Needs Improvement";
3614       run;
3615       
3616       proc print data=work.validation_summary noobs;
3617           title "Model Validation Summary";
3618       run;
