4796       /*****************************************************************************
4797        * 3. Feature Engineering (Same as Training)
4798        *****************************************************************************/
4799       
4800       data work.test_features;
4801           set work.test_imputed;
4802       
4803           /* Total late payments across all categories */
4804           total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
4805       
4806           /* Has any delinquency indicator */
4807           has_delinquency = (total_late_payments > 0);
4808       
4809           /* Has serious delinquency (90+ days) */
4810           has_serious_delinquency = (num_late_90_plus > 0);
4811       
4812           /* Credit utilization categories */
4813           if credit_utilization < 30 then credit_util_category = 1;
4814           else if credit_utilization < 50 then credit_util_category = 2;
4815           else if credit_utilization < 75 then credit_util_category = 3;
4816           else credit_util_category = 4;
4817       
4818           /* Debt ratio categories */
4819           if debt_ratio < 30 then debt_category = 1;
4820           else if debt_ratio < 43 then debt_category = 2;
4821           else if debt_ratio < 60 then debt_category = 3;
4822           else debt_category = 4;
4823       
4824           /* Income per dependent */
4825           if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
4826           else income_per_dependent = monthly_income;
4827       
4828           /* Credit lines per person in household */
4829           credit_lines_per_person = num_credit_lines / (num_dependents + 1);
4830       
4831           /* Age categories */
4832           if age < 25 then age_category = 1;
4833           else if age < 35 then age_category = 2;
4834           else if age < 50 then age_category = 3;
4835           else if age < 65 then age_category = 4;
4836           else age_category = 5;
4837       
4838           /* Risk flags */
4839           flag_high_utilization = (credit_utilization > 75);
4840           flag_very_high_utilization = (credit_utilization > 100);
4841           flag_high_debt_ratio = (debt_ratio > 43);
4842           flag_very_high_debt_ratio = (debt_ratio > 60);
4843           flag_recent_late_payments = (num_late_30_59 > 0);
4844           flag_serious_delinquency = (num_late_90_plus > 0);
4845           flag_multiple_delinquencies = (total_late_payments >= 3);
4846           flag_low_income = (monthly_income < 2500);
4847           flag_many_dependents = (num_dependents >= 3);
4848           flag_few_credit_lines = (num_credit_lines <= 2);
4849       
4850           /* Total risk flags */
4851           total_risk_flags = sum(flag_high_utilization, flag_very_high_utilization,
4852                                 flag_high_debt_ratio,
4853                                 flag_serious_delinquency, flag_multiple_delinquencies,
4854                                 flag_low_income, flag_many_dependents,
4855                                 flag_few_credit_lines);
4856       
4857           /* Financial health score */
4858           financial_health = 100;
4859           if credit_utilization > 30 then financial_health = financial_health - 15;
4860           if credit_utilization > 75 then financial_health = financial_health - 15;
4861           if debt_ratio > 43 then financial_health = financial_health - 20;
4862           if has_delinquency then financial_health = financial_health - 20;
4863           if num_late_90_plus > 0 then financial_health = financial_health - 30;
4864           financial_health = max(0, financial_health);
4865       
4866           /* Log transformations */
4867           log_monthly_income = log(monthly_income + 1);
4868           log_num_credit_lines = log(num_credit_lines + 1);
4869           log_total_late_payments = log(total_late_payments + 1);
4870       
4871           /* Interaction features */
4872           if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
4873           else age_income_interaction = age * log_monthly_income;
4874           utilization_debt_interaction = credit_utilization * debt_ratio;
4875       
4876           /* Cap extreme outliers */
4877           credit_utilization_capped = min(credit_utilization, 200);
4878           debt_ratio_capped = min(debt_ratio, 500);
4879       run;
4880       
4881       /*****************************************************************************
4882        * 4. Score Test Set Using Trained Model
4883        *****************************************************************************/
4884       
4885       /* Score test set with trained model */
4886       proc plm restore=work.logit_model;
4887           score data=work.test_features
4888                 out=work.test_scored_temp
4889                 predicted=predicted_logit;
4890       run;
4891       
4892       /* Convert logit to probability */
4893       data work.test_scored;
4894           set work.test_scored_temp;
4895       
4896           /* Apply inverse logit function */
4897           pd_logistic = 1 / (1 + exp(-predicted_logit));
4898       
4899           drop predicted_logit;
4900       run;
4901       
4902       /*****************************************************************************
4903        * 5. Generate Risk Scores and Recommendations
4904        *****************************************************************************/
4905       
4906       data work.test_predictions;
4907           set work.test_scored;
4908       
4909           /* Binary prediction at 0.5 threshold */
4910           pred_logistic = (pd_logistic >= 0.5);
4911       
4912           /* Convert probability to credit risk score (300-850 scale) */
4913           base_score = 600;
4914           score_range = 250;
4915           credit_risk_score = base_score + score_range * (1 - pd_logistic);
4916       
4917           /* Assign risk grades from the probability (a missing probability is graded F) */
4918           if missing(pd_logistic) then risk_grade = 'F';
4919           else if pd_logistic < 0.10 then risk_grade = 'A';
4920           else if pd_logistic < 0.15 then risk_grade = 'B';
4921           else if pd_logistic < 0.25 then risk_grade = 'C';
4922           else if pd_logistic < 0.35 then risk_grade = 'D';
4923           else if pd_logistic <= 0.50 then risk_grade = 'E';
4924           else risk_grade = 'F';
4925       
4926           /* Recommended actions */
4927           if risk_grade in ('A', 'B') then recommendation = 'Approve';
4928           else if risk_grade = 'C' then recommendation = 'Review';
4929           else recommendation = 'Decline';
4930       
4931           /* Suggested interest rate */
4932           base_rate = 0.05;
4933           if risk_grade = 'A' then interest_rate = base_rate;
4934           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
4935           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
4936           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
4937           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
4938           else interest_rate = base_rate + 0.15;
4939       
4940           format interest_rate percent8.2;
4941       run;
4942       
4943       /*****************************************************************************
4944        * 6. Create Output Datasets
4945        *****************************************************************************/
4946       
4947       /* Kaggle submission format (row_id, probability) */
4948       data work.kaggle_submission;
4949           set work.test_predictions;
4950           keep row_id pd_logistic;
4951       run;
4952       
4953       /* Full predictions with all scores and recommendations */
4954       data work.test_predictions_full;
4955           set work.test_predictions;
4956           keep row_id pd_logistic pred_logistic credit_risk_score risk_grade
4957                recommendation interest_rate age monthly_income
4958                credit_utilization debt_ratio total_late_payments
4959                num_credit_lines financial_health total_risk_flags;
4960       run;
4961       
