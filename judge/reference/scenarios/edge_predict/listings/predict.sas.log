4801       data work.test_cleaned;
4802           set work.test_raw_clean;
4803       
4804           /* Create age group for income imputation */
4805           if age < 30 then age_group = 1;
4806           else if age < 40 then age_group = 2;
4807           else if age < 50 then age_group = 3;
4808           else if age < 60 then age_group = 4;
4809           else age_group = 5;
4810       
4811           /* Handle missing values - create flags */
4812           if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
4813           else MonthlyIncome_missing = 0;
4814       
4815           if missing(NumberOfDependents) then do;
4816               NumberOfDependents = 0;
4817               Dependents_missing = 1;
4818           end;
4819           else Dependents_missing = 0;
4820       run;
4821       
4822       /* Merge and impute income - rename columns in SQL */
4823       proc sql;
4824           create table work.test_imputed as
4825           select
4826               a.VAR1 as row_id,
4827               a.age,
4828               case when a.MonthlyIncome_missing = 1 then coalesce(b.median_income, b.overall_median_income)
4829                    else a.MonthlyIncome
4830               end as monthly_income,
4831               a.MonthlyIncome_missing,
4832               a.NumberOfDependents as num_dependents,
4833               a.Dependents_missing,
4834               a.age_group,
4835               a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
4836               a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
4837               a.NumberOfTimes90DaysLate as num_late_90_plus,
4838               a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
4839               a.DebtRatio * 100 as debt_ratio,
4840               a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
4841               a.NumberRealEstateLoansOrLines as num_real_estate_loans
4842           from work.test_cleaned a
4843           left join work.train_income_medians b
4844           on a.age_group = b.age_group;
4845       quit;
