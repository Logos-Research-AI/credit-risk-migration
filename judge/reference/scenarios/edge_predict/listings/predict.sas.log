4698       
4699       data work.test_cleaned;
4700           set work.test_raw_clean;
4701       
4702           /* Create age group for income imputation */
4703           if age < 30 then age_group = 1;
4704           else if age < 40 then age_group = 2;
4705           else if age < 50 then age_group = 3;
4706           else if age < 60 then age_group = 4;
4707           else age_group = 5;
4708       
4709           /* Handle missing values - create flags */
4710           if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
4711           else MonthlyIncome_missing = 0;
4712       
4713           if missing(NumberOfDependents) then do;
4714               NumberOfDependents = 0;
4715               Dependents_missing = 1;
4716           end;
4717           else Dependents_missing = 0;
4718       run;
4719       
4720       /* Merge and impute income - rename columns in SQL */
4721       proc sql;
4722           create table work.test_imputed as
4723           select
4724               a.VAR1 as row_id,
4725               a.age,
4726               case when a.MonthlyIncome_missing = 1 then coalesce(b.median_income, b.overall_median_income)
4727                    else a.MonthlyIncome
4728               end as monthly_income,
4729               a.MonthlyIncome_missing,
4730               a.NumberOfDependents as num_dependents,
4731               a.Dependents_missing,
4732               a.age_group,
4733               a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
4734               a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
4735               a.NumberOfTimes90DaysLate as num_late_90_plus,
4736               a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
4737               a.DebtRatio * 100 as debt_ratio,
4738               a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
4739               a.NumberRealEstateLoansOrLines as num_real_estate_loans
4740           from work.test_cleaned a
4741           left join work.train_income_medians b
4742           on a.age_group = b.age_group;
4743       quit;
4744       
4745       /*****************************************************************************
4746        * 3. Feature Engineering (Same as Training)
4747        *****************************************************************************/
4748       
4749       data work.test_features;
4750           set work.test_imputed;
4751       
4752           /* Total late payments across all categories */
4753           total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
4754       
4755           /* Has any delinquency indicator */
4756           has_delinquency = (total_late_payments > 0);
4757       
4758           /* Has serious delinquency (90+ days) */
4759           has_serious_delinquency = (num_late_90_plus > 0);
4760       
4761           /* Credit utilization categories */
4762           if credit_utilization < 30 then credit_util_category = 1;
4763           else if credit_utilization < 50 then credit_util_category = 2;
4764           else if credit_utilization < 75 then credit_util_category = 3;
4765           else credit_util_category = 4;
4766       
4767           /* Debt ratio categories */
4768           if debt_ratio < 30 then debt_category = 1;
4769           else if debt_ratio < 43 then debt_category = 2;
4770           else if debt_ratio < 60 then debt_category = 3;
4771           else debt_category = 4;
4772       
4773           /* Income per dependent */
4774           if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
4775           else income_per_dependent = monthly_income;
4776       
4777           /* Credit lines per person in household */
4778           credit_lines_per_person = num_credit_lines / (num_dependents + 1);
4779       
4780           /* Age categories */
4781           if age < 25 then age_category = 1;
4782           else if age < 35 then age_category = 2;
4783           else if age < 50 then age_category = 3;
4784           else if age < 65 then age_category = 4;
4785           else age_category = 5;
4786       
4787           /* Risk flags */
4788           flag_high_utilization = (credit_utilization > 75);
4789           flag_very_high_utilization = (credit_utilization > 100);
4790           flag_high_debt_ratio = (debt_ratio > 43);
4791           flag_very_high_debt_ratio = (debt_ratio > 60);
4792           flag_recent_late_payments = (num_late_30_59 > 0);
4793           flag_serious_delinquency = (num_late_90_plus > 0);
4794           flag_multiple_delinquencies = (total_late_payments >= 3);
4795           flag_low_income = (monthly_income < 2500);
4796           flag_many_dependents = (num_dependents >= 3);
4797           flag_few_credit_lines = (num_credit_lines <= 2);
4798       
4799           /* Total risk flags */
4800           total_risk_flags = sum(flag_high_utilization, flag_very_high_utilization,
4801                                 flag_high_debt_ratio,
4802                                 flag_serious_delinquency, flag_multiple_delinquencies,
4803                                 flag_low_income, flag_many_dependents,
4804                                 flag_few_credit_lines);
4805       
4806           /* Financial health score */
4807           financial_health = 100;
4808           if credit_utilization > 30 then financial_health = financial_health - 15;
4809           if credit_utilization > 75 then financial_health = financial_health - 15;
4810           if debt_ratio > 43 then financial_health = financial_health - 20;
4811           if has_delinquency then financial_health = financial_health - 20;
4812           if num_late_90_plus > 0 then financial_health = financial_health - 30;
4813           financial_health = max(0, financial_health);
4814       
4815           /* Log transformations */
4816           log_monthly_income = log(monthly_income + 1);
4817           log_num_credit_lines = log(num_credit_lines + 1);
4818           log_total_late_payments = log(total_late_payments + 1);
4819       
4820           /* Interaction features */
4821           if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
4822           else age_income_interaction = age * log_monthly_income;
4823           utilization_debt_interaction = credit_utilization * debt_ratio;
4824       
4825           /* Cap extreme outliers */
4826           credit_utilization_capped = min(credit_utilization, 200);
4827           debt_ratio_capped = min(debt_ratio, 500);
4828       run;
4829       
4830       /*****************************************************************************
4831        * 4. Score Test Set Using Trained Model
4832        *****************************************************************************/
4833       
4834       /* Score test set with trained model */
4835       proc plm restore=work.logit_model;
4836           score data=work.test_features
4837                 out=work.test_scored_temp
4838                 predicted=predicted_logit;
4839       run;
4840       
4841       /* Convert logit to probability */
4842       data work.test_scored;
4843           set work.test_scored_temp;
4844       
4845           /* Apply inverse logit function */
4846           pd_logistic = 1 / (1 + exp(-predicted_logit));
4847       
4848           drop predicted_logit;
4849       run;
4850       
4851       /*****************************************************************************
4852        * 5. Generate Risk Scores and Recommendations
4853        *****************************************************************************/
4854       
4855       data work.test_predictions;
4856           set work.test_scored;
4857       
4858           /* Binary prediction at 0.5 threshold */
4859           pred_logistic = (pd_logistic >= 0.5);
4860       
4861           /* Convert probability to credit risk score (300-850 scale) */
4862           base_score = 600;
4863           score_range = 250;
4864           credit_risk_score = base_score + score_range * (1 - pd_logistic);
4865       
4866           /* Assign risk grades from the probability (a missing probability is graded F) */
4867           if missing(pd_logistic) then risk_grade = 'F';
4868           else if pd_logistic < 0.10 then risk_grade = 'A';
4869           else if pd_logistic < 0.15 then risk_grade = 'B';
4870           else if pd_logistic < 0.25 then risk_grade = 'C';
4871           else if pd_logistic < 0.35 then risk_grade = 'D';
4872           else if pd_logistic <= 0.50 then risk_grade = 'E';
4873           else risk_grade = 'F';
4874       
4875           /* Recommended actions */
4876           if risk_grade in ('A', 'B') then recommendation = 'Approve';
4877           else if risk_grade = 'C' then recommendation = 'Review';
4878           else recommendation = 'Decline';
4879       
4880           /* Suggested interest rate */
4881           base_rate = 0.05;
4882           if risk_grade = 'A' then interest_rate = base_rate;
4883           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
4884           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
4885           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
4886           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
4887           else interest_rate = base_rate + 0.15;
4888       
4889           format interest_rate percent8.2;
4890       run;
4891       
4892       /*****************************************************************************
4893        * 6. Create Output Datasets
4894        *****************************************************************************/
4895       
4896       /* Kaggle submission format (row_id, probability) */
4897       data work.kaggle_submission;
4898           set work.test_predictions;
4899           keep row_id pd_logistic;
4900       run;
4901       
4902       /* Full predictions with all scores and recommendations */
4903       data work.test_predictions_full;
4904           set work.test_predictions;
4905           keep row_id pd_logistic pred_logistic credit_risk_score risk_grade
4906                recommendation interest_rate age monthly_income
4907                credit_utilization debt_ratio total_late_payments
4908                num_credit_lines financial_health total_risk_flags;
4909       run;
