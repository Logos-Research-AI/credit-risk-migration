4750       data work.test_cleaned;
4751           set work.test_raw_clean;
4752       
4753           /* Create age group for income imputation */
4754           if age < 30 then age_group = 1;
4755           else if age < 40 then age_group = 2;
4756           else if age < 50 then age_group = 3;
4757           else if age < 60 then age_group = 4;
4758           else age_group = 5;
4759       
4760           /* Handle missing values - create flags */
4761           if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
4762           else MonthlyIncome_missing = 0;
4763       
4764           if missing(NumberOfDependents) then do;
4765               NumberOfDependents = 0;
4766               Dependents_missing = 1;
4767           end;
4768           else Dependents_missing = 0;
4769       run;
4770       
4771       /* Merge and impute income - rename columns in SQL */
4772       proc sql;
4773           create table work.test_imputed as
4774           select
4775               a.VAR1 as row_id,
4776               a.age,
4777               case when a.MonthlyIncome_missing = 1 then coalesce(b.median_income, b.overall_median_income)
4778                    else a.MonthlyIncome
4779               end as monthly_income,
4780               a.MonthlyIncome_missing,
4781               a.NumberOfDependents as num_dependents,
4782               a.Dependents_missing,
4783               a.age_group,
4784               a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
4785               a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
4786               a.NumberOfTimes90DaysLate as num_late_90_plus,
4787               a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
4788               a.DebtRatio * 100 as debt_ratio,
4789               a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
4790               a.NumberRealEstateLoansOrLines as num_real_estate_loans
4791           from work.test_cleaned a
4792           left join work.train_income_medians b
4793           on a.age_group = b.age_group;
4794       quit;
