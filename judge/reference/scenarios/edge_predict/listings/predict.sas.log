4853       
4854           /* Total late payments across all categories */
4855           total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
4856       
4857           /* Has any delinquency indicator */
4858           has_delinquency = (total_late_payments > 0);
4859       
4860           /* Has serious delinquency (90+ days) */
4861           has_serious_delinquency = (num_late_90_plus > 0);
4862       
4863           /* Credit utilization categories */
4864           if credit_utilization < 30 then credit_util_category = 1;
4865           else if credit_utilization < 50 then credit_util_category = 2;
4866           else if credit_utilization < 75 then credit_util_category = 3;
4867           else credit_util_category = 4;
4868       
4869           /* Debt ratio categories */
4870           if debt_ratio < 30 then debt_category = 1;
4871           else if debt_ratio < 43 then debt_category = 2;
4872           else if debt_ratio < 60 then debt_category = 3;
4873           else debt_category = 4;
4874       
4875           /* Income per dependent */
4876           if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
4877           else income_per_dependent = monthly_income;
4878       
4879           /* Credit lines per person in household */
4880           credit_lines_per_person = num_credit_lines / (num_dependents + 1);
4881       
4882           /* Age categories */
4883           if age < 25 then age_category = 1;
4884           else if age < 35 then age_category = 2;
4885           else if age < 50 then age_category = 3;
4886           else if age < 65 then age_category = 4;
4887           else age_category = 5;
4888       
4889           /* Risk flags */
4890           flag_high_utilization = (credit_utilization > 75);
4891           flag_very_high_utilization = (credit_utilization > 100);
4892           flag_high_debt_ratio = (debt_ratio > 43);
4893           flag_very_high_debt_ratio = (debt_ratio > 60);
4894           flag_recent_late_payments = (num_late_30_59 > 0);
4895           flag_serious_delinquency = (num_late_90_plus > 0);
4896           flag_multiple_delinquencies = (total_late_payments >= 3);
4897           flag_low_income = (monthly_income < 2500);
4898           flag_many_dependents = (num_dependents >= 3);
4899           flag_few_credit_lines = (num_credit_lines <= 2);
4900       
4901           /* Total risk flags */
4902           total_risk_flags = sum(flag_high_utilization, flag_very_high_utilization,
4903                                 flag_high_debt_ratio,
4904                                 flag_serious_delinquency, flag_multiple_delinquencies,
4905                                 flag_low_income, flag_many_dependents,
4906                                 flag_few_credit_lines);
4907       
4908           /* Financial health score */
4909           financial_health = 100;
4910           if credit_utilization > 30 then financial_health = financial_health - 15;
4911           if credit_utilization > 75 then financial_health = financial_health - 15;
4912           if debt_ratio > 43 then financial_health = financial_health - 20;
4913           if has_delinquency then financial_health = financial_health - 20;
4914           if num_late_90_plus > 0 then financial_health = financial_health - 30;
4915           financial_health = max(0, financial_health);
4916       
4917           /* Log transformations */
4918           log_monthly_income = log(monthly_income + 1);
4919           log_num_credit_lines = log(num_credit_lines + 1);
4920           log_total_late_payments = log(total_late_payments + 1);
4921       
4922           /* Interaction features */
4923           if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
4924           else age_income_interaction = age * log_monthly_income;
4925           utilization_debt_interaction = credit_utilization * debt_ratio;
4926       
4927           /* Cap extreme outliers */
4928           credit_utilization_capped = min(credit_utilization, 200);
4929           debt_ratio_capped = min(debt_ratio, 500);
4930       run;
4931       
4932       /*****************************************************************************
4933        * 4. Score Test Set Using Trained Model
4934        *****************************************************************************/
4935       
4936       /* Score test set with trained model */
4937       proc plm restore=work.logit_model;
4938           score data=work.test_features
4939                 out=work.test_scored_temp
4940                 predicted=predicted_logit;
4941       run;
4942       
4943       /* Convert logit to probability */
4944       data work.test_scored;
4945           set work.test_scored_temp;
4946       
4947           /* Apply inverse logit function */
4948           pd_logistic = 1 / (1 + exp(-predicted_logit));
4949       
4950           drop predicted_logit;
4951       run;
4952       
4953       /*****************************************************************************
4954        * 5. Generate Risk Scores and Recommendations
4955        *****************************************************************************/
4956       
4957       data work.test_predictions;
4958           set work.test_scored;
4959       
4960           /* Binary prediction at 0.5 threshold */
4961           pred_logistic = (pd_logistic >= 0.5);
4962       
4963           /* Convert probability to credit risk score (300-850 scale) */
4964           base_score = 600;
4965           score_range = 250;
4966           credit_risk_score = base_score + score_range * (1 - pd_logistic);
4967       
4968           /* Assign risk grades from the probability (a missing probability is graded F) */
4969           if missing(pd_logistic) then risk_grade = 'F';
4970           else if pd_logistic < 0.10 then risk_grade = 'A';
4971           else if pd_logistic < 0.15 then risk_grade = 'B';
4972           else if pd_logistic < 0.25 then risk_grade = 'C';
4973           else if pd_logistic < 0.35 then risk_grade = 'D';
4974           else if pd_logistic <= 0.50 then risk_grade = 'E';
4975           else risk_grade = 'F';
4976       
4977           /* Recommended actions */
4978           if risk_grade in ('A', 'B') then recommendation = 'Approve';
4979           else if risk_grade = 'C' then recommendation = 'Review';
4980           else recommendation = 'Decline';
4981       
4982           /* Suggested interest rate */
4983           base_rate = 0.05;
4984           if risk_grade = 'A' then interest_rate = base_rate;
4985           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
4986           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
4987           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
4988           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
4989           else interest_rate = base_rate + 0.15;
4990       
4991           format interest_rate percent8.2;
4992       run;
4993       
4994       /*****************************************************************************
4995        * 6. Create Output Datasets
4996        *****************************************************************************/
4997       
4998       /* Kaggle submission format (row_id, probability) */
4999       data work.kaggle_submission;
5000           set work.test_predictions;
5001           keep row_id pd_logistic;
5002       run;
5003       
5004       /* Full predictions with all scores and recommendations */
5005       data work.test_predictions_full;
5006           set work.test_predictions;
5007           keep row_id pd_logistic pred_logistic credit_risk_score risk_grade
5008                recommendation interest_rate age monthly_income
5009                credit_utilization debt_ratio total_late_payments
5010                num_credit_lines financial_health total_risk_flags;
5011       run;
