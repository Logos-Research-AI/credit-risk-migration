1430       /*****************************************************************************
1431        * 2. Train Logistic Regression Model
1432        *****************************************************************************/
1433       
1434       /* Train logistic regression with stepwise selection */
1435       proc logistic data=work.model_features_train descending;
1436           model default_flag =
1437               /* Core risk metrics */
1438               credit_utilization_capped debt_ratio_capped
1439       
1440               /* Late payment indicators */
1441               num_late_30_59 num_late_60_89 num_late_90_plus
1442               total_late_payments has_delinquency has_serious_delinquency
1443       
1444               /* Financial metrics */
1445               age monthly_income log_monthly_income
1446               num_credit_lines num_real_estate_loans log_num_credit_lines
1447               num_dependents income_per_dependent credit_lines_per_person
1448       
1449               /* Risk flags */
1450               flag_high_utilization flag_very_high_utilization
1451               flag_high_debt_ratio flag_very_high_debt_ratio
1452               flag_recent_late_payments flag_serious_delinquency
1453               flag_multiple_delinquencies flag_low_income
1454               flag_many_dependents flag_few_credit_lines
1455               total_risk_flags
1456       
1457               /* Categorical indicators */
1458               credit_util_category debt_category age_category
1459       
1460               /* Composite scores */
1461               financial_health
1462       
1463               /* Interaction features */
1464               age_income_interaction utilization_debt_interaction
1465       
1466               /* Missing value flags */
1467               MonthlyIncome_missing Dependents_missing
1468       
1469           / selection=stepwise slentry=0.05 slstay=0.05
1470             ctable lackfit rsquare;
1471       
1472           /* Output predictions */
1473           output out=work.logit_scored_train
1474                  predicted=pd_logistic;
1475       
1476           /* Store model for scoring */
1477           store work.logit_model;
1478       
1479           /* Output parameter estimates (coefficients) */
1480           ods output ModelBuildingSummary=work._j_modelbuildingsummary FitStatistics=work._j_fitstatistics
1480     ! GlobalTests=work._j_globaltests RSquare=work._j_rsquare Association=work._j_association OddsRatios=work._j_oddsratios
1480     ! LackFitPartition=work._j_lackfitpartition LackFitChiSq=work._j_lackfitchisq Classification=work._j_classification
1480     ! ParameterEstimates=work.model_coefficients;
1481       
1482           title "Logistic Regression Model - Credit Default Prediction";
1483       run;
1484       
1485       /*****************************************************************************
1486        * 3. Evaluate Model on Training Data
1487        *****************************************************************************/
1488       
1489       /* Add binary prediction variable */
1490       data work.logit_scored_train;
1491           set work.logit_scored_train;
1492           pred_logistic = (pd_logistic >= 0.5);
1493       run;
1494       
1495       /* Confusion matrix on training set */
1496       proc freq data=work.logit_scored_train noprint;
1497           tables default_flag * pred_logistic / out=work.confusion_matrix_train;
1498       run;
1499       
1500       proc print data=work.confusion_matrix_train;
1501           title "Confusion Matrix - Training Set";
1502       run;
1503       
1504       /* Calculate precision, recall, and F1 score for training set */
1505       data work.training_metrics;
1506           set work.confusion_matrix_train end=eof;
1507           retain TP TN FP FN 0;
1508       
1509           if default_flag = 1 and pred_logistic = 1 then TP = count;
1510           else if default_flag = 0 and pred_logistic = 0 then TN = count;
1511           else if default_flag = 0 and pred_logistic = 1 then FP = count;
1512           else if default_flag = 1 and pred_logistic = 0 then FN = count;
1513       
1514           if eof then do;
1515               if (TP + FP) > 0 then train_precision = TP / (TP + FP);
1516               else train_precision = .;
1517               if (TP + FN) > 0 then train_recall = TP / (TP + FN);
1518               else train_recall = .;
1519               if (train_precision + train_recall) > 0 then train_f1_score = 2 * (train_precision * train_recall) /
1519     ! (train_precision + train_recall);
1520               else train_f1_score = .;
1521               if (TP + TN + FP + FN) > 0 then train_accuracy = (TP + TN) / (TP + TN + FP + FN);
1522               else train_accuracy = .;
1523               output;
1524           end;
1525           keep train_precision train_recall train_f1_score train_accuracy;
1526       run;
1527       
1528       proc print data=work.training_metrics;
1529           title "Training Set - Performance Metrics";
1530           format train_precision train_recall train_f1_score train_accuracy 8.4;
1531       run;
1532       
1533       /*****************************************************************************
1534        * 4. Score Validation Set
1535        *****************************************************************************/
1536       
1537       /* Score validation set with trained model */
1538       proc plm restore=work.logit_model;
1539           score data=work.model_features_validation
1540                 out=work.logit_scored_valid_temp
1541                 predicted=predicted_logit;
1542       run;
1543       
1544       /* Convert logit to probability */
1545       data work.logit_scored_valid;
1546           set work.logit_scored_valid_temp;
1547       
1548           /* Apply inverse logit (logistic) function */
1549           pd_logistic = 1 / (1 + exp(-predicted_logit));
1550       
1551           /* Add binary prediction */
1552           pred_logistic = (pd_logistic >= 0.5);
1553       
1554           drop predicted_logit;
1555       run;
1556       
1557       /* Confusion matrix on validation set */
1558       proc freq data=work.logit_scored_valid noprint;
1559           tables default_flag * pred_logistic / out=work.confusion_matrix;
1560       run;
1561       
1562       proc print data=work.confusion_matrix;
1563           title "Confusion Matrix - Validation Set";
1564       run;
1565       
1566       /* Calculate precision, recall, and F1 score for validation set */
1567       data work.validation_metrics;
1568           set work.confusion_matrix end=eof;
1569           retain TP TN FP FN 0;
1570       
1571           if default_flag = 1 and pred_logistic = 1 then TP = count;
1572           else if default_flag = 0 and pred_logistic = 0 then TN = count;
1573           else if default_flag = 0 and pred_logistic = 1 then FP = count;
1574           else if default_flag = 1 and pred_logistic = 0 then FN = count;
1575       
1576           if eof then do;
1577               if (TP + FP) > 0 then valid_precision = TP / (TP + FP);
1578               else valid_precision = .;
1579               if (TP + FN) > 0 then valid_recall = TP / (TP + FN);
1580               else valid_recall = .;
1581               if (valid_precision + valid_recall) > 0 then valid_f1_score = 2 * (valid_precision * valid_recall) /
1581     ! (valid_precision + valid_recall);
1582               else valid_f1_score = .;
1583               if (TP + TN + FP + FN) > 0 then valid_accuracy = (TP + TN) / (TP + TN + FP + FN);
1584               else valid_accuracy = .;
1585               output;
1586           end;
1587           keep valid_precision valid_recall valid_f1_score valid_accuracy;
1588       run;
1589       
1590       proc print data=work.validation_metrics;
1591           title "Validation Set - Performance Metrics";
1592           format valid_precision valid_recall valid_f1_score valid_accuracy 8.4;
1593       run;
1594       
1595       /*****************************************************************************
1596        * 5. Create Risk Scores and Grades
1597        *****************************************************************************/
1598       
1599       /* Generate risk scores for training set */
1600       data work.risk_scores_train;
1601           set work.logit_scored_train;
1602       
1603           /* Convert probability to credit risk score (300-850 scale like FICO) */
1604           base_score = 600;
1605           score_range = 250;
1606           credit_risk_score = base_score + score_range * (1 - pd_logistic);
1607       
1608           /* Assign risk grades from the probability (a missing probability is graded F) */
1609           if missing(pd_logistic) then risk_grade = 'F';
1610           else if pd_logistic < 0.10 then risk_grade = 'A';
1611           else if pd_logistic < 0.15 then risk_grade = 'B';
1612           else if pd_logistic < 0.25 then risk_grade = 'C';
1613           else if pd_logistic < 0.35 then risk_grade = 'D';
1614           else if pd_logistic <= 0.50 then risk_grade = 'E';
1615           else risk_grade = 'F';
1616       
1617           /* Recommended actions */
1618           if risk_grade in ('A', 'B') then recommendation = 'Approve';
1619           else if risk_grade = 'C' then recommendation = 'Review';
1620           else recommendation = 'Decline';
1621       
1622           /* Suggested interest rate (risk-based pricing) */
1623           base_rate = 0.05;
1624           if risk_grade = 'A' then interest_rate = base_rate;
1625           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
1626           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
1627           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
1628           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
1629           else interest_rate = base_rate + 0.15;
1630       
1631           format interest_rate percent8.2;
1632       run;
1633       
1634       /* Generate risk scores for validation set */
1635       data work.risk_scores_validation;
1636           set work.logit_scored_valid;
1637       
1638           /* Same scoring logic as training */
1639           base_score = 600;
1640           score_range = 250;
1641           credit_risk_score = base_score + score_range * (1 - pd_logistic);
1642       
1643           if missing(pd_logistic) then risk_grade = 'F';
1644           else if pd_logistic < 0.10 then risk_grade = 'A';
1645           else if pd_logistic < 0.15 then risk_grade = 'B';
1646           else if pd_logistic < 0.25 then risk_grade = 'C';
1647           else if pd_logistic < 0.35 then risk_grade = 'D';
1648           else if pd_logistic <= 0.50 then risk_grade = 'E';
1649           else risk_grade = 'F';
1650       
1651           if risk_grade in ('A', 'B') then recommendation = 'Approve';
1652           else if risk_grade = 'C' then recommendation = 'Review';
1653           else recommendation = 'Decline';
1654       
1655           base_rate = 0.05;
1656           if risk_grade = 'A' then interest_rate = base_rate;
1657           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
1658           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
1659           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
1660           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
1661           else interest_rate = base_rate + 0.15;
1662       
1663           format interest_rate percent8.2;
1664       run;
1665       
1666       /* Risk grade distribution */
1667       proc freq data=work.risk_scores_train;
1668           tables risk_grade * default_flag / nocol nopercent;
1669           title "Default Rate by Risk Grade - Training Set";
1670       run;
1671       
1672       proc freq data=work.risk_scores_validation;
1673           tables risk_grade * default_flag / nocol nopercent;
1674           title "Default Rate by Risk Grade - Validation Set";
1675       run;
1676       
1677       /*****************************************************************************
1678        * 6. ROC Curve and AUC
1679        *****************************************************************************/
1680       
1681       /* ROC analysis for training set */
1682       proc logistic data=work.risk_scores_train;
1683           model default_flag(event='1') = pd_logistic / nofit;
1684           roc 'Training Set' pred=pd_logistic;
1685           ods output ROCAssociation=work.roc_train;
1686           title "ROC Curve - Training Set";
1687       run;
1688       
1689       /* ROC analysis for validation set */
1690       proc logistic data=work.risk_scores_validation;
1691           model default_flag(event='1') = pd_logistic / nofit;
1692           roc 'Validation Set' pred=pd_logistic;
1693           ods output ROCAssociation=work.roc_valid;
1694           title "ROC Curve - Validation Set";
1695       run;
1696       
1697       /* Display AUC */
1698       proc print data=work.roc_train;
1699           where ROCModel = 'Training Set';
1700           var Area;
1701           title "Training Set AUC";
1702       run;
1703       
1704       proc print data=work.roc_valid;
1705           where ROCModel = 'Validation Set';
1706           var Area;
1707           title "Validation Set AUC";
1708       run;
