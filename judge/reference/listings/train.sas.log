1432       /*****************************************************************************
1433        * 2. Train Logistic Regression Model
1434        *****************************************************************************/
1435       
1436       /* Train logistic regression with stepwise selection */
1437       proc logistic data=work.model_features_train descending;
1438           model default_flag =
1439               /* Core risk metrics */
1440               credit_utilization_capped debt_ratio_capped
1441       
1442               /* Late payment indicators */
1443               num_late_30_59 num_late_60_89 num_late_90_plus
1444               total_late_payments has_delinquency has_serious_delinquency
1445       
1446               /* Financial metrics */
1447               age monthly_income log_monthly_income
1448               num_credit_lines num_real_estate_loans log_num_credit_lines
1449               num_dependents income_per_dependent credit_lines_per_person
1450       
1451               /* Risk flags */
1452               flag_high_utilization flag_very_high_utilization
1453               flag_high_debt_ratio flag_very_high_debt_ratio
1454               flag_recent_late_payments flag_serious_delinquency
1455               flag_multiple_delinquencies flag_low_income
1456               flag_many_dependents flag_few_credit_lines
1457               total_risk_flags
1458       
1459               /* Categorical indicators */
1460               credit_util_category debt_category age_category
1461       
1462               /* Composite scores */
1463               financial_health
1464       
1465               /* Interaction features */
1466               age_income_interaction utilization_debt_interaction
1467       
1468               /* Missing value flags */
1469               MonthlyIncome_missing Dependents_missing
1470       
1471           / selection=stepwise slentry=0.05 slstay=0.05
1472             ctable lackfit rsquare;
1473       
1474           /* Output predictions */
1475           output out=work.logit_scored_train
1476                  predicted=pd_logistic;
1477       
1478           /* Store model for scoring */
1479           store work.logit_model;
1480       
1481           /* Output parameter estimates (coefficients) */
1482           ods output ModelBuildingSummary=work._j_modelbuildingsummary FitStatistics=work._j_fitstatistics
1482     ! GlobalTests=work._j_globaltests RSquare=work._j_rsquare Association=work._j_association OddsRatios=work._j_oddsratios
1482     ! LackFitPartition=work._j_lackfitpartition LackFitChiSq=work._j_lackfitchisq Classification=work._j_classification
1482     ! ParameterEstimates=work.model_coefficients;
1483       
1484           title "Logistic Regression Model - Credit Default Prediction";
1485       run;
1486       
1487       /*****************************************************************************
1488        * 3. Evaluate Model on Training Data
1489        *****************************************************************************/
1490       
1491       /* Add binary prediction variable */
1492       data work.logit_scored_train;
1493           set work.logit_scored_train;
1494           pred_logistic = (pd_logistic >= 0.5);
1495       run;
1496       
1497       /* Confusion matrix on training set */
1498       proc freq data=work.logit_scored_train noprint;
1499           tables default_flag * pred_logistic / out=work.confusion_matrix_train;
1500       run;
1501       
1502       proc print data=work.confusion_matrix_train;
1503           title "Confusion Matrix - Training Set";
1504       run;
1505       
1506       /* Calculate precision, recall, and F1 score for training set */
1507       data work.training_metrics;
1508           set work.confusion_matrix_train end=eof;
1509           retain TP TN FP FN 0;
1510       
1511           if default_flag = 1 and pred_logistic = 1 then TP = count;
1512           else if default_flag = 0 and pred_logistic = 0 then TN = count;
1513           else if default_flag = 0 and pred_logistic = 1 then FP = count;
1514           else if default_flag = 1 and pred_logistic = 0 then FN = count;
1515       
1516           if eof then do;
1517               if (TP + FP) > 0 then train_precision = TP / (TP + FP);
1518               else train_precision = .;
1519               if (TP + FN) > 0 then train_recall = TP / (TP + FN);
1520               else train_recall = .;
1521               if (train_precision + train_recall) > 0 then train_f1_score = 2 * (train_precision * train_recall) /
1521     ! (train_precision + train_recall);
1522               else train_f1_score = .;
1523               if (TP + TN + FP + FN) > 0 then train_accuracy = (TP + TN) / (TP + TN + FP + FN);
1524               else train_accuracy = .;
1525               output;
1526           end;
1527           keep train_precision train_recall train_f1_score train_accuracy;
1528       run;
1529       
1530       proc print data=work.training_metrics;
1531           title "Training Set - Performance Metrics";
1532           format train_precision train_recall train_f1_score train_accuracy 8.4;
1533       run;
1534       
1535       /*****************************************************************************
1536        * 4. Score Validation Set
1537        *****************************************************************************/
1538       
1539       /* Score validation set with trained model */
1540       proc plm restore=work.logit_model;
1541           score data=work.model_features_validation
1542                 out=work.logit_scored_valid_temp
1543                 predicted=predicted_logit;
1544       run;
1545       
1546       /* Convert logit to probability */
1547       data work.logit_scored_valid;
1548           set work.logit_scored_valid_temp;
1549       
1550           /* Apply inverse logit (logistic) function */
1551           pd_logistic = 1 / (1 + exp(-predicted_logit));
1552       
1553           /* Add binary prediction */
1554           pred_logistic = (pd_logistic >= 0.5);
1555       
1556           drop predicted_logit;
1557       run;
1558       
1559       /* Confusion matrix on validation set */
1560       proc freq data=work.logit_scored_valid noprint;
1561           tables default_flag * pred_logistic / out=work.confusion_matrix;
1562       run;
1563       
1564       proc print data=work.confusion_matrix;
1565           title "Confusion Matrix - Validation Set";
1566       run;
1567       
1568       /* Calculate precision, recall, and F1 score for validation set */
1569       data work.validation_metrics;
1570           set work.confusion_matrix end=eof;
1571           retain TP TN FP FN 0;
1572       
1573           if default_flag = 1 and pred_logistic = 1 then TP = count;
1574           else if default_flag = 0 and pred_logistic = 0 then TN = count;
1575           else if default_flag = 0 and pred_logistic = 1 then FP = count;
1576           else if default_flag = 1 and pred_logistic = 0 then FN = count;
1577       
1578           if eof then do;
1579               if (TP + FP) > 0 then valid_precision = TP / (TP + FP);
1580               else valid_precision = .;
1581               if (TP + FN) > 0 then valid_recall = TP / (TP + FN);
1582               else valid_recall = .;
1583               if (valid_precision + valid_recall) > 0 then valid_f1_score = 2 * (valid_precision * valid_recall) /
1583     ! (valid_precision + valid_recall);
1584               else valid_f1_score = .;
1585               if (TP + TN + FP + FN) > 0 then valid_accuracy = (TP + TN) / (TP + TN + FP + FN);
1586               else valid_accuracy = .;
1587               output;
1588           end;
1589           keep valid_precision valid_recall valid_f1_score valid_accuracy;
1590       run;
1591       
1592       proc print data=work.validation_metrics;
1593           title "Validation Set - Performance Metrics";
1594           format valid_precision valid_recall valid_f1_score valid_accuracy 8.4;
1595       run;
1596       
1597       /*****************************************************************************
1598        * 5. Create Risk Scores and Grades
1599        *****************************************************************************/
1600       
1601       /* Generate risk scores for training set */
1602       data work.risk_scores_train;
1603           set work.logit_scored_train;
1604       
1605           /* Convert probability to credit risk score (300-850 scale like FICO) */
1606           base_score = 600;
1607           score_range = 250;
1608           credit_risk_score = base_score + score_range * (1 - pd_logistic);
1609       
1610           /* Assign risk grades from the probability (a missing probability is graded F) */
1611           if missing(pd_logistic) then risk_grade = 'F';
1612           else if pd_logistic < 0.10 then risk_grade = 'A';
1613           else if pd_logistic < 0.15 then risk_grade = 'B';
1614           else if pd_logistic < 0.25 then risk_grade = 'C';
1615           else if pd_logistic < 0.35 then risk_grade = 'D';
1616           else if pd_logistic <= 0.50 then risk_grade = 'E';
1617           else risk_grade = 'F';
1618       
1619           /* Recommended actions */
1620           if risk_grade in ('A', 'B') then recommendation = 'Approve';
1621           else if risk_grade = 'C' then recommendation = 'Review';
1622           else recommendation = 'Decline';
1623       
1624           /* Suggested interest rate (risk-based pricing) */
1625           base_rate = 0.05;
1626           if risk_grade = 'A' then interest_rate = base_rate;
1627           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
1628           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
1629           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
1630           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
1631           else interest_rate = base_rate + 0.15;
1632       
1633           format interest_rate percent8.2;
1634       run;
1635       
1636       /* Generate risk scores for validation set */
1637       data work.risk_scores_validation;
1638           set work.logit_scored_valid;
1639       
1640           /* Same scoring logic as training */
1641           base_score = 600;
1642           score_range = 250;
1643           credit_risk_score = base_score + score_range * (1 - pd_logistic);
1644       
1645           if missing(pd_logistic) then risk_grade = 'F';
1646           else if pd_logistic < 0.10 then risk_grade = 'A';
1647           else if pd_logistic < 0.15 then risk_grade = 'B';
1648           else if pd_logistic < 0.25 then risk_grade = 'C';
1649           else if pd_logistic < 0.35 then risk_grade = 'D';
1650           else if pd_logistic <= 0.50 then risk_grade = 'E';
1651           else risk_grade = 'F';
1652       
1653           if risk_grade in ('A', 'B') then recommendation = 'Approve';
1654           else if risk_grade = 'C' then recommendation = 'Review';
1655           else recommendation = 'Decline';
1656       
1657           base_rate = 0.05;
1658           if risk_grade = 'A' then interest_rate = base_rate;
1659           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
1660           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
1661           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
1662           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
1663           else interest_rate = base_rate + 0.15;
1664       
1665           format interest_rate percent8.2;
1666       run;
1667       
1668       /* Risk grade distribution */
1669       proc freq data=work.risk_scores_train;
1670           tables risk_grade * default_flag / nocol nopercent;
1671           title "Default Rate by Risk Grade - Training Set";
1672       run;
1673       
1674       proc freq data=work.risk_scores_validation;
1675           tables risk_grade * default_flag / nocol nopercent;
1676           title "Default Rate by Risk Grade - Validation Set";
1677       run;
1678       
1679       /*****************************************************************************
1680        * 6. ROC Curve and AUC
1681        *****************************************************************************/
1682       
1683       /* ROC analysis for training set */
1684       proc logistic data=work.risk_scores_train;
1685           model default_flag(event='1') = pd_logistic / nofit;
1686           roc 'Training Set' pred=pd_logistic;
1687           ods output ROCAssociation=work.roc_train;
1688           title "ROC Curve - Training Set";
1689       run;
1690       
1691       /* ROC analysis for validation set */
1692       proc logistic data=work.risk_scores_validation;
1693           model default_flag(event='1') = pd_logistic / nofit;
1694           roc 'Validation Set' pred=pd_logistic;
1695           ods output ROCAssociation=work.roc_valid;
1696           title "ROC Curve - Validation Set";
1697       run;
1698       
1699       /* Display AUC */
1700       proc print data=work.roc_train;
1701           where ROCModel = 'Training Set';
1702           var Area;
1703           title "Training Set AUC";
1704       run;
1705       
1706       proc print data=work.roc_valid;
1707           where ROCModel = 'Validation Set';
1708           var Area;
1709           title "Validation Set AUC";
1710       run;
