1491        *****************************************************************************/
1492       
1493       /* ROC analysis for training set */
1494       proc logistic data=work.risk_scores_train;
1495           model default_flag(event='1') = pd_logistic / nofit;
1496           roc 'Training Set' pred=pd_logistic;
1497           ods output ROCAssociation=work.roc_train;
1498           title "ROC Curve - Training Set";
1499       run;
1500       
1501       /* ROC analysis for validation set */
1502       proc logistic data=work.risk_scores_validation;
1503           model default_flag(event='1') = pd_logistic / nofit;
1504           roc 'Validation Set' pred=pd_logistic;
1505           ods output ROCAssociation=work.roc_valid;
1506           title "ROC Curve - Validation Set";
1507       run;
1508       
1509       /* Display AUC */
1510       proc print data=work.roc_train;
1511           where ROCModel = 'Training Set';
1512           var Area;
1513           title "Training Set AUC";
1514       run;
1515       
1516       proc print data=work.roc_valid;
1517           where ROCModel = 'Validation Set';
1518           var Area;
1519           title "Validation Set AUC";
1520       run;
