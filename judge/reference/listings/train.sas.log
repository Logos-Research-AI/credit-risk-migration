1244       /*****************************************************************************
1245        * 2. Train Logistic Regression Model
1246        *****************************************************************************/
1247       
1248       /* Train logistic regression with stepwise selection */
1249       proc logistic data=work.model_features_train descending;
1250           model default_flag =
1251               /* Core risk metrics */
1252               credit_utilization_capped debt_ratio_capped
1253       
1254               /* Late payment indicators */
1255               num_late_30_59 num_late_60_89 num_late_90_plus
1256               total_late_payments has_delinquency has_serious_delinquency
1257       
1258               /* Financial metrics */
1259               age monthly_income log_monthly_income
1260               num_credit_lines num_real_estate_loans log_num_credit_lines
1261               num_dependents income_per_dependent credit_lines_per_person
1262       
1263               /* Risk flags */
1264               flag_high_utilization flag_very_high_utilization
1265               flag_high_debt_ratio flag_very_high_debt_ratio
1266               flag_recent_late_payments flag_serious_delinquency
1267               flag_multiple_delinquencies flag_low_income
1268               flag_many_dependents flag_few_credit_lines
1269               total_risk_flags
1270       
1271               /* Categorical indicators */
1272               credit_util_category debt_category age_category
1273       
1274               /* Composite scores */
1275               financial_health
1276       
1277               /* Interaction features */
1278               age_income_interaction utilization_debt_interaction
1279       
1280               /* Missing value flags */
1281               MonthlyIncome_missing Dependents_missing
1282       
1283           / selection=stepwise slentry=0.05 slstay=0.05
1284             ctable lackfit rsquare;
1285       
1286           /* Output predictions */
1287           output out=work.logit_scored_train
1288                  predicted=pd_logistic;
1289       
1290           /* Store model for scoring */
1291           store work.logit_model;
1292       
1293           /* Output parameter estimates (coefficients) */
1294           ods output ModelBuildingSummary=work._j_modelbuildingsummary FitStatistics=work._j_fitstatistics
1294     ! GlobalTests=work._j_globaltests RSquare=work._j_rsquare Association=work._j_association OddsRatios=work._j_oddsratios
1294     ! LackFitPartition=work._j_lackfitpartition LackFitChiSq=work._j_lackfitchisq Classification=work._j_classification
1294     ! ParameterEstimates=work.model_coefficients;
1295       
1296           title "Logistic Regression Model - Credit Default Prediction";
1297       run;
1298       
1299       /*****************************************************************************
1300        * 3. Evaluate Model on Training Data
1301        *****************************************************************************/
1302       
1303       /* Add binary prediction variable */
1304       data work.logit_scored_train;
1305           set work.logit_scored_train;
1306           pred_logistic = (pd_logistic >= 0.5);
1307       run;
1308       
1309       /* Confusion matrix on training set */
1310       proc freq data=work.logit_scored_train noprint;
1311           tables default_flag * pred_logistic / out=work.confusion_matrix_train;
1312       run;
1313       
1314       proc print data=work.confusion_matrix_train;
1315           title "Confusion Matrix - Training Set";
1316       run;
1317       
1318       /* Calculate precision, recall, and F1 score for training set */
1319       data work.training_metrics;
1320           set work.confusion_matrix_train end=eof;
1321           retain TP TN FP FN 0;
1322       
1323           if default_flag = 1 and pred_logistic = 1 then TP = count;
1324           else if default_flag = 0 and pred_logistic = 0 then TN = count;
1325           else if default_flag = 0 and pred_logistic = 1 then FP = count;
1326           else if default_flag = 1 and pred_logistic = 0 then FN = count;
1327       
1328           if eof then do;
1329               if (TP + FP) > 0 then train_precision = TP / (TP + FP);
1330               else train_precision = .;
1331               if (TP + FN) > 0 then train_recall = TP / (TP + FN);
1332               else train_recall = .;
1333               if (train_precision + train_recall) > 0 then train_f1_score = 2 * (train_precision * train_recall) /
1333     ! (train_precision + train_recall);
1334               else train_f1_score = .;
1335               if (TP + TN + FP + FN) > 0 then train_accuracy = (TP + TN) / (TP + TN + FP + FN);
1336               else train_accuracy = .;
1337               output;
1338           end;
1339           keep train_precision train_recall train_f1_score train_accuracy;
1340       run;
1341       
1342       proc print data=work.training_metrics;
1343           title "Training Set - Performance Metrics";
1344           format train_precision train_recall train_f1_score train_accuracy 8.4;
1345       run;
1346       
1347       /*****************************************************************************
1348        * 4. Score Validation Set
1349        *****************************************************************************/
1350       
1351       /* Score validation set with trained model */
1352       proc plm restore=work.logit_model;
1353           score data=work.model_features_validation
1354                 out=work.logit_scored_valid_temp
1355                 predicted=predicted_logit;
1356       run;
1357       
1358       /* Convert logit to probability */
1359       data work.logit_scored_valid;
1360           set work.logit_scored_valid_temp;
1361       
1362           /* Apply inverse logit (logistic) function */
1363           pd_logistic = 1 / (1 + exp(-predicted_logit));
1364       
1365           /* Add binary prediction */
1366           pred_logistic = (pd_logistic >= 0.5);
1367       
1368           drop predicted_logit;
1369       run;
1370       
1371       /* Confusion matrix on validation set */
1372       proc freq data=work.logit_scored_valid noprint;
1373           tables default_flag * pred_logistic / out=work.confusion_matrix;
1374       run;
1375       
1376       proc print data=work.confusion_matrix;
1377           title "Confusion Matrix - Validation Set";
1378       run;
1379       
1380       /* Calculate precision, recall, and F1 score for validation set */
1381       data work.validation_metrics;
1382           set work.confusion_matrix end=eof;
1383           retain TP TN FP FN 0;
1384       
1385           if default_flag = 1 and pred_logistic = 1 then TP = count;
1386           else if default_flag = 0 and pred_logistic = 0 then TN = count;
1387           else if default_flag = 0 and pred_logistic = 1 then FP = count;
1388           else if default_flag = 1 and pred_logistic = 0 then FN = count;
1389       
1390           if eof then do;
1391               if (TP + FP) > 0 then valid_precision = TP / (TP + FP);
1392               else valid_precision = .;
1393               if (TP + FN) > 0 then valid_recall = TP / (TP + FN);
1394               else valid_recall = .;
1395               if (valid_precision + valid_recall) > 0 then valid_f1_score = 2 * (valid_precision * valid_recall) /
1395     ! (valid_precision + valid_recall);
1396               else valid_f1_score = .;
1397               if (TP + TN + FP + FN) > 0 then valid_accuracy = (TP + TN) / (TP + TN + FP + FN);
1398               else valid_accuracy = .;
1399               output;
1400           end;
1401           keep valid_precision valid_recall valid_f1_score valid_accuracy;
1402       run;
1403       
1404       proc print data=work.validation_metrics;
1405           title "Validation Set - Performance Metrics";
1406           format valid_precision valid_recall valid_f1_score valid_accuracy 8.4;
1407       run;
1408       
1409       /*****************************************************************************
1410        * 5. Create Risk Scores and Grades
1411        *****************************************************************************/
1412       
1413       /* Generate risk scores for training set */
1414       data work.risk_scores_train;
1415           set work.logit_scored_train;
1416       
1417           /* Convert probability to credit risk score (300-850 scale like FICO) */
1418           base_score = 600;
1419           score_range = 250;
1420           credit_risk_score = round(base_score + score_range * (1 - pd_logistic));
1421       
1422           /* Assign risk grades based on score */
1423           if credit_risk_score >= 750 then risk_grade = 'A';
1424           else if credit_risk_score >= 700 then risk_grade = 'B';
1425           else if credit_risk_score >= 650 then risk_grade = 'C';
1426           else if credit_risk_score >= 600 then risk_grade = 'D';
1427           else if credit_risk_score >= 550 then risk_grade = 'E';
1428           else risk_grade = 'F';
1429       
1430           /* Recommended actions */
1431           if risk_grade in ('A', 'B') then recommendation = 'Approve';
1432           else if risk_grade = 'C' then recommendation = 'Review';
1433           else recommendation = 'Decline';
1434       
1435           /* Suggested interest rate (risk-based pricing) */
1436           base_rate = 0.05;
1437           if risk_grade = 'A' then interest_rate = base_rate;
1438           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
1439           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
1440           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
1441           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
1442           else interest_rate = base_rate + 0.15;
1443       
1444           format interest_rate percent8.2;
1445       run;
1446       
1447       /* Generate risk scores for validation set */
1448       data work.risk_scores_validation;
1449           set work.logit_scored_valid;
1450       
1451           /* Same scoring logic as training */
1452           base_score = 600;
1453           score_range = 250;
1454           credit_risk_score = round(base_score + score_range * (1 - pd_logistic));
1455       
1456           if credit_risk_score >= 750 then risk_grade = 'A';
1457           else if credit_risk_score >= 700 then risk_grade = 'B';
1458           else if credit_risk_score >= 650 then risk_grade = 'C';
1459           else if credit_risk_score >= 600 then risk_grade = 'D';
1460           else if credit_risk_score >= 550 then risk_grade = 'E';
1461           else risk_grade = 'F';
1462       
1463           if risk_grade in ('A', 'B') then recommendation = 'Approve';
1464           else if risk_grade = 'C' then recommendation = 'Review';
1465           else recommendation = 'Decline';
1466       
1467           base_rate = 0.05;
1468           if risk_grade = 'A' then interest_rate = base_rate;
1469           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
1470           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
1471           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
1472           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
1473           else interest_rate = base_rate + 0.15;
1474       
1475           format interest_rate percent8.2;
1476       run;
1477       
1478       /* Risk grade distribution */
1479       proc freq data=work.risk_scores_train;
1480           tables risk_grade * default_flag / nocol nopercent;
1481           title "Default Rate by Risk Grade - Training Set";
1482       run;
1483       
1484       proc freq data=work.risk_scores_validation;
1485           tables risk_grade * default_flag / nocol nopercent;
1486           title "Default Rate by Risk Grade - Validation Set";
1487       run;
