361        data _null_;
362            if &columns_ok ne 1 or &bad_rows ne 0 or &duplicate_ids ne 0 or &known_incomes < 1 then do;
363                put "ERROR: cs-training.csv does not meet the input conditions: "
364                    "columns_ok=&columns_ok bad_rows=&bad_rows duplicate_ids=&duplicate_ids known_incomes=&known_incomes..";
365                put "ERROR: Feature engineering stopped. Nothing is exported.";
366                abort cancel;
367            end;
368        run;
