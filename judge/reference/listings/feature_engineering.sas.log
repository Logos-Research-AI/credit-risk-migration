392        
393        /* Calculate income medians by age group for imputation */
394        proc sql;
395            create table work.income_medians as
396            select
397                case
398                    when age < 30 then 1
399                    when age < 40 then 2
400                    when age < 50 then 3
401                    when age < 60 then 4
402                    else 5
403                end as age_group,
404                median(MonthlyIncome) as median_income
405            from work.credit_raw_clean
406            where MonthlyIncome is not missing
407            group by calculated age_group;
408        quit;
409        
410        /* One row per age group, with the median of all known incomes:
411           the fallback for an age group that has no known income */
412        data work.age_groups;
413            do age_group = 1 to 5;
414                output;
415            end;
416        run;
417        
418        proc sql;
419            create table work.income_medians_all as
420            select
421                g.age_group,
422                m.median_income,
423                (select median(MonthlyIncome) from work.credit_raw_clean
424                 where MonthlyIncome is not missing) as overall_median_income
425            from work.age_groups g
426            left join work.income_medians m
427            on g.age_group = m.age_group
428            order by g.age_group;
429        quit;
430        
431        data work.credit_cleaned;
432            set work.credit_raw_clean;
433        
434            /* Create age group for income imputation */
435            if age < 30 then age_group = 1;
436            else if age < 40 then age_group = 2;
437            else if age < 50 then age_group = 3;
438            else if age < 60 then age_group = 4;
439            else age_group = 5;
440        
441            /* Handle missing values - create flags */
442            if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
443            else MonthlyIncome_missing = 0;
444        
445            if missing(NumberOfDependents) then do;
446                NumberOfDependents = 0;
447                Dependents_missing = 1;
448            end;
449            else Dependents_missing = 0;
450        run;
451        
452        /* Merge and impute income - rename columns in SQL */
453        proc sql;
454            create table work.credit_imputed as
455            select
456                a.VAR1 as row_id,
457                a.SeriousDlqin2yrs as default_flag,
458                a.age,
459                case when a.MonthlyIncome_missing = 1 then coalesce(b.median_income, b.overall_median_income)
460                     else a.MonthlyIncome
461                end as monthly_income,
462                a.MonthlyIncome_missing,
463                a.NumberOfDependents as num_dependents,
464                a.Dependents_missing,
465                a.age_group,
466                a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
467                a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
468                a.NumberOfTimes90DaysLate as num_late_90_plus,
469                a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
470                a.DebtRatio * 100 as debt_ratio,
471                a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
472                a.NumberRealEstateLoansOrLines as num_real_estate_loans
473            from work.credit_cleaned a
474            left join work.income_medians_all b
475            on a.age_group = b.age_group;
476        quit;
477        
478        /*****************************************************************************
479         * 3. Feature Engineering
480         *****************************************************************************/
481        
482        data work.credit_features;
483            set work.credit_imputed;
484        
485            /* Total late payments across all categories */
486            total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
487        
488            /* Has any delinquency indicator */
489            has_delinquency = (total_late_payments > 0);
490        
491            /* Has serious delinquency (90+ days) */
492            has_serious_delinquency = (num_late_90_plus > 0);
493        
494            /* Credit utilization categories */
495            if credit_utilization < 30 then credit_util_category = 1; /* Low */
496            else if credit_utilization < 50 then credit_util_category = 2; /* Medium */
497            else if credit_utilization < 75 then credit_util_category = 3; /* High */
498            else credit_util_category = 4; /* Very High */
499        
500            /* Debt ratio categories */
501            if debt_ratio < 30 then debt_category = 1; /* Low */
502            else if debt_ratio < 43 then debt_category = 2; /* Medium */
503            else if debt_ratio < 60 then debt_category = 3; /* High */
504            else debt_category = 4; /* Very High */
505        
506            /* Income per dependent (handle division by zero) */
507            if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
508            else income_per_dependent = monthly_income;
509        
510            /* Credit lines per person in household */
511            credit_lines_per_person = num_credit_lines / (num_dependents + 1);
512        
513            /* Age categories for risk assessment */
514            if age < 25 then age_category = 1; /* Young */
515            else if age < 35 then age_category = 2; /* Young Adult */
516            else if age < 50 then age_category = 3; /* Middle Age */
517            else if age < 65 then age_category = 4; /* Mature */
518            else age_category = 5; /* Senior */
519        
520            /* Risk flags */
521            flag_high_utilization = (credit_utilization > 75);
522            flag_very_high_utilization = (credit_utilization > 100);
523            flag_high_debt_ratio = (debt_ratio > 43);
524            flag_very_high_debt_ratio = (debt_ratio > 60);
525            flag_recent_late_payments = (num_late_30_59 > 0);
526            flag_serious_delinquency = (num_late_90_plus > 0);
527            flag_multiple_delinquencies = (total_late_payments >= 3);
528            flag_low_income = (monthly_income < 2500);
529            flag_many_dependents = (num_dependents >= 3);
530            flag_few_credit_lines = (num_credit_lines <= 2);
531        
532            /* Total risk flags */
533            total_risk_flags = sum(flag_high_utilization, flag_very_high_utilization,
534                                  flag_high_debt_ratio,
535                                  flag_serious_delinquency, flag_multiple_delinquencies,
536                                  flag_low_income, flag_many_dependents,
537                                  flag_few_credit_lines);
538        
539            /* Financial health score (0-100) */
540            financial_health = 100;
541            if credit_utilization > 30 then financial_health = financial_health - 15;
542            if credit_utilization > 75 then financial_health = financial_health - 15;
543            if debt_ratio > 43 then financial_health = financial_health - 20;
544            if has_delinquency then financial_health = financial_health - 20;
545            if num_late_90_plus > 0 then financial_health = financial_health - 30;
546            financial_health = max(0, financial_health);
547        
548            /* Log transformations for skewed variables (add 1 to handle zeros) */
549            log_monthly_income = log(monthly_income + 1);
550            log_num_credit_lines = log(num_credit_lines + 1);
551            log_total_late_payments = log(total_late_payments + 1);
552        
553            /* Interaction features */
554            if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
555            else age_income_interaction = age * log_monthly_income;
556            utilization_debt_interaction = credit_utilization * debt_ratio;
557        
558            /* Cap extreme outliers in credit_utilization and debt_ratio */
559            credit_utilization_capped = min(credit_utilization, 200);
560            debt_ratio_capped = min(debt_ratio, 500);
561        run;
562        
563        /*****************************************************************************
564         * 4. Split into Training and Validation Sets (70/30)
565         *****************************************************************************/
566        
567        /* Set random seed for reproducibility */
568        proc surveyselect data=work.credit_features
569                          out=work.credit_split
570                          samprate=0.7
571                          seed=42
572                          outall;
573        run;
574        
575        data work.credit_train work.credit_validation;
576            set work.credit_split;
577            if selected = 1 then output work.credit_train;
578            else output work.credit_validation;
579            drop selected;
580        run;
581        
582        /*****************************************************************************
583         * 5. Summary Statistics
584         *****************************************************************************/
585        
586        proc means data=work.credit_train n mean std min max;
587            var age monthly_income credit_utilization debt_ratio total_late_payments
588                num_credit_lines num_real_estate_loans default_flag;
589            title "Training Set Summary Statistics";
590        run;
591        
592        proc freq data=work.credit_train;
593            tables default_flag;
594            title "Training Set - Default Rate";
595        run;
596        
597        proc means data=work.credit_validation n mean std min max;
598            var age monthly_income credit_utilization debt_ratio total_late_payments
599                num_credit_lines num_real_estate_loans default_flag;
600            title "Validation Set Summary Statistics";
601        run;
602        
603        proc freq data=work.credit_validation;
