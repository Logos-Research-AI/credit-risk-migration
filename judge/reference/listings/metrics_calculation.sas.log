3523       /*****************************************************************************
3524        * 2. ROC Curve and AUC Analysis
3525        *****************************************************************************/
3526       
3527       /* ROC analysis for validation set */
3528       proc logistic data=work.logit_scored_valid;
3529           model default_flag(event='1') = pd_logistic / nofit;
3530           roc 'Logistic Model' pred=pd_logistic;
3531           roccontrast;
3532           ods output ROCAssociation=work.roc_stats;
3533           title "ROC Curve Analysis - Validation Set";
3534       run;
3535       
3536       /* Extract and display AUC */
3537       data work.auc_summary;
3538           set work.roc_stats;
3539           where ROCModel = 'Logistic Model';
3540           AUC = Area;
3541           Gini = 2 * Area - 1;
3542           keep ROCModel AUC Gini;
3543           format AUC Gini 8.4;
3544       run;
3545       
3546       proc print data=work.auc_summary noobs;
3547           title "Model Performance Metrics - AUC and Gini";
3548       run;
3549       
3550       /*****************************************************************************
3551        * 3. Kolmogorov-Smirnov (KS) Statistic
3552        *****************************************************************************/
3553       
3554       /* Sort by predicted probability */
3555       proc sort data=work.logit_scored_valid;
3556           by pd_logistic;
3557       run;
3558       
3559       /* Calculate total good and bad counts */
3560       proc sql noprint;
3561           select sum(default_flag = 0), sum(default_flag = 1)
3562           into :total_good_count, :total_bad_count
3563           from work.logit_scored_valid;
3564       quit;
3565       
3566       /* Calculate cumulative distributions */
3567       data work.ks_calculation;
3568           set work.logit_scored_valid;
3569           by pd_logistic;
3570           retain cum_good cum_bad;
3571       
3572           if _n_ = 1 then do;
3573               cum_good = 0;
3574               cum_bad = 0;
3575           end;
3576       
3577           if default_flag = 0 then cum_good + 1;
3578           else cum_bad + 1;
3579       
3580           cum_pct_good = cum_good / &total_good_count;
3581           cum_pct_bad = cum_bad / &total_bad_count;
3582           /* Compare the two distributions only after the last applicant of each probability */
3583           if last.pd_logistic then ks_value = abs(cum_pct_good - cum_pct_bad);
3584       run;
3585       
3586       /* Find maximum KS (one row: the lowest cutoff when several attain the maximum) */
3587       proc sql;
3588           create table work.ks_statistic as
3589           select max(ks_value) as KS_Statistic format=8.4,
3590                  min(pd_logistic) as KS_Cutoff format=8.4
3591           from work.ks_calculation
3592           where ks_value = (select max(ks_value) from work.ks_calculation);
3593       quit;
3594       
3595       proc print data=work.ks_statistic noobs;
3596           title "Kolmogorov-Smirnov Statistic";
3597       run;
3598       
3599       /*****************************************************************************
3600        * 4. Confusion Matrix and Accuracy Metrics
3601        *****************************************************************************/
3602       
3603       /* Calculate metrics at different thresholds */
3604       %macro confusion_metrics(threshold, suffix);
3605           data work.confusion_&suffix;
3606               set work.logit_scored_valid;
3607               predicted = (pd_logistic >= &threshold);
3608           run;
3609       
3610           proc freq data=work.confusion_&suffix noprint;
3611               tables default_flag * predicted / out=work.conf_matrix_&suffix;
3612           run;
3613       
3614           /* Calculate metrics */
3615           data work.metrics_&suffix;
3616               set work.conf_matrix_&suffix end=eof;
3617               retain TP TN FP FN 0;
3618       
3619               if default_flag = 1 and predicted = 1 then TP = count;
3620               else if default_flag = 0 and predicted = 0 then TN = count;
3621               else if default_flag = 0 and predicted = 1 then FP = count;
3622               else if default_flag = 1 and predicted = 0 then FN = count;
3623       
3624               if eof then do;
3625                   threshold = &threshold;
3626                   if (TP + TN + FP + FN) > 0 then accuracy = (TP + TN) / (TP + TN + FP + FN);
3627                   else accuracy = .;
3628                   if (TP + FP) > 0 then precision = TP / (TP + FP);
3629                   else precision = .;
3630                   if (TP + FN) > 0 then recall = TP / (TP + FN);
3631                   else recall = .;
3632                   if (precision + recall) > 0 then f1_score = 2 * (precision * recall) / (precision + recall);
3633                   else f1_score = .;
3634                   if (TN + FP) > 0 then specificity = TN / (TN + FP);
3635                   else specificity = .;
3636                   output;
3637               end;
3638               keep threshold accuracy precision recall f1_score specificity;
3639           run;
3640       %mend;
3641       
3642       /* Test multiple thresholds */
3643       %confusion_metrics(0.3, 03);
3644       %confusion_metrics(0.4, 04);
3645       %confusion_metrics(0.5, 05);
3646       %confusion_metrics(0.6, 06);
3647       %confusion_metrics(0.7, 07);
3648       
3649       /* Combine results */
3650       data work.threshold_analysis;
3651           set work.metrics_03 work.metrics_04 work.metrics_05
3652               work.metrics_06 work.metrics_07;
3653       run;
3654       
3655       proc print data=work.threshold_analysis;
3656           title "Performance Metrics at Different Thresholds";
3657           format accuracy precision recall f1_score specificity 8.4;
3658       run;
3659       
3660       /*****************************************************************************
3661        * 5. Decile Analysis and Lift Chart
3662        *****************************************************************************/
3663       
3664       /* Create deciles based on predicted probability */
3665       proc rank data=work.logit_scored_valid
3666                 out=work.decile_data
3667                 groups=10 descending;
3668           var pd_logistic;
3669           ranks decile;
3670       run;
3671       
3672       /* Calculate lift by decile */
3673       proc sql;
3674           create table work.decile_analysis as
3675           select
3676               decile + 1 as decile,
3677               count(*) as total_count,
3678               sum(default_flag) as defaults,
3679               mean(default_flag) as default_rate format=percent8.2,
3680               mean(pd_logistic) as avg_pd format=8.4,
3681               min(pd_logistic) as min_pd format=8.4,
3682               max(pd_logistic) as max_pd format=8.4,
3683               sum(default_flag) / (select sum(default_flag) from work.decile_data) as capture_rate format=percent8.2,
3684               (calculated default_rate) / (select mean(default_flag) from work.decile_data) as lift format=8.2
3685           from work.decile_data
3686           group by decile
3687           order by decile;
3688       quit;
3689       
3690       proc print data=work.decile_analysis;
3691           title "Decile Analysis - Model Lift and Capture Rate";
3692       run;
3693       
3694       /* Calculate totals for cumulative lift chart */
3695       proc sql noprint;
3696           select sum(default_flag), mean(default_flag)
3697           into :total_defaults, :overall_default_rate
3698           from work.decile_data;
3699       quit;
3700       
3701       /* Create cumulative lift chart */
3702       data work.cumulative_lift;
3703           set work.decile_analysis;
3704           retain cum_defaults cum_count;
3705           if _n_ = 1 then do;
3706               cum_defaults = defaults;
3707               cum_count = total_count;
3708           end;
3709           else do;
3710               cum_defaults + defaults;
3711               cum_count + total_count;
3712           end;
3713       
3714           cum_capture_rate = cum_defaults / &total_defaults;
3715           cum_lift = (cum_defaults / cum_count) / &overall_default_rate;
3716           format cum_capture_rate percent8.2 cum_lift 8.2;
3717       run;
3718       
3719       proc sgplot data=work.cumulative_lift;
3720           series x=decile y=cum_lift;
3721           refline 1 / axis=y;
3722           xaxis label="Decile";
3723           yaxis label="Cumulative Lift";
3724           title "Cumulative Lift Chart";
3725       run;
3726       
3727       /*****************************************************************************
3728        * 6. Population Stability Index (PSI)
3729        *****************************************************************************/
3730       
3731       /* Compare score distributions between training and validation */
3732       
3733       /* Ten bins cut from the training scores: the nine cuts are the nearest-rank
3734          deciles of the training scores (no interpolation) */
3735       proc sort data=work.logit_scored_train(keep=credit_risk_score)
3736                 out=work.train_scores_sorted;
3737           by credit_risk_score;
3738       run;
3739       
3740       data work.psi_cuts;
3741           set work.train_scores_sorted nobs=n_train end=eof;
3742           array cut{9};
3743           retain cut1-cut9;
3744           do k = 1 to 9;
3745               if _n_ = ceil(k * n_train / 10) then cut{k} = credit_risk_score;
3746           end;
3747           if eof then output;
3748           keep cut1-cut9;
3749       run;
3750       
3751       /* Place both sets in the same bins; a score equal to a cut belongs to the lower bin */
3752       data work.train_bins;
3753           if _n_ = 1 then set work.psi_cuts;
3754           set work.logit_scored_train;
3755           array cut{9};
3756           score_bin = 0;
3757           do k = 1 to 9;
3758               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
3759           end;
3760           drop k cut1-cut9;
3761       run;
3762       
3763       data work.valid_bins;
3764           if _n_ = 1 then set work.psi_cuts;
3765           set work.logit_scored_valid;
3766           array cut{9};
3767           score_bin = 0;
3768           do k = 1 to 9;
3769               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
3770           end;
3771           drop k cut1-cut9;
3772       run;
3773       
3774       data work.psi_bins;
3775           do score_bin = 0 to 9;
3776               output;
3777           end;
3778       run;
3779       
3780       /* An empty bin is given a share below that of one applicant, the same on both
3781          sides, so that a bin filled on one side only adds a positive amount */
3782       proc sql noprint;
3783           select 0.5 / max(t.n, v.n) into :psi_floor trimmed
3784           from (select count(*) as n from work.train_bins) t,
3785                (select count(*) as n from work.valid_bins) v;
3786       quit;
3787       
3788       /* Calculate PSI */
3789       proc sql;
3790           create table work.psi_calculation as
3791           select
3792               s.score_bin,
3793               coalesce(a.train_pct, 0) as train_pct,
3794               coalesce(b.valid_pct, 0) as valid_pct,
3795               (max(calculated train_pct, &psi_floor) - max(calculated valid_pct, &psi_floor))
3796                   * log(max(calculated train_pct, &psi_floor) / max(calculated valid_pct, &psi_floor)) as psi_component
3797           from work.psi_bins s
3798           left join
3799               (select score_bin, count(*) / (select count(*) from work.train_bins) as train_pct
3800                from work.train_bins group by score_bin) a
3801           on s.score_bin = a.score_bin
3802           left join
3803               (select score_bin, count(*) / (select count(*) from work.valid_bins) as valid_pct
3804                from work.valid_bins group by score_bin) b
3805           on s.score_bin = b.score_bin
3806           order by s.score_bin;
3807       
3808           create table work.psi_summary as
3809           select sum(psi_component) as PSI format=best12.,
3810                  case
3811                     when calculated PSI < 0.1 then 'No significant change'
3812                     when calculated PSI < 0.25 then 'Some change'
3813                     else 'Significant change'
3814                  end as PSI_interpretation
3815           from work.psi_calculation;
3816       quit;
3817       
3818       proc print data=work.psi_summary noobs;
3819           title "Population Stability Index";
3820       run;
3821       
3822       /*****************************************************************************
3823        * 7. Calibration Plot
3824        *****************************************************************************/
3825       
3826       /* Bin predictions and compare to actual */
3827       proc rank data=work.logit_scored_valid
3828                 out=work.calibration_data
3829                 groups=20;
3830           var pd_logistic;
3831           ranks pred_bin;
3832       run;
3833       
3834       proc sql;
3835           create table work.calibration_plot as
3836           select
3837               pred_bin,
3838               mean(pd_logistic) as mean_predicted format=8.4,
3839               mean(default_flag) as mean_actual format=8.4,
3840               count(*) as bin_count
3841           from work.calibration_data
3842           group by pred_bin
3843           order by pred_bin;
3844       quit;
3845       
3846       proc sgplot data=work.calibration_plot;
3847           scatter x=mean_predicted y=mean_actual / markerattrs=(size=10);
3848           lineparm x=0 y=0 slope=1 / lineattrs=(pattern=dash);
3849           xaxis label="Mean Predicted Probability";
3850           yaxis label="Mean Actual Default Rate";
3851           title "Calibration Plot - Predicted vs Actual";
3852       run;
