3523       /*****************************************************************************
3524        * 2. ROC Curve and AUC Analysis
3525        *****************************************************************************/
3526       
3527       /* ROC analysis for validation set */
3528       proc logistic data=work.logit_scored_valid;
3529           model default_flag(event='1') = pd_logistic / nofit;
3530           roc 'Logistic Model' pred=pd_logistic;
3531           roccontrast;
3532           ods output ROCAssociation=work.roc_stats;
3533           title "ROC Curve Analysis - Validation Set";
3534       run;
3535       
3536       /* Calculate and display AUC: the exact pairwise AUC of the validation probabilities.
3537          A defaulter/non-defaulter pair is concordant when the defaulter's probability is
3538          higher, and tied only when the two probabilities are equal */
3539       proc sql;
3540           create table work.auc_pairs as
3541           select pd_logistic,
3542                  sum(default_flag = 1) as n_bad,
3543                  sum(default_flag = 0) as n_good
3544           from work.logit_scored_valid
3545           where not missing(pd_logistic)
3546           group by pd_logistic
3547           order by pd_logistic;
3548       quit;
3549       
3550       data work.auc_summary;
3551           length ROCModel $14;
3552           set work.auc_pairs end=eof;
3553           retain concordant tied cum_good cum_bad 0;
3554       
3555           concordant + n_bad * cum_good;
3556           tied + n_bad * n_good;
3557           cum_good + n_good;
3558           cum_bad + n_bad;
3559       
3560           if eof then do;
3561               ROCModel = 'Logistic Model';
3562               if cum_bad * cum_good > 0 then do;
3563                   AUC = (concordant + tied / 2) / (cum_bad * cum_good);
3564                   Gini = 2 * AUC - 1;
3565               end;
3566               output;
3567           end;
3568           keep ROCModel AUC Gini;
3569           format AUC Gini 8.4;
3570       run;
3571       
3572       proc print data=work.auc_summary noobs;
3573           title "Model Performance Metrics - AUC and Gini";
3574       run;
3575       
3576       /*****************************************************************************
3577        * 3. Kolmogorov-Smirnov (KS) Statistic
3578        *****************************************************************************/
3579       
3580       /* Sort by predicted probability */
3581       proc sort data=work.logit_scored_valid;
3582           by pd_logistic;
3583       run;
3584       
3585       /* Calculate total good and bad counts */
3586       proc sql noprint;
3587           select sum(default_flag = 0), sum(default_flag = 1)
3588           into :total_good_count, :total_bad_count
3589           from work.logit_scored_valid;
3590       quit;
3591       
3592       /* Calculate cumulative distributions */
3593       data work.ks_calculation;
3594           set work.logit_scored_valid;
3595           by pd_logistic;
3596           retain cum_good cum_bad;
3597       
3598           if _n_ = 1 then do;
3599               cum_good = 0;
3600               cum_bad = 0;
3601           end;
3602       
3603           if default_flag = 0 then cum_good + 1;
3604           else cum_bad + 1;
3605       
3606           cum_pct_good = cum_good / &total_good_count;
3607           cum_pct_bad = cum_bad / &total_bad_count;
3608           /* Compare the two distributions only after the last applicant of each probability */
3609           if last.pd_logistic then ks_value = abs(cum_pct_good - cum_pct_bad);
3610       run;
3611       
3612       /* Find maximum KS (one row: the lowest cutoff when several attain the maximum) */
3613       proc sql;
3614           create table work.ks_statistic as
3615           select max(ks_value) as KS_Statistic format=8.4,
3616                  min(pd_logistic) as KS_Cutoff format=8.4
3617           from work.ks_calculation
3618           where ks_value = (select max(ks_value) from work.ks_calculation);
3619       quit;
3620       
3621       proc print data=work.ks_statistic noobs;
3622           title "Kolmogorov-Smirnov Statistic";
3623       run;
3624       
3625       /*****************************************************************************
3626        * 4. Confusion Matrix and Accuracy Metrics
3627        *****************************************************************************/
3628       
3629       /* Calculate metrics at different thresholds */
3630       %macro confusion_metrics(threshold, suffix);
3631           data work.confusion_&suffix;
3632               set work.logit_scored_valid;
3633               predicted = (pd_logistic >= &threshold);
3634           run;
3635       
3636           proc freq data=work.confusion_&suffix noprint;
3637               tables default_flag * predicted / out=work.conf_matrix_&suffix;
3638           run;
3639       
3640           /* Calculate metrics */
3641           data work.metrics_&suffix;
3642               set work.conf_matrix_&suffix end=eof;
3643               retain TP TN FP FN 0;
3644       
3645               if default_flag = 1 and predicted = 1 then TP = count;
3646               else if default_flag = 0 and predicted = 0 then TN = count;
3647               else if default_flag = 0 and predicted = 1 then FP = count;
3648               else if default_flag = 1 and predicted = 0 then FN = count;
3649       
3650               if eof then do;
3651                   threshold = &threshold;
3652                   if (TP + TN + FP + FN) > 0 then accuracy = (TP + TN) / (TP + TN + FP + FN);
3653                   else accuracy = .;
3654                   if (TP + FP) > 0 then precision = TP / (TP + FP);
3655                   else precision = .;
3656                   if (TP + FN) > 0 then recall = TP / (TP + FN);
3657                   else recall = .;
3658                   if (precision + recall) > 0 then f1_score = 2 * (precision * recall) / (precision + recall);
3659                   else f1_score = .;
3660                   if (TN + FP) > 0 then specificity = TN / (TN + FP);
3661                   else specificity = .;
3662                   output;
3663               end;
3664               keep threshold accuracy precision recall f1_score specificity;
3665           run;
3666       %mend;
3667       
3668       /* Test multiple thresholds */
3669       %confusion_metrics(0.3, 03);
3670       %confusion_metrics(0.4, 04);
3671       %confusion_metrics(0.5, 05);
3672       %confusion_metrics(0.6, 06);
3673       %confusion_metrics(0.7, 07);
3674       
3675       /* Combine results */
3676       data work.threshold_analysis;
3677           set work.metrics_03 work.metrics_04 work.metrics_05
3678               work.metrics_06 work.metrics_07;
3679       run;
3680       
3681       proc print data=work.threshold_analysis;
3682           title "Performance Metrics at Different Thresholds";
3683           format accuracy precision recall f1_score specificity 8.4;
3684       run;
3685       
3686       /*****************************************************************************
3687        * 5. Decile Analysis and Lift Chart
3688        *****************************************************************************/
3689       
3690       /* Create deciles based on predicted probability */
3691       proc rank data=work.logit_scored_valid
3692                 out=work.decile_data
3693                 groups=10 descending;
3694           var pd_logistic;
3695           ranks decile;
3696       run;
3697       
3698       /* Always ten rows, deciles 1 to 10 */
3699       data work.decile_list;
3700           do decile = 1 to 10;
3701               output;
3702           end;
3703       run;
3704       
3705       /* Calculate lift by decile; a decile that receives no applicant has
3706          count 0, capture rate 0 and lift 0; with no defaulter in the validation set
3707          capture rate and lift are 0 on every decile */
3708       proc sql;
3709           create table work.decile_analysis as
3710           select
3711               l.decile,
3712               coalesce(d.total_count, 0) as total_count,
3713               coalesce(d.defaults, 0) as defaults,
3714               d.default_rate format=percent8.2,
3715               d.avg_pd format=8.4,
3716               d.min_pd format=8.4,
3717               d.max_pd format=8.4,
3718               coalesce(d.capture_rate, 0) as capture_rate format=percent8.2,
3719               coalesce(d.lift, 0) as lift format=8.2
3720           from work.decile_list l
3721           left join
3722               (select
3723                   decile + 1 as decile,
3724                   count(*) as total_count,
3725                   sum(default_flag) as defaults,
3726                   mean(default_flag) as default_rate,
3727                   mean(pd_logistic) as avg_pd,
3728                   min(pd_logistic) as min_pd,
3729                   max(pd_logistic) as max_pd,
3730                   sum(default_flag) / (select sum(default_flag) from work.decile_data) as capture_rate,
3731                   (calculated default_rate) / (select mean(default_flag) from work.decile_data) as lift
3732                from work.decile_data
3733                group by decile) d
3734           on l.decile = d.decile
3735           order by l.decile;
3736       quit;
3737       
3738       proc print data=work.decile_analysis;
3739           title "Decile Analysis - Model Lift and Capture Rate";
3740       run;
3741       
3742       /* Calculate totals for cumulative lift chart */
3743       proc sql noprint;
3744           select sum(default_flag), mean(default_flag)
3745           into :total_defaults, :overall_default_rate
3746           from work.decile_data;
3747       quit;
3748       
3749       /* Create cumulative lift chart */
3750       data work.cumulative_lift;
3751           set work.decile_analysis;
3752           retain cum_defaults cum_count;
3753           if _n_ = 1 then do;
3754               cum_defaults = defaults;
3755               cum_count = total_count;
3756           end;
3757           else do;
3758               cum_defaults + defaults;
3759               cum_count + total_count;
3760           end;
3761       
3762           /* With no defaulter in the validation set both are 0, as in the decile table */
3763           if &total_defaults > 0 then cum_capture_rate = cum_defaults / &total_defaults;
3764           else cum_capture_rate = 0;
3765           /* No cumulative lift while the deciles so far are empty */
3766           if cum_count > 0 then do;
3767               if &overall_default_rate > 0 then cum_lift = (cum_defaults / cum_count) / &overall_default_rate;
3768               else cum_lift = 0;
3769           end;
3770           format cum_capture_rate percent8.2 cum_lift 8.2;
3771       run;
3772       
3773       proc sgplot data=work.cumulative_lift;
3774           series x=decile y=cum_lift;
3775           refline 1 / axis=y;
3776           xaxis label="Decile";
3777           yaxis label="Cumulative Lift";
3778           title "Cumulative Lift Chart";
3779       run;
3780       
3781       /*****************************************************************************
3782        * 6. Population Stability Index (PSI)
3783        *****************************************************************************/
3784       
3785       /* Compare score distributions between training and validation */
3786       
3787       /* Ten bins cut from the training scores: the nine cuts are the nearest-rank
3788          deciles of the training scores (no interpolation) */
3789       proc sort data=work.logit_scored_train(keep=credit_risk_score)
3790                 out=work.train_scores_sorted;
3791           by credit_risk_score;
3792       run;
3793       
3794       data work.psi_cuts;
3795           set work.train_scores_sorted nobs=n_train end=eof;
3796           array cut{9};
3797           retain cut1-cut9;
3798           do k = 1 to 9;
3799               if _n_ = ceil(k * n_train / 10) then cut{k} = credit_risk_score;
3800           end;
3801           if eof then output;
3802           keep cut1-cut9;
3803       run;
3804       
3805       /* Place both sets in the same bins; a score equal to a cut belongs to the lower bin */
3806       data work.train_bins;
3807           if _n_ = 1 then set work.psi_cuts;
3808           set work.logit_scored_train;
3809           array cut{9};
3810           score_bin = 0;
3811           do k = 1 to 9;
3812               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
3813           end;
3814           drop k cut1-cut9;
3815       run;
3816       
3817       data work.valid_bins;
3818           if _n_ = 1 then set work.psi_cuts;
3819           set work.logit_scored_valid;
3820           array cut{9};
3821           score_bin = 0;
3822           do k = 1 to 9;
3823               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
3824           end;
3825           drop k cut1-cut9;
3826       run;
3827       
3828       data work.psi_bins;
3829           do score_bin = 0 to 9;
3830               output;
3831           end;
3832       run;
3833       
3834       /* An empty bin is given a share below that of one applicant, the same on both
3835          sides, so that a bin filled on one side only adds a positive amount */
3836       /* The size of the larger set is carried as a whole number and the share is computed
3837          where it is used, so it is not cut to the 8 characters of a macro variable */
3838       proc sql noprint;
3839           select max(t.n, v.n) format=32. into :psi_rows trimmed
3840           from (select count(*) as n from work.train_bins) t,
3841                (select count(*) as n from work.valid_bins) v;
3842       quit;
3843       %let psi_floor = (0.5 / &psi_rows);
3844       
3845       /* Calculate PSI */
3846       proc sql;
3847           create table work.psi_calculation as
3848           select
3849               s.score_bin,
3850               coalesce(a.train_pct, 0) as train_pct,
3851               coalesce(b.valid_pct, 0) as valid_pct,
3852               (max(calculated train_pct, &psi_floor) - max(calculated valid_pct, &psi_floor))
3853                   * log(max(calculated train_pct, &psi_floor) / max(calculated valid_pct, &psi_floor)) as psi_component
3854           from work.psi_bins s
3855           left join
3856               (select score_bin, count(*) / (select count(*) from work.train_bins) as train_pct
3857                from work.train_bins group by score_bin) a
3858           on s.score_bin = a.score_bin
3859           left join
3860               (select score_bin, count(*) / (select count(*) from work.valid_bins) as valid_pct
3861                from work.valid_bins group by score_bin) b
3862           on s.score_bin = b.score_bin
3863           order by s.score_bin;
3864       
3865           create table work.psi_summary as
3866           select sum(psi_component) as PSI format=best12.,
3867                  case
3868                     when calculated PSI < 0.1 then 'No significant change'
3869                     when calculated PSI < 0.25 then 'Some change'
3870                     else 'Significant change'
3871                  end as PSI_interpretation
3872           from work.psi_calculation;
3873       quit;
3874       
3875       proc print data=work.psi_summary noobs;
3876           title "Population Stability Index";
3877       run;
3878       
3879       /*****************************************************************************
3880        * 7. Calibration Plot
3881        *****************************************************************************/
3882       
3883       /* Bin predictions and compare to actual */
3884       proc rank data=work.logit_scored_valid
3885                 out=work.calibration_data
3886                 groups=20;
3887           var pd_logistic;
3888           ranks pred_bin;
3889       run;
3890       
3891       proc sql;
3892           create table work.calibration_plot as
3893           select
3894               pred_bin,
3895               mean(pd_logistic) as mean_predicted format=8.4,
3896               mean(default_flag) as mean_actual format=8.4,
3897               count(*) as bin_count
3898           from work.calibration_data
3899           group by pred_bin
3900           order by pred_bin;
3901       quit;
3902       
3903       proc sgplot data=work.calibration_plot;
3904           scatter x=mean_predicted y=mean_actual / markerattrs=(size=10);
3905           lineparm x=0 y=0 slope=1 / lineattrs=(pattern=dash);
3906           xaxis label="Mean Predicted Probability";
3907           yaxis label="Mean Actual Default Rate";
3908           title "Calibration Plot - Predicted vs Actual";
3909       run;
3910       
3911       /*****************************************************************************
3912        * 8. Generate Validation Report
3913        *****************************************************************************/
3914       
3915       /* Compile validation metrics */
3916       data work.validation_summary;
3917           merge work.auc_summary
3918                 work.ks_statistic
3919                 work.psi_summary;
3920           length model $20 status $20;
3921           model = "Logistic Regression";
3922       
3923           /* Determine model status based on metrics */
3924           if AUC >= 0.7 and KS_Statistic >= 0.3 and PSI < 0.25 then
3925               status = "Production Ready";
3926           else if AUC >= 0.65 then
3927               status = "Requires Review";
3928           else
3929               status = "Needs Improvement";
3930       run;
3931       
3932       proc print data=work.validation_summary noobs;
3933           title "Model Validation Summary";
3934       run;
