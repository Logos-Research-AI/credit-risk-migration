3525       /*****************************************************************************
3526        * 2. ROC Curve and AUC Analysis
3527        *****************************************************************************/
3528       
3529       /* ROC analysis for validation set */
3530       proc logistic data=work.logit_scored_valid;
3531           model default_flag(event='1') = pd_logistic / nofit;
3532           roc 'Logistic Model' pred=pd_logistic;
3533           roccontrast;
3534           ods output ROCAssociation=work.roc_stats;
3535           title "ROC Curve Analysis - Validation Set";
3536       run;
3537       
3538       /* Calculate and display AUC: the exact pairwise AUC of the validation probabilities.
3539          A defaulter/non-defaulter pair is concordant when the defaulter's probability is
3540          higher, and tied only when the two probabilities are equal */
3541       proc sql;
3542           create table work.auc_pairs as
3543           select pd_logistic,
3544                  sum(default_flag = 1) as n_bad,
3545                  sum(default_flag = 0) as n_good
3546           from work.logit_scored_valid
3547           where not missing(pd_logistic)
3548           group by pd_logistic
3549           order by pd_logistic;
3550       quit;
3551       
3552       data work.auc_summary;
3553           length ROCModel $14;
3554           set work.auc_pairs end=eof;
3555           retain concordant tied cum_good cum_bad 0;
3556       
3557           concordant + n_bad * cum_good;
3558           tied + n_bad * n_good;
3559           cum_good + n_good;
3560           cum_bad + n_bad;
3561       
3562           if eof then do;
3563               ROCModel = 'Logistic Model';
3564               if cum_bad * cum_good > 0 then do;
3565                   AUC = (concordant + tied / 2) / (cum_bad * cum_good);
3566                   Gini = 2 * AUC - 1;
3567               end;
3568               output;
3569           end;
3570           keep ROCModel AUC Gini;
3571           format AUC Gini 8.4;
3572       run;
3573       
3574       proc print data=work.auc_summary noobs;
3575           title "Model Performance Metrics - AUC and Gini";
3576       run;
3577       
3578       /*****************************************************************************
3579        * 3. Kolmogorov-Smirnov (KS) Statistic
3580        *****************************************************************************/
3581       
3582       /* Sort by predicted probability */
3583       proc sort data=work.logit_scored_valid;
3584           by pd_logistic;
3585       run;
3586       
3587       /* Calculate total good and bad counts */
3588       proc sql noprint;
3589           select sum(default_flag = 0), sum(default_flag = 1)
3590           into :total_good_count, :total_bad_count
3591           from work.logit_scored_valid;
3592       quit;
3593       
3594       /* Calculate cumulative distributions */
3595       data work.ks_calculation;
3596           set work.logit_scored_valid;
3597           by pd_logistic;
3598           retain cum_good cum_bad;
3599       
3600           if _n_ = 1 then do;
3601               cum_good = 0;
3602               cum_bad = 0;
3603           end;
3604       
3605           if default_flag = 0 then cum_good + 1;
3606           else cum_bad + 1;
3607       
3608           cum_pct_good = cum_good / &total_good_count;
3609           cum_pct_bad = cum_bad / &total_bad_count;
3610           /* Compare the two distributions only after the last applicant of each probability */
3611           if last.pd_logistic then ks_value = abs(cum_pct_good - cum_pct_bad);
3612       run;
3613       
3614       /* Find maximum KS (one row: the lowest cutoff when several attain the maximum) */
3615       proc sql;
3616           create table work.ks_statistic as
3617           select max(ks_value) as KS_Statistic format=8.4,
3618                  min(pd_logistic) as KS_Cutoff format=8.4
3619           from work.ks_calculation
3620           where ks_value = (select max(ks_value) from work.ks_calculation);
3621       quit;
3622       
3623       proc print data=work.ks_statistic noobs;
3624           title "Kolmogorov-Smirnov Statistic";
3625       run;
3626       
3627       /*****************************************************************************
3628        * 4. Confusion Matrix and Accuracy Metrics
3629        *****************************************************************************/
3630       
3631       /* Calculate metrics at different thresholds */
3632       %macro confusion_metrics(threshold, suffix);
3633           data work.confusion_&suffix;
3634               set work.logit_scored_valid;
3635               predicted = (pd_logistic >= &threshold);
3636           run;
3637       
3638           proc freq data=work.confusion_&suffix noprint;
3639               tables default_flag * predicted / out=work.conf_matrix_&suffix;
3640           run;
3641       
3642           /* Calculate metrics */
3643           data work.metrics_&suffix;
3644               set work.conf_matrix_&suffix end=eof;
3645               retain TP TN FP FN 0;
3646       
3647               if default_flag = 1 and predicted = 1 then TP = count;
3648               else if default_flag = 0 and predicted = 0 then TN = count;
3649               else if default_flag = 0 and predicted = 1 then FP = count;
3650               else if default_flag = 1 and predicted = 0 then FN = count;
3651       
3652               if eof then do;
3653                   threshold = &threshold;
3654                   if (TP + TN + FP + FN) > 0 then accuracy = (TP + TN) / (TP + TN + FP + FN);
3655                   else accuracy = .;
3656                   if (TP + FP) > 0 then precision = TP / (TP + FP);
3657                   else precision = .;
3658                   if (TP + FN) > 0 then recall = TP / (TP + FN);
3659                   else recall = .;
3660                   if (precision + recall) > 0 then f1_score = 2 * (precision * recall) / (precision + recall);
3661                   else f1_score = .;
3662                   if (TN + FP) > 0 then specificity = TN / (TN + FP);
3663                   else specificity = .;
3664                   output;
3665               end;
3666               keep threshold accuracy precision recall f1_score specificity;
3667           run;
3668       %mend;
3669       
3670       /* Test multiple thresholds */
3671       %confusion_metrics(0.3, 03);
3672       %confusion_metrics(0.4, 04);
3673       %confusion_metrics(0.5, 05);
3674       %confusion_metrics(0.6, 06);
3675       %confusion_metrics(0.7, 07);
3676       
3677       /* Combine results */
3678       data work.threshold_analysis;
3679           set work.metrics_03 work.metrics_04 work.metrics_05
3680               work.metrics_06 work.metrics_07;
3681       run;
3682       
3683       proc print data=work.threshold_analysis;
3684           title "Performance Metrics at Different Thresholds";
3685           format accuracy precision recall f1_score specificity 8.4;
3686       run;
3687       
3688       /*****************************************************************************
3689        * 5. Decile Analysis and Lift Chart
3690        *****************************************************************************/
3691       
3692       /* Create deciles based on predicted probability */
3693       proc rank data=work.logit_scored_valid
3694                 out=work.decile_data
3695                 groups=10 descending;
3696           var pd_logistic;
3697           ranks decile;
3698       run;
3699       
3700       /* Always ten rows, deciles 1 to 10 */
3701       data work.decile_list;
3702           do decile = 1 to 10;
3703               output;
3704           end;
3705       run;
3706       
3707       /* Calculate lift by decile; a decile that receives no applicant has
3708          count 0, capture rate 0 and lift 0; with no defaulter in the validation set
3709          capture rate and lift are 0 on every decile */
3710       proc sql;
3711           create table work.decile_analysis as
3712           select
3713               l.decile,
3714               coalesce(d.total_count, 0) as total_count,
3715               coalesce(d.defaults, 0) as defaults,
3716               d.default_rate format=percent8.2,
3717               d.avg_pd format=8.4,
3718               d.min_pd format=8.4,
3719               d.max_pd format=8.4,
3720               coalesce(d.capture_rate, 0) as capture_rate format=percent8.2,
3721               coalesce(d.lift, 0) as lift format=8.2
3722           from work.decile_list l
3723           left join
3724               (select
3725                   decile + 1 as decile,
3726                   count(*) as total_count,
3727                   sum(default_flag) as defaults,
3728                   mean(default_flag) as default_rate,
3729                   mean(pd_logistic) as avg_pd,
3730                   min(pd_logistic) as min_pd,
3731                   max(pd_logistic) as max_pd,
3732                   sum(default_flag) / (select sum(default_flag) from work.decile_data) as capture_rate,
3733                   (calculated default_rate) / (select mean(default_flag) from work.decile_data) as lift
3734                from work.decile_data
3735                group by decile) d
3736           on l.decile = d.decile
3737           order by l.decile;
3738       quit;
3739       
3740       proc print data=work.decile_analysis;
3741           title "Decile Analysis - Model Lift and Capture Rate";
3742       run;
3743       
3744       /* Calculate totals for cumulative lift chart */
3745       proc sql noprint;
3746           select sum(default_flag), mean(default_flag)
3747           into :total_defaults, :overall_default_rate
3748           from work.decile_data;
3749       quit;
3750       
3751       /* Create cumulative lift chart */
3752       data work.cumulative_lift;
3753           set work.decile_analysis;
3754           retain cum_defaults cum_count;
3755           if _n_ = 1 then do;
3756               cum_defaults = defaults;
3757               cum_count = total_count;
3758           end;
3759           else do;
3760               cum_defaults + defaults;
3761               cum_count + total_count;
3762           end;
3763       
3764           /* With no defaulter in the validation set both are 0, as in the decile table */
3765           if &total_defaults > 0 then cum_capture_rate = cum_defaults / &total_defaults;
3766           else cum_capture_rate = 0;
3767           /* No cumulative lift while the deciles so far are empty */
3768           if cum_count > 0 then do;
3769               if &overall_default_rate > 0 then cum_lift = (cum_defaults / cum_count) / &overall_default_rate;
3770               else cum_lift = 0;
3771           end;
3772           format cum_capture_rate percent8.2 cum_lift 8.2;
3773       run;
3774       
3775       proc sgplot data=work.cumulative_lift;
3776           series x=decile y=cum_lift;
3777           refline 1 / axis=y;
3778           xaxis label="Decile";
3779           yaxis label="Cumulative Lift";
3780           title "Cumulative Lift Chart";
3781       run;
3782       
3783       /*****************************************************************************
3784        * 6. Population Stability Index (PSI)
3785        *****************************************************************************/
3786       
3787       /* Compare score distributions between training and validation */
3788       
3789       /* Ten bins cut from the training scores: the nine cuts are the nearest-rank
3790          deciles of the training scores (no interpolation) */
3791       proc sort data=work.logit_scored_train(keep=credit_risk_score)
3792                 out=work.train_scores_sorted;
3793           by credit_risk_score;
3794       run;
3795       
3796       data work.psi_cuts;
3797           set work.train_scores_sorted nobs=n_train end=eof;
3798           array cut{9};
3799           retain cut1-cut9;
3800           do k = 1 to 9;
3801               if _n_ = ceil(k * n_train / 10) then cut{k} = credit_risk_score;
3802           end;
3803           if eof then output;
3804           keep cut1-cut9;
3805       run;
3806       
3807       /* Place both sets in the same bins; a score equal to a cut belongs to the lower bin */
3808       data work.train_bins;
3809           if _n_ = 1 then set work.psi_cuts;
3810           set work.logit_scored_train;
3811           array cut{9};
3812           score_bin = 0;
3813           do k = 1 to 9;
3814               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
3815           end;
3816           drop k cut1-cut9;
3817       run;
3818       
3819       data work.valid_bins;
3820           if _n_ = 1 then set work.psi_cuts;
3821           set work.logit_scored_valid;
3822           array cut{9};
3823           score_bin = 0;
3824           do k = 1 to 9;
3825               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
3826           end;
3827           drop k cut1-cut9;
3828       run;
3829       
3830       data work.psi_bins;
3831           do score_bin = 0 to 9;
3832               output;
3833           end;
3834       run;
3835       
3836       /* An empty bin is given a share below that of one applicant, the same on both
3837          sides, so that a bin filled on one side only adds a positive amount */
3838       /* The size of the larger set is carried as a whole number and the share is computed
3839          where it is used, so it is not cut to the 8 characters of a macro variable */
3840       proc sql noprint;
3841           select max(t.n, v.n) format=32. into :psi_rows trimmed
3842           from (select count(*) as n from work.train_bins) t,
3843                (select count(*) as n from work.valid_bins) v;
3844       quit;
3845       %let psi_floor = (0.5 / &psi_rows);
3846       
3847       /* Calculate PSI */
3848       proc sql;
3849           create table work.psi_calculation as
3850           select
3851               s.score_bin,
3852               coalesce(a.train_pct, 0) as train_pct,
3853               coalesce(b.valid_pct, 0) as valid_pct,
3854               (max(calculated train_pct, &psi_floor) - max(calculated valid_pct, &psi_floor))
3855                   * log(max(calculated train_pct, &psi_floor) / max(calculated valid_pct, &psi_floor)) as psi_component
3856           from work.psi_bins s
3857           left join
3858               (select score_bin, count(*) / (select count(*) from work.train_bins) as train_pct
3859                from work.train_bins group by score_bin) a
3860           on s.score_bin = a.score_bin
3861           left join
3862               (select score_bin, count(*) / (select count(*) from work.valid_bins) as valid_pct
3863                from work.valid_bins group by score_bin) b
3864           on s.score_bin = b.score_bin
3865           order by s.score_bin;
3866       
3867           create table work.psi_summary as
3868           select sum(psi_component) as PSI format=best12.,
3869                  case
3870                     when calculated PSI < 0.1 then 'No significant change'
3871                     when calculated PSI < 0.25 then 'Some change'
3872                     else 'Significant change'
3873                  end as PSI_interpretation
3874           from work.psi_calculation;
3875       quit;
3876       
3877       proc print data=work.psi_summary noobs;
3878           title "Population Stability Index";
3879       run;
3880       
3881       /*****************************************************************************
3882        * 7. Calibration Plot
3883        *****************************************************************************/
3884       
3885       /* Bin predictions and compare to actual */
3886       proc rank data=work.logit_scored_valid
3887                 out=work.calibration_data
3888                 groups=20;
3889           var pd_logistic;
3890           ranks pred_bin;
3891       run;
3892       
3893       proc sql;
3894           create table work.calibration_plot as
3895           select
3896               pred_bin,
3897               mean(pd_logistic) as mean_predicted format=8.4,
3898               mean(default_flag) as mean_actual format=8.4,
3899               count(*) as bin_count
3900           from work.calibration_data
3901           group by pred_bin
3902           order by pred_bin;
3903       quit;
3904       
3905       proc sgplot data=work.calibration_plot;
3906           scatter x=mean_predicted y=mean_actual / markerattrs=(size=10);
3907           lineparm x=0 y=0 slope=1 / lineattrs=(pattern=dash);
3908           xaxis label="Mean Predicted Probability";
3909           yaxis label="Mean Actual Default Rate";
3910           title "Calibration Plot - Predicted vs Actual";
3911       run;
3912       
3913       /*****************************************************************************
3914        * 8. Generate Validation Report
3915        *****************************************************************************/
3916       
3917       /* Compile validation metrics */
3918       data work.validation_summary;
3919           merge work.auc_summary
3920                 work.ks_statistic
3921                 work.psi_summary;
3922           length model $20 status $20;
3923           model = "Logistic Regression";
3924       
3925           /* Determine model status based on metrics */
3926           if AUC >= 0.7 and KS_Statistic >= 0.3 and PSI < 0.25 then
3927               status = "Production Ready";
3928           else if AUC >= 0.65 then
3929               status = "Requires Review";
3930           else
3931               status = "Needs Improvement";
3932       run;
3933       
3934       proc print data=work.validation_summary noobs;
3935           title "Model Validation Summary";
3936       run;
