3523       /*****************************************************************************
3524        * 2. ROC Curve and AUC Analysis
3525        *****************************************************************************/
3526       
3527       /* ROC analysis for validation set */
3528       proc logistic data=work.logit_scored_valid;
3529           model default_flag(event='1') = pd_logistic / nofit;
3530           roc 'Logistic Model' pred=pd_logistic;
3531           roccontrast;
3532           ods output ROCAssociation=work.roc_stats;
3533           title "ROC Curve Analysis - Validation Set";
3534       run;
3535       
3536       /* Calculate and display AUC: the exact pairwise AUC of the validation probabilities.
3537          A defaulter/non-defaulter pair is concordant when the defaulter's probability is
3538          higher, and tied only when the two probabilities are equal */
3539       proc sql;
3540           create table work.auc_pairs as
3541           select pd_logistic,
3542                  sum(default_flag = 1) as n_bad,
3543                  sum(default_flag = 0) as n_good
3544           from work.logit_scored_valid
3545           where not missing(pd_logistic)
3546           group by pd_logistic
3547           order by pd_logistic;
3548       quit;
3549       
3550       data work.auc_summary;
3551           length ROCModel $14;
3552           set work.auc_pairs end=eof;
3553           retain concordant tied cum_good cum_bad 0;
3554       
3555           concordant + n_bad * cum_good;
3556           tied + n_bad * n_good;
3557           cum_good + n_good;
3558           cum_bad + n_bad;
3559       
3560           if eof then do;
3561               ROCModel = 'Logistic Model';
3562               if cum_bad * cum_good > 0 then do;
3563                   AUC = (concordant + tied / 2) / (cum_bad * cum_good);
3564                   Gini = 2 * AUC - 1;
3565               end;
3566               output;
3567           end;
3568           keep ROCModel AUC Gini;
3569           format AUC Gini 8.4;
3570       run;
3571       
3572       proc print data=work.auc_summary noobs;
3573           title "Model Performance Metrics - AUC and Gini";
3574       run;
3575       
3576       /*****************************************************************************
3577        * 3. Kolmogorov-Smirnov (KS) Statistic
3578        *****************************************************************************/
3579       
3580       /* Sort by predicted probability */
3581       proc sort data=work.logit_scored_valid;
3582           by pd_logistic;
3583       run;
3584       
3585       /* Calculate total good and bad counts */
3586       proc sql noprint;
3587           select sum(default_flag = 0), sum(default_flag = 1)
3588           into :total_good_count, :total_bad_count
3589           from work.logit_scored_valid;
3590       quit;
3591       
3592       /* Calculate cumulative distributions */
3593       data work.ks_calculation;
3594           set work.logit_scored_valid;
3595           by pd_logistic;
3596           retain cum_good cum_bad;
3597       
3598           if _n_ = 1 then do;
3599               cum_good = 0;
3600               cum_bad = 0;
3601           end;
3602       
3603           if default_flag = 0 then cum_good + 1;
3604           else cum_bad + 1;
3605       
3606           cum_pct_good = cum_good / &total_good_count;
3607           cum_pct_bad = cum_bad / &total_bad_count;
3608           /* Compare the two distributions only after the last applicant of each probability */
3609           if last.pd_logistic then ks_value = abs(cum_pct_good - cum_pct_bad);
3610       run;
3611       
3612       /* Find maximum KS (one row: the lowest cutoff when several attain the maximum) */
3613       proc sql;
3614           create table work.ks_statistic as
3615           select max(ks_value) as KS_Statistic format=8.4,
3616                  min(pd_logistic) as KS_Cutoff format=8.4
3617           from work.ks_calculation
3618           where ks_value = (select max(ks_value) from work.ks_calculation);
3619       quit;
3620       
3621       proc print data=work.ks_statistic noobs;
3622           title "Kolmogorov-Smirnov Statistic";
3623       run;
3624       
3625       /*****************************************************************************
3626        * 4. Confusion Matrix and Accuracy Metrics
3627        *****************************************************************************/
3628       
3629       /* Calculate metrics at different thresholds */
3630       %macro confusion_metrics(threshold, suffix);
3631           data work.confusion_&suffix;
3632               set work.logit_scored_valid;
3633               predicted = (pd_logistic >= &threshold);
3634           run;
3635       
3636           proc freq data=work.confusion_&suffix noprint;
3637               tables default_flag * predicted / out=work.conf_matrix_&suffix;
3638           run;
3639       
3640           /* Calculate metrics */
3641           data work.metrics_&suffix;
3642               set work.conf_matrix_&suffix end=eof;
3643               retain TP TN FP FN 0;
3644       
3645               if default_flag = 1 and predicted = 1 then TP = count;
3646               else if default_flag = 0 and predicted = 0 then TN = count;
3647               else if default_flag = 0 and predicted = 1 then FP = count;
3648               else if default_flag = 1 and predicted = 0 then FN = count;
3649       
3650               if eof then do;
3651                   threshold = &threshold;
3652                   if (TP + TN + FP + FN) > 0 then accuracy = (TP + TN) / (TP + TN + FP + FN);
3653                   else accuracy = .;
3654                   if (TP + FP) > 0 then precision = TP / (TP + FP);
3655                   else precision = .;
3656                   if (TP + FN) > 0 then recall = TP / (TP + FN);
3657                   else recall = .;
3658                   if (precision + recall) > 0 then f1_score = 2 * (precision * recall) / (precision + recall);
3659                   else f1_score = .;
3660                   if (TN + FP) > 0 then specificity = TN / (TN + FP);
3661                   else specificity = .;
3662                   output;
3663               end;
3664               keep threshold accuracy precision recall f1_score specificity;
3665           run;
3666       %mend;
3667       
3668       /* Test multiple thresholds */
3669       %confusion_metrics(0.3, 03);
3670       %confusion_metrics(0.4, 04);
3671       %confusion_metrics(0.5, 05);
3672       %confusion_metrics(0.6, 06);
3673       %confusion_metrics(0.7, 07);
3674       
3675       /* Combine results */
3676       data work.threshold_analysis;
3677           set work.metrics_03 work.metrics_04 work.metrics_05
3678               work.metrics_06 work.metrics_07;
3679       run;
3680       
3681       proc print data=work.threshold_analysis;
3682           title "Performance Metrics at Different Thresholds";
3683           format accuracy precision recall f1_score specificity 8.4;
3684       run;
3685       
3686       /*****************************************************************************
3687        * 5. Decile Analysis and Lift Chart
3688        *****************************************************************************/
3689       
3690       /* Create deciles based on predicted probability */
3691       proc rank data=work.logit_scored_valid
3692                 out=work.decile_data
3693                 groups=10 descending;
3694           var pd_logistic;
3695           ranks decile;
3696       run;
3697       
3698       /* Always ten rows, deciles 1 to 10 */
3699       data work.decile_list;
3700           do decile = 1 to 10;
3701               output;
3702           end;
3703       run;
3704       
3705       /* Calculate lift by decile; a decile that receives no applicant has
3706          count 0, capture rate 0 and lift 0 */
3707       proc sql;
3708           create table work.decile_analysis as
3709           select
3710               l.decile,
3711               coalesce(d.total_count, 0) as total_count,
3712               coalesce(d.defaults, 0) as defaults,
3713               d.default_rate format=percent8.2,
3714               d.avg_pd format=8.4,
3715               d.min_pd format=8.4,
3716               d.max_pd format=8.4,
3717               case when d.decile is null then 0 else d.capture_rate end as capture_rate format=percent8.2,
3718               case when d.decile is null then 0 else d.lift end as lift format=8.2
3719           from work.decile_list l
3720           left join
3721               (select
3722                   decile + 1 as decile,
3723                   count(*) as total_count,
3724                   sum(default_flag) as defaults,
3725                   mean(default_flag) as default_rate,
3726                   mean(pd_logistic) as avg_pd,
3727                   min(pd_logistic) as min_pd,
3728                   max(pd_logistic) as max_pd,
3729                   sum(default_flag) / (select sum(default_flag) from work.decile_data) as capture_rate,
3730                   (calculated default_rate) / (select mean(default_flag) from work.decile_data) as lift
3731                from work.decile_data
3732                group by decile) d
3733           on l.decile = d.decile
3734           order by l.decile;
3735       quit;
3736       
3737       proc print data=work.decile_analysis;
3738           title "Decile Analysis - Model Lift and Capture Rate";
3739       run;
3740       
3741       /* Calculate totals for cumulative lift chart */
3742       proc sql noprint;
3743           select sum(default_flag), mean(default_flag)
3744           into :total_defaults, :overall_default_rate
3745           from work.decile_data;
3746       quit;
3747       
3748       /* Create cumulative lift chart */
3749       data work.cumulative_lift;
3750           set work.decile_analysis;
3751           retain cum_defaults cum_count;
3752           if _n_ = 1 then do;
3753               cum_defaults = defaults;
3754               cum_count = total_count;
3755           end;
3756           else do;
3757               cum_defaults + defaults;
3758               cum_count + total_count;
3759           end;
3760       
3761           cum_capture_rate = cum_defaults / &total_defaults;
3762           /* No cumulative lift while the deciles so far are empty */
3763           if cum_count > 0 then cum_lift = (cum_defaults / cum_count) / &overall_default_rate;
3764           format cum_capture_rate percent8.2 cum_lift 8.2;
3765       run;
3766       
3767       proc sgplot data=work.cumulative_lift;
3768           series x=decile y=cum_lift;
3769           refline 1 / axis=y;
3770           xaxis label="Decile";
3771           yaxis label="Cumulative Lift";
3772           title "Cumulative Lift Chart";
3773       run;
3774       
3775       /*****************************************************************************
3776        * 6. Population Stability Index (PSI)
3777        *****************************************************************************/
3778       
3779       /* Compare score distributions between training and validation */
3780       
3781       /* Ten bins cut from the training scores: the nine cuts are the nearest-rank
3782          deciles of the training scores (no interpolation) */
3783       proc sort data=work.logit_scored_train(keep=credit_risk_score)
3784                 out=work.train_scores_sorted;
3785           by credit_risk_score;
3786       run;
3787       
3788       data work.psi_cuts;
3789           set work.train_scores_sorted nobs=n_train end=eof;
3790           array cut{9};
3791           retain cut1-cut9;
3792           do k = 1 to 9;
3793               if _n_ = ceil(k * n_train / 10) then cut{k} = credit_risk_score;
3794           end;
3795           if eof then output;
3796           keep cut1-cut9;
3797       run;
3798       
3799       /* Place both sets in the same bins; a score equal to a cut belongs to the lower bin */
3800       data work.train_bins;
3801           if _n_ = 1 then set work.psi_cuts;
3802           set work.logit_scored_train;
3803           array cut{9};
3804           score_bin = 0;
3805           do k = 1 to 9;
3806               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
3807           end;
3808           drop k cut1-cut9;
3809       run;
3810       
3811       data work.valid_bins;
3812           if _n_ = 1 then set work.psi_cuts;
3813           set work.logit_scored_valid;
3814           array cut{9};
3815           score_bin = 0;
3816           do k = 1 to 9;
3817               if credit_risk_score > cut{k} then score_bin = score_bin + 1;
3818           end;
3819           drop k cut1-cut9;
3820       run;
3821       
3822       data work.psi_bins;
3823           do score_bin = 0 to 9;
3824               output;
3825           end;
3826       run;
3827       
3828       /* An empty bin is given a share below that of one applicant, the same on both
3829          sides, so that a bin filled on one side only adds a positive amount */
3830       /* The size of the larger set is carried as a whole number and the share is computed
3831          where it is used, so it is not cut to the 8 characters of a macro variable */
3832       proc sql noprint;
3833           select max(t.n, v.n) format=32. into :psi_rows trimmed
3834           from (select count(*) as n from work.train_bins) t,
3835                (select count(*) as n from work.valid_bins) v;
3836       quit;
3837       %let psi_floor = (0.5 / &psi_rows);
3838       
3839       /* Calculate PSI */
3840       proc sql;
3841           create table work.psi_calculation as
3842           select
3843               s.score_bin,
3844               coalesce(a.train_pct, 0) as train_pct,
3845               coalesce(b.valid_pct, 0) as valid_pct,
3846               (max(calculated train_pct, &psi_floor) - max(calculated valid_pct, &psi_floor))
3847                   * log(max(calculated train_pct, &psi_floor) / max(calculated valid_pct, &psi_floor)) as psi_component
3848           from work.psi_bins s
3849           left join
3850               (select score_bin, count(*) / (select count(*) from work.train_bins) as train_pct
3851                from work.train_bins group by score_bin) a
3852           on s.score_bin = a.score_bin
3853           left join
3854               (select score_bin, count(*) / (select count(*) from work.valid_bins) as valid_pct
3855                from work.valid_bins group by score_bin) b
3856           on s.score_bin = b.score_bin
3857           order by s.score_bin;
3858       
3859           create table work.psi_summary as
3860           select sum(psi_component) as PSI format=best12.,
3861                  case
3862                     when calculated PSI < 0.1 then 'No significant change'
3863                     when calculated PSI < 0.25 then 'Some change'
3864                     else 'Significant change'
3865                  end as PSI_interpretation
3866           from work.psi_calculation;
3867       quit;
3868       
3869       proc print data=work.psi_summary noobs;
3870           title "Population Stability Index";
3871       run;
3872       
3873       /*****************************************************************************
3874        * 7. Calibration Plot
3875        *****************************************************************************/
3876       
3877       /* Bin predictions and compare to actual */
3878       proc rank data=work.logit_scored_valid
3879                 out=work.calibration_data
3880                 groups=20;
3881           var pd_logistic;
3882           ranks pred_bin;
3883       run;
3884       
3885       proc sql;
3886           create table work.calibration_plot as
3887           select
3888               pred_bin,
3889               mean(pd_logistic) as mean_predicted format=8.4,
3890               mean(default_flag) as mean_actual format=8.4,
3891               count(*) as bin_count
3892           from work.calibration_data
3893           group by pred_bin
3894           order by pred_bin;
3895       quit;
3896       
3897       proc sgplot data=work.calibration_plot;
3898           scatter x=mean_predicted y=mean_actual / markerattrs=(size=10);
3899           lineparm x=0 y=0 slope=1 / lineattrs=(pattern=dash);
3900           xaxis label="Mean Predicted Probability";
3901           yaxis label="Mean Actual Default Rate";
3902           title "Calibration Plot - Predicted vs Actual";
3903       run;
3904       
3905       /*****************************************************************************
3906        * 8. Generate Validation Report
3907        *****************************************************************************/
3908       
3909       /* Compile validation metrics */
3910       data work.validation_summary;
3911           merge work.auc_summary
3912                 work.ks_statistic
3913                 work.psi_summary;
3914           length model $20 status $20;
3915           model = "Logistic Regression";
3916       
3917           /* Determine model status based on metrics */
3918           if AUC >= 0.7 and KS_Statistic >= 0.3 and PSI < 0.25 then
3919               status = "Production Ready";
3920           else if AUC >= 0.65 then
3921               status = "Requires Review";
3922           else
3923               status = "Needs Improvement";
3924       run;
3925       
3926       proc print data=work.validation_summary noobs;
3927           title "Model Validation Summary";
3928       run;
