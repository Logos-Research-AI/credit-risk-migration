4813       data work.test_cleaned;
4814           set work.test_raw_clean;
4815       
4816           /* Create age group for income imputation */
4817           if age < 30 then age_group = 1;
4818           else if age < 40 then age_group = 2;
4819           else if age < 50 then age_group = 3;
4820           else if age < 60 then age_group = 4;
4821           else age_group = 5;
4822       
4823           /* Handle missing values - create flags */
4824           if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
4825           else MonthlyIncome_missing = 0;
4826       
4827           if missing(NumberOfDependents) then do;
4828               NumberOfDependents = 0;
4829               Dependents_missing = 1;
4830           end;
4831           else Dependents_missing = 0;
4832       run;
