4311       /* Calculate income medians by age group from test data */
4312       proc sql;
4313           create table work.test_income_medians as
4314           select
4315               case
4316                   when age < 30 then 1
4317                   when age < 40 then 2
4318                   when age < 50 then 3
4319                   when age < 60 then 4
4320                   else 5
4321               end as age_group,
4322               median(MonthlyIncome) as median_income
4323           from work.test_raw_clean
4324           where MonthlyIncome is not missing
4325           group by calculated age_group;
4326       quit;
4327       
4328       data work.test_cleaned;
4329           set work.test_raw_clean;
4330       
4331           /* Create age group for income imputation */
4332           if age < 30 then age_group = 1;
4333           else if age < 40 then age_group = 2;
4334           else if age < 50 then age_group = 3;
4335           else if age < 60 then age_group = 4;
4336           else age_group = 5;
4337       
4338           /* Handle missing values - create flags */
4339           if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
4340           else MonthlyIncome_missing = 0;
4341       
4342           if missing(NumberOfDependents) then do;
4343               NumberOfDependents = 0;
4344               Dependents_missing = 1;
4345           end;
4346           else Dependents_missing = 0;
4347       run;
4348       
4349       /* Merge and impute income - rename columns in SQL */
4350       proc sql;
4351           create table work.test_imputed as
4352           select
4353               a.VAR1 as row_id,
4354               a.age,
4355               case when a.MonthlyIncome_missing = 1 then b.median_income
4356                    else a.MonthlyIncome
4357               end as monthly_income,
4358               a.MonthlyIncome_missing,
4359               a.NumberOfDependents as num_dependents,
4360               a.Dependents_missing,
4361               a.age_group,
4362               a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
4363               a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
4364               a.NumberOfTimes90DaysLate as num_late_90_plus,
4365               a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
4366               a.DebtRatio * 100 as debt_ratio,
4367               a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
4368               a.NumberRealEstateLoansOrLines as num_real_estate_loans
4369           from work.test_cleaned a
4370           left join work.test_income_medians b
4371           on a.age_group = b.age_group;
4372       quit;
4373       
4374       /*****************************************************************************
4375        * 3. Feature Engineering (Same as Training)
4376        *****************************************************************************/
4377       
4378       data work.test_features;
4379           set work.test_imputed;
4380       
4381           /* Total late payments across all categories */
4382           total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
4383       
4384           /* Has any delinquency indicator */
4385           has_delinquency = (total_late_payments > 0);
4386       
4387           /* Has serious delinquency (90+ days) */
4388           has_serious_delinquency = (num_late_90_plus > 0);
4389       
4390           /* Credit utilization categories */
4391           if credit_utilization < 30 then credit_util_category = 1;
4392           else if credit_utilization < 50 then credit_util_category = 2;
4393           else if credit_utilization < 75 then credit_util_category = 3;
4394           else credit_util_category = 4;
4395       
4396           /* Debt ratio categories */
4397           if debt_ratio < 30 then debt_category = 1;
4398           else if debt_ratio < 43 then debt_category = 2;
4399           else if debt_ratio < 60 then debt_category = 3;
4400           else debt_category = 4;
4401       
4402           /* Income per dependent */
4403           if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
4404           else income_per_dependent = monthly_income;
4405       
4406           /* Credit lines per person in household */
4407           credit_lines_per_person = num_credit_lines / (num_dependents + 1);
4408       
4409           /* Age categories */
4410           if age < 25 then age_category = 1;
4411           else if age < 35 then age_category = 2;
4412           else if age < 50 then age_category = 3;
4413           else if age < 65 then age_category = 4;
4414           else age_category = 5;
4415       
4416           /* Risk flags */
4417           flag_high_utilization = (credit_utilization > 75);
4418           flag_very_high_utilization = (credit_utilization > 100);
4419           flag_high_debt_ratio = (debt_ratio > 43);
4420           flag_very_high_debt_ratio = (debt_ratio > 60);
4421           flag_recent_late_payments = (num_late_30_59 > 0);
4422           flag_serious_delinquency = (num_late_90_plus > 0);
4423           flag_multiple_delinquencies = (total_late_payments >= 3);
4424           flag_low_income = (monthly_income < 2500);
4425           flag_many_dependents = (num_dependents >= 3);
4426           flag_few_credit_lines = (num_credit_lines <= 2);
4427       
4428           /* Total risk flags */
4429           total_risk_flags = sum(flag_high_utilization, flag_high_debt_ratio,
4430                                 flag_serious_delinquency, flag_multiple_delinquencies,
4431                                 flag_low_income);
4432       
4433           /* Financial health score */
4434           financial_health = 100;
4435           if credit_utilization > 30 then financial_health = financial_health - 15;
4436           if credit_utilization > 75 then financial_health = financial_health - 15;
4437           if debt_ratio > 43 then financial_health = financial_health - 20;
4438           if has_delinquency then financial_health = financial_health - 20;
4439           if num_late_90_plus > 0 then financial_health = financial_health - 30;
4440           financial_health = max(0, financial_health);
4441       
4442           /* Log transformations */
4443           log_monthly_income = log(monthly_income + 1);
4444           log_num_credit_lines = log(num_credit_lines + 1);
4445           log_total_late_payments = log(total_late_payments + 1);
4446       
4447           /* Interaction features */
4448           age_income_interaction = age * log_monthly_income;
4449           utilization_debt_interaction = credit_utilization * debt_ratio / 100;
4450       
4451           /* Cap extreme outliers */
4452           credit_utilization_capped = min(credit_utilization, 200);
4453           debt_ratio_capped = min(debt_ratio, 500);
4454       run;
4455       
4456       /*****************************************************************************
4457        * 4. Score Test Set Using Trained Model
4458        *****************************************************************************/
4459       
4460       /* Score test set with trained model */
4461       proc plm restore=work.logit_model;
4462           score data=work.test_features
4463                 out=work.test_scored_temp
4464                 predicted=predicted_logit;
4465       run;
4466       
4467       /* Convert logit to probability */
4468       data work.test_scored;
4469           set work.test_scored_temp;
4470       
4471           /* Apply inverse logit function */
4472           pd_logistic = 1 / (1 + exp(-predicted_logit));
4473       
4474           drop predicted_logit;
4475       run;
4476       
4477       /*****************************************************************************
4478        * 5. Generate Risk Scores and Recommendations
4479        *****************************************************************************/
4480       
4481       data work.test_predictions;
4482           set work.test_scored;
4483       
4484           /* Binary prediction at 0.5 threshold */
4485           pred_logistic = (pd_logistic >= 0.5);
4486       
4487           /* Convert probability to credit risk score (300-850 scale) */
4488           base_score = 600;
4489           score_range = 250;
4490           credit_risk_score = round(base_score + score_range * (1 - pd_logistic));
4491       
4492           /* Assign risk grades */
4493           if credit_risk_score >= 750 then risk_grade = 'A';
4494           else if credit_risk_score >= 700 then risk_grade = 'B';
4495           else if credit_risk_score >= 650 then risk_grade = 'C';
4496           else if credit_risk_score >= 600 then risk_grade = 'D';
4497           else if credit_risk_score >= 550 then risk_grade = 'E';
4498           else risk_grade = 'F';
4499       
4500           /* Recommended actions */
4501           if risk_grade in ('A', 'B') then recommendation = 'Approve';
4502           else if risk_grade = 'C' then recommendation = 'Review';
4503           else recommendation = 'Decline';
4504       
4505           /* Suggested interest rate */
4506           base_rate = 0.05;
4507           if risk_grade = 'A' then interest_rate = base_rate;
4508           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
4509           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
4510           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
4511           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
4512           else interest_rate = base_rate + 0.15;
4513       
4514           format interest_rate percent8.2;
4515       run;
4516       
4517       /*****************************************************************************
4518        * 6. Create Output Datasets
4519        *****************************************************************************/
4520       
4521       /* Kaggle submission format (row_id, probability) */
4522       data work.kaggle_submission;
4523           set work.test_predictions;
4524           keep row_id pd_logistic;
4525       run;
4526       
4527       /* Full predictions with all scores and recommendations */
4528       data work.test_predictions_full;
4529           set work.test_predictions;
4530           keep row_id pd_logistic pred_logistic credit_risk_score risk_grade
4531                recommendation interest_rate age monthly_income
4532                credit_utilization debt_ratio total_late_payments
4533                num_credit_lines financial_health total_risk_flags;
4534       run;
