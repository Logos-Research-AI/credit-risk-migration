4567       
4568       /* How many lines the test file has (counted up to two). The first line is copied to the
4569          work folder with one made-up applicant under it: a value for every name, chosen by the
4570          name and not by its place (NA under the three names that may hold NA, a number under
4571          every other), the same line end */
4572       %let test_lines = 0;
4573       %let header_copy = %sysfunc(pathname(work))/cs-test-header.csv;
4574       
4575       data _null_;
4576           infile "&data_path/cs-test.csv" lrecl=32767 truncover obs=2 length=len;
4577           file "&header_copy" lrecl=131068;
4578           input;
4579           if _n_ = 1 then do;
4580               put _infile_;
4581               do i = 1 to countc(_infile_, ',') + 1;
4582                   if i > 1 then put ',' @;
4583                   if upcase(compress(scan(_infile_, i, ',', 'm'), , 'kn')) in
4584                      ('SERIOUSDLQIN2YRS', 'MONTHLYINCOME', 'NUMBEROFDEPENDENTS') then put 'NA' @;
4585                   else put '1' @;
4586               end;
4587               if len > 0 then if char(_infile_, len) = '0D'x then put '0D'x @;
4588               put;
4589           end;
4590           call symputx('test_lines', _n_);
4591       run;
4592       
4593       /* Import test data. PROC IMPORT cannot read a file that has its header line and no
4594          applicant: PROC IMPORT then reads the copy, so the columns are named as it names them,
4595          and the made-up applicant is removed, which leaves an empty table. The tables an earlier
4596          scoring left in the session are removed first: a step that fails finds no table to use */
4597       %macro import_test;
4598           %local source;
4599           %let source = &data_path/cs-test.csv;
4600           %if &test_lines = 1 %then %do;
4601               %let source = &header_copy;
4602               proc datasets library=work nolist nowarn;
4603                   delete test_raw input_check test_raw_clean test_cleaned test_imputed
4604                          test_features test_scored_temp test_scored test_predictions
4605                          kaggle_submission test_predictions_full;
4606               quit;
4607           %end;
4608           proc import datafile="&source"
4609               out=work.test_raw
4610               dbms=csv
4611               replace;
4612               getnames=yes;
4613               guessingrows=max;
4614           run;
4615           %if &test_lines = 1 and %sysfunc(exist(work.test_raw)) %then %do;
4616               data work.test_raw;
4617                   set work.test_raw;
4618                   stop;
4619               run;
4620           %end;
4621       %mend;
4622       %import_test
