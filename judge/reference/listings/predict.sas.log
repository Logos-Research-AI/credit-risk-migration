4817       data work.test_cleaned;
4818           set work.test_raw_clean;
4819       
4820           /* Create age group for income imputation */
4821           if age < 30 then age_group = 1;
4822           else if age < 40 then age_group = 2;
4823           else if age < 50 then age_group = 3;
4824           else if age < 60 then age_group = 4;
4825           else age_group = 5;
4826       
4827           /* Handle missing values - create flags */
4828           if missing(MonthlyIncome) then MonthlyIncome_missing = 1;
4829           else MonthlyIncome_missing = 0;
4830       
4831           if missing(NumberOfDependents) then do;
4832               NumberOfDependents = 0;
4833               Dependents_missing = 1;
4834           end;
4835           else Dependents_missing = 0;
4836       run;
