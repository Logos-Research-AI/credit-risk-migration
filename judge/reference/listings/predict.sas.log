4834       /* Merge and impute income - rename columns in SQL */
4835       proc sql;
4836           create table work.test_imputed as
4837           select
4838               a.VAR1 as row_id,
4839               a.age,
4840               case when a.MonthlyIncome_missing = 1 then coalesce(b.median_income, b.overall_median_income)
4841                    else a.MonthlyIncome
4842               end as monthly_income,
4843               a.MonthlyIncome_missing,
4844               a.NumberOfDependents as num_dependents,
4845               a.Dependents_missing,
4846               a.age_group,
4847               a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
4848               a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
4849               a.NumberOfTimes90DaysLate as num_late_90_plus,
4850               a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
4851               a.DebtRatio * 100 as debt_ratio,
4852               a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
4853               a.NumberRealEstateLoansOrLines as num_real_estate_loans
4854           from work.test_cleaned a
4855           left join work.train_income_medians b
4856           on a.age_group = b.age_group;
4857       quit;
4858       
4859       /*****************************************************************************
4860        * 3. Feature Engineering (Same as Training)
4861        *****************************************************************************/
4862       
4863       data work.test_features;
4864           set work.test_imputed;
4865       
4866           /* Total late payments across all categories */
4867           total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
4868       
4869           /* Has any delinquency indicator */
4870           has_delinquency = (total_late_payments > 0);
4871       
4872           /* Has serious delinquency (90+ days) */
4873           has_serious_delinquency = (num_late_90_plus > 0);
4874       
4875           /* Credit utilization categories */
4876           if credit_utilization < 30 then credit_util_category = 1;
4877           else if credit_utilization < 50 then credit_util_category = 2;
4878           else if credit_utilization < 75 then credit_util_category = 3;
4879           else credit_util_category = 4;
4880       
4881           /* Debt ratio categories */
4882           if debt_ratio < 30 then debt_category = 1;
4883           else if debt_ratio < 43 then debt_category = 2;
4884           else if debt_ratio < 60 then debt_category = 3;
4885           else debt_category = 4;
4886       
4887           /* Income per dependent */
4888           if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
4889           else income_per_dependent = monthly_income;
4890       
4891           /* Credit lines per person in household */
4892           credit_lines_per_person = num_credit_lines / (num_dependents + 1);
4893       
4894           /* Age categories */
4895           if age < 25 then age_category = 1;
4896           else if age < 35 then age_category = 2;
4897           else if age < 50 then age_category = 3;
4898           else if age < 65 then age_category = 4;
4899           else age_category = 5;
4900       
4901           /* Risk flags */
4902           flag_high_utilization = (credit_utilization > 75);
4903           flag_very_high_utilization = (credit_utilization > 100);
4904           flag_high_debt_ratio = (debt_ratio > 43);
4905           flag_very_high_debt_ratio = (debt_ratio > 60);
4906           flag_recent_late_payments = (num_late_30_59 > 0);
4907           flag_serious_delinquency = (num_late_90_plus > 0);
4908           flag_multiple_delinquencies = (total_late_payments >= 3);
4909           flag_low_income = (monthly_income < 2500);
4910           flag_many_dependents = (num_dependents >= 3);
4911           flag_few_credit_lines = (num_credit_lines <= 2);
4912       
4913           /* Total risk flags */
4914           total_risk_flags = sum(flag_high_utilization, flag_very_high_utilization,
4915                                 flag_high_debt_ratio,
4916                                 flag_serious_delinquency, flag_multiple_delinquencies,
4917                                 flag_low_income, flag_many_dependents,
4918                                 flag_few_credit_lines);
4919       
4920           /* Financial health score */
4921           financial_health = 100;
4922           if credit_utilization > 30 then financial_health = financial_health - 15;
4923           if credit_utilization > 75 then financial_health = financial_health - 15;
4924           if debt_ratio > 43 then financial_health = financial_health - 20;
4925           if has_delinquency then financial_health = financial_health - 20;
4926           if num_late_90_plus > 0 then financial_health = financial_health - 30;
4927           financial_health = max(0, financial_health);
4928       
4929           /* Log transformations */
4930           log_monthly_income = log(monthly_income + 1);
4931           log_num_credit_lines = log(num_credit_lines + 1);
4932           log_total_late_payments = log(total_late_payments + 1);
4933       
4934           /* Interaction features */
4935           if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
4936           else age_income_interaction = age * log_monthly_income;
4937           utilization_debt_interaction = credit_utilization * debt_ratio;
4938       
4939           /* Cap extreme outliers */
4940           credit_utilization_capped = min(credit_utilization, 200);
4941           debt_ratio_capped = min(debt_ratio, 500);
4942       run;
4943       
4944       /*****************************************************************************
4945        * 4. Score Test Set Using Trained Model
4946        *****************************************************************************/
4947       
4948       /* Score test set with trained model */
4949       proc plm restore=work.logit_model;
4950           score data=work.test_features
4951                 out=work.test_scored_temp
4952                 predicted=predicted_logit;
4953       run;
4954       
4955       /* Convert logit to probability */
4956       data work.test_scored;
4957           set work.test_scored_temp;
4958       
4959           /* Apply inverse logit function */
4960           pd_logistic = 1 / (1 + exp(-predicted_logit));
4961       
4962           drop predicted_logit;
4963       run;
4964       
4965       /*****************************************************************************
4966        * 5. Generate Risk Scores and Recommendations
4967        *****************************************************************************/
4968       
4969       data work.test_predictions;
4970           set work.test_scored;
4971       
4972           /* Binary prediction at 0.5 threshold */
4973           pred_logistic = (pd_logistic >= 0.5);
4974       
4975           /* Convert probability to credit risk score (300-850 scale) */
4976           base_score = 600;
4977           score_range = 250;
4978           credit_risk_score = base_score + score_range * (1 - pd_logistic);
4979       
4980           /* Assign risk grades from the probability (a missing probability is graded F) */
4981           if missing(pd_logistic) then risk_grade = 'F';
4982           else if pd_logistic < 0.10 then risk_grade = 'A';
4983           else if pd_logistic < 0.15 then risk_grade = 'B';
4984           else if pd_logistic < 0.25 then risk_grade = 'C';
4985           else if pd_logistic < 0.35 then risk_grade = 'D';
4986           else if pd_logistic <= 0.50 then risk_grade = 'E';
4987           else risk_grade = 'F';
4988       
4989           /* Recommended actions */
4990           if risk_grade in ('A', 'B') then recommendation = 'Approve';
4991           else if risk_grade = 'C' then recommendation = 'Review';
4992           else recommendation = 'Decline';
4993       
4994           /* Suggested interest rate */
4995           base_rate = 0.05;
4996           if risk_grade = 'A' then interest_rate = base_rate;
4997           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
4998           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
4999           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
5000           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
5001           else interest_rate = base_rate + 0.15;
5002       
5003           format interest_rate percent8.2;
5004       run;
5005       
5006       /*****************************************************************************
5007        * 6. Create Output Datasets
5008        *****************************************************************************/
5009       
5010       /* Kaggle submission format (row_id, probability) */
5011       data work.kaggle_submission;
5012           set work.test_predictions;
5013           keep row_id pd_logistic;
5014       run;
5015       
5016       /* Full predictions with all scores and recommendations */
5017       data work.test_predictions_full;
5018           set work.test_predictions;
5019           keep row_id pd_logistic pred_logistic credit_risk_score risk_grade
5020                recommendation interest_rate age monthly_income
5021                credit_utilization debt_ratio total_late_payments
5022                num_credit_lines financial_health total_risk_flags;
5023       run;
