4565       
4566       /* How many lines the test file has (counted up to two). The first line is copied to the
4567          work folder with one made-up applicant under it: a value for every name, chosen by the
4568          name and not by its place (NA under the three names that may hold NA, a number under
4569          every other), the same line end */
4570       %let test_lines = 0;
4571       %let header_copy = %sysfunc(pathname(work))/cs-test-header.csv;
4572       
4573       data _null_;
4574           infile "&data_path/cs-test.csv" lrecl=32767 truncover obs=2 length=len;
4575           file "&header_copy" lrecl=131068;
4576           input;
4577           if _n_ = 1 then do;
4578               put _infile_;
4579               do i = 1 to countc(_infile_, ',') + 1;
4580                   if i > 1 then put ',' @;
4581                   if upcase(compress(scan(_infile_, i, ',', 'm'), , 'kn')) in
4582                      ('SERIOUSDLQIN2YRS', 'MONTHLYINCOME', 'NUMBEROFDEPENDENTS') then put 'NA' @;
4583                   else put '1' @;
4584               end;
4585               if len > 0 then if char(_infile_, len) = '0D'x then put '0D'x @;
4586               put;
4587           end;
4588           call symputx('test_lines', _n_);
4589       run;
4590       
4591       /* Import test data. PROC IMPORT cannot read a file that has its header line and no
4592          applicant: PROC IMPORT then reads the copy, so the columns are named as it names them,
4593          and the made-up applicant is removed, which leaves an empty table. The tables an earlier
4594          scoring left in the session are removed first: a step that fails finds no table to use */
4595       %macro import_test;
4596           %local source;
4597           %let source = &data_path/cs-test.csv;
4598           %if &test_lines = 1 %then %do;
4599               %let source = &header_copy;
4600               proc datasets library=work nolist nowarn;
4601                   delete test_raw input_check test_raw_clean test_cleaned test_imputed
4602                          test_features test_scored_temp test_scored test_predictions
4603                          kaggle_submission test_predictions_full;
4604               quit;
4605           %end;
4606           proc import datafile="&source"
4607               out=work.test_raw
4608               dbms=csv
4609               replace;
4610               getnames=yes;
4611               guessingrows=max;
4612           run;
4613           %if &test_lines = 1 and %sysfunc(exist(work.test_raw)) %then %do;
4614               data work.test_raw;
4615                   set work.test_raw;
4616                   stop;
4617               run;
4618           %end;
4619       %mend;
4620       %import_test
