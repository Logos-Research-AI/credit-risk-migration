4838       /* Merge and impute income - rename columns in SQL */
4839       proc sql;
4840           create table work.test_imputed as
4841           select
4842               a.VAR1 as row_id,
4843               a.age,
4844               case when a.MonthlyIncome_missing = 1 then coalesce(b.median_income, b.overall_median_income)
4845                    else a.MonthlyIncome
4846               end as monthly_income,
4847               a.MonthlyIncome_missing,
4848               a.NumberOfDependents as num_dependents,
4849               a.Dependents_missing,
4850               a.age_group,
4851               a."NumberOfTime30-59DaysPastDueNotW"n as num_late_30_59,
4852               a."NumberOfTime60-89DaysPastDueNotW"n as num_late_60_89,
4853               a.NumberOfTimes90DaysLate as num_late_90_plus,
4854               a.RevolvingUtilizationOfUnsecuredL * 100 as credit_utilization,
4855               a.DebtRatio * 100 as debt_ratio,
4856               a.NumberOfOpenCreditLinesAndLoans as num_credit_lines,
4857               a.NumberRealEstateLoansOrLines as num_real_estate_loans
4858           from work.test_cleaned a
4859           left join work.train_income_medians b
4860           on a.age_group = b.age_group;
4861       quit;
4862       
4863       /*****************************************************************************
4864        * 3. Feature Engineering (Same as Training)
4865        *****************************************************************************/
4866       
4867       data work.test_features;
4868           set work.test_imputed;
4869       
4870           /* Total late payments across all categories */
4871           total_late_payments = sum(num_late_30_59, num_late_60_89, num_late_90_plus);
4872       
4873           /* Has any delinquency indicator */
4874           has_delinquency = (total_late_payments > 0);
4875       
4876           /* Has serious delinquency (90+ days) */
4877           has_serious_delinquency = (num_late_90_plus > 0);
4878       
4879           /* Credit utilization categories */
4880           if credit_utilization < 30 then credit_util_category = 1;
4881           else if credit_utilization < 50 then credit_util_category = 2;
4882           else if credit_utilization < 75 then credit_util_category = 3;
4883           else credit_util_category = 4;
4884       
4885           /* Debt ratio categories */
4886           if debt_ratio < 30 then debt_category = 1;
4887           else if debt_ratio < 43 then debt_category = 2;
4888           else if debt_ratio < 60 then debt_category = 3;
4889           else debt_category = 4;
4890       
4891           /* Income per dependent */
4892           if num_dependents > 0 then income_per_dependent = monthly_income / (num_dependents + 1);
4893           else income_per_dependent = monthly_income;
4894       
4895           /* Credit lines per person in household */
4896           credit_lines_per_person = num_credit_lines / (num_dependents + 1);
4897       
4898           /* Age categories */
4899           if age < 25 then age_category = 1;
4900           else if age < 35 then age_category = 2;
4901           else if age < 50 then age_category = 3;
4902           else if age < 65 then age_category = 4;
4903           else age_category = 5;
4904       
4905           /* Risk flags */
4906           flag_high_utilization = (credit_utilization > 75);
4907           flag_very_high_utilization = (credit_utilization > 100);
4908           flag_high_debt_ratio = (debt_ratio > 43);
4909           flag_very_high_debt_ratio = (debt_ratio > 60);
4910           flag_recent_late_payments = (num_late_30_59 > 0);
4911           flag_serious_delinquency = (num_late_90_plus > 0);
4912           flag_multiple_delinquencies = (total_late_payments >= 3);
4913           flag_low_income = (monthly_income < 2500);
4914           flag_many_dependents = (num_dependents >= 3);
4915           flag_few_credit_lines = (num_credit_lines <= 2);
4916       
4917           /* Total risk flags */
4918           total_risk_flags = sum(flag_high_utilization, flag_very_high_utilization,
4919                                 flag_high_debt_ratio,
4920                                 flag_serious_delinquency, flag_multiple_delinquencies,
4921                                 flag_low_income, flag_many_dependents,
4922                                 flag_few_credit_lines);
4923       
4924           /* Financial health score */
4925           financial_health = 100;
4926           if credit_utilization > 30 then financial_health = financial_health - 15;
4927           if credit_utilization > 75 then financial_health = financial_health - 15;
4928           if debt_ratio > 43 then financial_health = financial_health - 20;
4929           if has_delinquency then financial_health = financial_health - 20;
4930           if num_late_90_plus > 0 then financial_health = financial_health - 30;
4931           financial_health = max(0, financial_health);
4932       
4933           /* Log transformations */
4934           log_monthly_income = log(monthly_income + 1);
4935           log_num_credit_lines = log(num_credit_lines + 1);
4936           log_total_late_payments = log(total_late_payments + 1);
4937       
4938           /* Interaction features */
4939           if monthly_income > 0 then age_income_interaction = age * log(monthly_income);
4940           else age_income_interaction = age * log_monthly_income;
4941           utilization_debt_interaction = credit_utilization * debt_ratio;
4942       
4943           /* Cap extreme outliers */
4944           credit_utilization_capped = min(credit_utilization, 200);
4945           debt_ratio_capped = min(debt_ratio, 500);
4946       run;
4947       
4948       /*****************************************************************************
4949        * 4. Score Test Set Using Trained Model
4950        *****************************************************************************/
4951       
4952       /* Score test set with trained model */
4953       proc plm restore=work.logit_model;
4954           score data=work.test_features
4955                 out=work.test_scored_temp
4956                 predicted=predicted_logit;
4957       run;
4958       
4959       /* Convert logit to probability */
4960       data work.test_scored;
4961           set work.test_scored_temp;
4962       
4963           /* Apply inverse logit function */
4964           pd_logistic = 1 / (1 + exp(-predicted_logit));
4965       
4966           drop predicted_logit;
4967       run;
4968       
4969       /*****************************************************************************
4970        * 5. Generate Risk Scores and Recommendations
4971        *****************************************************************************/
4972       
4973       data work.test_predictions;
4974           set work.test_scored;
4975       
4976           /* Binary prediction at 0.5 threshold */
4977           pred_logistic = (pd_logistic >= 0.5);
4978       
4979           /* Convert probability to credit risk score (300-850 scale) */
4980           base_score = 600;
4981           score_range = 250;
4982           credit_risk_score = base_score + score_range * (1 - pd_logistic);
4983       
4984           /* Assign risk grades from the probability (a missing probability is graded F) */
4985           if missing(pd_logistic) then risk_grade = 'F';
4986           else if pd_logistic < 0.10 then risk_grade = 'A';
4987           else if pd_logistic < 0.15 then risk_grade = 'B';
4988           else if pd_logistic < 0.25 then risk_grade = 'C';
4989           else if pd_logistic < 0.35 then risk_grade = 'D';
4990           else if pd_logistic <= 0.50 then risk_grade = 'E';
4991           else risk_grade = 'F';
4992       
4993           /* Recommended actions */
4994           if risk_grade in ('A', 'B') then recommendation = 'Approve';
4995           else if risk_grade = 'C' then recommendation = 'Review';
4996           else recommendation = 'Decline';
4997       
4998           /* Suggested interest rate */
4999           base_rate = 0.05;
5000           if risk_grade = 'A' then interest_rate = base_rate;
5001           else if risk_grade = 'B' then interest_rate = base_rate + 0.02;
5002           else if risk_grade = 'C' then interest_rate = base_rate + 0.04;
5003           else if risk_grade = 'D' then interest_rate = base_rate + 0.07;
5004           else if risk_grade = 'E' then interest_rate = base_rate + 0.10;
5005           else interest_rate = base_rate + 0.15;
5006       
5007           format interest_rate percent8.2;
5008       run;
5009       
5010       /*****************************************************************************
5011        * 6. Create Output Datasets
5012        *****************************************************************************/
5013       
5014       /* Kaggle submission format (row_id, probability) */
5015       data work.kaggle_submission;
5016           set work.test_predictions;
5017           keep row_id pd_logistic;
5018       run;
5019       
5020       /* Full predictions with all scores and recommendations */
5021       data work.test_predictions_full;
5022           set work.test_predictions;
5023           keep row_id pd_logistic pred_logistic credit_risk_score risk_grade
5024                recommendation interest_rate age monthly_income
5025                credit_utilization debt_ratio total_late_payments
5026                num_credit_lines financial_health total_risk_flags;
5027       run;
